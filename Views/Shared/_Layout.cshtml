<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CVBuilder Pro</title>
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)

    <style>
        .navbar-brand { font-weight: 800; color: #0d6efd !important; }
        .nav-link { font-weight: 500; color: #444 !important; }
        .nav-link:hover { color: #0d6efd !important; }
        footer { background: #f8f9fa; border-top: 1px solid #dee2e6; padding: 40px 0; }
        /* Tinh chỉnh dropdown cho đẹp */
        .user-dropdown-btn { border: 1.5px solid #0d6efd; color: #0d6efd; font-weight: 600; }
        .user-dropdown-btn:hover { background-color: #0d6efd; color: white; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm py-3">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-file-invoice me-2"></i>CVBuilder
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Resume" asp-action="Templates">Mẫu CV</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Jobs">Việc làm</a>
                        </li>
                    </ul>
                    
                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <div class="dropdown">
                                <button class="btn user-dropdown-btn dropdown-toggle rounded-pill px-4 shadow-sm" 
                                        type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-user-circle me-2"></i> Chào, @User.Identity.Name
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" aria-labelledby="userDropdown">
                                    <li>
                                        <a class="dropdown-item py-2" href="/Resume/MyResumes">
                                            <i class="fas fa-file-invoice me-2 text-primary"></i> CV của tôi
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" href="/Account/Profile">
                                            <i class="fas fa-user-cog me-2 text-primary"></i> Thông tin cá nhân
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item py-2 text-danger" asp-controller="Account" asp-action="Logout">
                                            <i class="fas fa-sign-out-alt me-2"></i> Đăng xuất
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary px-4 rounded-pill">Đăng nhập / Đăng ký</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="content-wrapper">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <h5 class="fw-bold text-primary mb-3">CVBuilder Pro</h5>
                    <p class="text-muted">Nền tảng hỗ trợ tạo CV chuyên nghiệp và kết nối cơ hội việc làm nhanh chóng cho sinh viên CNTT.</p>
                </div>
                <div class="col-md-2 mb-4">
                    <h6 class="fw-bold">Khám phá</h6>
                    <ul class="list-unstyled">
                        <li><a asp-controller="Resume" asp-action="Templates" class="text-decoration-none text-muted">Mẫu CV</a></li>
                        <li><a asp-controller="Home" asp-action="Jobs" class="text-decoration-none text-muted">Việc làm mới</a></li>
                    </ul>
                </div>
                <div class="col-md-3 mb-4">
                    <h6 class="fw-bold">Hỗ trợ</h6>
                    <ul class="list-unstyled">
                        <li><a asp-controller="Support" asp-action="Guide" class="text-decoration-none text-muted">Hướng dẫn sử dụng</a></li>
                        <li><a asp-controller="Support" asp-action="Contact" class="text-decoration-none text-muted">Liên hệ chúng tôi</a></li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h6 class="fw-bold">Kết nối</h6>
                    <div class="d-flex gap-3 fs-4">
                        <a href="#" class="text-primary"><i class="fab fa-facebook"></i></a>
                        <a href="#" class="text-info"><i class="fab fa-linkedin"></i></a>
                        <a href="#" class="text-dark"><i class="fab fa-github"></i></a>
                    </div>
                </div>
            </div>
            <hr class="my-4">
            <div class="text-center text-muted small">
                &copy; @DateTime.Now.Year - Đồ án Công nghệ Thông tin - Phát triển bởi Nguyễn Võ Lê Khoa và đồng bọn
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>