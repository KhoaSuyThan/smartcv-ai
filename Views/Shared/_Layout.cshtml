    <script>
    (function () {
        window.chatboxToggle = function () {
            const box = document.getElementById('ai-chatbox');
            box.classList.toggle('open');
            if (box.classList.contains('open')) {
                document.getElementById('chat-badge').style.display = 'none';
            }
        };

        window.chatboxOpen = function (msg = "") {
            const box = document.getElementById('ai-chatbox');
            if (box && !box.classList.contains('open')) {
                window.chatboxToggle();
            }
            if (msg) {
                const input = document.getElementById('chatbox-input');
                if (input) {
                    input.value = msg;
                    input.dispatchEvent(new Event('input'));
                    input.focus();
                }
            }
        };

        // Danh sách câu hỏi thường gặp và câu trả lời nhanh (tránh tốn token)
        const faqData = {
            "tạo cv như thế nào?": "Để tạo CV, bạn hãy thực hiện các bước sau:<br>1. Vào mục <strong>Mẫu CV</strong> trên thanh menu.<br>2. Chọn một mẫu thiết kế bạn ưng ý.<br>3. Nhấn <strong>Sử dụng mẫu này</strong> và điền thông tin cá nhân.<br>4. Nhấn <strong>Lưu</strong> và <strong>Tải xuống</strong> định dạng PDF.",
            "tìm việc làm it": "Bạn có thể vào mục <strong>Việc làm</strong> để xem danh sách các cơ hội nghề nghiệp mới nhất. Bạn cũng có thể lọc theo ngôn ngữ lập trình hoặc mức lương mong muốn nhé!",
            "tính năng pro là gì?": "Tài khoản <strong>Pro</strong> mang lại cho bạn các đặc quyền:<br>- Sử dụng toàn bộ kho mẫu CV cao cấp.<br>- Không bị dính logo watermark khi xuất PDF.<br>- Được AI ưu tiên phân tích sâu hơn cho hồ sơ của bạn.",
            "ai hỗ trợ gì?": "AI của chúng tôi hỗ trợ bạn:<br>- <strong>Viết nội dung</strong> chuyên nghiệp cho CV.<br>- <strong>Chấm điểm</strong> sức mạnh hồ sơ.<br>- <strong>Tư vấn</strong> công việc phù hợp với kỹ năng của bạn.",
            "liên hệ hỗ trợ": "Bạn có thể liên hệ với đội ngũ hỗ trợ qua:<br>- Facebook: <a href='https://www.facebook.com/lekhoa.nguyenvo.7' target='_blank'>CVBuilder Pro</a><br>- Email: khoanv249@gmail.com<br>- Hotline: 0374139213 (8:00 - 22:00)"
        };

        function showFaqChips() {
            const faq = document.getElementById('chatbox-faq');
            if (faq) {
                faq.style.display = 'flex';
                // Cuộn xuống cuối để thấy chips nếu tin nhắn quá dài
                const msgs = document.getElementById('chatbox-messages');
                msgs.scrollTop = msgs.scrollHeight;
            }
        }

        window.chatboxSendFaq = function (el) {
            // Lấy text bỏ emoji đầu dòng
            const question = el.textContent.replace(/^\p{Emoji_Presentation}\s*/u, '').trim();
            const lowerQuestion = question.toLowerCase();

            // Hiển thị câu hỏi của người dùng
            appendMessage(question, 'user');
            
            // Ẩn FAQ chips sau lần hỏi đầu
            document.getElementById('chatbox-faq').style.display = 'none';

            // Kiểm tra nếu có câu trả lời sẵn
            if (faqData[lowerQuestion]) {
                showTyping();
                setTimeout(() => {
                    removeTyping();
                    appendMessage(faqData[lowerQuestion], 'bot');
                    
                    // Hiện lại FAQ chips sau 3s
                    setTimeout(showFaqChips, 1000);
                }, 600); // Tạo hiệu ứng chờ nhẹ cho tự nhiên
                return;
            }

            // Nếu không có, gửi cho AI
            document.getElementById('chatbox-input').value = question;
            chatboxSend(true); // Tham số true để báo là đã hiển thị message user rồi
        };

        window.chatboxKeyDown = function (e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                chatboxSend();
            }
        };

        function appendMessage(text, type) {
            const msgs = document.getElementById('chatbox-messages');
            const div = document.createElement('div');
            div.className = 'chat-bubble ' + type;
            div.innerHTML = text;
            msgs.appendChild(div);
            msgs.scrollTop = msgs.scrollHeight;
            return div;
        }

        function showTyping() {
            const msgs = document.getElementById('chatbox-messages');
            const div = document.createElement('div');
            div.className = 'typing-indicator';
            div.id = 'chatbox-typing';
            div.innerHTML = '<div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div>';
            msgs.appendChild(div);
            msgs.scrollTop = msgs.scrollHeight;
        }

        function removeTyping() {
            const t = document.getElementById('chatbox-typing');
            if (t) t.remove();
        }

        function formatReply(text) {
            return text
                .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                .replace(/\*(.*?)\*/g, '<em>$1</em>')
                .replace(/\n/g, '<br>');
        }

        window.chatboxSend = async function (userMsgAlreadyShown = false) {
            const input = document.getElementById('chatbox-input');
            const sendBtn = document.getElementById('chatbox-send');
            const msg = input.value.trim();
            if (!msg) return;

            if (!userMsgAlreadyShown) {
                appendMessage(msg, 'user');
            }
            
            input.value = '';
            input.style.height = '38px';
            sendBtn.disabled = true;
            showTyping();

            // Ẩn FAQ chips sau lần hỏi đầu
            document.getElementById('chatbox-faq').style.display = 'none';

            try {
                const res = await fetch('/AI/ChatboxAsk', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: msg })
                });
                const data = await res.json();
                removeTyping();
                if (data.success) {
                    appendMessage(formatReply(data.reply), 'bot');
                } else {
                    appendMessage('⚠️ ' + (data.reply || 'Có lỗi xảy ra, thử lại nhé!'), 'bot-error');
                }
                
                // Hiện lại FAQ chips sau 3s
                setTimeout(showFaqChips, 3000);
            } catch (err) {
                removeTyping();
                appendMessage('⚠️ Không thể kết nối. Vui lòng kiểm tra mạng!', 'bot-error');
                
                // Hiện lại FAQ chips sau 3s
                setTimeout(showFaqChips, 3000);
            } finally {
                sendBtn.disabled = false;
                input.focus();
            }
        };

        // Auto-resize textarea
        document.addEventListener('DOMContentLoaded', function () {
            const input = document.getElementById('chatbox-input');
            if (input) {
                input.addEventListener('input', function () {
                    this.style.height = '38px';
                    this.style.height = Math.min(this.scrollHeight, 90) + 'px';
                });
            }
        });
    })();
    </script>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
