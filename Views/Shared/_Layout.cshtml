@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment env
@inject DoAnCS.Data.AppDbContext _context
@{
    double avgRating = 0;
    int totalFeedbacks = 0;
    try {
        if (_context.SiteFeedbacks.Any()) {
            avgRating = Math.Round(_context.SiteFeedbacks.Average(f => f.Rating), 1);
            totalFeedbacks = _context.SiteFeedbacks.Count();
        }
        
        if (avgRating < 4) {
            avgRating = 4.3;
        }
    } catch {}
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CVBuilder Pro</title>
    
    <!-- Open Graph / Meta Tags for Social Media Sharing -->
    @{
        var pageTitle = ViewData["Title"] != null ? $"{ViewData["Title"]} - CVBuilder Pro" : "Kiến tạo sự nghiệp tương lai - CVBuilder Pro";
        var pageDescription = ViewData["Description"] ?? "Nền tảng tiên phong tích hợp trí tuệ nhân tạo (AI) giúp tối ưu hóa CV và kết nối nhân tài với các doanh nghiệp hàng đầu.";
        var request = Context.Request;
        var absoluteFaviconUrl = $"{request.Scheme}://{request.Host}{Url.Content("~/favicon.png")}";
    }
    <meta name="description" content="@pageDescription" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@pageDescription" />
    <meta property="og:image" content="@absoluteFaviconUrl" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@($"{request.Scheme}://{request.Host}{request.Path}")" />

    <link rel="icon" type="image/png" href="~/favicon.png?v=2" />
    <link rel="shortcut icon" href="~/favicon.png?v=2" />
    <link rel="apple-touch-icon" href="~/favicon.png?v=2" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    @await RenderSectionAsync("Styles", required: false)

    <!-- Script chống FOUC (Flash of Unstyled Content) cho Dark Mode -->
    <script>
        const storedTheme = localStorage.getItem('theme') || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        if (storedTheme) {
            document.documentElement.setAttribute('data-bs-theme', storedTheme);
        }
    </script>

    <style>
        html {
            zoom: 80%; /* Ép toàn bộ trang về 80% */
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        @@media print {
            html {
                zoom: 100% !important;
            }
        }
        body {
            margin: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            flex: 1;
        }

        /* 2. Ép phần nội dung chính giãn ra để đẩy footer xuống */
        .content-wrapper {
            flex: 1 0 auto; /* Tự động giãn ra để chiếm hết khoảng trống, đẩy footer xuống dưới */
            display: flex;
            flex-direction: column;
        }

        main[role="main"] {
            flex: 1 0 auto;
        }

        /* 3. Đảm bảo footer không bị co lại */
        footer {
            flex-shrink: 0;
        }
        .navbar-brand { font-weight: 800; color: #0d6efd !important; white-space: nowrap; font-size: 1.65rem; }
        .nav-link { font-weight: 600; color: #444 !important; transition: all 0.3s ease; position: relative; padding: 0.5rem 0.8rem !important; white-space: nowrap; font-size: 1.05rem; }
        .nav-link:hover, .nav-link.active { color: #0d6efd !important; }
        .nav-link::after { content: ''; position: absolute; width: 0; height: 2px; bottom: 5px; left: 50%; background: #0d6efd; transition: 0.3s; transform: translateX(-50%); }
        .nav-link:hover::after, .nav-link.active::after { width: 70%; }
        footer { background: #ffffff; border-top: 1px solid #eee; padding: 50px 0 20px 0; }
        .user-dropdown-btn { border: 1.5px solid #0d6efd; color: #0d6efd; font-weight: 600; transition: 0.3s; white-space: nowrap; }
        .user-dropdown-btn:hover { background-color: #0d6efd; color: white; }
        .navbar .btn { white-space: nowrap; }
        .container-navbar {
            display: flex;
            flex-wrap: inherit;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            padding-right: 1.5rem;
            padding-left: 1.5rem;
            margin-right: auto;
            margin-left: auto;
            max-width: 1450px;
        }
        .footer-link { color: #6c757d; text-decoration: none; transition: 0.3s; }
        .footer-link:hover { color: #0d6efd; padding-left: 5px; }

        /* Styles cho Admin Sidebar cố định (Phiên bản sáng sủa có chia khối) */
        .admin-sidebar-container { border-right: 2px solid #dee2e6; }
        .sidebar-group { border-color: #e9ecef !important; background-color: #fcfcfc; box-shadow: 0 1px 2px rgba(0,0,0,0.02); }
        .admin-sidebar-container .menu-label { color: #043277ff; font-size: 0.75rem; font-weight: 900; letter-spacing: 1.2px; padding: 5px 10px; text-transform: uppercase; margin-bottom: 0; opacity: 0.9; }
        .admin-sidebar-container .menu-item { display: flex; align-items: center; gap: 12px; padding: 10px 14px; color: #495057; text-decoration: none; border-radius: 8px; transition: 0.2s; font-weight: 600; margin: 2px 0; }
        .admin-sidebar-container .menu-item i { font-size: 1.25rem; color: #6c757d; transition: 0.2s; }
        .admin-sidebar-container .menu-item:hover { background: #e9ecef; color: #0d6efd; transform: translateX(2px); }
        .admin-sidebar-container .menu-item:hover i { color: #0d6efd; }
        .admin-sidebar-container .menu-item.active { background: #ffffff; color: #0d6efd; border-left: 4px solid #0d6efd; border-radius: 4px 8px 8px 4px; padding-left: 10px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); border-top: 1px solid #f1f3f5; border-right: 1px solid #f1f3f5; border-bottom: 1px solid #f1f3f5; }
        .admin-sidebar-container .menu-item.active i { color: #0d6efd; }
        /* Sửa lỗi lệch Modal khi dùng CSS Zoom */
        .modal-backdrop {
            width: 150vw !important;  /* Tăng bề rộng lớp nền */
            height: 150vh !important; /* Tăng chiều cao lớp nền */
        }

        .modal {
            /* Đảm bảo vị trí modal luôn chuẩn */
            perspective: none !important;
        }

        /* Hỗ trợ chế độ tối (Dark Mode) cho các thành phần chính */
        [data-bs-theme="dark"] body {
            background-color: #121212 !important;
            color: #e0e0e0 !important;
        }
        [data-bs-theme="dark"] .navbar {
            background-color: #1e1e1e !important;
            border-bottom: 1px solid #2d2d2d !important;
        }
        [data-bs-theme="dark"] .nav-link {
            color: #b0b0b0 !important;
        }
        [data-bs-theme="dark"] .nav-link:hover,
        [data-bs-theme="dark"] .nav-link.active {
            color: #0d6efd !important;
        }
        [data-bs-theme="dark"] footer {
            background-color: #1a1a1a !important;
            border-top: 1px solid #2d2d2d !important;
            color: #b0b0b0 !important;
        }
        [data-bs-theme="dark"] .footer-link {
            color: #888888 !important;
        }
        [data-bs-theme="dark"] .footer-link:hover {
            color: #0d6efd !important;
        }
        [data-bs-theme="dark"] .admin-sidebar-container {
            background-color: #1e1e1e !important;
            border-right: 2px solid #2d2d2d !important;
        }
        [data-bs-theme="dark"] .sidebar-group {
            background-color: #1a1a1a !important;
            border-color: #2d2d2d !important;
        }
        [data-bs-theme="dark"] .admin-sidebar-container .menu-item {
            color: #c0c0c0 !important;
        }
        [data-bs-theme="dark"] .admin-sidebar-container .menu-item:hover {
            background-color: #2d2d2d !important;
            color: #0d6efd !important;
        }
        [data-bs-theme="dark"] .admin-sidebar-container .menu-item.active {
            background-color: #252525 !important;
            border-color: #0d6efd !important;
            color: #0d6efd !important;
        }
        [data-bs-theme="dark"] .card,
        [data-bs-theme="dark"] .modal-content {
            background-color: #1e1e1e !important;
            border-color: #2d2d2d !important;
            color: #e0e0e0 !important;
        }
        [data-bs-theme="dark"] .text-dark:not(.bg-warning) {
            color: #e0e0e0 !important;
        }
        [data-bs-theme="dark"] .bg-warning.text-dark {
            color: #000 !important;
        }
        [data-bs-theme="dark"] .bg-white {
            background-color: #1e1e1e !important;
        }
        [data-bs-theme="dark"] .bg-light {
            background-color: #121212 !important;
        }
        .pro-warning-bubble {
            position: absolute;
            top: 50%;
            left: calc(100% + 15px);
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            color: white;
            padding: 8px 10px;
            border-radius: 12px;
            font-size: 0.8rem;
            font-weight: 600;
            box-shadow: 0 10px 25px rgba(220, 38, 38, 0.35);
            z-index: 1050;
            display: flex;
            align-items: flex-start;
            gap: 6px;
            width: max-content;
            line-height: 1.4;
            animation: bubbleFadeInLeft 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
            transform-origin: left center;
        }
        .pro-warning-bubble::before {
            content: '';
            position: absolute;
            top: 50%;
            right: 100%;
            transform: translateY(-50%);
            border-width: 8px;
            border-style: solid;
            border-color: transparent #ef4444 transparent transparent;
        }
        .pro-warning-bubble .btn-close {
            font-size: 0.6rem;
            opacity: 0.8;
            transition: 0.2s;
        }
        .pro-warning-bubble .btn-close:hover { opacity: 1; transform: scale(1.1); }
        @@keyframes bubbleFadeInLeft {
            from { opacity: 0; transform: translateY(-50%) translateX(-15px) scale(0.95); }
            to { opacity: 1; transform: translateY(-50%) translateX(0) scale(1); }
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm py-3">
            <div class="container-navbar">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-file-invoice me-2"></i>CVBuilder
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" 
                               asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home me-1"></i> Trang chủ
                            </a>
                        </li>

                        @* Quyền hạn chung cho khách và Ứng viên *@
                        @if (!User.IsInRole("Recruiter"))
                        {
                            @if (env.IsDevelopment())
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Resume" && ViewContext.RouteData.Values["action"]?.ToString() == "Templates" ? "active" : "")" 
                                       asp-controller="Resume" asp-action="Templates">
                                        <i class="fas fa-flask me-1"></i> Mẫu CV Beta
                                    </a>
                                </li>
                            }

                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Resume" && ViewContext.RouteData.Values["action"]?.ToString() == "VueTemplates" ? "active" : "")" 
                                   asp-controller="Resume" asp-action="VueTemplates">
                                    <i class="fas fa-id-card me-1"></i> Mẫu CV
                                </a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link @((ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && (ViewContext.RouteData.Values["action"]?.ToString() == "Jobs" || ViewContext.RouteData.Values["action"]?.ToString() == "Details")) || (ViewContext.RouteData.Values["controller"]?.ToString() == "Jobs" && ViewContext.RouteData.Values["action"]?.ToString() == "Index") ? "active" : "")" 
                               asp-controller="Home" asp-action="Jobs">
                                <i class="fas fa-search me-1"></i> Ứng tuyển
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Companies" ? "active" : "")" 
                               asp-controller="Companies" asp-action="Index">
                                <i class="fas fa-building me-1"></i> Công ty
                            </a>
                        </li>

                        @* PHÂN QUYỀN TRÊN MENU CHÍNH *@
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-danger fw-bold @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")" 
                                       asp-controller="Admin" asp-action="Index">
                                        <i class="fas fa-user-shield me-1"></i> Quản trị hệ thống
                                    </a>
                                </li>
                            }
                            
                            @if (User.IsInRole("Recruiter"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-primary fw-bold @(ViewContext.RouteData.Values["controller"]?.ToString() == "Jobs" && (ViewContext.RouteData.Values["action"]?.ToString() == "Manage" || ViewContext.RouteData.Values["action"]?.ToString() == "Create" || ViewContext.RouteData.Values["action"]?.ToString() == "Edit") ? "active" : "")" 
                                       asp-controller="Jobs" asp-action="Manage">
                                        <i class="fas fa-briefcase me-1"></i> Tuyển dụng
                                    </a>
                                </li>
                                <li class="nav-item dropdown dropdown-hover">
                                    <a class="nav-link text-success fw-bold d-inline-flex align-items-center @(ViewContext.RouteData.Values["controller"]?.ToString() == "Talent" || ViewContext.RouteData.Values["controller"]?.ToString() == "SmartMatch" ? "active" : "")" 
                                       asp-controller="Talent" asp-action="Index"
                                       id="talentDropdown" role="button" aria-expanded="false">
                                        <i class="fas fa-users me-1"></i> Tìm ứng viên <i class="fas fa-chevron-down ms-1" style="font-size: 0.7rem; opacity: 0.85;"></i>
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-hover shadow border-0 mt-0" aria-labelledby="talentDropdown">
                                        <li>
                                            <a class="dropdown-item py-2 px-3 fw-bold text-success @(ViewContext.RouteData.Values["controller"]?.ToString() == "Talent" ? "active-item" : "")" asp-controller="Talent" asp-action="Index">
                                                <i class="fas fa-users me-2"></i> Tìm ứng viên
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider my-1 opacity-10"></li>
                                        <li>
                                            <a class="dropdown-item py-2 px-3 fw-bold @(ViewContext.RouteData.Values["controller"]?.ToString() == "SmartMatch" ? "active-item" : "")" asp-controller="SmartMatch" asp-action="Index" style="color: #7c3aed !important;">
                                                <i class="fas fa-brain me-2"></i> Smart Match (AI) <span class="badge bg-warning ms-1 rounded-pill" style="font-size: 0.6rem; padding: 2px 6px; color: #000 !important;">PRO</span>
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }

                            @if (User.IsInRole("User")) // Chỉ ứng viên mới thấy menu CV của tôi
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Resume" && ViewContext.RouteData.Values["action"]?.ToString() == "MyResumes" ? "active" : "")" 
                                       asp-controller="Resume" asp-action="MyResumes">
                                        <i class="fas fa-file-alt me-1"></i> CV của tôi
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                    
                    <div class="d-flex align-items-center gap-2">
                        <!-- Nút bật/tắt Dark Mode -->
                        <button id="theme-toggle" class="btn btn-light rounded-circle shadow-sm me-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; border: 1px solid #dee2e6; transition: all 0.3s;" title="Chuyển đổi Chế độ Tối/Sáng">
                            <i class="fas fa-moon text-secondary" id="theme-icon"></i>
                        </button>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (!User.HasClaim("IsPro", "True") && !User.IsInRole("Admin"))
                            {
                                <a asp-controller="Account" asp-action="Upgrade" class="btn btn-outline-warning btn-sm rounded-pill px-3 fw-bold d-none d-md-inline-block">
                                    <i class="fas fa-crown me-1"></i> Nâng cấp Pro
                                </a>
                            }
                            <div class="dropdown position-relative">
                                @{
                                    bool showProWarning = false;
                                    int daysRemaining = 0;
                                    
                                    // Chỉ hiển thị thông báo ở Trang chủ (Path == "/" hoặc "/Home/Index")
                                    bool isHomePage = Context.Request.Path == "/" || Context.Request.Path.Value.Equals("/Home/Index", StringComparison.OrdinalIgnoreCase);
                                    
                                    if (User.HasClaim("IsPro", "True") && isHomePage)
                                    {
                                        var userIdClaim = User.FindFirst("UserID")?.Value;
                                        if (int.TryParse(userIdClaim, out int uid))
                                        {
                                            var currentUser = _context.Users.FirstOrDefault(u => u.UserID == uid);
                                            if (currentUser != null && currentUser.ProExpirationDate.HasValue)
                                            {
                                                var timeDiff = currentUser.ProExpirationDate.Value - DateTime.Now;
                                                if (timeDiff.TotalDays > 0 && timeDiff.TotalDays <= 3)
                                                {
                                                    daysRemaining = (int)Math.Ceiling(timeDiff.TotalDays);
                                                    showProWarning = true;
                                                }
                                            }
                                        }
                                    }
                                }
                                <button class="btn user-dropdown-btn dropdown-toggle rounded-pill px-4 shadow-sm" 
                                        type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-user-circle me-2"></i> 
                                    @User.Identity.Name
                                    @if (User.HasClaim("IsPro", "True"))
                                    {
                                        <i class="fas fa-crown ms-1 text-warning" title="Thành viên Pro"></i>
                                    }
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" aria-labelledby="userDropdown">
                                    @if (!User.HasClaim("IsPro", "True") && !User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a class="dropdown-item py-2 text-warning fw-bold" asp-controller="Account" asp-action="Upgrade">
                                                <i class="fas fa-crown me-2"></i> Nâng cấp Pro
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    <li>
                                        <a class="dropdown-item py-2" href="/Account/Profile">
                                            <i class="fas fa-id-card me-2 text-primary"></i> 
                                            @if (User.IsInRole("Recruiter"))
                                            {
                                                <span>Hồ sơ doanh nghiệp</span>
                                            }
                                            else
                                            {
                                                <span>Hồ sơ cá nhân</span>
                                            }
                                        </a>
                                    </li>
                                    @if (User.IsInRole("User"))
                                    {
                                        <li>
                                            <a class="dropdown-item py-2" href="/Account/Applications">
                                                <i class="fas fa-briefcase me-2 text-info"></i> Quản lý Ứng tuyển
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item py-2 text-danger" asp-controller="Account" asp-action="Logout">
                                            <i class="fas fa-sign-out-alt me-2"></i> Đăng xuất
                                        </a>
                                    </li>
                                </ul>
                                
                                @if (showProWarning)
                                {
                                    <div id="pro-warning-bubble" class="pro-warning-bubble d-none" data-days="@daysRemaining">
                                        <i class="fas fa-exclamation-triangle mt-1"></i>
                                        <div style="flex: 1; display: flex; flex-direction: column;">
                                            <span style="white-space: nowrap;">Gói Pro hết hạn sau @daysRemaining ngày!</span>
                                            <div>
                                                <a asp-controller="Account" asp-action="Upgrade" class="text-white text-decoration-underline fw-bold mt-1 d-inline-block" style="font-size: 0.9rem; white-space: nowrap;">Gia hạn ngay</a>
                                            </div>
                                        </div>
                                        <button type="button" class="btn-close btn-close-white ms-2 mt-1 flex-shrink-0" aria-label="Close" onclick="closeProWarning()"></button>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-primary px-4 rounded-pill shadow-sm">
                                <i class="fas fa-sign-in-alt me-2"></i>Đăng nhập
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="content-wrapper">
        <main role="main">
            @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Admin")
            {
                var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
                <div class="d-flex">
                    <!-- Admin Sidebar Cố định dạng Sticky bản sáng -->
                    <div class="admin-sidebar-container d-none d-lg-block bg-white shadow-sm" style="width: 280px; height: 100vh; position: sticky; top: 0; align-self: flex-start; overflow-y: hidden;">
                        <div class="p-4 border-bottom border-1 mb-3 text-center">
                            <h5 class="text-primary fw-bolder m-0" style="letter-spacing: 1.5px;">
                                <i class='fas fa-user-shield text-primary me-2 fs-4' style="vertical-align: middle;"></i>ADMIN PANEL
                            </h5>
                        </div>
                        <div class="px-3 pb-4">
                            <!-- Nhóm Tổng quan -->
                            <div class="sidebar-group border rounded-3 p-2 mb-3">
                                <a href="/Admin" class="menu-item @(currentAction == "Index" ? "active" : "")"><i class='bx bxs-dashboard'></i> Tổng quan</a>
                            </div>
                            
                            <!-- Nhóm Dữ liệu -->
                            <div class="sidebar-group border rounded-3 p-2 mb-3">
