<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CVBuilder Pro</title>
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)

    <style>
        html {
            zoom: 80%; /* Ép toàn bộ trang về 80% */
            height: 100%;
        }
        /* 1. Thiết lập cho toàn bộ trang */
        body {
            margin: 0;
            display: flex;
            flex-direction: column;
            height: 100%;   /* Ép body chiếm trọn không gian đã zoom */
        }

        /* 2. Ép phần nội dung chính giãn ra để đẩy footer xuống */
        .content-wrapper {
            flex: 1 0 auto; /* Tự động giãn ra để chiếm hết khoảng trống, đẩy footer xuống dưới */
            display: flex;
            flex-direction: column;
        }

        main[role="main"] {
            flex: 1 0 auto;
        }

        /* 3. Đảm bảo footer không bị co lại */
        footer {
            flex-shrink: 0;
        }
        .navbar-brand { font-weight: 800; color: #0d6efd !important; }
        .nav-link { font-weight: 500; color: #444 !important; transition: 0.3s; }
        .nav-link:hover { color: #0d6efd !important; transform: translateY(-1px); }
        footer { background: #ffffff; border-top: 1px solid #eee; padding: 50px 0 20px 0; }
        .user-dropdown-btn { border: 1.5px solid #0d6efd; color: #0d6efd; font-weight: 600; transition: 0.3s; }
        .user-dropdown-btn:hover { background-color: #0d6efd; color: white; }
        .footer-link { color: #6c757d; text-decoration: none; transition: 0.3s; }
        .footer-link:hover { color: #0d6efd; padding-left: 5px; }

        /* Styles cho Admin Sidebar cố định (Phiên bản sáng sủa có chia khối) */
        .admin-sidebar-container { border-right: 2px solid #dee2e6; }
        .sidebar-group { border-color: #e9ecef !important; background-color: #fcfcfc; box-shadow: 0 1px 2px rgba(0,0,0,0.02); }
        .admin-sidebar-container .menu-label { color: #043277ff; font-size: 0.75rem; font-weight: 900; letter-spacing: 1.2px; padding: 5px 10px; text-transform: uppercase; margin-bottom: 0; opacity: 0.9; }
        .admin-sidebar-container .menu-item { display: flex; align-items: center; gap: 12px; padding: 10px 14px; color: #495057; text-decoration: none; border-radius: 8px; transition: 0.2s; font-weight: 600; margin: 2px 0; }
        .admin-sidebar-container .menu-item i { font-size: 1.25rem; color: #6c757d; transition: 0.2s; }
        .admin-sidebar-container .menu-item:hover { background: #e9ecef; color: #0d6efd; transform: translateX(2px); }
        .admin-sidebar-container .menu-item:hover i { color: #0d6efd; }
        .admin-sidebar-container .menu-item.active { background: #ffffff; color: #0d6efd; border-left: 4px solid #0d6efd; border-radius: 4px 8px 8px 4px; padding-left: 10px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); border-top: 1px solid #f1f3f5; border-right: 1px solid #f1f3f5; border-bottom: 1px solid #f1f3f5; }
        .admin-sidebar-container .menu-item.active i { color: #0d6efd; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm py-3">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-file-invoice me-2"></i>CVBuilder
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home me-1"></i> Trang chủ
                            </a>
                        </li>

                        @* Quyền hạn chung cho khách và Ứng viên *@
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Resume" asp-action="Templates">
                                <i class="fas fa-id-card me-1"></i> Mẫu CV
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Jobs">
                                <i class="fas fa-briefcase me-1"></i> Việc làm
                            </a>
                        </li>

                        @* PHÂN QUYỀN TRÊN MENU CHÍNH *@
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-danger fw-bold" asp-controller="Admin" asp-action="Index">
                                        <i class="fas fa-user-shield me-1"></i> Quản trị hệ thống
                                    </a>
                                </li>
                            }
                            
                            @if (User.IsInRole("Recruiter"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-primary fw-bold" asp-controller="Jobs" asp-action="Manage">
                                        <i class="fas fa-briefcase me-1"></i> Tuyển dụng
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("User")) // Chỉ ứng viên mới thấy menu CV của tôi
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Resume" asp-action="MyResumes">CV của tôi</a>
                                </li>
                            }
                        }
                    </ul>
                    
                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <div class="dropdown">
                                <button class="btn user-dropdown-btn dropdown-toggle rounded-pill px-4 shadow-sm" 
                                        type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-user-circle me-2"></i> @User.Identity.Name
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" aria-labelledby="userDropdown">
                                    <li>
                                        <a class="dropdown-item py-2" href="/Account/Profile">
                                            <i class="fas fa-id-card me-2 text-primary"></i> 
                                            @if (User.IsInRole("Recruiter"))
                                            {
                                                <span>Hồ sơ doanh nghiệp</span>
                                            }
                                            else
                                            {
                                                <span>Hồ sơ cá nhân</span>
                                            }
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item py-2 text-danger" asp-controller="Account" asp-action="Logout">
                                            <i class="fas fa-sign-out-alt me-2"></i> Đăng xuất
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-primary px-4 rounded-pill shadow-sm">
                                <i class="fas fa-sign-in-alt me-2"></i>Đăng nhập
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="content-wrapper">
        <main role="main">
            @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Admin")
            {
                var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
                <div class="d-flex">
                    <!-- Admin Sidebar Cố định dạng Sticky bản sáng -->
                    <div class="admin-sidebar-container d-none d-lg-block bg-white shadow-sm" style="width: 280px; height: calc(100vh - 76px); position: sticky; top: 0; align-self: flex-start; overflow-y: auto;">
                        <div class="p-4 border-bottom border-1 mb-3 text-center">
                            <h5 class="text-primary fw-bolder m-0" style="letter-spacing: 1.5px;">
                                <i class='fas fa-user-shield text-primary me-2 fs-4' style="vertical-align: middle;"></i>ADMIN PANEL
                            </h5>
                        </div>
                        <div class="px-3 pb-4">
                            <!-- Nhóm Tổng quan -->
                            <div class="sidebar-group border rounded-3 p-2 mb-3">
                                <a href="/Admin" class="menu-item @(currentAction == "Index" ? "active" : "")"><i class='bx bxs-dashboard'></i> Tổng quan</a>
                            </div>
                            
                            <!-- Nhóm Dữ liệu -->
                            <div class="sidebar-group border rounded-3 p-2 mb-3">
                                <div class="menu-label mb-2 mt-1">QUẢN LÝ DỮ LIỆU</div>
                                <a href="/Admin/Templates" class="menu-item @(currentAction == "Templates" ? "active" : "")"><i class='bx bxs-layout'></i> Mẫu thiết kế CV</a>
                                <a href="/Admin/Jobs" class="menu-item @(currentAction == "Jobs" ? "active" : "")"><i class='bx bxs-briefcase-alt-2'></i> Tin tuyển dụng</a>
                                <a href="/Admin/Companies" class="menu-item @(currentAction == "Companies" ? "active" : "")"><i class='bx bxs-business'></i> Công ty</a>
                            </div>

                            <!-- Nhóm Hệ thống -->
                            <div class="sidebar-group border rounded-3 p-2 mb-3">
                                <div class="menu-label mb-2 mt-1">HỆ THỐNG</div>
                                <a href="/Admin/Users" class="menu-item @(currentAction == "Users" ? "active" : "")"><i class='bx bxs-group'></i> Người dùng</a>
                                <a href="#" class="menu-item"><i class='bx bxs-bot'></i> Cấu hình Gemini</a>
                            </div>
                        </div>
                    </div>

                    <!-- Main Content Panel (Có bề ngang là còn lại trừ Sidebar) -->
                    <div class="flex-grow-1" style="width: calc(100% - 280px); overflow-x: hidden;">
                        @RenderBody()
                    </div>
                </div>
            }
            else
            {
                @RenderBody()
            }
        </main>
    </div>

    @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Admin")
    {
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
        <!-- Mobile Offcanvas Sidebar bản sáng có khối -->
        <div class="offcanvas offcanvas-start border-0 shadow admin-sidebar-container" tabindex="-1" id="adminSidebar" style="width: 280px; background: #ffffff;">
            <div class="p-4 border-bottom border-1 d-flex justify-content-between align-items-center mb-3">
                <h5 class="offcanvas-title text-primary fw-bolder m-0" style="letter-spacing: 1.5px;">
                    <i class='fas fa-user-shield text-primary me-2 fs-4' style="vertical-align: middle;"></i>ADMIN PANEL
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
            </div>
            <div class="offcanvas-body px-3 p-0 pb-4 border-0">
                <!-- Nhóm Tổng quan -->
                <div class="sidebar-group border rounded-3 p-2 mb-3">
                    <a href="/Admin" class="menu-item @(currentAction == "Index" ? "active" : "")"><i class='bx bxs-dashboard'></i> Tổng quan</a>
                </div>
                
                <!-- Nhóm Dữ liệu -->
                <div class="sidebar-group border rounded-3 p-2 mb-3">
                    <div class="menu-label mb-2 mt-1">QUẢN LÝ DỮ LIỆU</div>
                    <a href="/Admin/Templates" class="menu-item @(currentAction == "Templates" ? "active" : "")"><i class='bx bxs-layout'></i> Mẫu thiết kế CV</a>
                    <a href="/Admin/Jobs" class="menu-item @(currentAction == "Jobs" ? "active" : "")"><i class='bx bxs-briefcase-alt-2'></i> Tin tuyển dụng</a>
                    <a href="/Admin/Companies" class="menu-item @(currentAction == "Companies" ? "active" : "")"><i class='bx bxs-business'></i> Công ty</a>
                </div>

                <!-- Nhóm Hệ thống -->
                <div class="sidebar-group border rounded-3 p-2 mb-3">
                    <div class="menu-label mb-2 mt-1">HỆ THỐNG</div>
                    <a href="/Admin/Users" class="menu-item @(currentAction == "Users" ? "active" : "")"><i class='bx bxs-group'></i> Người dùng</a>
                    <a href="#" class="menu-item"><i class='bx bxs-bot'></i> Cấu hình Gemini</a>
                </div>
            </div>
        </div>
    }

    @* FOOTER CẢI THIỆN *@
    <footer>
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="fw-bold text-primary mb-3">
                        <i class="fas fa-file-invoice me-2"></i>CVBuilder Pro
                    </h5>
                    <p class="text-muted" style="text-align: justify;">
                        Nền tảng tiên phong tích hợp trí tuệ nhân tạo (AI) giúp tối ưu hóa CV và kết nối nhân tài với các doanh nghiệp hàng đầu trong ngành Công nghệ thông tin.
                    </p>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h6 class="fw-bold mb-3">Dịch vụ</h6>
                    <ul class="list-unstyled">
                        <li><a asp-controller="Resume" asp-action="Templates" class="footer-link">Kho mẫu CV</a></li>
                        <li><a asp-controller="Home" asp-action="Jobs" class="footer-link">Tìm việc làm</a></li>
                        <li><a href="#" class="footer-link">Tư vấn nghề nghiệp</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h6 class="fw-bold mb-3">Hỗ trợ</h6>
                    <ul class="list-unstyled">
                        <li><a asp-controller="Support" asp-action="Guide" class="footer-link">Hướng dẫn</a></li>
                        <li><a asp-controller="Support" asp-action="Contact" class="footer-link">Liên hệ</a></li>
                        <li><a asp-controller="Support" asp-action="Terms" class="footer-link">Điều khoản sử dụng</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-6 text-lg-center">
                    <h6 class="fw-bold mb-3">Theo dõi chúng tôi</h6>
                    <div class="d-flex gap-3 justify-content-lg-center fs-4 mb-4">
                        <a href="https://www.facebook.com/lekhoa.nguyenvo.7" target="_blank" rel="noopener noreferrer" class="text-primary hover-lift">
                            <i class="fab fa-facebook"></i>
                        </a>
                        <a href="https://www.linkedin.com/in/nguyễn-võ-lê-khoa-7994823b5" target="_blank" rel="noopener noreferrer" class="text-info hover-lift">
                            <i class="fab fa-linkedin"></i>
                        </a>
                        <a href="https://github.com/KhoaSuyThan" target="_blank" rel="noopener noreferrer" class="text-dark hover-lift">
                            <i class="fab fa-github"></i>
                        </a>
                    </div>
                    <p class="small text-muted mb-0">Hỗ trợ 24/7 qua hệ thống Ticket</p>
                </div>
            </div>
            <hr class="my-4 text-muted opacity-25">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start text-muted small">
                    &copy; @DateTime.Now.Year - CVBuilder Pro. All rights reserved.
                </div>
                <div class="col-md-6 text-center text-md-end text-muted small">
                    Phát triển bởi <strong>Nguyễn Võ Lê Khoa</strong> và Đội ngũ cộng tác
                </div>
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>