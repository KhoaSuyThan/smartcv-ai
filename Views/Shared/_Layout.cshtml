<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CVBuilder Pro</title>
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)

    <style>
        .navbar-brand { font-weight: 800; color: #0d6efd !important; }
        .nav-link { font-weight: 500; color: #444 !important; transition: 0.3s; }
        .nav-link:hover { color: #0d6efd !important; transform: translateY(-1px); }
        footer { background: #ffffff; border-top: 1px solid #eee; padding: 50px 0 20px 0; }
        .user-dropdown-btn { border: 1.5px solid #0d6efd; color: #0d6efd; font-weight: 600; transition: 0.3s; }
        .user-dropdown-btn:hover { background-color: #0d6efd; color: white; }
        .footer-link { color: #6c757d; text-decoration: none; transition: 0.3s; }
        .footer-link:hover { color: #0d6efd; padding-left: 5px; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm py-3">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-file-invoice me-2"></i>CVBuilder
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        
                        @* Quyền hạn chung cho khách và Ứng viên *@
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Resume" asp-action="Templates">Mẫu CV</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Jobs">Việc làm</a>
                        </li>

                        @* PHÂN QUYỀN TRÊN MENU CHÍNH *@
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-danger fw-bold" asp-controller="Admin" asp-action="Index">
                                        <i class="fas fa-user-shield me-1"></i> Quản trị hệ thống
                                    </a>
                                </li>
                            }
                            
                            @if (User.IsInRole("Recruiter"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-primary fw-bold" asp-controller="Jobs" asp-action="Manage">
                                        <i class="fas fa-briefcase me-1"></i> Tuyển dụng
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("User")) // Chỉ ứng viên mới thấy menu CV của tôi
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Resume" asp-action="MyResumes">CV của tôi</a>
                                </li>
                            }
                        }
                    </ul>
                    
                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <div class="dropdown">
                                <button class="btn user-dropdown-btn dropdown-toggle rounded-pill px-4 shadow-sm" 
                                        type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-user-circle me-2"></i> @User.Identity.Name
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" aria-labelledby="userDropdown">
                                    <li>
                                        <a class="dropdown-item py-2" href="/Account/Profile">
                                            <i class="fas fa-id-card me-2 text-primary"></i> Hồ sơ cá nhân
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item py-2 text-danger" asp-controller="Account" asp-action="Logout">
                                            <i class="fas fa-sign-out-alt me-2"></i> Đăng xuất
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-primary px-4 rounded-pill shadow-sm">
                                <i class="fas fa-sign-in-alt me-2"></i>Đăng nhập
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="content-wrapper">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    @* FOOTER CẢI THIỆN *@
    <footer>
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="fw-bold text-primary mb-3">
                        <i class="fas fa-file-invoice me-2"></i>CVBuilder Pro
                    </h5>
                    <p class="text-muted" style="text-align: justify;">
                        Nền tảng tiên phong tích hợp trí tuệ nhân tạo (AI) giúp tối ưu hóa CV và kết nối nhân tài với các doanh nghiệp hàng đầu trong ngành Công nghệ thông tin.
                    </p>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h6 class="fw-bold mb-3">Dịch vụ</h6>
                    <ul class="list-unstyled">
                        <li><a asp-controller="Resume" asp-action="Templates" class="footer-link">Kho mẫu CV</a></li>
                        <li><a asp-controller="Home" asp-action="Jobs" class="footer-link">Tìm việc làm</a></li>
                        <li><a href="#" class="footer-link">Tư vấn nghề nghiệp</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h6 class="fw-bold mb-3">Hỗ trợ</h6>
                    <ul class="list-unstyled">
                        <li><a asp-controller="Support" asp-action="Guide" class="footer-link">Hướng dẫn</a></li>
                        <li><a asp-controller="Support" asp-action="Contact" class="footer-link">Liên hệ</a></li>
                        <li><a href="#" class="footer-link">Điều khoản sử dụng</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-6 text-lg-end">
                    <h6 class="fw-bold mb-3">Theo dõi chúng tôi</h6>
                    <div class="d-flex gap-3 justify-content-lg-end fs-4 mb-4">
                        <a href="#" class="text-primary"><i class="fab fa-facebook"></i></a>
                        <a href="#" class="text-info"><i class="fab fa-linkedin"></i></a>
                        <a href="#" class="text-dark"><i class="fab fa-github"></i></a>
                        <a href="#" class="text-danger"><i class="fab fa-youtube"></i></a>
                    </div>
                    <p class="small text-muted mb-0">Hỗ trợ 24/7 qua hệ thống Ticket</p>
                </div>
            </div>
            <hr class="my-4 text-muted opacity-25">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start text-muted small">
                    &copy; @DateTime.Now.Year - CVBuilder Pro. All rights reserved.
                </div>
                <div class="col-md-6 text-center text-md-end text-muted small">
                    Phát triển bởi <strong>Nguyễn Võ Lê Khoa</strong> và Đội ngũ cộng tác
                </div>
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>