<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AI CV Builder</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DoAnLTWeb.styles.css" asp-append-version="true" />
</head>

<body>

    <div class="container-fluid">
        <div class="row">

            <!-- SIDEBAR -->
            <div class="col-2 bg-dark text-white vh-100">

                <h4 class="p-3">AI CV Builder</h4>

                <a class="d-block text-white p-2" asp-controller="Home" asp-action="Dashboard">Trang tổng quan</a>

                <a class="d-block text-white p-2" asp-controller="Profile" asp-action="Index">Thông tin cá nhân</a>

                <a class="d-block text-white p-2" asp-controller="Resume" asp-action="Index">CV của tôi</a>

                <a class="d-block text-white p-2" asp-controller="Experience" asp-action="Index">Kinh nghiệm làm việc</a>

                <a class="d-block text-white p-2" asp-controller="Education" asp-action="Index">Học vấn</a>

                <a class="d-block text-white p-2" asp-controller="Skills" asp-action="Index">Kỹ năng</a>

                <a class="d-block text-white p-2" asp-controller="Projects" asp-action="Index">Dự án</a>

                <a class="d-block text-white p-2" asp-controller="Templates" asp-action="Index">Mẫu CV</a>

                <a class="d-block text-white p-2" asp-controller="AI" asp-action="Index">Gợi ý AI</a>

                </div>

                <!-- CONTENT -->
                <div class="col-10 p-4">

                    @RenderBody()

                </div>

            </div>
        </div>

        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

        @RenderSection("Scripts", required: false)

    </body>

</html>