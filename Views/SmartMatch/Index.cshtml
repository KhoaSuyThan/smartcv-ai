@{
    ViewData["Title"] = "Smart CV Matcher - AI";
    var jobs = ViewBag.Jobs as List<DoAnCS.Models.Job> ?? new List<DoAnCS.Models.Job>();
}

<style>
    :root {
        --sm-primary: #6366f1;
        --sm-primary-light: #818cf8;
        --sm-primary-dark: #4f46e5;
        --sm-accent: #f43f5e;
        --sm-success: #10b981;
        --sm-warning: #f59e0b;
        --sm-bg: #f8fafc;
        --sm-card: #ffffff;
        --sm-text: #0f172a;
        --sm-muted: #64748b;
        --sm-border: #e2e8f0;
    }
    .sm-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #312e81 100%);
        border-radius: 2rem;
        padding: 4rem 2rem;
        position: relative;
        overflow: hidden;
        margin-top: 1.5rem;
    }
    .sm-hero::before {
        content: '';
        position: absolute;
        top: -50%; right: -50%;
        width: 100%; height: 200%;
        background: radial-gradient(circle, rgba(99,102,241,0.15) 0%, transparent 60%);
        animation: sm-float 15s ease-in-out infinite;
    }
    @@keyframes sm-float {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        50% { transform: translateY(-20px) rotate(5deg); }
    }
    .sm-hero-title {
        font-size: 3rem; font-weight: 800; letter-spacing: -0.02em;
        background: linear-gradient(to right, #fff 30%, rgba(255,255,255,0.7));
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }
    .sm-hero-badge {
        display: inline-flex; align-items: center; gap: 0.5rem;
        background: rgba(99,102,241,0.2); border: 1px solid rgba(99,102,241,0.3);
        color: #c7d2fe; padding: 0.4rem 1rem; border-radius: 2rem;
        font-size: 0.8rem; font-weight: 600; margin-bottom: 1rem;
    }
    .sm-control-panel {
        background: var(--sm-card); border-radius: 1.5rem;
        border: 1px solid var(--sm-border); padding: 2rem;
        box-shadow: 0 10px 40px -10px rgba(0,0,0,0.08);
        margin-top: -3rem; position: relative; z-index: 10;
    }
    .sm-select-wrapper {
        position: relative; background: #f8fafc;
        border-radius: 1rem; border: 2px solid var(--sm-border);
        transition: all 0.3s;
    }
    .sm-select-wrapper:focus-within {
        border-color: var(--sm-primary);
        box-shadow: 0 0 0 4px rgba(99,102,241,0.1);
    }
    .sm-select-wrapper select {
        border: none; background: transparent;
        padding: 1rem 1.25rem; font-weight: 600;
        color: var(--sm-text); width: 100%; font-size: 1rem;
        appearance: none; cursor: pointer;
    }
    .sm-select-wrapper select:focus { outline: none; box-shadow: none; }
    .sm-select-wrapper::after {
        content: '\f078'; font-family: 'Font Awesome 6 Free';
        font-weight: 900; position: absolute; right: 1.25rem; top: 50%;
        transform: translateY(-50%); color: var(--sm-muted); pointer-events: none;
    }
    .sm-btn-analyze {
        background: linear-gradient(135deg, var(--sm-primary), var(--sm-primary-dark));
        color: white; border: none; padding: 1rem 2rem;
        border-radius: 1rem; font-weight: 700; font-size: 1rem;
        transition: all 0.3s; display: flex; align-items: center;
        justify-content: center; gap: 0.75rem; min-width: 220px;
    }
    .sm-btn-analyze:hover:not(:disabled) {
        transform: translateY(-3px);
        box-shadow: 0 12px 30px -8px rgba(99,102,241,0.5);
        color: white;
    }
    .sm-btn-analyze:disabled { opacity: 0.6; cursor: not-allowed; }
    .sm-stats-row { display: flex; gap: 1rem; flex-wrap: wrap; }
    .sm-stat-card {
        flex: 1; min-width: 140px;
        background: linear-gradient(135deg, #f8fafc, #fff);
        border: 1px solid var(--sm-border); border-radius: 1rem;
        padding: 1.25rem; text-align: center;
        transition: all 0.3s;
    }
    .sm-stat-card:hover { transform: translateY(-4px); box-shadow: 0 8px 25px -8px rgba(0,0,0,0.1); }
    .sm-stat-value { font-size: 2rem; font-weight: 800; color: var(--sm-primary); }
    .sm-stat-label { font-size: 0.8rem; color: var(--sm-muted); font-weight: 600; margin-top: 0.25rem; }
    .sm-results-container { margin-top: 2rem; }
    .sm-candidate-row {
        background: var(--sm-card); border: 1px solid var(--sm-border);
        border-radius: 1.25rem; padding: 1.5rem;
        margin-bottom: 1rem; transition: all 0.3s;
        display: flex; align-items: center; gap: 1.5rem;
    }
    .sm-candidate-row:hover {
        transform: translateX(6px);
        box-shadow: 0 8px 25px -8px rgba(0,0,0,0.1);
        border-color: var(--sm-primary-light);
    }
    .sm-rank-badge {
        width: 50px; height: 50px; border-radius: 1rem;
        display: flex; align-items: center; justify-content: center;
        font-weight: 900; font-size: 1.25rem; flex-shrink: 0;
    }
    .sm-rank-1 { background: linear-gradient(135deg, #fbbf24, #f59e0b); color: #78350f; box-shadow: 0 4px 15px rgba(245,158,11,0.3); }
    .sm-rank-2 { background: linear-gradient(135deg, #d1d5db, #9ca3af); color: #374151; }
    .sm-rank-3 { background: linear-gradient(135deg, #f97316, #ea580c); color: #fff; }
    .sm-rank-other { background: #f1f5f9; color: var(--sm-muted); }
    .sm-avatar-sm {
        width: 52px; height: 52px; border-radius: 0.85rem;
        object-fit: cover; border: 2px solid #e2e8f0; flex-shrink: 0;
    }
    .sm-candidate-info { flex: 1; min-width: 0; }
    .sm-candidate-name { font-weight: 700; font-size: 1.05rem; color: var(--sm-text); }
    .sm-candidate-role { font-size: 0.85rem; color: var(--sm-primary); font-weight: 600; }
    .sm-score-ring {
        width: 65px; height: 65px; position: relative; flex-shrink: 0;
    }
    .sm-score-ring svg { transform: rotate(-90deg); }
    .sm-score-ring .score-text {
        position: absolute; top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        font-weight: 900; font-size: 0.95rem; color: var(--sm-text);
    }
    .sm-skill-tag {
        display: inline-block; padding: 0.3rem 0.7rem;
        border-radius: 2rem; font-size: 0.72rem; font-weight: 600;
        margin: 0.15rem;
    }
    .sm-skill-match { background: #dcfce7; color: #166534; }
    .sm-skill-miss { background: #fee2e2; color: #991b1b; }
    .sm-rec-badge {
        padding: 0.35rem 0.85rem; border-radius: 2rem;
        font-size: 0.75rem; font-weight: 700;
    }
    .sm-rec-strong { background: #dcfce7; color: #166534; }
    .sm-rec-good { background: #dbeafe; color: #1e40af; }
    .sm-rec-partial { background: #fef3c7; color: #92400e; }
    .sm-rec-weak { background: #fee2e2; color: #991b1b; }
    .sm-detail-panel {
        background: #f8fafc; border-radius: 1rem;
        padding: 1.25rem; margin-top: 1rem;
        border: 1px solid #e2e8f0;
        display: none;
    }
    .sm-detail-panel.show { display: block; animation: smSlideDown 0.3s ease; }
    @@keyframes smSlideDown {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .sm-progress-bar {
        height: 8px; border-radius: 4px; background: #e2e8f0;
        overflow: hidden; margin-top: 0.5rem;
    }
    .sm-progress-fill {
        height: 100%; border-radius: 4px;
        transition: width 1s cubic-bezier(0.4,0,0.2,1);
    }
    .sm-loading-overlay {
        display: none; position: fixed; top: 0; left: 0;
        width: 100%; height: 100%; background: rgba(15,23,42,0.7);
        z-index: 9999; align-items: center; justify-content: center;
        backdrop-filter: blur(4px);
    }
    .sm-loading-overlay.show { display: flex; }
    .sm-loading-card {
        background: white; border-radius: 1.5rem;
        padding: 3rem; text-align: center;
        box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        max-width: 400px; width: 90%;
    }
    .sm-pulse-icon {
        width: 80px; height: 80px; border-radius: 50%;
        background: linear-gradient(135deg, var(--sm-primary), var(--sm-primary-dark));
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 1.5rem; animation: smPulse 2s infinite;
        color: white; font-size: 2rem;
    }
    @@keyframes smPulse {
        0%, 100% { box-shadow: 0 0 0 0 rgba(99,102,241,0.4); }
        50% { box-shadow: 0 0 0 20px rgba(99,102,241,0); }
    }
    .sm-empty-state {
        text-align: center; padding: 4rem 2rem;
        background: var(--sm-card); border-radius: 1.5rem;
        border: 2px dashed var(--sm-border);
    }
    .sm-empty-icon {
        width: 100px; height: 100px; border-radius: 50%;
        background: #f1f5f9; display: flex; align-items: center;
        justify-content: center; margin: 0 auto 1.5rem;
        font-size: 2.5rem; color: #94a3b8;
    }
</style>

<div class="container-fluid px-xl-5 pb-5">
    <!-- Hero -->
    <div class="sm-hero">
        <div class="text-center position-relative" style="z-index:1">
            <div class="sm-hero-badge"><i class="fas fa-brain"></i> Powered by Gemini AI</div>
            <h1 class="sm-hero-title mb-3">Smart CV <span style="background:linear-gradient(to right,var(--sm-primary-light),#06b6d4);-webkit-background-clip:text;-webkit-text-fill-color:transparent">Matcher</span></h1>
            <p class="text-white-50 fs-5 mb-0 mx-auto" style="max-width:650px">
                AI tự động phân tích và xếp hạng ứng viên phù hợp nhất với từng vị trí tuyển dụng. Nhanh chóng, chính xác, minh bạch.
            </p>
        </div>
    </div>

    <!-- Control Panel -->
    <div class="sm-control-panel mx-auto" style="max-width:900px">
        <div class="row g-3 align-items-end">
            <div class="col-md-8">
                <label class="fw-bold text-dark mb-2"><i class="fas fa-briefcase me-2 text-primary"></i>Chọn vị trí tuyển dụng</label>
                <div class="sm-select-wrapper">
                    <select id="jobSelect">
                        <option value="">-- Chọn tin tuyển dụng để phân tích --</option>
                        @foreach (var job in jobs)
                        {
                            <option value="@job.JobID">@job.Title — @(job.Company?.Name ?? "N/A")</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-md-4">
                <button class="sm-btn-analyze w-100" id="btnAnalyze" onclick="startAnalysis()" disabled>
                    <i class="fas fa-rocket"></i> Phân tích AI
                </button>
            </div>
        </div>
        <div class="text-muted small mt-2"><i class="fas fa-info-circle me-1"></i>AI sẽ so khớp tất cả CV công khai với mô tả công việc đã chọn</div>
    </div>

    <!-- Stats -->
    <div id="statsSection" class="mx-auto mt-4" style="max-width:900px;display:none">
        <div class="sm-stats-row">
            <div class="sm-stat-card">
                <div class="sm-stat-value" id="statTotal">0</div>
                <div class="sm-stat-label">Ứng viên phân tích</div>
            </div>
            <div class="sm-stat-card">
                <div class="sm-stat-value" id="statAvg">0</div>
                <div class="sm-stat-label">Điểm trung bình</div>
            </div>
            <div class="sm-stat-card">
                <div class="sm-stat-value text-success" id="statStrong">0</div>
                <div class="sm-stat-label">Rất phù hợp</div>
            </div>
            <div class="sm-stat-card">
                <div class="sm-stat-value text-warning" id="statPartial">0</div>
                <div class="sm-stat-label">Phù hợp một phần</div>
            </div>
        </div>
    </div>

    <!-- Results -->
    <div id="resultsSection" class="sm-results-container mx-auto" style="max-width:900px"></div>
</div>

<!-- Loading Overlay -->
<div class="sm-loading-overlay" id="loadingOverlay">
    <div class="sm-loading-card">
        <div class="sm-pulse-icon"><i class="fas fa-brain"></i></div>
        <h4 class="fw-bold text-dark mb-2">AI đang phân tích...</h4>
        <p class="text-muted mb-3">Đang so khớp CV ứng viên với Job Description</p>
        <div class="sm-progress-bar"><div class="sm-progress-fill bg-primary" id="loadingProgress" style="width:0%"></div></div>
        <p class="text-muted small mt-2" id="loadingText">Vui lòng chờ trong giây lát...</p>
    </div>
</div>

@section Scripts {
<script>
    const jobSelect = document.getElementById('jobSelect');
    const btnAnalyze = document.getElementById('btnAnalyze');

    jobSelect.addEventListener('change', function() {
        btnAnalyze.disabled = !this.value;
        if (this.value) loadExistingResults(this.value);
    });

    function startAnalysis() {
        const jobId = jobSelect.value;
        if (!jobId) return;
        btnAnalyze.disabled = true;
        showLoading(true);

        // Xóa kết quả cũ trên màn hình trước khi phân tích
        document.getElementById('resultsSection').innerHTML = '';
        document.getElementById('statsSection').style.display = 'none';

        // Timeout 3 phút
        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), 180000);

        fetch('/SmartMatch/AnalyzeJob', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
            body: 'jobId=' + jobId,
            signal: controller.signal
        })
        .then(r => r.json())
        .then(data => {
            clearTimeout(timeout);
            showLoading(false);
            btnAnalyze.disabled = false;
            // Luôn load kết quả từ DB bất kể thành công hay thất bại
            loadExistingResults(jobId);
            if (!data.success) alert(data.message || 'Có lỗi xảy ra');
        })
        .catch(err => {
            clearTimeout(timeout);
            showLoading(false);
            btnAnalyze.disabled = false;
            // Dù timeout, server vẫn có thể đã lưu được 1 phần kết quả → load lên
            loadExistingResults(jobId);
            if (err.name === 'AbortError') {
                alert('Phân tích mất hơn 3 phút. Kết quả đã lưu được sẽ hiển thị bên dưới.');
            }
        });
    }

    function loadExistingResults(jobId) {
        fetch('/SmartMatch/GetResults?jobId=' + jobId)
        .then(r => r.json())
        .then(data => {
            if (data.success) renderResults(data);
            else document.getElementById('resultsSection').innerHTML = renderEmpty(data.message);
        });
    }

    function showLoading(show) {
        const overlay = document.getElementById('loadingOverlay');
        const progress = document.getElementById('loadingProgress');
        const loadingText = document.getElementById('loadingText');
        if (show) {
            overlay.classList.add('show');
            let w = 0, seconds = 0;
            const interval = setInterval(() => {
                w += Math.random() * 5;
                if (w > 92) w = 92;
                progress.style.width = w + '%';
            }, 800);
            const timer = setInterval(() => {
                seconds++;
                loadingText.textContent = `Đang xử lý... ${seconds}s (tối đa 10 CV, mỗi CV ~10-15 giây)`;
            }, 1000);
            overlay._interval = interval;
            overlay._timer = timer;
        } else {
            if (overlay._interval) clearInterval(overlay._interval);
            if (overlay._timer) clearInterval(overlay._timer);
            progress.style.width = '100%';
            loadingText.textContent = 'Hoàn tất!';
            setTimeout(() => overlay.classList.remove('show'), 400);
        }
    }

    function renderResults(data) {
        // Stats
        document.getElementById('statsSection').style.display = 'block';
        document.getElementById('statTotal').textContent = data.totalCandidates;
        document.getElementById('statAvg').textContent = data.avgScore;
        const strong = data.candidates.filter(c => c.recommendation === 'strong_match' || c.recommendation === 'good_match').length;
        const partial = data.candidates.filter(c => c.recommendation === 'partial_match' || c.recommendation === 'weak_match').length;
        document.getElementById('statStrong').textContent = strong;
        document.getElementById('statPartial').textContent = partial;

        // Header
        let html = `<div class="d-flex justify-content-between align-items-center mb-3 mt-4">
            <div>
                <h4 class="fw-bold text-dark mb-1"><i class="fas fa-trophy text-warning me-2"></i>Bảng Xếp Hạng Ứng Viên</h4>
                <span class="text-muted small">${data.jobTitle} — ${data.companyName || ''}</span>
            </div>
        </div>`;

        data.candidates.forEach((c, i) => {
            const rankClass = i === 0 ? 'sm-rank-1' : i === 1 ? 'sm-rank-2' : i === 2 ? 'sm-rank-3' : 'sm-rank-other';
            const medal = i === 0 ? '🥇' : i === 1 ? '🥈' : i === 2 ? '🥉' : '#' + c.rank;
            const recClass = c.recommendation === 'strong_match' ? 'sm-rec-strong' : c.recommendation === 'good_match' ? 'sm-rec-good' : c.recommendation === 'partial_match' ? 'sm-rec-partial' : 'sm-rec-weak';
            const recText = c.recommendation === 'strong_match' ? 'Rất phù hợp' : c.recommendation === 'good_match' ? 'Phù hợp' : c.recommendation === 'partial_match' ? 'Phù hợp 1 phần' : 'Ít phù hợp';
            const scoreColor = c.matchScore >= 75 ? '#10b981' : c.matchScore >= 50 ? '#f59e0b' : '#ef4444';
            const avatarUrl = c.avatarUrl || `https://ui-avatars.com/api/?name=${encodeURIComponent(c.fullName)}&background=random`;
            const circumference = 2 * Math.PI * 24;
            const offset = circumference - (c.matchScore / 100) * circumference;

            html += `<div class="sm-candidate-row" id="row-${c.resumeId}">
                <div class="sm-rank-badge ${rankClass}">${medal}</div>
                <img src="${avatarUrl}" class="sm-avatar-sm" onerror="this.src='https://ui-avatars.com/api/?name=${encodeURIComponent(c.fullName)}&background=random'">
                <div class="sm-candidate-info">
                    <div class="sm-candidate-name">${c.fullName}</div>
                    <div class="sm-candidate-role"><i class="fas fa-briefcase me-1"></i>${c.jobTitle}</div>
                </div>
                <div class="sm-score-ring">
                    <svg width="65" height="65" viewBox="0 0 60 60">
                        <circle cx="30" cy="30" r="24" fill="none" stroke="#e2e8f0" stroke-width="5"/>
                        <circle cx="30" cy="30" r="24" fill="none" stroke="${scoreColor}" stroke-width="5" stroke-dasharray="${circumference}" stroke-dashoffset="${offset}" stroke-linecap="round"/>
                    </svg>
                    <div class="score-text">${c.matchScore}</div>
                </div>
                <span class="sm-rec-badge ${recClass}">${recText}</span>
                <button class="btn btn-sm btn-outline-primary rounded-pill ms-2" onclick="toggleDetail(${c.resumeId})">
                    <i class="fas fa-chevron-down"></i> Chi tiết
                </button>
            </div>
            <div class="sm-detail-panel" id="detail-${c.resumeId}">
                <div class="row g-3">
                    <div class="col-md-6">
                        <h6 class="fw-bold text-success mb-2"><i class="fas fa-check-circle me-1"></i>Kỹ năng phù hợp</h6>
                        <div>${c.matchedSkills.map(s => `<span class="sm-skill-tag sm-skill-match">${s}</span>`).join('')}</div>
                    </div>
                    <div class="col-md-6">
                        <h6 class="fw-bold text-danger mb-2"><i class="fas fa-times-circle me-1"></i>Kỹ năng còn thiếu</h6>
                        <div>${c.missingSkills.map(s => `<span class="sm-skill-tag sm-skill-miss">${s}</span>`).join('')}</div>
                    </div>
                    <div class="col-md-6">
                        <h6 class="fw-bold text-primary mb-2"><i class="fas fa-star me-1"></i>Điểm mạnh</h6>
                        <ul class="mb-0 small">${c.strengths.map(s => `<li>${s}</li>`).join('')}</ul>
                    </div>
                    <div class="col-md-6">
                        <h6 class="fw-bold text-warning mb-2"><i class="fas fa-lightbulb me-1"></i>Gợi ý cải thiện</h6>
                        <ul class="mb-0 small">${c.suggestions.map(s => `<li>${s}</li>`).join('')}</ul>
                    </div>
                    <div class="col-12">
                        <div class="p-3 bg-white rounded-3 border mt-2">
                            <h6 class="fw-bold mb-1"><i class="fas fa-comment-dots me-1 text-info"></i>Nhận xét AI</h6>
                            <p class="mb-0 text-muted small">${c.summary}</p>
                        </div>
                    </div>
                </div>
            </div>`;
        });

        document.getElementById('resultsSection').innerHTML = html;
    }

    function toggleDetail(resumeId) {
        const panel = document.getElementById('detail-' + resumeId);
        panel.classList.toggle('show');
        const btn = document.querySelector(`#row-${resumeId} button i`);
        if (btn) btn.classList.toggle('fa-chevron-up');
        if (btn) btn.classList.toggle('fa-chevron-down');
    }

    function renderEmpty(msg) {
        return `<div class="sm-empty-state mt-4">
            <div class="sm-empty-icon"><i class="fas fa-search"></i></div>
            <h5 class="fw-bold text-dark">${msg || 'Chưa có kết quả'}</h5>
            <p class="text-muted">Chọn một vị trí tuyển dụng và nhấn "Phân tích AI" để bắt đầu</p>
        </div>`;
    }
</script>
}
