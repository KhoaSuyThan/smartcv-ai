@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quên mật khẩu - CVBuilder Premium</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600&display=swap" rel="stylesheet">
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --glass-bg: rgba(255, 255, 255, 0.9);
            --text-main: #2d3436;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Outfit', sans-serif; }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #0f0c29;
            background: linear-gradient(to right, #24243e, #302b63, #0f0c29);
            overflow: hidden;
            position: relative;
        }

        /* Trang trí nền */
        body::before, body::after {
            content: '';
            position: absolute;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background: var(--primary-gradient);
            filter: blur(80px);
            z-index: -1;
            animation: float 10s infinite alternate;
        }
        body::before { top: -10%; left: -5%; }
        body::after { bottom: -10%; right: -5%; animation-delay: -5s; }

        @@keyframes float {
            from { transform: translate(0, 0); }
            to { transform: translate(50px, 50px); }
        }

        .card {
            background: var(--glass-bg);
            width: 100%;
            max-width: 420px;
            padding: 40px;
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.3);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.2);
            text-align: center;
            animation: slideUp 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
        }

        @@keyframes slideUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .logo-icon {
            width: 64px;
            height: 64px;
            background: var(--primary-gradient);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            box-shadow: 0 10px 20px rgba(118, 75, 162, 0.3);
        }
        .logo-icon i { font-size: 32px; color: #fff; }

        h1 { font-size: 28px; color: var(--text-main); font-weight: 600; margin-bottom: 12px; }
        p { color: #636e72; font-size: 15px; line-height: 1.6; margin-bottom: 30px; }

        .input-group { position: relative; margin-bottom: 24px; text-align: left; }
        .input-group label { display: block; font-size: 14px; font-weight: 600; color: #636e72; margin-bottom: 8px; margin-left: 4px; }
        .input-box { position: relative; }
        .input-box input {
            width: 100%;
            padding: 14px 20px 14px 48px;
            background: #f1f2f6;
            border: 2px solid transparent;
            border-radius: 12px;
            outline: none;
            font-size: 16px;
            transition: all 0.3s;
        }
        .input-box input:focus { border-color: #764ba2; background: #fff; box-shadow: 0 0 0 4px rgba(118, 75, 162, 0.1); }
        .input-box i { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); font-size: 20px; color: #b2bec3; transition: 0.3s; }
        .input-box input:focus + i { color: #764ba2; }

        .btn {
            width: 100%;
            padding: 14px;
            background: var(--primary-gradient);
            border: none;
            border-radius: 12px;
            color: #fff;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            box-shadow: 0 10px 20px rgba(118, 75, 162, 0.2);
            margin-bottom: 20px;
        }
        .btn:hover { transform: translateY(-2px); box-shadow: 0 15px 25px rgba(118, 75, 162, 0.3); }
        .btn:active { transform: translateY(0); }

        .back-to-login {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #764ba2;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            transition: 0.3s;
        }
        .back-to-login:hover { gap: 12px; color: #667eea; }

        .alert {
            padding: 12px;
            border-radius: 10px;
            font-size: 14px;
            margin-bottom: 20px;
            animation: fadeIn 0.5s;
        }
        .alert-error { background: #ffeaa7; color: #d63031; border: 1px solid #fab1a0; }
        @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    </style>
</head>
<body>
    <div class="card">
        <div class="logo-icon">
            <i class='bx bxs-lock-open'></i>
        </div>
        <h1>Quên mật khẩu?</h1>
        <p>Đừng lo lắng! Hãy nhập Email đã đăng ký, chúng tôi sẽ gửi mã xác thực OTP để giúp bạn đặt lại mật khẩu.</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-error">
                <i class='bx bx-error-circle'></i> @ViewBag.Error
            </div>
        }

        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()
            <div class="input-group">
                <label>Địa chỉ Email</label>
                <div class="input-box">
                    <input type="email" name="email" placeholder="example@gmail.com" required autofocus>
                    <i class='bx bx-envelope'></i>
                </div>
            </div>

            <button type="submit" class="btn">Gửi mã xác thực</button>
            
            <a href="/Account/Login" class="back-to-login">
                <i class='bx bx-arrow-back'></i> Quay lại đăng nhập
            </a>
        </form>
    </div>
</body>
</html>
