@{
    ViewData["Title"] = "Nâng cấp lên Pro";
    var pendingRequest = ViewBag.PendingRequest as DoAnCS.Models.UpgradeRequest;
}

<div class="upgrade-container pb-5">
    <!-- Header Section -->
    <div class="upgrade-header text-center py-5 mb-5">
        <div class="container">
            <h1 class="display-4 fw-bold text-white mb-3">Mở khóa sức mạnh của <span class="text-warning">Pro</span></h1>
            <p class="lead text-white-50 mx-auto" style="max-width: 700px;">
                Đưa sự nghiệp của bạn lên tầm cao mới với các công cụ hỗ trợ AI tiên tiến và các mẫu thiết kế CV đẳng cấp thế giới.
            </p>
        </div>
    </div>

    <div class="container">
        @if (pendingRequest != null)
        {
            <div class="row justify-content-center mb-5">
                <div class="col-lg-8">
                    <div class="alert alert-info border-0 shadow-sm rounded-4 p-4 d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="fas fa-clock fa-3x text-info me-4"></i>
                        </div>
                        <div>
                            <h4 class="alert-heading fw-bold">Yêu cầu đang được xét duyệt!</h4>
                            <p class="mb-0">Bạn đã gửi yêu cầu nâng cấp vào lúc <strong>@pendingRequest.RequestDate.ToString("HH:mm dd/MM/yyyy")</strong>. Admin đang kiểm tra minh chứng thanh toán của bạn. Vui lòng kiên nhẫn đợi trong giây lát.</p>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row justify-content-center g-4">
            <!-- Free Plan -->
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 border-0 shadow-sm plan-card">
                    <div class="card-body p-5">
                        <div class="mb-4">
                            <span class="badge bg-light text-muted px-3 py-2 rounded-pill fw-bold mb-3">MIỄN PHÍ</span>
                            <h2 class="card-title fw-bold">Cá nhân</h2>
                            <div class="d-flex align-items-baseline mb-3">
                                <span class="h1 fw-bold mb-0">0đ</span>
                                <span class="text-muted ms-2">/vĩnh viễn</span>
                            </div>
                            <p class="text-muted small">Cơ bản cho người mới bắt đầu tìm việc.</p>
                        </div>
                        
                        <ul class="list-unstyled mb-5">
                            <li class="mb-3 d-flex align-items-center">
                                <i class="fas fa-check-circle text-success me-2"></i>
                                <span>3 mẫu CV cơ bản</span>
                            </li>
                            <li class="mb-3 d-flex align-items-center">
                                <i class="fas fa-check-circle text-success me-2"></i>
                                <span>Tải xuống PDF (có logo)</span>
                            </li>
                            <li class="mb-3 d-flex align-items-center">
                                <i class="fas fa-check-circle text-success me-2"></i>
                                <span>Quản lý 1 CV</span>
                            </li>
                        </ul>

                        <div class="d-grid mt-auto">
                            <button class="btn btn-outline-secondary py-3 rounded-pill fw-bold" disabled>Đang sử dụng</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pro Plan -->
            <div class="col-lg-5 col-md-6">
                <div class="card h-100 border-0 shadow-lg plan-card pro-featured">
                    <div class="card-body p-5 position-relative overflow-hidden">
                        <div class="pro-ribbon">PHỔ BIẾN</div>
                        
                        <div class="mb-4">
                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-3">
                                <i class="fas fa-crown me-1"></i>PRO MEMBER
                            </span>
                            <h2 class="card-title fw-bold text-white">Chuyên nghiệp</h2>
                            <div class="d-flex align-items-baseline mb-3">
                                <span class="h1 fw-bold mb-0 text-white">99.000đ</span>
                                <span class="text-white-50 ms-2">/vĩnh viễn</span>
                            </div>
                            <p class="text-white-50 small">Tối ưu hóa mọi cơ hội nghề nghiệp của bạn.</p>
                        </div>
                        
                        <ul class="list-unstyled mb-4 text-white">
                            <li class="mb-2 d-flex align-items-center"><i class="fas fa-star text-warning me-2"></i><span>Truy cập 50+ mẫu CV Premium</span></li>
                            <li class="mb-2 d-flex align-items-center"><i class="fas fa-star text-warning me-2"></i><span>Tải PDF chất lượng cao (Không logo)</span></li>
                            <li class="mb-2 d-flex align-items-center"><i class="fas fa-star text-warning me-2"></i><span>AI tư vấn nội dung & kỹ năng</span></li>
                            <li class="mb-2 d-flex align-items-center"><i class="fas fa-star text-warning me-2"></i><span>Quản lý không giới hạn CV</span></li>
                        </ul>

                        <hr class="border-light opacity-25 mb-4">

                        @if (pendingRequest == null)
                        {
                            <form asp-action="UpgradeConfirmed" method="post" enctype="multipart/form-data">
                                @Html.AntiForgeryToken()
                                
                                <div class="mb-4">
                                    <label class="form-label text-white fw-bold mb-2">
                                        <i class="fas fa-camera me-1"></i> Ảnh minh chứng thanh toán
                                    </label>
                                    <input type="file" name="evidenceFile" class="form-control bg-white-10 border-0 text-white custom-file-input" required accept="image/*">
                                    <div class="form-text text-white-50 mt-1 small">Vui lòng tải lên ảnh chụp màn hình chuyển khoản qua QR/Số tài khoản.</div>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label text-white fw-bold mb-2">Ghi chú (nếu có)</label>
                                    <textarea name="notes" class="form-control bg-white-10 border-0 text-white" rows="2" placeholder="Ví dụ: Đã chuyển khoản từ ngân hàng MB..."></textarea>
                                </div>

                                <div class="d-grid mt-4">
                                    <button type="submit" class="btn btn-light text-primary py-3 rounded-pill fw-bold w-100 shadow-sm upgrade-submit-btn">
                                        Gửi yêu cầu xét duyệt
                                    </button>
                                </div>
                            </form>
                        }
                        else
                        {
                            <div class="text-center py-4 bg-white-10 rounded-4 border border-white-10">
                                <i class="fas fa-spinner fa-spin fa-2x text-warning mb-3"></i>
                                <h5 class="text-white fw-bold mb-1">Yêu cầu đang chờ duyệt</h5>
                                <p class="text-white-50 small px-4">Chúng tôi sẽ thông báo cho bạn ngay khi Admin phê duyệt.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
            
            <!-- QR Payment Section -->
            <div class="col-lg-3 col-md-12">
                <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4">
                    <h5 class="fw-bold mb-3">Quét mã thanh toán</h5>
                    <div class="qr-wrapper bg-white-10 rounded-4 mb-3 overflow-hidden p-2" style="background-color: rgba(13, 110, 253, 0.05); border: 1px solid rgba(13, 110, 253, 0.1);">
                        <img src="/images/QR/UpgradeCV.png" alt="QR Payment" class="img-fluid rounded-4 w-100 mb-2 shadow-sm">
                        <div class="pb-2">
                            <p class="mb-0 fw-bold text-primary">NGUYEN VO LE KHOA</p>
                            <p class="small text-muted mb-0">Ngân hàng: Vietcombank</p>
                        </div>
                    </div>
                    <p class="small text-muted mb-0">Nội dung: <span class="fw-bold text-danger">UPGRADEPRO [Email của bạn]</span></p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .upgrade-container { background-color: #f8f9fa; min-height: 100vh; }
        .upgrade-header { background: linear-gradient(135deg, #0d6efd 0%, #6610f2 100%); border-bottom-left-radius: 50% 20px; border-bottom-right-radius: 50% 20px; }
        .plan-card { transition: all 0.3s ease; border-radius: 24px; }
        .plan-card:hover { transform: translateY(-5px); box-shadow: 0 15px 35px rgba(0,0,0,0.1) !important; }
        .pro-featured { background: linear-gradient(135deg, #2a2a72 0%, #009ffd 100%); transform: scale(1.02); z-index: 2; border: 2px solid rgba(255,193,7,0.3) !important; }
        .pro-ribbon { position: absolute; top: 20px; right: -35px; background: #ffc107; color: #000; padding: 5px 40px; transform: rotate(45deg); font-size: 0.75rem; font-weight: 800; letter-spacing: 1px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
        
        .bg-white-10 { background-color: rgba(255,255,255,0.1) !important; }
        .border-white-10 { border-color: rgba(255,255,255,0.15) !important; }
        
        .custom-file-input::-webkit-file-upload-button { visibility: hidden; }
        .custom-file-input::before { content: 'Chọn ảnh minh chứng'; display: inline-block; background: white; border-radius: 30px; padding: 8px 20px; outline: none; white-space: nowrap; cursor: pointer; color: #0d6efd; font-weight: 700; font-size: 0.85rem; margin-right: 10px; }
        .custom-file-input:active::before { background: #f8f9fa; }
        
        textarea::placeholder { color: rgba(255,255,255,0.4) !important; }
        
        .upgrade-submit-btn { transition: 0.3s; }
        .upgrade-submit-btn:hover { background: #ffc107 !important; border-color: #ffc107 !important; color: #000 !important; transform: scale(1.02); }
    </style>
}
