@model IEnumerable<DoAnCS.Models.Application>
@{
    ViewData["Title"] = "Quản lý Ứng tuyển";
}

<div class="container py-5 mt-5">
    <div class="row mb-4 pt-3">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <h2 class="fw-bold text-primary mb-0"><i class="fas fa-briefcase me-2"></i>Công việc đã ứng tuyển</h2>
            <a href="/Home/Jobs" class="btn btn-outline-primary rounded-pill fw-bold">Tìm việc mới <i class="fas fa-search ms-1"></i></a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="px-4 py-3 text-muted fw-bold">Công việc</th>
                                <th class="py-3 text-muted fw-bold">CV đã nộp</th>
                                <th class="py-3 text-muted fw-bold">Ngày nộp</th>
                                <th class="py-3 text-muted fw-bold">Trạng thái</th>
                                <th class="px-4 py-3 text-muted fw-bold text-end">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var app in Model)
                            {
                                <tr>
                                    <td class="px-4 py-4">
                                        <div class="d-flex align-items-center">
                                            @if (app.Job?.Company?.LogoUrl != null)
                                            {
                                                <img src="@app.Job.Company.LogoUrl" class="rounded border me-3" style="width: 48px; height: 48px; object-fit: contain; padding: 4px;" alt="Logo" />
                                            }
                                            else
                                            {
                                                <div class="rounded border me-3 bg-light d-flex justify-content-center align-items-center" style="width: 48px; height: 48px;">
                                                    <i class="fas fa-building text-muted"></i>
                                                </div>
                                            }
                                            <div>
                                                <h6 class="mb-1 fw-bold text-dark">@(app.Job?.Title ?? "Việc làm không tồn tại")</h6>
                                                <span class="text-muted small">@(app.Job?.Company?.Name ?? "Công ty không rõ")</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-4">
                                        <span class="fw-medium text-primary"><i class="fas fa-file-alt me-2 text-muted"></i>@(app.Resume?.Title ?? "CV Mặc định")</span>
                                    </td>
                                    <td class="py-4 text-muted small">
                                        @app.AppliedAt.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td class="py-4">
                                        @if (app.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill"><i class="fas fa-clock me-1"></i>Chờ phản hồi</span>
                                        }
                                        else if (app.Status == "Reviewing")
                                        {
                                            <span class="badge bg-info px-3 py-2 rounded-pill"><i class="fas fa-eye me-1"></i>Đang xem xét</span>
                                        }
                                        else if (app.Status == "Interviewing")
                                        {
                                            <span class="badge bg-purple text-white px-3 py-2 rounded-pill cursor-pointer" onclick="openCandidateInterviewModal('@(app.InterviewSchedule?.InterviewTime.ToString("yyyy-MM-ddTHH:mm") ?? "")', '@(app.InterviewSchedule?.LocationType ?? "")', '@(app.InterviewSchedule?.Location ?? "")', '@(app.InterviewSchedule?.Notes ?? "")')" title="Nhấp để xem chi tiết lịch phỏng vấn"><i class="fas fa-calendar-alt me-1"></i>Lịch phỏng vấn</span>
                                        }
                                        else if (app.Status == "Offered")
                                        {
                                            <span class="badge bg-orange text-white px-3 py-2 rounded-pill cursor-pointer" style="background-color: #fd7e14 !important;" onclick="openCandidateOfferModal(@app.ApplicationID, '@(app.JobOffer?.Salary ?? "")', '@(app.JobOffer?.StartDate.ToString("yyyy-MM-dd") ?? "")', '@(app.JobOffer?.Notes ?? "")', '@(app.JobOffer?.Status ?? "")', '@(app.JobOffer?.WorkLocation ?? "")')" title="Nhấp để xem thư mời nhận việc & phản hồi"><i class="fas fa-envelope-open-text me-1"></i>Nhận được Offer</span>
                                        }
                                        else if (app.Status == "Accepted")
                                        {
                                            <span class="badge bg-success px-3 py-2 rounded-pill"><i class="fas fa-check-circle me-1"></i>Đồng ý nhận việc</span>
                                        }
                                        else if (app.Status == "Rejected" || app.Status == "Từ chối")
                                        {
                                            <span class="badge bg-danger px-3 py-2 rounded-pill"><i class="fas fa-times-circle me-1"></i>Bị từ chối</span>
                                        }
                                        else if (app.Status == "DeclinedOffer")
                                        {
                                            <span class="badge bg-dark text-white px-3 py-2 rounded-pill" title="Bạn đã từ chối thư mời nhận việc"><i class="fas fa-user-slash me-1"></i>Đã từ chối Offer</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-3 py-2 rounded-pill">@app.Status</span>
                                        }
                                    </td>
                                    <td class="px-4 py-4 text-end" style="white-space: nowrap;">
                                        <div class="d-flex justify-content-end align-items-center gap-2">
                                            <a href="/Home/Details/@app.JobID" class="btn btn-sm btn-light border rounded-pill fw-bold text-secondary hover-primary"><i class="fas fa-info-circle me-1"></i>Xem tin</a>
                                            
                                            @if (app.Status == "Pending" || app.Status == "Reviewing")
                                            {
                                                <button onclick="withdrawApplication(@app.ApplicationID)" class="btn btn-sm btn-outline-danger rounded-pill fw-bold"><i class="fas fa-ban me-1"></i>Hủy đơn</button>
                                            }
                                            
                                            @if (app.InterviewSchedule != null)
                                            {
                                                <button onclick="openCandidateInterviewModal('@(app.InterviewSchedule?.InterviewTime.ToString("yyyy-MM-ddTHH:mm") ?? "")', '@(app.InterviewSchedule?.LocationType ?? "")', '@(app.InterviewSchedule?.Location ?? "")', '@(app.InterviewSchedule?.Notes ?? "")')" class="btn btn-sm btn-outline-purple rounded-pill fw-bold" title="Xem chi tiết lịch phỏng vấn"><i class="fas fa-calendar-alt me-1"></i>Xem lịch PV</button>
                                            }

                                            @if (app.JobOffer != null)
                                            {
                                                <button onclick="openCandidateOfferModal(@app.ApplicationID, '@(app.JobOffer?.Salary ?? "")', '@(app.JobOffer?.StartDate.ToString("yyyy-MM-dd") ?? "")', '@(app.JobOffer?.Notes ?? "")', '@(app.JobOffer?.Status ?? "")', '@(app.JobOffer?.WorkLocation ?? "")')" class="btn btn-sm text-white rounded-pill fw-bold" style="background-color: #fd7e14; border-color: #fd7e14;" title="Xem chi tiết Offer"><i class="fas fa-file-signature me-1"></i>Xem Offer</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="mb-3">
                        <i class="fas fa-folder-open text-muted" style="font-size: 4rem; opacity: 0.3;"></i>
                    </div>
                    <h5 class="text-dark fw-bold mb-2">Bạn chưa ứng tuyển công việc nào</h5>
                    <p class="text-secondary mb-4">Khám phá hàng ngàn cơ hội việc làm hấp dẫn và gửi CV ngay hôm nay!</p>
                    <a href="/Home/Jobs" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm fw-bold">
                        Bắt đầu tìm việc <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- ================= MODAL CHI TIẾT LỊCH PHỎNG VẤN (ỨNG VIÊN) ================= -->
<div class="modal fade" id="candidateInterviewDetailModal" tabindex="-1" aria-labelledby="candidateInterviewDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header bg-purple text-white py-3 rounded-top-4" style="background-color: #6d28d9 !important;">
                <h5 class="modal-title fw-bold" id="candidateInterviewDetailModalLabel"><i class="fas fa-calendar-alt me-2"></i>Lịch hẹn phỏng vấn từ nhà tuyển dụng</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="d-flex flex-column gap-3">
                    <div class="p-3 bg-light rounded-3 border border-light-subtle">
                        <div class="mb-2 text-secondary small fw-bold">THỜI GIAN PHỎNG VẤN</div>
                        <div class="fs-5 fw-bold text-purple" id="candViewInterviewTime" style="color: #6d28d9;">--:-- - --/--/----</div>
                    </div>
                    <div class="p-3 bg-light rounded-3 border border-light-subtle">
                        <div class="mb-2 text-secondary small fw-bold">HÌNH THỨC</div>
                        <div class="fw-bold text-dark" id="candViewInterviewType">--</div>
                    </div>
                    <div class="p-3 bg-light rounded-3 border border-light-subtle">
                        <div class="mb-2 text-secondary small fw-bold">ĐỊA ĐIỂM / LINK PHÒNG HỌP</div>
                        <div class="text-break" id="candViewInterviewLocation">--</div>
                    </div>
                    <div class="p-3 bg-light rounded-3 border border-light-subtle">
                        <div class="mb-2 text-secondary small fw-bold">CHỈ DẪN TỪ NHÀ TUYỂN DỤNG</div>
                        <div class="text-muted small italic" id="candViewInterviewNotes" style="white-space: pre-wrap;">--</div>
                    </div>
                </div>
                <div class="text-end mt-4 pt-3 border-top">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MODAL CHI TIẾT OFFER & PHẢN HỒI (ỨNG VIÊN) ================= -->
<div class="modal fade" id="candidateOfferDetailModal" data-bs-backdrop="static" tabindex="-1" aria-labelledby="candidateOfferDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header text-white py-3 rounded-top-4" style="background: linear-gradient(135deg, #fd7e14 0%, #f76707 100%); border-bottom: 0;">
                <h5 class="modal-title fw-bold" id="candidateOfferDetailModalLabel"><i class="fas fa-file-signature me-2"></i>Thư mời nhận việc (Job Offer)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="d-flex flex-column gap-3">
                    <div class="p-3 bg-light rounded-3 border border-light-subtle">
                        <div class="mb-2 text-secondary small fw-bold">MỨC LƯƠNG ĐỀ XUẤT</div>
                        <div class="fs-5 fw-bold text-success" id="candViewOfferSalary">--</div>
                    </div>
                    <div class="p-3 bg-light rounded-3 border border-light-subtle">
                        <div class="mb-2 text-secondary small fw-bold">NGÀY BẮT ĐẦU LÀM VIỆC</div>
                        <div class="fw-bold text-dark" id="candViewOfferStartDate">--</div>
                    </div>
                    <div class="p-3 bg-light rounded-3 border border-light-subtle">
                        <div class="mb-2 text-secondary small fw-bold">ĐỊA ĐIỂM LÀM VIỆC</div>
                        <div class="fw-bold text-dark" id="candViewOfferWorkLocation">--</div>
                    </div>
                    <div class="p-3 bg-light rounded-3 border border-light-subtle">
                        <div class="mb-2 text-secondary small fw-bold">ĐIỀU KHOẢN & GHI CHÚ BỔ SUNG</div>
                        <div class="text-muted small" id="candViewOfferNotes" style="white-space: pre-wrap;">--</div>
                    </div>
                    <div id="offerFeedbackStatusArea" class="p-3 bg-light rounded-3 border border-light-subtle d-none justify-content-between align-items-center">
                        <div class="text-secondary small fw-bold">PHẢN HỒI CỦA BẠN</div>
                        <span class="badge px-3 py-2 rounded-pill fw-bold" id="candViewOfferStatus">--</span>
                    </div>
                </div>

                <!-- Vùng nút phản hồi Offer (chỉ hiện khi offer đang Pending) -->
                <div id="offerActionButtons" class="mt-4 pt-3 border-top d-flex gap-2">
                    <button type="button" id="btnDeclineOffer" class="btn btn-outline-danger rounded-pill w-50 py-2 fw-bold"><i class="fas fa-times me-1"></i>Từ chối Offer</button>
                    <button type="button" id="btnAcceptOffer" class="btn btn-success rounded-pill w-50 py-2 fw-bold"><i class="fas fa-check me-1"></i>Đồng ý nhận việc</button>
                </div>
                
                <div id="offerCloseButtonOnly" class="mt-4 pt-3 border-top text-end d-none">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function openCandidateInterviewModal(time, type, location, notes) {
        let formattedTime = time;
        if (time) {
            const dateObj = new Date(time);
            if (!isNaN(dateObj.getTime())) {
                formattedTime = dateObj.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) + ' - ' + dateObj.toLocaleDateString('vi-VN');
            }
        }
        $('#candViewInterviewTime').text(formattedTime || 'N/A');
        $('#candViewInterviewType').text(type === 'Online' ? 'Phỏng vấn trực tuyến (Online)' : 'Phỏng vấn trực tiếp (Offline)');
        $('#candViewInterviewLocation').html(type === 'Online' ? `<a href="${location}" target="_blank" class="text-primary text-decoration-underline">${location} <i class="fas fa-external-link-alt ms-1 small"></i></a>` : location);
        $('#candViewInterviewNotes').text(notes || 'Không có ghi chú từ nhà tuyển dụng.');

        var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('candidateInterviewDetailModal'));
        modal.show();
    }

    function openCandidateOfferModal(applicationId, salary, startDate, notes, status, workLocation) {
        let formattedDate = startDate;
        if (startDate) {
            const dateObj = new Date(startDate);
            if (!isNaN(dateObj.getTime())) {
                formattedDate = dateObj.toLocaleDateString('vi-VN');
            }
        }
        $('#candViewOfferSalary').text(salary || 'N/A');
        $('#candViewOfferStartDate').text(formattedDate || 'N/A');
        $('#candViewOfferWorkLocation').text(workLocation || 'Không chỉ định (Thỏa thuận)');
        $('#candViewOfferNotes').text(notes || 'Không có ghi chú/điều khoản bổ sung nào.');

        const actionArea = $('#offerActionButtons');
        const statusArea = $('#offerFeedbackStatusArea');
        const closeArea = $('#offerCloseButtonOnly');

        // Gán sự kiện click cho các nút
        $('#btnAcceptOffer').off('click').on('click', function() {
            respondToOffer(applicationId, 'Accepted');
        });
        $('#btnDeclineOffer').off('click').on('click', function() {
            respondToOffer(applicationId, 'Declined');
        });

        if (status === 'Pending') {
            actionArea.removeClass('d-none').addClass('d-flex');
            statusArea.addClass('d-none').removeClass('d-flex');
            closeArea.addClass('d-none');
        } else {
            actionArea.addClass('d-none').removeClass('d-flex');
            statusArea.removeClass('d-none').addClass('d-flex');
            closeArea.removeClass('d-none');

            const statusBadge = $('#candViewOfferStatus');
            statusBadge.removeClass('bg-success bg-danger text-white');
            if (status === 'Accepted') {
                statusBadge.addClass('bg-success text-white').text('Đồng ý nhận việc');
            } else {
                statusBadge.addClass('bg-danger text-white').text('Từ chối nhận việc');
            }
        }

        var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('candidateOfferDetailModal'));
        modal.show();
    }

    async function respondToOffer(applicationId, responseStatus) {
        const actionText = responseStatus === 'Accepted' ? 'ĐỒNG Ý NHẬN VIỆC' : 'TỪ CHỐI';
        if (!confirm(`Bạn có chắc chắn muốn ${actionText} cho thư mời nhận việc này?`)) {
            return;
        }

        // Disable nút để tránh spam
        $('#btnAcceptOffer, #btnDeclineOffer').prop('disabled', true);

        try {
            const response = await fetch('/Jobs/RespondToOffer', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `applicationId=${applicationId}&response=${responseStatus}`
            });

            const result = await response.json();
            if (result.success) {
                alert(result.message);
                window.location.reload();
            } else {
                alert(result.message || 'Có lỗi xảy ra.');
                $('#btnAcceptOffer, #btnDeclineOffer').prop('disabled', false);
            }
        } catch (error) {
            alert('Lỗi kết nối máy chủ.');
            $('#btnAcceptOffer, #btnDeclineOffer').prop('disabled', false);
        }
    }

    async function withdrawApplication(applicationId) {
        if (!confirm('Bạn có chắc chắn muốn hủy đơn ứng tuyển này? Hành động này không thể hoàn tác.')) {
            return;
        }

        try {
            const response = await fetch('/Jobs/WithdrawApplication', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `applicationId=${applicationId}`
            });

            const result = await response.json();

            if (result.success) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'success',
                        title: 'Đã hủy!',
                        text: result.message,
                        timer: 2000,
                        showConfirmButton: false
                    }).then(() => {
                        window.location.reload();
                    });
                } else {
                    alert(result.message);
                    window.location.reload();
                }
            } else {
                alert(result.message || 'Có lỗi xảy ra.');
            }
        } catch (error) {
            alert('Lỗi kết nối máy chủ.');
        }
    }
</script>

<style>
    .hover-primary:hover {
        background-color: #0d6efd !important;
        color: white !important;
        border-color: #0d6efd !important;
    }
</style>
