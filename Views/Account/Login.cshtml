    @model DoAnCS.Models.ViewModels.AuthVM
    @{
        Layout = null;
    }

    <html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login/Signup Form</title>
    <link rel="stylesheet" href="/css/SignUp_LogIn_Form.css" asp-append-version="true">
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
</head>
<body>
    @{
        bool showRegister = !ViewData.ModelState.IsValid && ViewData.ModelState.Keys.Any(k => k.StartsWith("Register.") && ViewData.ModelState[k].Errors.Count > 0);
    }
    <div class="container @(showRegister ? "active" : "")">
        <div class="form-box login">
            <div style="width: 100%;"> <form asp-controller="Account" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <h1>Đăng nhập</h1>
                    
                    @if (ViewBag.Error != null)
                    {
                        <div style="color: #d9534f; background: rgba(242, 222, 222, 0.8); border: 1px solid #ebccd1; padding: 10px; border-radius: 8px; margin-bottom: 15px; font-weight: 500; font-size: 14px; text-align: center;">
                            @ViewBag.Error
                        </div>
                    }

                    <div class="input-box">
                        <input asp-for="Login.Email" placeholder="Email">
                        <i class='bx bxs-user'></i>
                    </div>
                    <div class="input-box">
                        <input asp-for="Login.Password" type="password" placeholder="Password" id="loginPassword">
                        <i class='bx bx-show toggle-password' onclick="toggleLoginPassword()" id="loginEyeIcon"></i>
                    </div>
                    <div class="forgot-link">
                        <a href="#">Bạn quên mật khẩu?</a>
                    </div>
                    <button type="submit" class="btn">Đăng nhập</button>
                </form>

                <p style="margin-top: 15px;">Hoặc đăng nhập với mạng xã hội</p>
                
                <form asp-controller="Account" asp-action="ExternalLogin" method="post">
                    @Html.AntiForgeryToken()
                    <div class="social-icons">
                        <button type="submit" name="provider" value="Google"><i class='bx bxl-google'></i></button>
                        <button type="submit" name="provider" value="Facebook"><i class='bx bxl-facebook'></i></button>
                        <button type="submit" name="provider" value="GitHub"><i class='bx bxl-github'></i></button>
                        <button type="submit" name="provider" value="LinkedIn"><i class='bx bxl-linkedin'></i></button>
                    </div>
                </form>
            </div>
        </div>

        <div class="form-box register">
            <div style="width: 100%;">
                <form asp-controller="Account" asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <h1>Đăng ký</h1>
                    
                    @if (showRegister)
                    {
                        var registerErrors = ViewData.ModelState.Where(x => x.Key.StartsWith("Register.") && x.Value.Errors.Count > 0).SelectMany(x => x.Value.Errors).Select(x => x.ErrorMessage).ToList();
                        if (registerErrors.Any())
                        {
                            <div style="color: #d9534f; background: rgba(242, 222, 222, 0.8); border: 1px solid #ebccd1; padding: 10px; border-radius: 8px; margin-bottom: 15px; font-weight: 500; font-size: 14px; text-align: center;">
                                @Html.Raw(string.Join("<br />", registerErrors))
                            </div>
                        }
                    }

                    <div class="input-box">
                        <input asp-for="Register.FullName" placeholder="Full Name" required>
                        <i class='bx bxs-user'></i>
                    </div>
                    <div class="input-box">
                        <input asp-for="Register.Email" type="email" placeholder="Email" required>
                        <i class='bx bxs-envelope'></i>
                    </div>
                    <div class="input-box">
                        <input asp-for="Register.Password" type="password" placeholder="Password" id="registerPassword">
                        <i class='bx bx-show toggle-password' onclick="toggleRegisterPassword()" id="registerEyeIcon"></i>
                    </div>
                    <div class="input-box">
                        <input asp-for="Register.ConfirmPassword" type="password" placeholder="Confirm Password">
                        <i class='bx bxs-lock-alt'></i>
                    </div>
                    <div class="role-container">
                        <div class="input-box role-select-box">
                            <select asp-for="Register.Role" id="roleSelect" class="form-control-select" 
                                    onchange="toggleCompany(this.value)" required>
                                <option value="User">Ứng viên (Tìm việc & làm CV)</option>
                                <option value="Recruiter">Nhà tuyển dụng</option>
                            </select>
                            <i class='bx bxs-user'></i> 
                        </div>
                    </div>

                    <div class="role-container" id="companyBox" style="display: none !important;">
                        <div class="input-box">
                            <input asp-for="Register.CompanyName" type="text" placeholder="Nhập tên công ty của bạn">
                            <i class='bx bxs-business'></i>
                        </div>
                    </div>
                    <button type="submit" class="btn">Đăng ký</button>
                </form>

                <p style="margin-top: 15px;">Hoặc đăng ký với mạng xã hội</p>
                
                <form asp-controller="Account" asp-action="ExternalLogin" method="post">
                    @Html.AntiForgeryToken()
                    <div class="social-icons">
                        <button type="submit" name="provider" value="Google"><i class='bx bxl-google'></i></button>
                        <button type="submit" name="provider" value="Facebook"><i class='bx bxl-facebook'></i></button>
                        <button type="submit" name="provider" value="GitHub"><i class='bx bxl-github'></i></button>
                        <button type="submit" name="provider" value="LinkedIn"><i class='bx bxl-linkedin'></i></button>
                    </div>
                </form>
            </div>
        </div>

        <div class="toggle-box">
            <div class="toggle-panel toggle-left">
                <h1>Xin chào!</h1>
                <p>Bạn chưa có tài khoản?</p>
                <button class="btn register-btn">Hãy đăng ký</button>
            </div>
            <div class="toggle-panel toggle-right">
                <h1>Chào mừng!</h1>
                <p>Bạn đã có tài khoản?</p>
                <button class="btn login-btn">Đăng nhập ngay</button>
            </div>
        </div>
    </div> <script src="/js/script.js"></script>
</body>
</html>
<style>
    html {
        zoom: 80%; /* Ép toàn bộ trang về 80% */
        height: 100%;
    }
    .form-control-select {
    width: 100%;
    height: 100%;
    background: transparent;
    border: none;
    outline: none;
    font-size: 16px;
    color: #333;
    font-weight: 500;
    padding: 0 45px 0 20px; 
    appearance: none;
    cursor: pointer;
    }

    .input-box select + i {
        position: absolute;
        right: 20px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 20px; 
    }

    .role-container {
        margin: 20px 0;
        text-align: left;
        width: 100%;
    }

    .role-select-box {
        margin-bottom: 0 !important;
        background: #ebebeb;
        border-radius: 8px;
        height: 45px;
    }

    .form-control-select {
        background: transparent;
        border: none;
        outline: none;
        width: 100%;
        height: 100%;
        padding: 0 15px; 
        font-size: 15px;
        cursor: pointer;
    }

    /* Toggle password eye icon */
    .toggle-password {
        cursor: pointer;
        user-select: none;
        transition: color 0.2s ease;
    }
    .toggle-password:hover {
        color: #512da8;
    }
</style>
<script>
    function toggleCompany(role) {
        const box = document.getElementById('companyBox');
        if (role === 'Recruiter') {
            box.style.setProperty('display', 'block', 'important');
            console.log("Đã hiện ô công ty");
        } else {
            box.style.setProperty('display', 'none', 'important');
            console.log("Đã ẩn ô công ty");
        }
    }

    function toggleLoginPassword() {
        const input = document.getElementById('loginPassword');
        const icon = document.getElementById('loginEyeIcon');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('bx-show');
            icon.classList.add('bx-hide');
        } else {
            input.type = 'password';
            icon.classList.remove('bx-hide');
            icon.classList.add('bx-show');
        }
    }

    function toggleRegisterPassword() {
        const input = document.getElementById('registerPassword');
        const icon = document.getElementById('registerEyeIcon');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('bx-show');
            icon.classList.add('bx-hide');
        } else {
            input.type = 'password';
            icon.classList.remove('bx-hide');
            icon.classList.add('bx-show');
        }
    }
</script>