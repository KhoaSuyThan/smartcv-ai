@model DoAnCS.Models.User
@{
    var publicResumes = ViewBag.PublicResumes as List<DoAnCS.Models.Resume>;
}

<!-- Header với thông tin cơ bản -->
<div class="card glass-card border-0 shadow-sm mb-4 overflow-hidden" style="border-radius: 15px;">
    <div class="card-body p-0">
        <div class="row g-0">
            <div class="col-md-4 bg-primary bg-gradient d-flex flex-column align-items-center justify-content-center p-4 text-white text-center">
                <img src="@(string.IsNullOrEmpty(Model.AvatarUrl) ? "/images/default-avatar.png" : Model.AvatarUrl)" 
                     class="rounded-circle border border-3 border-white shadow mb-3" 
                     style="width: 110px; height: 110px; object-fit: cover;">
                <h5 class="fw-bold mb-1">@Model.FullName</h5>
                <span class="badge bg-white text-primary rounded-pill px-3 small">Ứng viên</span>
            </div>
            <div class="col-md-8 p-4">
                <h6 class="fw-bold mb-3 text-secondary text-uppercase small" style="letter-spacing: 1px;">Thông tin liên hệ</h6>
                <div class="row g-3">
                    <div class="col-12">
                        <div class="d-flex align-items-center">
                            <div class="icon-box bg-light text-primary rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 35px; height: 35px;">
                                <i class="bi bi-envelope"></i>
                            </div>
                            <div>
                                <div class="text-muted small">Email</div>
                                <div class="fw-medium">@Model.Email</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="d-flex align-items-center">
                            <div class="icon-box bg-light text-primary rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 35px; height: 35px;">
                                <i class="bi bi-telephone"></i>
                            </div>
                            <div>
                                <div class="text-muted small">Số điện thoại</div>
                                <div class="fw-medium">@(string.IsNullOrEmpty(Model.Phone) ? "Chưa cung cấp" : Model.Phone)</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Danh sách CV -->
<div class="px-2">
    <h6 class="fw-bold mb-3 text-dark d-flex align-items-center">
        <i class="bi bi-file-earmark-text text-primary me-2"></i> Danh sách CV công khai
    </h6>

    <div class="row g-3">
        @if (publicResumes == null || !publicResumes.Any())
        {
            <div class="col-12 text-center py-4">
                <p class="text-muted italic small">Chưa có hồ sơ nào được công khai.</p>
            </div>
        }
        else
        {
            @foreach (var resume in publicResumes)
            {
                <div class="col-12">
                    <div class="cv-card shadow-sm border border-light-subtle p-3 bg-white" style="border-radius: 12px;">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <h6 class="fw-bold text-dark mb-0 text-truncate" style="max-width: 70%;">@resume.Title</h6>
                            <div class="view-count-badge d-flex align-items-center bg-light-blue px-2 py-0 rounded">
                                <i class="bi bi-eye-fill text-primary" style="font-size: 0.75rem;"></i>
                                <span class="text-primary fw-bold ms-1" style="font-size: 0.7rem;">@resume.ViewCount</span>
                            </div>
                        </div>
                        <p class="text-secondary mb-3" style="font-size: 0.7rem;">Cập nhật: @resume.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                        
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="d-flex align-items-center">
                                <span class="fw-bold me-2" style="font-size: 0.75rem;">Công khai</span>
                                <div class="form-check form-switch p-0 m-0">
                                    <input class="form-check-input ms-0" type="checkbox" checked disabled style="cursor: default; width: 2.2em; height: 1.1em;">
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <a href="@Url.Action("Preview", "Resume", new { id = resume.ResumeID })" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold flex-grow-1">
                                <i class="bi bi-file-earmark-person me-1"></i> Xem CV
                            </a>
                            <button onclick="copyToClipboard('@(Context.Request.Scheme + "://" + Context.Request.Host + Url.Action("Preview", "Resume", new { id = resume.ResumeID }))')" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-bold">
                                <i class="bi bi-link-45deg"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold">
                                <i class="bi bi-heart"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    .bg-light-blue { background-color: #e7f1ff; }
    .cv-card { transition: all 0.2s; }
    .cv-card:hover { transform: scale(1.02); box-shadow: 0 5px 15px rgba(0,0,0,0.05) !important; }
    .glass-card { background: rgba(255, 255, 255, 0.9); }
</style>
