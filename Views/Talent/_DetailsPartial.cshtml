@model DoAnCS.Models.User
@{
    var publicResumes = ViewBag.PublicResumes as List<DoAnCS.Models.Resume>;
}

<div class="p-0 overflow-x-hidden">
    <!-- Cover & Avatar Header -->
    <div class="mb-4">
        <div style="height: 140px; background: linear-gradient(135deg, var(--primary), var(--secondary)); border-radius: 0 0 2rem 2rem; opacity: 0.8;"></div>
        <div class="text-center" style="margin-top: -70px; position: relative; z-index: 10;">
            <div class="position-relative d-inline-block">
                <img src="@(string.IsNullOrWhiteSpace(Model.AvatarUrl) ? $"https://ui-avatars.com/api/?name={Model.FullName}&background=random&size=256" : Model.AvatarUrl)" 
                     class="rounded-circle border border-4 border-white shadow-lg" 
                     style="width: 140px; height: 140px; object-fit: cover; background: white;"
                     onerror="this.src='https://ui-avatars.com/api/?name=@Model.FullName&background=random&size=256'">
                <span class="position-absolute bottom-0 end-0 bg-success border border-3 border-white rounded-circle" 
                      style="width: 24px; height: 24px; margin-bottom: 10px; margin-right: 10px;" 
                      title="Sẵn sàng làm việc"></span>
            </div>
            <h3 class="fw-bold mt-3 mb-1 text-dark">@Model.FullName</h3>
            @if (!string.IsNullOrEmpty(Model.ProfessionalTitle))
            {
                <h6 class="text-primary fw-bold mb-2">@Model.ProfessionalTitle</h6>
            }
            <div class="d-flex align-items-center justify-content-center gap-3 mt-2">
                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1">Ứng viên xác thực</span>
            </div>
        </div>
    </div>

    <div class="px-4 pb-4">
        <!-- Info Grid -->
        <div class="row g-3 mb-5">
            <div class="col-md-6">
                <div class="info-card p-3 rounded-4 border bg-white shadow-sm d-flex align-items-center gap-3">
                    <div class="icon-circle bg-success-subtle text-success">
                        <i class="bi bi-telephone"></i>
                    </div>
                    <div class="overflow-hidden">
                        <div class="text-muted small fw-medium">Số điện thoại</div>
                        <div class="fw-bold text-dark text-truncate">@(string.IsNullOrEmpty(Model.Phone) ? "Chưa cập nhật" : Model.Phone)</div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="info-card p-3 rounded-4 border bg-white shadow-sm d-flex align-items-center gap-3">
                    <div class="icon-circle bg-primary-subtle text-primary">
                        <i class="bi bi-geo-alt"></i>
                    </div>
                    <div class="overflow-hidden">
                        <div class="text-muted small fw-medium">Địa điểm làm việc</div>
                        <div class="fw-bold text-dark text-truncate">@(string.IsNullOrEmpty(Model.ExpectedLocation) ? "Việt Nam" : Model.ExpectedLocation)</div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="info-card p-3 rounded-4 border bg-white shadow-sm d-flex align-items-center gap-3">
                    <div class="icon-circle bg-warning-subtle text-warning">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                    <div class="overflow-hidden">
                        <div class="text-muted small fw-medium">Mức lương mong muốn</div>
                        <div class="fw-bold text-dark text-truncate">@(Model.ExpectedSalary.HasValue ? Model.ExpectedSalary.Value + " Triệu VNĐ" : "Thỏa thuận")</div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="info-card p-3 rounded-4 border bg-white shadow-sm d-flex align-items-center gap-3">
                    <div class="icon-circle bg-info-subtle text-info">
                        <i class="bi bi-briefcase"></i>
                    </div>
                    <div class="overflow-hidden">
                        <div class="text-muted small fw-medium">Năm kinh nghiệm</div>
                        <div class="fw-bold text-dark text-truncate">@(!string.IsNullOrEmpty(Model.YearsOfExperience) ? Model.YearsOfExperience + " năm" : "Chưa cập nhật")</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section: Skills -->
        @if (!string.IsNullOrEmpty(Model.Skills))
        {
            <div class="mb-5">
                <h6 class="section-title">
                    <i class="bi bi-lightning-charge me-2"></i> Kỹ năng chính
                </h6>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var skill in Model.Skills.Split(',', StringSplitOptions.RemoveEmptyEntries))
                    {
                        <span class="skill-tag">@skill.Trim()</span>
                    }
                </div>
            </div>
        }

        <!-- Section: Resumes -->
        <div>
            <h6 class="section-title">
                <i class="bi bi-file-earmark-person me-2"></i> Hồ sơ năng lực (CV)
            </h6>

            <div class="row g-3">
                @if (publicResumes == null || !publicResumes.Any())
                {
                    <div class="col-12 text-center py-5 bg-light rounded-4 border border-dashed">
                        <i class="bi bi-cloud-slash fs-1 text-muted opacity-25 mb-2"></i>
                        <p class="text-muted mb-0">Ứng viên chưa công khai hồ sơ nào.</p>
                    </div>
                }
                else
                {
                    @foreach (var resume in publicResumes)
                    {
                        bool isPdf = !string.IsNullOrEmpty(resume.FileUploadUrl);
                        bool isVue = !string.IsNullOrEmpty(resume.JsonContent);
                        
                        <div class="col-12">
                            <div class="cv-premium-card p-3 rounded-4 border bg-white d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 transition-all">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="cv-icon @(isPdf ? "bg-danger-subtle text-danger" : (isVue ? "bg-primary-subtle text-primary" : "bg-info-subtle text-info")) rounded-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                        @if (isPdf) { <i class="bi bi-file-pdf fs-3"></i> }
                                        else if (isVue) { <i class="bi bi-filetype-vue fs-3"></i> }
                                        else { <i class="bi bi-file-earmark-person fs-3"></i> }
                                    </div>
                                    <div class="overflow-hidden">
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <h6 class="fw-bold mb-0 text-dark text-truncate">@resume.Title</h6>
                                            @if (isVue) { <span class="badge bg-primary px-2" style="font-size: 0.6rem;">VUE</span> }
                                        </div>
                                        <div class="d-flex align-items-center gap-3 text-muted" style="font-size: 0.8rem;">
                                            <span><i class="bi bi-calendar3 me-1"></i> @resume.UpdatedAt.ToString("dd/MM/yyyy")</span>
                                            <span><i class="bi bi-eye me-1"></i> @resume.ViewCount lượt xem</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex gap-2">
                                    <a href="@Url.Action("Preview", "Resume", new { id = resume.ResumeID })" target="_blank" 
                                       class="btn btn-primary rounded-pill px-4 btn-sm fw-bold shadow-sm">
                                        <i class="bi bi-eye-fill"></i> Xem CV
                                    </a>
                                    <button onclick="copyToClipboard('@(Context.Request.Scheme + "://" + Context.Request.Host + Url.Action("Preview", "Resume", new { id = resume.ResumeID }))')" 
                                            class="btn btn-light rounded-circle border shadow-sm" style="width: 34px; height: 34px; display: flex; align-items: center; justify-content: center;" 
                                            title="Copy Link">
                                        <i class="bi bi-link-45deg"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<style>
    .section-title {
        font-weight: 800;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        color: var(--text-gray);
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
    }
    .info-card {
        transition: all 0.3s;
    }
    .info-card:hover {
        border-color: var(--primary-light);
        transform: translateY(-2px);
    }
    .icon-circle {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        flex-shrink: 0;
    }
    .skill-tag {
        background: white;
        color: var(--text-dark);
        border: 1px solid var(--border);
        padding: 0.5rem 1rem;
        border-radius: 2rem;
        font-size: 0.85rem;
        font-weight: 600;
        box-shadow: var(--shadow-sm);
        transition: all 0.2s;
    }
    .skill-tag:hover {
        background: var(--primary);
        color: white;
        border-color: var(--primary);
    }
    .cv-premium-card:hover {
        background: #f8fafc;
        border-color: var(--primary-light);
        box-shadow: var(--shadow-md);
    }
</style>

