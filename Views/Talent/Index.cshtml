@model IEnumerable<DoAnCS.Models.Resume>
@{
    ViewData["Title"] = "Tìm kiếm ứng viên tiềm năng";
}

<style>
    :root {
        --primary-color: #4f46e5;
        --primary-hover: #4338ca;
        --secondary-color: #0ea5e9;
        --dark-bg: #0f172a;
        --light-bg: #f8fafc;
        --card-bg: #ffffff;
        --text-main: #1e293b;
        --text-muted: #64748b;
        --border-color: #e2e8f0;
    }

    body {
        background-color: var(--light-bg);
    }

    .talent-hero {
        background: linear-gradient(135deg, var(--dark-bg) 0%, #1e1b4b 100%);
        border-radius: 1.5rem;
        padding: 5rem 2rem 7rem;
        position: relative;
        overflow: hidden;
        margin-top: 1rem;
    }

    .talent-hero::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: radial-gradient(circle at top right, rgba(79, 70, 229, 0.2), transparent 40%),
                    radial-gradient(circle at bottom left, rgba(14, 165, 233, 0.2), transparent 40%);
        z-index: 0;
    }

    .talent-hero-content {
        position: relative;
        z-index: 1;
    }

    .text-gradient-primary {
        background: linear-gradient(135deg, #818cf8 0%, #38bdf8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .search-container {
        margin-top: -4rem;
        position: relative;
        z-index: 10;
        max-width: 1000px;
        margin-left: auto;
        margin-right: auto;
    }

    .search-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        border-radius: 1.25rem;
        box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.05);
        padding: 1.5rem;
    }

    .search-input-group {
        background: white;
        border-radius: 1rem;
        border: 1px solid var(--border-color);
        transition: all 0.3s ease;
    }

    .search-input-group:focus-within {
        border-color: var(--primary-color);
        box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
    }

    .search-input-group input {
        border: none;
        background: transparent;
        box-shadow: none !important;
        font-size: 0.95rem;
    }

    .search-input-group .input-icon {
        color: var(--text-muted);
        padding-left: 1.25rem;
    }

    .btn-search-submit {
        background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
        border: none;
        color: white;
        font-weight: 600;
        border-radius: 1rem;
        padding: 0.75rem 2rem;
        transition: all 0.3s ease;
    }

    .btn-search-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px -10px var(--primary-color);
        color: white;
    }

    .candidate-card {
        background: var(--card-bg);
        border-radius: 1.25rem;
        border: 1px solid rgba(226, 232, 240, 0.8);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .candidate-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.08);
        border-color: rgba(79, 70, 229, 0.3);
    }

    .candidate-avatar-wrapper {
        position: relative;
        width: 70px;
        height: 70px;
        flex-shrink: 0;
    }

    .candidate-avatar {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 1rem;
        border: 2px solid white;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    }

    .candidate-status-dot {
        position: absolute;
        bottom: -2px;
        right: -2px;
        width: 16px;
        height: 16px;
        background: #22c55e;
        border: 3px solid white;
        border-radius: 50%;
    }

    .candidate-name {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--text-main);
        margin-bottom: 0.25rem;
    }

    .candidate-role {
        color: var(--primary-color);
        font-weight: 500;
        font-size: 0.9rem;
    }

    .candidate-summary {
        color: var(--text-muted);
        font-size: 0.875rem;
        line-height: 1.6;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 2.8rem;
    }

    .skill-badge {
        background: #f1f5f9;
        color: #475569;
        font-size: 0.75rem;
        font-weight: 500;
        padding: 0.4rem 0.8rem;
        border-radius: 2rem;
        border: 1px solid #e2e8f0;
        transition: all 0.2s ease;
    }
    
    .candidate-card:hover .skill-badge {
        background: rgba(79, 70, 229, 0.05);
        border-color: rgba(79, 70, 229, 0.2);
        color: var(--primary-color);
    }

    .btn-view-profile {
        background: transparent;
        color: var(--primary-color);
        border: 1px solid rgba(79, 70, 229, 0.3);
        border-radius: 0.75rem;
        font-weight: 600;
        padding: 0.6rem 1rem;
        transition: all 0.3s ease;
        width: 100%;
    }

    .btn-view-profile:hover {
        background: var(--primary-color);
        color: white;
        border-color: var(--primary-color);
    }

    .sidebar-card {
        background: white;
        border-radius: 1.25rem;
        border: none;
        box-shadow: 0 10px 30px -15px rgba(0, 0, 0, 0.05);
        position: sticky;
        top: 2rem;
    }

    .sidebar-header {
        background: linear-gradient(to right, #f8fafc, #ffffff);
        border-bottom: 1px solid var(--border-color);
        padding: 1.5rem;
        border-radius: 1.25rem 1.25rem 0 0;
    }

    .saved-candidate-item {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #f1f5f9;
        transition: all 0.2s;
        cursor: pointer;
    }

    .saved-candidate-item:last-child {
        border-bottom: none;
    }

    .saved-candidate-item:hover {
        background: #f8fafc;
        padding-left: 1.75rem;
    }

    .saved-candidate-avatar {
        width: 40px; height: 40px;
        border-radius: 0.75rem;
        object-fit: cover;
    }

    .empty-state {
        padding: 4rem 2rem;
        text-align: center;
        background: white;
        border-radius: 1.25rem;
        border: 1px dashed var(--border-color);
    }

    .empty-state-icon {
        width: 80px;
        height: 80px;
        background: #f1f5f9;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        color: var(--text-muted);
        margin: 0 auto 1.5rem;
    }
</style>

<div class="container-fluid px-xl-5 pb-5">
    <!-- Hero Section -->
    <div class="talent-hero">
        <div class="talent-hero-content text-center">
            <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill mb-4" style="background: rgba(255,255,255,0.1); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1);">
                <span class="badge bg-primary rounded-pill">Mới</span>
                <span class="text-white-50 small fw-medium">Hệ thống gợi ý ứng viên thông minh</span>
            </div>
            <h1 class="display-4 fw-black text-white mb-3" style="font-weight: 800; letter-spacing: -1px;">
                Tìm Kiếm <span class="text-gradient-primary">Nhân Tài</span> Xuất Chúng
            </h1>
            <p class="text-white-50 fs-5 mb-0 mx-auto" style="max-width: 600px;">
                Truy cập hàng ngàn hồ sơ chất lượng cao và kết nối trực tiếp với những ứng viên phù hợp nhất cho doanh nghiệp của bạn.
            </p>
        </div>
    </div>

    <!-- Search Section -->
    <div class="search-container mb-5">
        <div class="search-card">
            <form method="get" asp-action="Index" class="row g-3 align-items-center">
                <div class="col-md-5">
                    <div class="search-input-group d-flex align-items-center p-1">
                        <i class="bi bi-search input-icon"></i>
                        <input type="text" name="searchTerm" class="form-control py-2" 
                               placeholder="Từ khóa, kỹ năng (ví dụ: React, Java...)" value="@ViewBag.SearchTerm">
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="search-input-group d-flex align-items-center p-1">
                        <i class="bi bi-briefcase input-icon"></i>
                        <input type="text" name="jobTitle" class="form-control py-2" 
                               placeholder="Vị trí ứng tuyển (ví dụ: Frontend...)" value="@ViewBag.JobTitleFilter">
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn-search-submit w-100 h-100 py-2 d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-sliders"></i> Lọc
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-4 mt-2">
        <!-- Cột trái: Kết quả -->
        <div class="col-lg-8 col-xl-9">
            <div class="d-flex justify-content-between align-items-end mb-4">
                <div>
                    <h4 class="fw-bold text-dark mb-1">Kết quả tìm kiếm</h4>
                    <p class="text-muted small mb-0">Hiển thị @Model.Count() ứng viên phù hợp</p>
                </div>
                @if (!string.IsNullOrEmpty(ViewBag.SearchTerm) || !string.IsNullOrEmpty(ViewBag.JobTitleFilter))
                {
                    <a href="@Url.Action("Index", "Talent")" class="text-danger small text-decoration-none fw-medium">
                        <i class="bi bi-x-circle me-1"></i> Xóa bộ lọc
                    </a>
                }
            </div>

            <div class="row g-4">
                @if (!Model.Any())
                {
                    <div class="col-12">
                        <div class="empty-state">
                            <div class="empty-state-icon">
                                <i class="bi bi-search"></i>
                            </div>
                            <h4 class="fw-bold text-dark mb-2">Không tìm thấy ứng viên</h4>
                            <p class="text-muted mb-4">Chúng tôi không tìm thấy ứng viên nào khớp với tiêu chí của bạn. Hãy thử thay đổi từ khóa tìm kiếm.</p>
                            <a href="@Url.Action("Index", "Talent")" class="btn btn-outline-primary rounded-pill px-4">Xóa tất cả bộ lọc</a>
                        </div>
                    </div>
                }
                else
                {
                    @foreach (var resume in Model)
                    {
                        <div class="col-md-6 col-xl-4">
                            <div class="candidate-card">
                                <div class="card-body p-4 flex-grow-1">
                                    <div class="d-flex align-items-start gap-3 mb-3">
                                        <div class="candidate-avatar-wrapper">
                                            <img src="@(!string.IsNullOrEmpty(resume.AvatarUrl) ? resume.AvatarUrl : (!string.IsNullOrEmpty(resume.User?.AvatarUrl) ? resume.User.AvatarUrl : "/images/default-avatar.png"))" 
                                                 class="candidate-avatar" alt="@resume.FullName">
                                            <div class="candidate-status-dot"></div>
                                        </div>
                                        <div class="overflow-hidden">
                                            <h5 class="candidate-name text-truncate" title="@resume.FullName">@resume.FullName</h5>
                                            <div class="candidate-role text-truncate" title="@resume.JobTitle">
                                                <i class="bi bi-person-workspace me-1"></i> @(resume.JobTitle ?? "Chưa cập nhật")
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <p class="candidate-summary mb-4">
                                        @if (!string.IsNullOrEmpty(resume.User?.Summary))
                                        {
                                            @resume.User.Summary
                                        }
                                        else
                                        {
                                            @(string.IsNullOrEmpty(resume.Summary) ? "Ứng viên này chưa cập nhật tóm tắt bản thân." : resume.Summary)
                                        }
                                    </p>

                                    <div class="d-flex flex-wrap gap-2 mt-auto">
                                        @if (!string.IsNullOrEmpty(resume.User?.Skills))
                                        {
                                            var skills = resume.User.Skills.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim()).ToList();
                                            foreach (var skill in skills.Take(3))
                                            {
                                                <span class="skill-badge">@skill</span>
                                            }
                                            if (skills.Count > 3)
                                            {
                                                <span class="skill-badge bg-light">+@(skills.Count - 3)</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="skill-badge text-muted" style="border: 1px dashed #cbd5e1; background: transparent;">Chưa cập nhật kỹ năng</span>
                                        }
                                    </div>
                                </div>
                                <div class="card-footer bg-transparent border-0 p-4 pt-0 mt-auto">
                                    <button onclick="showTalentDetails(@resume.UserID)" class="btn-view-profile">
                                        Xem hồ sơ chi tiết
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Cột phải: Ứng viên đã lưu -->
        <div class="col-lg-4 col-xl-3">
            <div class="sidebar-card">
                <div class="sidebar-header d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-1 text-dark">Đã lưu</h5>
                        <p class="text-muted small mb-0">Danh sách theo dõi</p>
                    </div>
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 36px; height: 36px;">
                        @(ViewBag.SavedCandidates?.Count ?? 0)
                    </div>
                </div>
                <div class="p-0">
                    <div class="list-group list-group-flush scrollbar-thin" style="max-height: 600px; overflow-y: auto;">
                        @{
                            var savedCandidates = ViewBag.SavedCandidates as List<DoAnCS.Models.SavedCandidate>;
                        }
                        @if (savedCandidates == null || !savedCandidates.Any())
                        {
                            <div class="p-5 text-center text-muted">
                                <i class="bi bi-bookmark-heart fs-1 mb-3 text-black-50 d-block"></i>
                                <p class="small fw-medium">Chưa có ứng viên nào trong danh sách lưu.</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var saved in savedCandidates)
                            {
                                <div class="saved-candidate-item d-flex align-items-center gap-3" onclick="showTalentDetails(@saved.Resume.UserID)">
                                    <img src="@(!string.IsNullOrEmpty(saved.Resume.AvatarUrl) ? saved.Resume.AvatarUrl : (!string.IsNullOrEmpty(saved.Resume.User?.AvatarUrl) ? saved.Resume.User.AvatarUrl : "/images/default-avatar.png"))" 
                                         class="saved-candidate-avatar border shadow-sm">
                                    <div class="overflow-hidden flex-grow-1">
                                        <h6 class="fw-bold mb-0 text-dark text-truncate fs-6">@saved.Resume.FullName</h6>
                                        <p class="text-muted small mb-0 text-truncate">@(saved.Resume.JobTitle ?? "Ứng viên")</p>
                                    </div>
                                    <i class="bi bi-chevron-right text-muted small"></i>
                                </div>
                            }
                        }
                    </div>
                </div>
                @if (savedCandidates != null && savedCandidates.Any())
                {
                    <div class="p-3 border-top text-center bg-light" style="border-radius: 0 0 1.25rem 1.25rem;">
                        <span class="text-primary small fw-semibold">Click vào ứng viên để xem chi tiết</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal chi tiết ứng viên -->
<div class="modal fade" id="talentDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 1.5rem; overflow: hidden;">
            <div class="modal-header border-0 pb-0 pt-4 pe-4">
                <button type="button" class="btn-close bg-light rounded-circle p-2 shadow-sm" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0 overflow-x-hidden" id="talentDetailContent">
                <div class="text-center py-5 my-5">
                    <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <h5 class="text-dark fw-bold">Đang tải hồ sơ...</h5>
                    <p class="text-muted">Vui lòng đợi trong giây lát</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const talentModal = new bootstrap.Modal(document.getElementById('talentDetailModal'));

    function showTalentDetails(userId) {
        document.getElementById('talentDetailContent').innerHTML = `
            <div class="text-center py-5 my-5">
                <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <h5 class="text-dark fw-bold">Đang tải hồ sơ...</h5>
                <p class="text-muted">Vui lòng đợi trong giây lát</p>
            </div>`;
        talentModal.show();

        fetch(`/Talent/Details/${userId}`, {
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.text())
        .then(html => {
            document.getElementById('talentDetailContent').innerHTML = html;
        })
        .catch(err => {
            document.getElementById('talentDetailContent').innerHTML = `
                <div class="alert alert-danger m-4 border-0 shadow-sm rounded-4 text-center py-4">
                    <i class="bi bi-exclamation-triangle fs-1 d-block mb-2"></i>
                    Lỗi khi tải thông tin ứng viên. Vui lòng thử lại sau.
                </div>`;
            console.error(err);
        });
    }

    function copyToClipboard(text) {
        navigator.clipboard.writeText(text).then(function() {
            alert('Đã sao chép liên kết vào bộ nhớ tạm!');
        }, function(err) {
            console.error('Không thể sao chép: ', err);
        });
    }

    function toggleSaveCandidate(resumeId, btn) {
        fetch(`/Talent/ToggleSave?resumeId=${resumeId}`, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                const icon = btn.querySelector('i');
                const textSpan = btn.querySelector('span');
                if (data.saved) {
                    btn.classList.remove('btn-outline-primary', 'bg-white');
                    btn.classList.add('btn-primary', 'text-white');
                    icon.classList.remove('bi-bookmark');
                    icon.classList.add('bi-bookmark-fill');
                    if (textSpan) textSpan.innerText = "Đã lưu";
                    btn.title = "Bỏ lưu";
                } else {
                    btn.classList.remove('btn-primary', 'text-white');
                    btn.classList.add('btn-outline-primary', 'bg-white');
                    icon.classList.remove('bi-bookmark-fill');
                    icon.classList.add('bi-bookmark');
                    if (textSpan) textSpan.innerText = "Lưu ứng viên";
                    btn.title = "Lưu ứng viên";
                }
                location.reload();
            } else {
                alert(data.message);
            }
        })
        .catch(err => console.error(err));
    }
</script>
}
