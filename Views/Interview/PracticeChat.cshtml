<text>
🇬🇧 ENGLISH POLISHING (SENIOR LEVEL):
"@parsedEng.improved"
</text>
}
@if (parsedEng.phrases.Any()) {
<text>
⚡ POWER PHRASES (CỤM TỪ KỸ THUẬT ĐẮT GIÁ):
@foreach (var pItem in parsedEng.phrases) {
<text>- @pItem.phrase @(!string.IsNullOrEmpty(pItem.meaning) ? $"({pItem.meaning})" : "")
</text>
}
</text>
}
--------------------------------------------------
(Được đánh giá tự động bởi SmartCV Local AI - Qwen 2.5 3B)</textarea>
                                            </div>

                                            <!-- 2. 4 Thẻ Trụ Cột STAR Đầy Đủ (Giãn cách rõ ràng, không đè thanh tiến trình) -->
                                            <div>
                                                <h6 class="fw-bold text-dark mb-3" style="font-size: 0.92rem;"><i class="fas fa-chart-bar text-primary me-2"></i>4 Trụ cột STAR định lượng:</h6>
                                                <div class="row g-3">
                                                    <div class="col-6">
                                                        <div class="star-pillar-card pillar-s">
                                                            <div class="star-pillar-header">
                                                                <span class="fw-bold text-info small"><i class="fas fa-map-marker-alt me-1.5"></i>S - Bối cảnh</span>
                                                                <strong class="text-dark">@(m.StarSituationScore ?? 0)/20</strong>
                                                            </div>
                                                            <div class="progress star-pillar-progress">
                                                                <div class="progress-bar bg-info" style="width: @(((m.StarSituationScore ?? 0) / 20.0) * 100)%"></div>
                                                            </div>
                                                        </div>
