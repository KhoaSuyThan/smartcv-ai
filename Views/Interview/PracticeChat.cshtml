@model DoAnCS.Models.InterviewSession
@using System.Text.Json
@using System.Text.RegularExpressions
@functions {
    // Helper parse English feedback an toàn tuyệt đối, không làm crash HTML
    public static (string improved, List<(string phrase, string meaning)> phrases) ParseEnglishData(string? json)
    {
        var phrases = new List<(string, string)>();
        string improved = "";
        if (string.IsNullOrWhiteSpace(json)) return (improved, phrases);

        try
        {
            using var doc = JsonDocument.Parse(json);
            if (doc.RootElement.TryGetProperty("englishPolish", out var ep))
            {
                if (ep.TryGetProperty("improvedResponse", out var imp) && imp.ValueKind == JsonValueKind.String)
                {
                    improved = imp.GetString() ?? "";
                }
                if (ep.TryGetProperty("powerPhrases", out var pp) && pp.ValueKind == JsonValueKind.Array)
                {
                    foreach (var item in pp.EnumerateArray())
                    {
                        if (item.ValueKind == JsonValueKind.String)
                        {
                            string s = item.GetString() ?? "";
                            if (!string.IsNullOrWhiteSpace(s)) phrases.Add((s, ""));
                        }
                        else if (item.ValueKind == JsonValueKind.Object)
                        {
                            string p = item.TryGetProperty("phrase", out var pP) && pP.ValueKind == JsonValueKind.String ? pP.GetString() ?? "" : "";
                            string m = item.TryGetProperty("meaning", out var pM) && pM.ValueKind == JsonValueKind.String ? pM.GetString() ?? "" : "";
                            if (!string.IsNullOrWhiteSpace(p)) phrases.Add((p, m));
                        }
                    }
                }
            }
        }
        catch { }
        return (improved, phrases);
    }

    // Helper làm sạch câu hỏi phỏng vấn, loại bỏ tiền tố thô và chia đoạn văn chuẩn
    public static List<string> ParseCleanQuestionParagraphs(string? content)
    {
        var list = new List<string>();
        if (string.IsNullOrWhiteSpace(content)) return list;
        string text = content;
        text = Regex.Replace(text, @"(?i)\b(SITUATION|SITTING|TASK|ACTION|RESULT)\s*:\s*", "");
        // Chuẩn hóa ngắt dòng: gộp các enter liên tiếp
        text = Regex.Replace(text, @"(\r?\n\s*){2,}", "\n\n");
        var rawParagraphs = text.Split(new[] { "\n\n" }, StringSplitOptions.RemoveEmptyEntries);
        foreach (var p in rawParagraphs)
        {
            // Bỏ dấu xuống dòng đơn lẻ trong đoạn để chữ tự wrap mềm mại không bị cụt dòng
            string cleaned = Regex.Replace(p.Trim(), @"\r?\n", " ");
            if (!string.IsNullOrWhiteSpace(cleaned))
            {
                list.Add(cleaned);
            }
        }
        return list;
    }
}
@{
    ViewData["Title"] = "Hội thoại phỏng vấn AI";
    var interviewMsgs = Model.Messages.OrderBy(m => m.CreatedAt).ToList();
    int currentAnswerCount = interviewMsgs.Count(m => m.Role == "candidate");

    // Tính điểm trung bình các trụ cột STAR cho cột Đánh giá chung cuộc
    var candidateMsgs = interviewMsgs.Where(m => m.Role == "candidate").ToList();
    int? latestCandidateMsgId = candidateMsgs.LastOrDefault()?.MessageID;
    double avgS = candidateMsgs.Any() ? candidateMsgs.Average(m => m.StarSituationScore ?? 0) : 0;
    double avgT = candidateMsgs.Any() ? candidateMsgs.Average(m => m.StarTaskScore ?? 0) : 0;
    double avgA = candidateMsgs.Any() ? candidateMsgs.Average(m => m.StarActionScore ?? 0) : 0;
    double avgR = candidateMsgs.Any() ? candidateMsgs.Average(m => m.StarResultScore ?? 0) : 0;
}

<div class="container-fluid px-lg-4 py-2">
