                                            <span class="text-white-50 d-block text-end mt-1" style="font-size: 0.65rem;">@m.CreatedAt.ToString("HH:mm")</span>
                                        </div>
                                        <div class="bg-secondary text-white rounded-circle p-1 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 34px; height: 34px; font-size: 0.85rem; background-color: #64748b !important;">
                                            <i class="fas fa-user"></i>
                                        </div>
                                    </div>
                                </div>

                                <!-- 2. Bong bóng Phản hồi & Đánh giá của Tech Lead AI (Bên trái - Kết hợp Phương án 3 & 1) -->
                                @if (m.Score.HasValue)
                                {
                                    var parsedEng = ParseEnglishData(m.EnglishFeedback);

