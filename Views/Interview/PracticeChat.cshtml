                                                        <div class="star-pillar-card pillar-a">
                                                            <div class="star-pillar-header">
                                                                <span class="fw-bold text-success small"><i class="fas fa-bolt me-1.5"></i>A - Hành động</span>
                                                                <strong class="text-dark">@(m.StarActionScore ?? 0)/40</strong>
                                                            </div>
                                                            <div class="progress star-pillar-progress">
                                                                <div class="progress-bar bg-success" style="width: @(((m.StarActionScore ?? 0) / 40.0) * 100)%"></div>
                                                            </div>
