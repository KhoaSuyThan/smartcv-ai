                                    <i class="fas fa-file-alt me-1"></i>Hồ sơ: <strong>@Model.Resume?.Title</strong>
                                </span>
                            </div>
                            <div class="d-flex align-items-center gap-2 text-muted" style="font-size: 0.73rem;">
                                <span class="text-success d-inline-flex align-items-center gap-1">
                                    <span class="spinner-grow spinner-grow-sm" style="width: 6px; height: 6px;"></span>
                                    <span>Local AI (Qwen 2.5 3B)</span>
                                </span>
                                <span>&bull;</span>
                                <span>Chế độ: Phỏng vấn Tự luận STAR</span>
                            </div>
                        </div>
                    </div>
                    <div class="text-end flex-shrink-0 ms-2">
                        @if (Model.Status == 0)
                        {
                            <span class="badge bg-secondary px-3 py-2 rounded-pill fw-bold shadow-2xs">
                                Lượt trả lời: @currentAnswerCount / 3
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success px-3 py-2 rounded-pill fw-bold shadow-2xs">
                                <i class="fas fa-check-circle me-1"></i> Đã hoàn thành
                            </span>
                        }
                    </div>
                </div>

                <!-- Vùng nội dung tin nhắn (Scrollable) -->
                <div class="card-body p-4 scroll-chat w-100 chat-scroll-area" id="chatBody" style="flex: 1 1 auto; overflow-y: auto !important;">
                    <div class="d-flex flex-column gap-3 w-100" id="chatMessagesList">
                        <!-- Tin nhắn chào mừng mặc định -->
                        <div class="d-flex align-items-start gap-2 max-w-85">
                            <div class="bg-primary text-white rounded-circle p-1 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 34px; height: 34px; font-size: 0.85rem;">
                                <i class="fas fa-robot"></i>
                            </div>
                            <div class="p-3 rounded-4 bg-white shadow-sm border border-light" style="border-top-left-radius: 0 !important;">
                                <p class="mb-0 text-dark small">
                                    Chào bạn! Tôi là Tech Lead phỏng vấn AI. Tôi sẽ đặt các câu hỏi tình huống thực tế bám sát hồ sơ và yêu cầu kỹ năng của bạn theo phương pháp STAR. Hãy chia sẻ cụ thể giải pháp kỹ thuật và kết quả đo lường để được đánh giá chính xác nhất!
                                </p>
                            </div>
                        </div>

                        <!-- Danh sách hội thoại thực tế -->
                        @{
                            int interviewerCount = 0;
                        }
                        @foreach (var m in interviewMsgs)
                        {
                            if (m.Role == "interviewer")
                            {
                                interviewerCount++;
                                string rawContent = m.Content ?? "";
                                string skillBadgeHtml = "";
                                if (rawContent.StartsWith("[TARGET_SKILL:"))
                                {
                                    int closeIdx = rawContent.IndexOf(']');
                                    if (closeIdx > 0)
                                    {
                                        string tag = rawContent.Substring(1, closeIdx - 1);
                                        rawContent = rawContent.Substring(closeIdx + 1).TrimStart('\r', '\n', ' ');
                                        var parts = tag.Split('|');
                                        string skillName = parts[0].Replace("TARGET_SKILL:", "").Trim();
                                        string skillType = parts.Length > 1 ? parts[1].Replace("TYPE:", "").Trim() : "target";
