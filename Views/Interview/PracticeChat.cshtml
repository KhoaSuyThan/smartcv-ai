                                                    <div class="col-6">
                                                        <div class="star-pillar-card pillar-t">
                                                            <div class="star-pillar-header">
                                                                <span class="fw-bold text-primary small"><i class="fas fa-tasks me-1.5"></i>T - Nhiệm vụ</span>
                                                                <strong class="text-dark">@(m.StarTaskScore ?? 0)/20</strong>
                                                            </div>
                                                            <div class="progress star-pillar-progress">
                                                                <div class="progress-bar bg-primary" style="width: @(((m.StarTaskScore ?? 0) / 20.0) * 100)%"></div>
                                                            </div>
                                                        </div>
                                                    </div>
