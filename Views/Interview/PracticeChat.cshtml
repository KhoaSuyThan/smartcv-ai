                                        string typeLabel = skillType == "unverified" ? "Kiểm chứng kỹ năng" : (skillType == "missing" ? "Lỗ hổng kỹ năng" : (skillType == "drilldown" ? "Hỏi dồn đào sâu" : "Kỹ năng mục tiêu"));
                                        skillBadgeHtml = $"<span class=\"badge {badgeClass} px-3 py-1 rounded-pill\"><i class=\"fas fa-crosshairs me-1\"></i> {typeLabel}: <strong>{skillName}</strong></span>";
                                    }
                                }

