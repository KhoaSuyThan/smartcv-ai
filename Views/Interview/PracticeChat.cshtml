                        </a>

                        <div class="bg-primary text-white rounded-circle p-2 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 42px; height: 42px; font-size: 1.15rem;">
                            <i class="fas fa-robot animate-pulse"></i>
                        </div>
                        <div>
