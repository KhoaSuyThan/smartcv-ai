</style>

@section Scripts {
    <script>
        // Cờ khóa chống gửi đúp (Double Submission)
        var isSubmitting = false;

        // Hàm sao chép câu tiếng Anh vào clipboard
        function copyToClipboard(text) {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(function() {
                    alert("Đã sao chép câu tiếng Anh vào bộ nhớ tạm!");
                }).catch(function() {
                    prompt("Sao chép thủ công:", text);
                });
            } else {
                prompt("Sao chép thủ công:", text);
            }
        }

        // Hiệu ứng nhảy số điểm mượt mà (Animated Count-Up) trong 500ms
        function animateCountUp(element, target, duration) {
            if (!element) return;
            var num = parseInt(target, 10);
            if (isNaN(num)) return;
            if (num <= 0) {
                element.textContent = '0';
                return;
            }
            duration = duration || 500;
            var start = 0;
            var startTime = null;
            function step(timestamp) {
                if (!startTime) startTime = timestamp;
                var progress = Math.min((timestamp - startTime) / duration, 1);
                // Hiệu ứng giảm tốc easeOutQuad mượt mà
                var ease = 1 - (1 - progress) * (1 - progress);
                var current = Math.floor(ease * num);
                element.textContent = current;
                if (progress < 1) {
                    window.requestAnimationFrame(step);
                } else {
                    element.textContent = num;
                }
            }
            window.requestAnimationFrame(step);
        }

        // Kích hoạt nhảy số cho tất cả counter trong một container
        function triggerAnimatedCounters(container) {
            if (!container) return;
            var counters = container.querySelectorAll('.animated-score-counter');
            counters.forEach(function (el) {
                var target = el.getAttribute('data-target-score');
                if (target !== null && target !== '') {
                    animateCountUp(el, target, 500);
                }
            });
        }

        // Sao chép toàn bộ phân tích STAR & English vào clipboard phục vụ học tập
        function copyFullStarAnalysis(msgId, btn) {
            var rawArea = document.getElementById('starAnalysisRaw-' + msgId);
            if (!rawArea) return;
            var text = rawArea.value;

            function onCopySuccess() {
                if (btn) {
                    var originalHtml = btn.innerHTML;
                    btn.classList.remove('btn-outline-secondary');
                    btn.classList.add('btn-success', 'text-white');
                    btn.innerHTML = '<i class="fas fa-check me-1"></i><span>Đã sao chép phân tích!</span>';
                    setTimeout(function () {
                        btn.classList.remove('btn-success', 'text-white');
                        btn.classList.add('btn-outline-secondary');
                        btn.innerHTML = originalHtml;
                    }, 2000);
                } else {
                    alert('Đã sao chép toàn bộ phân tích STAR vào bộ nhớ tạm!');
                }
            }

            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(onCopySuccess).catch(function () {
                    prompt("Sao chép thủ công phân tích STAR:", text);
                });
            } else {
                prompt("Sao chép thủ công phân tích STAR:", text);
            }
        }

        // Sao chép toàn bộ báo cáo đánh giá chung cuộc vào clipboard
        function copyOverallReport(btn) {
            var rawArea = document.getElementById('overallReportRaw');
            if (!rawArea) return;
            var text = rawArea.value;

            function onCopySuccess() {
                if (btn) {
                    var originalHtml = btn.innerHTML;
                    btn.classList.remove('btn-outline-primary');
                    btn.classList.add('btn-success', 'text-white');
                    btn.innerHTML = '<i class="fas fa-check me-1"></i><span>Đã sao chép đánh giá!</span>';
                    setTimeout(function () {
                        btn.classList.remove('btn-success', 'text-white');
                        btn.classList.add('btn-outline-primary');
                        btn.innerHTML = originalHtml;
                    }, 2000);
                } else {
                    alert('Đã sao chép toàn bộ đánh giá tổng thể vào bộ nhớ tạm!');
                }
            }

            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(onCopySuccess).catch(function () {
                    prompt("Sao chép thủ công báo cáo đánh giá:", text);
                });
            } else {
                prompt("Sao chép thủ công báo cáo đánh giá:", text);
            }
        }

        // Chuyển đổi Markdown đơn giản sang HTML hiển thị đẹp
        function parseMarkdownToHtml(md) {
            if (!md) return '';
            var html = md
                .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                .replace(/^### (.*$)/gim, '<h5 class="fw-bold text-primary mt-2 mb-1 border-bottom pb-1"><i class="fas fa-check-circle text-success me-1"></i> $1</h5>')
                .replace(/^#### (.*$)/gim, '<h6 class="fw-bold text-dark mt-2 mb-1">$1</h6>')
                .replace(/\*\*(.*?)\*\*/gim, '<strong class="text-dark">$1</strong>')
                .replace(/^\s*-\s+(.*$)/gim, '<li class="text-secondary">$1</li>')
                .replace(/^\s*\d+\.\s+(.*$)/gim, '<li class="text-secondary">$1</li>')
                .replace(/\n\n+/gim, '<br/>')
                .replace(/\n/gim, '<br/>');
            return html;
        }

        // Hàm cuộn chatbox xuống sát đáy
        function scrollToBottom() {
            var chatBody = document.getElementById("chatBody");
            if (chatBody) {
                chatBody.scrollTop = chatBody.scrollHeight;
            }
        }

        // Gửi câu trả lời: Hiển thị câu trả lời & loading AI ngay lập tức
        function doSubmitChatMessage() {
            if (isSubmitting) return;

            var answerInput = document.getElementById('answerInput');
            if (!answerInput) return;

            var text = answerInput.value.trim();
            if (!text) return;

            isSubmitting = true;

            var btn = document.getElementById('sendBtn');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm text-white"></span>';
                btn.title = 'AI đang xử lý câu trả lời... Vui lòng đợi';
            }

            // Xóa sạch dữ liệu đã gửi khỏi ô nhập và cho phép nhập nội dung mới
            answerInput.value = '';
            answerInput.readOnly = false;
            answerInput.placeholder = 'Đang đợi AI phản hồi... Bạn có thể soạn trước câu trả lời tiếp theo tại đây (Không cho gửi trước khi AI hoàn tất)';

            var messagesList = document.getElementById('chatMessagesList');
            var userTime = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

            // Escape HTML để hiển thị an toàn
            var divEsc = document.createElement('div');
            divEsc.textContent = text;
            var escapedText = divEsc.innerHTML.replace(/\n/g, '<br/>');

            // 1. CHÈN NGAY LẬP TỨC BONG BÓNG CÂU TRẢ LỜI CỦA ỨNG VIÊN
            var userBubble = document.createElement('div');
            userBubble.className = "w-100 d-flex flex-column align-items-end mb-2";
            userBubble.innerHTML = `
                <div class="d-flex align-items-start gap-2 max-w-85 justify-content-end">
                    <div class="p-3 rounded-4 text-white shadow-sm bg-primary" style="border-top-right-radius: 0 !important;">
                        <p class="mb-0 small" style="line-height: 1.6; white-space: pre-line;">${escapedText}</p>
                        <span class="text-white-50 d-block text-end mt-1" style="font-size: 0.65rem;">${userTime} (Vừa gửi)</span>
                    </div>
                    <div class="bg-secondary text-white rounded-circle p-1 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 34px; height: 34px; font-size: 0.85rem; background-color: #64748b !important;">
                        <i class="fas fa-user"></i>
                    </div>
                </div>
            `;
            if (messagesList) messagesList.appendChild(userBubble);

            // 2. CHÈN NGAY LẬP TỨC BONG BÓNG CHỜ CỦA AI PHỎNG VẤN
            var aiBubble = document.createElement('div');
            aiBubble.className = "d-flex align-items-start gap-2 max-w-85";
            aiBubble.id = "aiWaitingBubble";
            aiBubble.innerHTML = `
                <div class="bg-primary text-white rounded-circle p-1 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 34px; height: 34px; font-size: 0.85rem;">
                    <i class="fas fa-robot animate-pulse"></i>
                </div>
                <div class="p-3 rounded-4 bg-white shadow-sm border border-primary border-opacity-25" style="border-top-left-radius: 0 !important;">
                    <div class="d-flex align-items-center gap-2 text-dark fw-medium small">
                        <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
                        <span class="text-primary fw-bold">Đang kiểm tra câu trả lời...</span>
                        <span class="badge bg-danger text-white rounded-pill px-2 py-1 ms-1" id="timerBadge">0s</span>
                    </div>
                    <small class="text-muted d-block mt-1" style="font-size: 0.72rem;">
                        Local AI (Qwen 2.5 3B) đang phân tích 4 trụ cột STAR và tra cứu English Polishing.
                    </small>
                </div>
            `;
            if (messagesList) messagesList.appendChild(aiBubble);

            // Cuộn xuống dưới cùng ngay tức thì
            scrollToBottom();

            // 3. ĐỒNG HỒ ĐẾM GIÂY TĂNG DẦN
            var elapsedSeconds = 0;
            var timerInterval = setInterval(function () {
                elapsedSeconds++;
                var badge = document.getElementById('timerBadge');
                if (badge) {
                    badge.textContent = elapsedSeconds + 's';
                }
            }, 1000);

            // 4. GỬI AJAX REQUEST NGẦM LÊN SERVER
            var formElement = document.getElementById('chatForm');
            if (formElement) {
                var formData = new FormData(formElement);
                formData.set('answer', text);

                fetch(formElement.action, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(function (res) {
                    clearInterval(timerInterval);
                    window.location.reload();
                })
                .catch(function (err) {
                    clearInterval(timerInterval);
                    window.location.reload();
                });
            }
        }

        // Quản lý trạng thái và tỷ lệ kéo chỉnh độ rộng của 2 cột (Resizable Splitter)
        var isSplitDragging = false;
        var currentChatRatio = 58; // Tỷ lệ phần trăm cột Chatbox mặc định

        function applySplitRatio(leftPercent) {
            var splitRow = document.getElementById('splitChatRow');
            var chatCol = document.getElementById('chatMainCol');
            var sideCol = document.getElementById('starSidePanelCol');
            var overallCol = document.getElementById('overallReportCol');
            var rightCol = (sideCol && !sideCol.classList.contains('d-none')) ? sideCol : (overallCol && !overallCol.classList.contains('d-none') ? overallCol : null);

            if (!splitRow || !chatCol || !rightCol) return;

            // Clamping an toàn: Cột trái từ 35% đến 75%
            if (leftPercent < 35) leftPercent = 35;
            if (leftPercent > 75) leftPercent = 75;

            var rightPercent = 100 - leftPercent;
            currentChatRatio = leftPercent;

            // Xóa các class col-lg-X để inline flex-basis chiếm quyền ưu tiên
            chatCol.classList.remove('col-lg-12', 'col-lg-7', 'col-lg-8');
            rightCol.classList.remove('col-lg-5', 'col-lg-4');

            chatCol.style.flex = '0 0 calc(' + leftPercent + '% - 7px)';
            chatCol.style.maxWidth = 'calc(' + leftPercent + '% - 7px)';
            chatCol.style.width = 'calc(' + leftPercent + '% - 7px)';

            rightCol.style.flex = '0 0 calc(' + rightPercent + '% - 7px)';
            rightCol.style.maxWidth = 'calc(' + rightPercent + '% - 7px)';
            rightCol.style.width = 'calc(' + rightPercent + '% - 7px)';
        }

        function initResizableSplitter() {
            var splitter = document.getElementById('chatSplitterBar');
            var splitRow = document.getElementById('splitChatRow');
            if (!splitter || !splitRow) return;

            splitter.addEventListener('mousedown', function (e) {
                e.preventDefault();
                isSplitDragging = true;
                splitter.classList.add('is-dragging');
                document.body.classList.add('is-resizing');

                function onMouseMove(moveEvent) {
                    if (!isSplitDragging) return;
                    var rect = splitRow.getBoundingClientRect();
                    var mouseX = moveEvent.clientX - rect.left;
                    var newRatio = (mouseX / rect.width) * 100;
                    applySplitRatio(newRatio);
                }

                function onMouseUp() {
                    if (!isSplitDragging) return;
                    isSplitDragging = false;
                    splitter.classList.remove('is-dragging');
                    document.body.classList.remove('is-resizing');
                    document.removeEventListener('mousemove', onMouseMove);
                    document.removeEventListener('mouseup', onMouseUp);

                    // Lưu tỷ lệ vào localStorage để duy trì trạng thái
                    try {
                        localStorage.setItem('interviewChatSplitRatio', currentChatRatio.toFixed(1));
                    } catch (err) {}
                }

                document.addEventListener('mousemove', onMouseMove);
                document.addEventListener('mouseup', onMouseUp);
            });
        }

        // Hiển thị chi tiết Đánh giá STAR & English Polishing chia đôi không gian (Split view Side Panel)
        function showStarDetailDrawer(msgId) {
            var tpl = document.getElementById('starDetailTpl-' + msgId);
            if (!tpl) return;

            var isFinished = @(Model.Status == 1 ? "true" : "false");

            if (!isFinished) {
                var chatCol = document.getElementById('chatMainCol');
                var sideCol = document.getElementById('starSidePanelCol');
                var sideBody = document.getElementById('starSidePanelBody');
                var splitter = document.getElementById('chatSplitterBar');

                if (chatCol && sideCol && sideBody) {
                    sideBody.innerHTML = tpl.innerHTML;
                    sideCol.classList.remove('d-none');
                    if (splitter) splitter.classList.remove('d-none');

                    // Kích hoạt hiệu ứng nhảy số điểm sinh động (Animated Count-up)
                    triggerAnimatedCounters(sideBody);

                    // Lấy tỷ lệ đã lưu hoặc mặc định 58%
                    var savedRatio = 58;
                    try {
                        var stored = localStorage.getItem('interviewChatSplitRatio');
                        if (stored) savedRatio = parseFloat(stored);
                    } catch (e) {}

                    applySplitRatio(savedRatio);
                    setTimeout(scrollToBottom, 60);
                }
            } else {
                // Nếu buổi phỏng vấn đã kết thúc, hiển thị chi tiết trong cột bên phải thay thế tạm cho tổng kết
                var overallView = document.getElementById('overallEvaluationView');
                var specificView = document.getElementById('starDetailSpecificView');
                var specificBody = document.getElementById('starDetailSpecificBody');

                if (overallView && specificView && specificBody) {
                    specificBody.innerHTML = tpl.innerHTML;
                    overallView.classList.add('d-none');
                    specificView.classList.remove('d-none');

                    // Kích hoạt hiệu ứng nhảy số điểm khi xem chi tiết câu đã hoàn thành
                    triggerAnimatedCounters(specificBody);
                }
            }
        }

        // Đóng Panel Chi tiết STAR và trả lại 100% không gian cho Chatbox
        function closeStarSidePanel() {
            var chatCol = document.getElementById('chatMainCol');
            var sideCol = document.getElementById('starSidePanelCol');
            var splitter = document.getElementById('chatSplitterBar');
            if (chatCol && sideCol) {
                sideCol.classList.add('d-none');
                if (splitter) splitter.classList.add('d-none');

                // Reset inline styles để chatCol chiếm lại 100%
                chatCol.style.flex = '';
                chatCol.style.maxWidth = '';
                chatCol.style.width = '';
                chatCol.classList.remove('col-lg-7');
                chatCol.classList.add('col-lg-12');
                setTimeout(scrollToBottom, 60);
            }
        }

        // Quay lại màn hình Đánh giá chung cuộc khi đang ở Model.Status == 1
        function backToOverallEvaluation() {
            var overallView = document.getElementById('overallEvaluationView');
            var specificView = document.getElementById('starDetailSpecificView');
            if (overallView && specificView) {
                specificView.classList.add('d-none');
                overallView.classList.remove('d-none');
            }
        }

        // Khởi tạo sự kiện DOM khi trang sẵn sàng
        document.addEventListener("DOMContentLoaded", function () {
            // Tự động cuộn xuống dưới cùng khi load trang
            setTimeout(scrollToBottom, 120);

            // Hiển thị nội dung nhận xét tổng quan bằng Markdown
            var rawEvaluation = document.getElementById("rawAiEvaluation");
            var evaluationContent = document.getElementById("aiEvaluationContent");
            if (rawEvaluation && evaluationContent && rawEvaluation.value && rawEvaluation.value.trim() !== '') {
                evaluationContent.innerHTML = parseMarkdownToHtml(rawEvaluation.value);
            }

            // Bắt sự kiện submit của form
            var form = document.getElementById('chatForm');
            if (form) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    doSubmitChatMessage();
                });
            }

            // Bắt sự kiện phím Enter trong ô textarea (Enter = gửi, Shift+Enter = xuống dòng)
            var input = document.getElementById('answerInput');
            if (input) {
                input.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' && !e.shiftKey) {
                        e.preventDefault();
                        doSubmitChatMessage();
                    }
                });
            }

            // Khởi tạo bộ kéo chỉnh độ rộng hai bên (Resizable Splitter)
            initResizableSplitter();

            // Nếu buổi phỏng vấn đã hoàn tất (Model.Status == 1), tự động khôi phục tỷ lệ kích thước đã lưu & nhảy số điểm tổng kết
            var isFinished = @(Model.Status == 1 ? "true" : "false");
            if (isFinished) {
                var savedRatio = 58;
                try {
                    var stored = localStorage.getItem('interviewChatSplitRatio');
                    if (stored) savedRatio = parseFloat(stored);
                } catch (e) {}
                applySplitRatio(savedRatio);

                // Hiệu ứng nhảy số điểm tổng kết
                var overallCard = document.getElementById('overallEvaluationView');
                if (overallCard) {
                    setTimeout(function () {
                        triggerAnimatedCounters(overallCard);
                    }, 100);
                }
            }

            // Bắt phím Escape để đóng nhanh Panel chi tiết STAR
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    closeStarSidePanel();
                }
            });

            // Giải phóng GPU VRAM khi người dùng đóng tab hoặc chuyển trang rời khỏi phòng phỏng vấn
            window.addEventListener('pagehide', function (e) {
                if (!isSubmitting && navigator.sendBeacon) {
                    navigator.sendBeacon('/Interview/ReleaseInterviewAi');
                }
            });
        });
    </script>
}
