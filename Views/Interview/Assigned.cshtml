@model IEnumerable<DoAnCS.Models.InterviewSession>
@{
    ViewData["Title"] = "Lời mời phỏng vấn";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-2">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
            <li class="breadcrumb-item active text-primary fw-medium" aria-current="page">Lời mời phỏng vấn</li>
        </ol>
    </nav>

    <!-- Tiêu đề & Banner -->
    <div class="card border-0 shadow-sm rounded-4 px-4 py-3 mb-4 header-card-assigned">
        <div class="row align-items-center">
            <div class="col-lg-10 col-md-9">
                <span class="badge bg-warning text-dark fw-bold mb-2 px-3 py-1 rounded-pill text-uppercase" style="font-size: 0.75rem;">
                    <i class="fas fa-briefcase me-1"></i> Quy trình tuyển dụng
                </span>
                <h1 class="header-title-assigned mb-1 fs-3">Lời Mời Phỏng Vấn Từ Nhà Tuyển Dụng</h1>
                <p class="header-desc-assigned mb-0 small">
                    Nơi lưu trữ các yêu cầu phỏng vấn tự luận do nhà tuyển dụng gửi trực tiếp để đánh giá năng lực của bạn.
                </p>
            </div>
            <div class="col-lg-2 col-md-3 text-end d-none d-md-block">
                <div class="p-2 bg-white rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 55px; height: 55px; border: 1px solid rgba(124, 58, 237, 0.15);">
                    <i class="fas fa-envelope-open-text text-primary fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-lg rounded-4 p-4 bg-white">
        <h4 class="fw-bold text-dark mb-4 border-bottom pb-3">
            <i class="fas fa-list-ul text-primary me-2"></i> Danh sách yêu cầu phỏng vấn
        </h4>

        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-envelope display-3 mb-3 opacity-30"></i>
                <h5 class="fw-bold text-secondary">Bạn chưa có lời mời phỏng vấn nào</h5>
                <p class="text-muted small">Khi nhà tuyển dụng gửi bài kiểm tra phỏng vấn cho CV của bạn, các yêu cầu sẽ xuất hiện tại đây.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="py-3 px-4">Công việc & Công ty</th>
                            <th scope="col" class="py-3">CV nộp ứng tuyển</th>
                            <th scope="col" class="py-3">Thời gian nhận</th>
                            <th scope="col" class="py-3 text-center">Trạng thái bài làm</th>
                            <th scope="col" class="py-3 text-center">Điểm đánh giá</th>
                            <th scope="col" class="py-3 text-center" style="width: 180px;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td class="py-3 px-4">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary-light text-primary rounded-3 p-2 me-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                                            <i class="fas fa-building"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-1">@s.Job?.Title</h6>
                                            <small class="text-muted"><i class="fas fa-city me-1"></i> @s.Job?.Company?.Name</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-bold text-secondary small"><i class="fas fa-file-invoice me-1"></i> @s.Resume?.Title</span>
                                </td>
                                <td>
                                    <small class="text-muted">@s.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                                </td>
                                <td class="text-center">
                                    @if (s.Status == 0)
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold">Chưa làm bài</span>
                                    }
                                    else if (!s.OverallScore.HasValue)
                                    {
                                        <span class="badge bg-info text-dark px-3 py-2 rounded-pill fw-bold">Chờ chấm điểm</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success px-3 py-2 rounded-pill fw-bold">Đã chấm điểm</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (s.OverallScore.HasValue)
                                    {
                                        <span class="badge @(s.OverallScore >= 80 ? "bg-success" : s.OverallScore >= 50 ? "bg-warning text-dark" : "bg-danger") fs-6 py-2 px-3 rounded-pill fw-bold">
                                            @s.OverallScore<span style="font-size: 0.7rem;">/100</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (s.Status == 0)
                                    {
                                        <a asp-action="AssignedInterview" asp-route-sessionId="@s.SessionID" class="btn btn-primary btn-sm w-100 rounded-pill py-2 shadow-sm fw-bold">
                                            <i class="fas fa-edit me-1"></i> Làm bài thi
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="AssignedInterview" asp-route-sessionId="@s.SessionID" class="btn btn-outline-secondary btn-sm w-100 rounded-pill py-2 fw-bold">
                                            <i class="fas fa-eye me-1"></i> Xem chi tiết
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<style>
    .bg-primary-light {
        background-color: rgba(13, 110, 253, 0.08) !important;
    }
    
    .table-hover tbody tr:hover {
        background-color: rgba(248, 250, 252, 0.75);
    }

    [data-bs-theme="dark"] .table-hover tbody tr:hover {
        background-color: rgba(255, 255, 255, 0.05) !important;
    }
    [data-bs-theme="dark"] .bg-primary-light {
        background-color: rgba(13, 110, 253, 0.2) !important;
    }

    .header-card-assigned {
        background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%) !important;
        border: 1px solid rgba(124, 58, 237, 0.1) !important;
    }
    
    [data-bs-theme="dark"] .header-card-assigned {
        background: rgba(139, 92, 246, 0.1) !important;
        border: 1px solid rgba(139, 92, 246, 0.35) !important;
        box-shadow: 0 8px 32px 0 rgba(139, 92, 246, 0.1) !important;
    }
    
    .header-title-assigned {
        color: #4c1d95 !important;
        font-weight: 800 !important;
        letter-spacing: -0.5px;
    }
    
    [data-bs-theme="dark"] .header-title-assigned {
        color: #ede9fe !important;
    }
    
    .header-desc-assigned {
        color: #6d28d9 !important;
        opacity: 0.85;
        font-weight: 500;
    }
    
    [data-bs-theme="dark"] .header-desc-assigned {
        color: #ddd6fe !important;
    }
</style>
