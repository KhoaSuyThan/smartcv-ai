@model IEnumerable<DoAnCS.Models.InterviewSession>
@{
    ViewData["Title"] = "Lời mời phỏng vấn";
}

<div class="container py-5" style="min-height: 85vh;">
    <!-- Tiêu đề & Banner -->
    <div class="p-5 mb-5 rounded-4 shadow-sm border position-relative overflow-hidden text-white" 
         style="background: linear-gradient(135deg, #7c3aed 0%, #4f46e5 100%);">
        <div class="position-absolute top-0 end-0 opacity-10" style="font-size: 15rem; transform: translate(15%, -15%);">
            <i class="fas fa-envelope-open-text"></i>
        </div>
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-warning text-dark fw-bold mb-3 px-3 py-2 rounded-pill text-uppercase" style="font-size: 0.8rem;">
                    <i class="fas fa-briefcase me-1"></i> Quy trình tuyển dụng
                </span>
                <h1 class="display-5 fw-extrabold mb-3">Lời Mời Phỏng Vấn Từ Nhà Tuyển Dụng</h1>
                <p class="lead mb-0 text-white-50">
                    Nơi lưu trữ các yêu cầu phỏng vấn tự luận do nhà tuyển dụng gửi trực tiếp cho bạn để đánh giá năng lực ứng tuyển.
                </p>
            </div>
            <div class="col-lg-4 text-center d-none d-lg-block">
                <i class="fas fa-file-signature text-warning" style="font-size: 7rem; filter: drop-shadow(0 10px 15px rgba(0,0,0,0.3));"></i>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-lg rounded-4 p-4 bg-white">
        <h4 class="fw-bold text-dark mb-4 border-bottom pb-3">
            <i class="fas fa-list-ul text-primary me-2"></i> Danh sách yêu cầu phỏng vấn
        </h4>

        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-envelope display-3 mb-3 opacity-30"></i>
                <h5 class="fw-bold text-secondary">Bạn chưa có lời mời phỏng vấn nào</h5>
                <p class="text-muted small">Khi nhà tuyển dụng gửi bài kiểm tra phỏng vấn cho CV của bạn, các yêu cầu sẽ xuất hiện tại đây.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="py-3 px-4">Công việc & Công ty</th>
                            <th scope="col" class="py-3">CV nộp ứng tuyển</th>
                            <th scope="col" class="py-3">Thời gian nhận</th>
                            <th scope="col" class="py-3 text-center">Trạng thái bài làm</th>
                            <th scope="col" class="py-3 text-center">Điểm đánh giá</th>
                            <th scope="col" class="py-3 text-center" style="width: 180px;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td class="py-3 px-4">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary-light text-primary rounded-3 p-2 me-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                                            <i class="fas fa-building"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-1">@s.Job?.Title</h6>
                                            <small class="text-muted"><i class="fas fa-city me-1"></i> @s.Job?.Company?.Name</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-bold text-secondary small"><i class="fas fa-file-invoice me-1"></i> @s.Resume?.Title</span>
                                </td>
                                <td>
                                    <small class="text-muted">@s.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                                </td>
                                <td class="text-center">
                                    @if (s.Status == 0)
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold">Chưa làm bài</span>
                                    }
                                    else if (!s.OverallScore.HasValue)
                                    {
                                        <span class="badge bg-info text-dark px-3 py-2 rounded-pill fw-bold">Chờ chấm điểm</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success px-3 py-2 rounded-pill fw-bold">Đã chấm điểm</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (s.OverallScore.HasValue)
                                    {
                                        <span class="badge @(s.OverallScore >= 80 ? "bg-success" : s.OverallScore >= 50 ? "bg-warning text-dark" : "bg-danger") fs-6 py-2 px-3 rounded-pill fw-bold">
                                            @s.OverallScore<span style="font-size: 0.7rem;">/100</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (s.Status == 0)
                                    {
                                        <a asp-action="AssignedInterview" asp-route-sessionId="@s.SessionID" class="btn btn-primary btn-sm w-100 rounded-pill py-2 shadow-sm fw-bold">
                                            <i class="fas fa-edit me-1"></i> Làm bài thi
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="AssignedInterview" asp-route-sessionId="@s.SessionID" class="btn btn-outline-secondary btn-sm w-100 rounded-pill py-2 fw-bold">
                                            <i class="fas fa-eye me-1"></i> Xem chi tiết
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<style>
    .bg-primary-light {
        background-color: rgba(13, 110, 253, 0.08) !important;
    }
    
    .table-hover tbody tr:hover {
        background-color: rgba(248, 250, 252, 0.75);
    }

    [data-bs-theme="dark"] .table-hover tbody tr:hover {
        background-color: rgba(255, 255, 255, 0.05) !important;
    }
    [data-bs-theme="dark"] .bg-primary-light {
        background-color: rgba(13, 110, 253, 0.2) !important;
    }
</style>
