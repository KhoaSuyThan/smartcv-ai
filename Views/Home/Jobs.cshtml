@using X.PagedList.Mvc.Core;
@using X.PagedList;
@model DoAnCS.Models.HomeViewModel  

@{
    ViewData["Title"] = "Việc làm";
}
<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
<style>
    /* Premium UI Styles for Jobs */
    body {
        background-color: #f8f9fa;
    }

    .job-filter-sidebar {
        background: #ffffff;
        border-radius: 1.5rem;
        padding: 2rem;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
        position: sticky;
        top: 20px;
        border: none;
    }

    .filter-scroll-container {
        border: 1px solid #e5e7eb !important;
        border-radius: 0.75rem !important;
        background-color: #f9fafb !important;
    }

    .form-control, .form-select {
        border-radius: 0.75rem;
        border: 1px solid #e5e7eb;
        padding: 0.6rem 1rem;
        transition: all 0.3s ease;
    }
    
    .form-control:focus, .form-select:focus {
        border-color: #4f46e5;
        box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
    }

    /* Checkbox styles */
    .form-check-input {
        cursor: pointer;
    }
    .form-check-input:checked {
        background-color: #4f46e5;
        border-color: #4f46e5;
    }
    .form-check-label {
        cursor: pointer;
        color: #4b5563;
    }

    .job-item-row {
        background: #ffffff;
        border-radius: 1.25rem;
        padding: 1.5rem;
        margin-bottom: 1.25rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid transparent;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
    }
    
    .job-item-row:hover {
        border-color: #e0e7ff;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        transform: translateY(-4px);
    }

    .company-logo-container {
        position: relative;
        padding: 0.5rem;
        background: #ffffff;
        border-radius: 1rem;
        border: 1px solid #f3f4f6;
    }

    .company-logo-img {
        width: 64px;
        height: 64px;
        object-fit: contain;
        border-radius: 0.5rem;
    }

    .company-logo-letter {
        width: 64px;
        height: 64px;
        background: linear-gradient(135deg, #e0e7ff 0%, #c7d2fe 100%);
        color: #4338ca;
        border-radius: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 1.75rem;
    }
    
    /* Pagination */
    .pagination { margin-bottom: 0; gap: 0.25rem; }
    .page-item .page-link {
        border-radius: 0.5rem;
        border: none;
        color: #4b5563;
        font-weight: 500;
        padding: 0.5rem 1rem;
        background: #ffffff;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
        transition: all 0.2s ease;
    }
    .page-item .page-link:hover {
        background: #f3f4f6;
        color: #4f46e5;
    }
    .page-item.active .page-link { 
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        color: white; 
        box-shadow: 0 4px 6px -1px rgba(79, 70, 229, 0.3);
    }
    .page-item.disabled .page-link {
        background: transparent;
        box-shadow: none;
    }
    
    #btnClearFilters:hover {
        background-color: #fee2e2;
        color: #ef4444 !important;
    }

    /* Badge Match Score */
    .match-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.35rem 0.8rem;
        border-radius: 50rem;
        font-weight: 700;
        font-size: 0.75rem;
        animation: fadeInBadge 0.5s ease;
    }
    .match-badge-high {
        background: #ecfdf5;
        color: #059669;
        border: 1px solid #a7f3d0;
    }
    .match-badge-medium {
        background: #eff6ff;
        color: #2563eb;
        border: 1px solid #bfdbfe;
    }
    .match-badge-low {
        background: #fffbeb;
        color: #d97706;
        border: 1px solid #fde68a;
    }
    .job-item-row.match-highlight {
        border-color: #a7f3d0;
        background: linear-gradient(to right, #f0fdf4, #ffffff);
    }
    @@keyframes fadeInBadge {
        from { opacity: 0; transform: translateY(-5px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .cv-selector-card {
        background: linear-gradient(135deg, #f5f3ff 0%, #eef2ff 100%);
        border: 1px solid #ddd6fe;
        border-radius: 1.25rem;
        padding: 1.25rem;
        margin-bottom: 2rem;
        box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.6), 0 4px 6px -1px rgba(79, 70, 229, 0.05);
        position: relative;
        overflow: hidden;
    }
    .cv-selector-card::before {
        content: '';
        position: absolute;
        width: 100px;
        height: 100px;
        background: radial-gradient(circle, rgba(99, 102, 241, 0.15) 0%, rgba(255, 255, 255, 0) 70%);
        top: -50px;
        right: -30px;
        pointer-events: none;
    }
    .cv-selector-card h6 {
        font-weight: 700 !important;
        font-size: 0.95rem;
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        display: inline-flex;
        align-items: center;
    }
    .cv-selector-card select {
        border: 1.5px solid #d8b4fe !important;
        background-color: #ffffff !important;
        color: #3730a3 !important;
        font-weight: 600 !important;
        border-radius: 0.75rem !important;
        padding: 0.5rem 2rem 0.5rem 1rem !important;
        transition: all 0.2s ease-in-out !important;
    }
    .cv-selector-card select:focus {
        border-color: #818cf8 !important;
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15) !important;
    }
    
    /* Buttons */
    .btn-apply-1click {
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        color: white;
        border: none;
        transition: all 0.3s ease;
    }
    .btn-apply-1click:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.4);
        color: white;
    }
    .btn-outline-primary {
        color: #4f46e5;
        border-color: #4f46e5;
        transition: all 0.3s ease;
    }
    .btn-outline-primary:hover {
        background: #4f46e5;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 4px 6px -1px rgba(79, 70, 229, 0.2);
    }
    .btn-primary {
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        border: none;
    }
    .btn-primary:hover {
        background: linear-gradient(135deg, #4338ca 0%, #6d28d9 100%);
    }

    /* ==========================================
       ĐỒNG BỘ DARK MODE CHO TRANG JOBS
       ========================================== */
    [data-bs-theme="dark"] body {
        background-color: #121212 !important;
    }
    
    [data-bs-theme="dark"] .job-filter-sidebar {
        background: #1e1e1e !important;
        border: 1px solid #2d2d2d !important;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3) !important;
    }

    [data-bs-theme="dark"] .job-filter-sidebar .text-dark {
        color: #f8fafc !important;
    }

    [data-bs-theme="dark"] .filter-scroll-container {
        border-color: #2d2d2d !important;
        background-color: #121212 !important;
    }

    [data-bs-theme="dark"] .form-control, 
    [data-bs-theme="dark"] .form-select {
        background-color: #121212 !important;
        border-color: #2d2d2d !important;
        color: #cbd5e1 !important;
    }

    [data-bs-theme="dark"] .form-check-label {
        color: #94a3b8 !important;
    }

    [data-bs-theme="dark"] .job-item-row {
        background: #1e1e1e !important;
        border: 1px solid #2d2d2d !important;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2) !important;
    }

    [data-bs-theme="dark"] .job-item-row:hover {
        border-color: #4f46e5 !important;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.4) !important;
    }

    [data-bs-theme="dark"] .job-item-row h5 a {
        color: #f8fafc !important;
    }

    [data-bs-theme="dark"] .job-item-row .text-dark {
        color: #cbd5e1 !important;
    }

    [data-bs-theme="dark"] .job-item-row .text-muted {
        color: #94a3b8 !important;
    }

    [data-bs-theme="dark"] .job-item-row .text-secondary {
        color: #94a3b8 !important;
    }

    /* Tiêu đề & Sắp xếp */
    [data-bs-theme="dark"] .col-lg-9 .border-bottom {
        border-color: #2d2d2d !important;
    }
    [data-bs-theme="dark"] .col-lg-9 h4.text-dark {
        color: #f8fafc !important;
    }
    [data-bs-theme="dark"] #sortBySelector {
        background-color: #1e1e1e !important;
        color: #f8fafc !important;
    }

    /* Alert lưu ý */
    [data-bs-theme="dark"] .alert-warning {
        background-color: #2e2206 !important;
        color: #fef08a !important;
    }

    /* Logo công ty luôn trên nền trắng */
    [data-bs-theme="dark"] .company-logo-container {
        background-color: #ffffff !important;
        border-color: #e5e7eb !important;
    }

    /* Phân trang */
    [data-bs-theme="dark"] .page-item .page-link {
        background: #1e1e1e !important;
        color: #cbd5e1 !important;
        border-color: #2d2d2d !important;
    }
    [data-bs-theme="dark"] .page-item .page-link:hover {
        background: #2d2d2d !important;
        color: #ffffff !important;
    }

    /* Khối so khớp việc làm */
    [data-bs-theme="dark"] .cv-selector-card {
        background: linear-gradient(135deg, #1e1b4b 0%, #2e1065 100%) !important;
        border-color: #4c1d95 !important;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2) !important;
    }
    [data-bs-theme="dark"] .cv-selector-card h6 {
        background: linear-gradient(135deg, #c084fc 0%, #a78bfa 100%) !important;
        -webkit-background-clip: text !important;
        -webkit-text-fill-color: transparent !important;
    }
    [data-bs-theme="dark"] .cv-selector-card p {
        color: #d8b4fe !important;
    }
    [data-bs-theme="dark"] #cvMatchSelector {
        background-color: #1e1b4b !important;
        color: #e9d5ff !important;
        border-color: #6b21a8 !important;
    }

    /* Horizontal Filter Premium Styles */
    .horizontal-filter-card {
        background: #ffffff;
        border: 1px solid #e5e7eb !important;
        border-radius: 1.25rem !important;
        box-shadow: 0 10px 25px -5px rgba(79, 70, 229, 0.05) !important;
        transition: all 0.3s ease;
    }
    
    .horizontal-filter-card .form-select,
    .horizontal-filter-card .form-control {
        border: 1.5px solid #e5e7eb !important;
        border-radius: 0.75rem !important;
        padding-top: 0.5rem !important;
        padding-bottom: 0.5rem !important;
        font-weight: 600;
        color: #4b5563;
        transition: all 0.2s ease-in-out;
    }

    .horizontal-filter-card .form-select:hover,
    .horizontal-filter-card .form-control:hover {
        border-color: #818cf8 !important;
    }

    .horizontal-filter-card .form-select:focus,
    .horizontal-filter-card .form-control:focus {
        border-color: #4f46e5 !important;
        box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1) !important;
    }

    /* Dark mode support */
    [data-bs-theme="dark"] .horizontal-filter-card {
        background: #1e1e1e !important;
        border-color: #2d2d2d !important;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3) !important;
    }

    [data-bs-theme="dark"] .horizontal-filter-card .form-select,
    [data-bs-theme="dark"] .horizontal-filter-card .form-control {
        background-color: #121212 !important;
        border-color: #2d2d2d !important;
        color: #cbd5e1 !important;
    }

    [data-bs-theme="dark"] .horizontal-filter-card .form-select:hover,
    [data-bs-theme="dark"] .horizontal-filter-card .form-control:hover {
        border-color: #4f46e5 !important;
    }

    [data-bs-theme="dark"] .horizontal-filter-card .form-select:focus,
    [data-bs-theme="dark"] .horizontal-filter-card .form-control:focus {
        border-color: #818cf8 !important;
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15) !important;
    }

    [data-bs-theme="dark"] .horizontal-filter-card .text-secondary {
        color: #94a3b8 !important;
    }

    /* Custom Combobox Premium Styles */
    .custom-combobox .input-group .form-control {
        border-top-right-radius: 0 !important;
        border-bottom-right-radius: 0 !important;
        border-right: none !important;
    }

    .dropdown-toggle-custom {
        transition: all 0.2s ease;
        border: 1.5px solid #e5e7eb !important;
        border-left: none !important;
        border-top-left-radius: 0 !important;
        border-bottom-left-radius: 0 !important;
        border-top-right-radius: 0.75rem !important;
        border-bottom-right-radius: 0.75rem !important;
        padding-left: 0.75rem !important;
        padding-right: 0.75rem !important;
        background-color: #ffffff !important;
        color: #6b7280 !important;
    }

    /* Group hover & focus sync effects */
    .custom-combobox .input-group:hover .form-control {
        border-color: #818cf8 !important;
    }
    .custom-combobox .input-group:hover .dropdown-toggle-custom {
        border-color: #818cf8 !important;
    }
    .custom-combobox .input-group:focus-within .form-control,
    .custom-combobox .input-group:focus-within .dropdown-toggle-custom {
        border-color: #4f46e5 !important;
        box-shadow: none !important;
    }
    .custom-combobox .input-group:focus-within {
        box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1) !important;
        border-radius: 0.75rem;
    }

    .custom-combobox .dropdown-menu {
        border-radius: 0.75rem !important;
        border: 1.5px solid #e5e7eb !important;
        background-color: #ffffff;
        overflow-x: hidden;
    }
    
    .custom-combobox .dropdown-item {
        color: #4b5563;
        font-weight: 500;
        transition: all 0.2s ease;
        white-space: normal;
        word-break: break-word;
    }
    
    .custom-combobox .dropdown-item:hover {
        background-color: #f3f4f6;
        color: #4f46e5;
    }

    .custom-combobox .dropdown-item.active {
        background-color: #4f46e5;
        color: #ffffff;
    }

    /* Dark Mode support for Custom Combobox */
    [data-bs-theme="dark"] .custom-combobox .dropdown-menu {
        background-color: #1e1e1e !important;
        border-color: #2d2d2d !important;
    }

    [data-bs-theme="dark"] .custom-combobox .dropdown-item {
        color: #cbd5e1 !important;
    }

    [data-bs-theme="dark"] .custom-combobox .dropdown-item:hover {
        background-color: #2d2d2d !important;
        color: #818cf8 !important;
    }

    [data-bs-theme="dark"] .custom-combobox .dropdown-item.active {
        background-color: #4f46e5 !important;
        color: #ffffff !important;
    }

    [data-bs-theme="dark"] .custom-combobox .input-group .form-control {
        border-color: #2d2d2d !important;
        border-right: none !important;
    }

    [data-bs-theme="dark"] .dropdown-toggle-custom {
        background-color: #121212 !important;
        border-color: #2d2d2d !important;
        color: #94a3b8 !important;
    }

    [data-bs-theme="dark"] .custom-combobox .input-group:hover .form-control,
    [data-bs-theme="dark"] .custom-combobox .input-group:hover .dropdown-toggle-custom {
        border-color: #4f46e5 !important;
    }

    [data-bs-theme="dark"] .custom-combobox .input-group:focus-within .form-control,
    [data-bs-theme="dark"] .custom-combobox .input-group:focus-within .dropdown-toggle-custom {
        border-color: #818cf8 !important;
    }
    
    [data-bs-theme="dark"] .custom-combobox .input-group:focus-within {
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15) !important;
    }
</style>

<div class="container py-5">
    <form id="jobFilterForm" asp-action="Jobs" method="get" class="mb-0">
        <div class="row">
            <div class="col-lg-3 mb-4">
                <div class="job-filter-sidebar">
                    @* === DROPDOWN CHỌN CV ĐỂ SO KHỚP === *@
                    @if (User.Identity.IsAuthenticated && ViewBag.UserResumes != null && ((List<DoAnCS.Models.Resume>)ViewBag.UserResumes).Any())
                    {
                        var userResumes = (List<DoAnCS.Models.Resume>)ViewBag.UserResumes;
                        var selectedId = ViewBag.SelectedResumeId ?? 0;
                        <div class="cv-selector-card">
                            <h6 class="mb-2">
                                <i class='bx bx-brain me-1'></i> So khớp việc làm
                            </h6>
                            <p class="text-muted small mb-3" style="font-size: 0.8rem; font-weight: 500;">Chọn CV để phân tích mức độ phù hợp:</p>
                            <select id="cvMatchSelector" class="form-select form-select-sm">
                                @foreach (var resume in userResumes)
                                {
                                    var isSelected = resume.ResumeID == (int)selectedId;
                                    if (isSelected)
                                    {
                                        <option value="@resume.ResumeID" selected="selected">
                                            @(resume.Title ?? resume.JobTitle ?? $"CV #{resume.ResumeID}")
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@resume.ResumeID">
                                            @(resume.Title ?? resume.JobTitle ?? $"CV #{resume.ResumeID}")
                                        </option>
                                    }
                                }
                            </select>
                        </div>
                    }

                    <h5 class="fw-bold mb-4 text-dark"><i class='bx bx-filter-alt text-primary me-2'></i>Bộ lọc tìm kiếm</h5>

                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label small fw-bold text-uppercase text-secondary mb-0">Từ khóa</label>
                            
                            <a href="@Url.Action("Jobs", "Home")" id="btnClearFilters" 
                            class="text-danger small text-decoration-none d-none rounded px-2 py-1" 
                            style="font-weight: 600; transition: all 0.2s ease;">
                                <i class='bx bx-refresh'></i> Xóa
                            </a>
                        </div>
                        <div class="position-relative">
                            <input type="text" name="searchQuery" class="form-control" 
                                placeholder="C#, AI, Flutter..." value="@Model.SearchQuery" style="padding-left: 2.5rem;">
                            <i class='bx bx-search position-absolute text-muted' style="left: 1rem; top: 50%; transform: translateY(-50%);"></i>
                        </div>
                        <input type="hidden" name="sortBy" id="hiddenSortBy" value="@Model.SortBy">
                    </div>

                    @if (Model.AllCompanies != null && Model.AllCompanies.Any())
                    {
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-uppercase text-secondary">Doanh nghiệp</label>
                            <input type="text" id="companySearch" class="form-control form-control-sm mb-2" placeholder="Tìm tên công ty...">
                            
                            <div class="filter-scroll-container p-3" style="max-height: 150px; overflow-y: auto;">
                                @foreach (var comName in Model.AllCompanies)
                                {
                                    <div class="form-check mb-2 company-item">
                                        <input class="form-check-input" type="checkbox" name="selectedCompanies" value="@comName" 
                                            id="com-@comName.GetHashCode()" 
                                            @(Model.SelectedCompanies.Contains(comName) ? "checked" : "")>
                                        <label class="form-check-label small" for="com-@comName.GetHashCode()">@comName</label>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <button type="submit" class="btn btn-primary w-100 rounded-pill shadow-sm mt-2 py-2 fw-bold">
                        Áp dụng bộ lọc
                    </button>
                </div>
            </div>

        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                <h4 class="fw-bold mb-0 text-dark">
                    <span class="text-primary">@(Model.RealJobs?.TotalItemCount ?? 0)</span> cơ hội việc làm
                </h4>
                <select id="sortBySelector" class="form-select form-select-sm w-auto rounded-pill px-3 py-1 bg-white shadow-sm border-0" style="cursor: pointer;">
                    <option value="latest" selected="@(Model.SortBy == "latest")">Mới nhất</option>
                    <option value="salary" selected="@(Model.SortBy == "salary")">Lương cao nhất</option>
                </select>
            </div>
            <!-- Bộ lọc nằm ngang cho Vị trí công việc và Địa điểm -->
            <div class="card border-0 mb-4 p-4 horizontal-filter-card">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-uppercase text-secondary mb-2 d-flex align-items-center">
                            <i class='bx bx-briefcase text-primary me-2 fs-5'></i> Vị trí công việc
                        </label>
                        <div class="dropdown custom-combobox w-100">
                            <div class="input-group">
                                <input type="text" id="SpecialtyInput" name="specialties" class="form-control border-2 border-end-0" 
                                       placeholder="Chọn hoặc nhập vị trí..." value="@(Model.SelectedSpecialties.FirstOrDefault())"
                                       autocomplete="off">
                                <button class="btn btn-outline-secondary border-2 border-start-0 dropdown-toggle-custom bg-white text-muted" 
                                        type="button" id="comboboxToggle">
                                    <i class='bx bx-chevron-down fs-5'></i>
                                </button>
                            </div>
                            <ul class="dropdown-menu w-100 shadow-sm border-2 mt-1 py-1" id="comboboxMenu" style="max-height: 250px; overflow-y: auto; z-index: 1050;">
                                <li><a class="dropdown-item py-2" href="#" data-value="">Tất cả vị trí</a></li>
                                @foreach (var spec in Model.AllSpecialties)
                                {
                                    <li><a class="dropdown-item py-2" href="#" data-value="@spec">@spec</a></li>
                                }
                            </ul>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-uppercase text-secondary mb-2 d-flex align-items-center">
                            <i class='bx bx-map-pin text-primary me-2 fs-5'></i> Tỉnh / Thành phố
                        </label>
                        <select id="ProvinceSelect" name="selectedProvince" class="form-select border-2">
                            <option value="">Tất cả tỉnh/thành</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-uppercase text-secondary mb-2 d-flex align-items-center">
                            <i class='bx bx-navigation text-primary me-2 fs-5'></i> Quận / Huyện
                        </label>
                        <select id="DistrictSelect" name="selectedDistrict" class="form-select border-2">
                            <option value="">Tất cả quận/huyện</option>
                        </select>
                    </div>
                </div>
            </div>
            <div id="job-list">
                @if (Model.RealJobs != null && Model.RealJobs.Any())
                {
                    @foreach (var job in Model.RealJobs)
                    {
                        var ms2 = ViewBag.MatchScores as Dictionary<string, int>;
                        var isHighMatch = User.Identity.IsAuthenticated && ms2 != null && ms2.ContainsKey(job.job_id) && ms2[job.job_id] >= 70;
                        <div class="job-item-row d-md-flex align-items-center @(isHighMatch ? "match-highlight" : "")">
                            <div class="me-4 mb-3 mb-md-0 company-logo-container">
                                @if (!string.IsNullOrEmpty(job.employer_logo))
                                {
                                    <img src="@job.employer_logo" 
                                        class="company-logo-img" 
                                        alt="logo" 
                                        onerror="this.parentElement.innerHTML = '<div class=\'company-logo-letter\'>@(string.IsNullOrEmpty(job.employer_name) ? "IT" : job.employer_name[0].ToString().ToUpper())</div>';">
                                }
                                else
                                {
                                    <div class="company-logo-letter">
                                        @(string.IsNullOrEmpty(job.employer_name) ? "IT" : job.employer_name[0].ToString().ToUpper())
                                    </div>
                                }
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                                    <h5 class="fw-bold mb-0">
                                        <a asp-controller="Home" asp-action="Details" asp-route-id="@job.job_id" 
                                           class="text-decoration-none text-dark hover-primary" style="transition: color 0.2s;">
                                            @job.job_title
                                        </a>
                                    </h5>
                                    @{
                                        var matchScores2 = ViewBag.MatchScores as Dictionary<string, int>;
                                        if (User.Identity.IsAuthenticated && matchScores2 != null && matchScores2.ContainsKey(job.job_id) && matchScores2[job.job_id] >= 0)
                                        {
                                            var score2 = matchScores2[job.job_id];
                                            var badgeClass2 = score2 >= 70 ? "match-badge-high" : (score2 >= 40 ? "match-badge-medium" : "match-badge-low");
                                            var emoji2 = score2 >= 70 ? "🎯" : (score2 >= 40 ? "👍" : "💡");
                                            <span class="match-badge @badgeClass2">@emoji2 Phù hợp @score2%</span>
                                        }
                                    }
                                </div>
                                <p class="text-muted small mb-2">
                                    <i class='bx bx-building-house text-secondary me-1'></i><span class="text-dark fw-bold me-3">@job.employer_name</span>
                                    <i class='bx bx-map text-secondary me-1'></i>@job.job_city
                                </p>
                                <p class="mb-0 text-secondary small" style="line-height: 1.6;">
                                    @{
                                        var desc = job.job_description ?? "Thông tin chi tiết công việc đang được cập nhật...";
                                        @(desc.Length > 150 ? desc.Substring(0, 150) + "..." : desc)
                                    }
                                </p>
                            </div>
                            <div class="text-md-end mt-4 mt-md-0 ms-md-4" style="min-width: 220px; flex-shrink: 0;">
                                <div class="text-primary fw-bold mb-3 fs-5 text-nowrap">@job.job_salary</div>
                                @if (!string.IsNullOrEmpty(job.job_apply_link) && job.job_apply_link != "#")
                                {
                                    <a href="@job.job_apply_link" target="_blank" class="btn btn-sm btn-outline-primary px-3 py-2 rounded-pill mb-1 d-block w-100 fw-bold">
                                        Đến Website <i class='bx bx-link-external ms-1'></i>
                                    </a>
                                }
                                else
                                {
                                    <a href="/Home/Details/@job.job_id" class="btn btn-sm btn-apply-1click px-3 py-2 rounded-pill fw-bold d-block w-100">
                                        Ứng tuyển ngay <i class="fas fa-paper-plane ms-1"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5 bg-white rounded-4 shadow-sm border border-light">
                        <i class='bx bx-search-alt text-muted mb-3' style="font-size: 5rem; opacity: 0.3;"></i>
                        <h4 class="fw-bold text-dark mb-2">Không tìm thấy việc làm</h4>
                        <p class="text-muted">Vui lòng thử thay đổi từ khóa hoặc bộ lọc để xem thêm kết quả.</p>
                    </div>
                }
            </div>

            <div class="d-flex justify-content-center mt-5 mb-3">
                @Html.PagedListPager(Model.RealJobs, page => Url.Action("Jobs", new { 
                    page, 
                    searchQuery = Model.SearchQuery, 
                    specialties = Model.SelectedSpecialties, 
                    selectedCompanies = Model.SelectedCompanies,
                    selectedProvince = Model.SelectedProvince,
                    selectedDistrict = Model.SelectedDistrict,
                    sortBy = Model.SortBy 
                }), 
                    new PagedListRenderOptions {
                        UlElementClasses = new string[] { "pagination", "justify-content-center" },
                        LiElementClasses = new string[] { "page-item" },
                        PageClasses = new string[] { "page-link" },
                        
                        DisplayLinkToFirstPage = PagedListDisplayMode.Always,
                        DisplayLinkToLastPage = PagedListDisplayMode.Always,
                        DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                        DisplayLinkToNextPage = PagedListDisplayMode.Always,
                        DisplayLinkToIndividualPages = true,
                        
                        MaximumPageNumbersToDisplay = 5, 
                        DisplayEllipsesWhenNotShowingAllPageNumbers = true,
                        
                        LinkToFirstPageFormat = "<i class='bx bx-chevrons-left'></i>",
                        LinkToPreviousPageFormat = "<i class='bx bx-chevron-left'></i>",
                        LinkToNextPageFormat = "<i class='bx bx-chevron-right'></i>",
                        LinkToLastPageFormat = "<i class='bx bx-chevrons-right'></i>"
                    })
            </div>
        </div>
    </div>
    </form>
</div>

<script>
    document.getElementById('companySearch').addEventListener('keyup', function() {
        let value = this.value.toLowerCase();
        document.querySelectorAll('.company-item').forEach(function(item) {
            let text = item.innerText.toLowerCase();
            item.style.display = text.includes(value) ? 'block' : 'none';
        });
    });

    // --- ĐỒNG BỘ ĐỊA ĐIỂM BỘ LỌC TỈNH/THÀNH VÀ QUẬN/HUYỆN ---
    var provincesData = [];
    var provinceSelect = document.getElementById("ProvinceSelect");
    var districtSelect = document.getElementById("DistrictSelect");

    async function loadProvincesForFilter() {
        try {
            const response = await fetch('/data/provinces.json');
            provincesData = await response.json();
            
            provinceSelect.innerHTML = '<option value="">Chọn tỉnh/thành phố</option>';
            provincesData.forEach(p => {
                const option = document.createElement('option');
                option.value = p.name;
                option.text = p.name;
                provinceSelect.add(option);
            });

            // Thiết lập giá trị cũ từ Model nếu có
            const initialProvince = '@Model.SelectedProvince';
            const initialDistrict = '@Model.SelectedDistrict';
            
            if (initialProvince) {
                provinceSelect.value = initialProvince;
                populateDistrictsForFilter(initialProvince);
                if (initialDistrict) {
                    districtSelect.value = initialDistrict;
                }
            }
            toggleClearButton();
        } catch (e) {
            console.error("Error loading filter provinces:", e);
        }
    }

    function populateDistrictsForFilter(provinceName) {
        districtSelect.innerHTML = '<option value="">Chọn quận/huyện</option>';
        if (!provinceName) return;

        const province = provincesData.find(p => p.name === provinceName);
        if (province && province.districts) {
            province.districts.forEach(d => {
                const option = document.createElement('option');
                option.value = d.name;
                option.text = d.name;
                districtSelect.add(option);
            });
        }
    }

    provinceSelect.addEventListener('change', function() {
        populateDistrictsForFilter(this.value);
        toggleClearButton();
        document.getElementById('jobFilterForm').submit();
    });

    districtSelect.addEventListener('change', function() {
        toggleClearButton();
        document.getElementById('jobFilterForm').submit();
    });

    function toggleClearButton() {
        const btnClear = document.getElementById('btnClearFilters');
        const searchInput = document.querySelector('input[name="searchQuery"]');
        const checkboxes = document.querySelectorAll('.form-check-input');
        const specialtyInput = document.getElementById('SpecialtyInput');
        
        let isAnyChecked = Array.from(checkboxes).some(cb => cb.checked);
        let isSearchFilled = searchInput.value.trim() !== "";
        let isLocationSelected = (provinceSelect && provinceSelect.value !== "") || (districtSelect && districtSelect.value !== "");
        let isSpecialtySelected = specialtyInput && specialtyInput.value.trim() !== "";

        if (isAnyChecked || isSearchFilled || isLocationSelected || isSpecialtySelected) {
            btnClear.classList.remove('d-none');
        } else {
            btnClear.classList.add('d-none');
        }
    }

    // --- CUSTOM COMBOBOX CHO VỊ TRÍ CÔNG VIỆC ---
    const comboboxToggle = document.getElementById('comboboxToggle');
    const comboboxMenu = document.getElementById('comboboxMenu');
    const specialtyInput = document.getElementById('SpecialtyInput');

    if (comboboxToggle && comboboxMenu && specialtyInput) {
        // Toggle menu khi click nút mũi tên
        comboboxToggle.addEventListener('click', function(e) {
            e.stopPropagation();
            comboboxMenu.classList.toggle('show');
        });

        // Hiện menu khi focus vào input để người dùng thấy gợi ý
        specialtyInput.addEventListener('focus', function() {
            comboboxMenu.classList.add('show');
            filterComboboxItems(this.value);
        });

        // Ẩn menu khi click ra ngoài
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.custom-combobox')) {
                comboboxMenu.classList.remove('show');
            }
        });

        // Chọn một phần tử từ dropdown
        comboboxMenu.querySelectorAll('.dropdown-item').forEach(item => {
            item.addEventListener('click', function(e) {
                e.preventDefault();
                const val = this.getAttribute('data-value');
                specialtyInput.value = val;
                comboboxMenu.classList.remove('show');
                
                // Submit form
                toggleClearButton();
                document.getElementById('jobFilterForm').submit();
            });
        });

        // Lọc danh sách khi người dùng gõ
        specialtyInput.addEventListener('input', function() {
            comboboxMenu.classList.add('show');
            filterComboboxItems(this.value);
        });

        // Submit khi nhấn Enter trong input
        specialtyInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                comboboxMenu.classList.remove('show');
                toggleClearButton();
                document.getElementById('jobFilterForm').submit();
            }
        });

        function filterComboboxItems(filterText) {
            const val = filterText.toLowerCase().trim();
            comboboxMenu.querySelectorAll('li').forEach(li => {
                const a = li.querySelector('.dropdown-item');
                if (!a) return;
                const text = a.innerText.toLowerCase();
                const itemVal = a.getAttribute('data-value');
                
                if (itemVal === "" || text.includes(val)) {
                    li.style.display = 'block';
                } else {
                    li.style.display = 'none';
                }
            });
        }
    }

    // Gán sự kiện lắng nghe
    document.addEventListener('DOMContentLoaded', () => {
        loadProvincesForFilter();
        
        // Theo dõi ô search chính
        document.querySelector('input[name="searchQuery"]').addEventListener('input', toggleClearButton);
        
        // Theo dõi tất cả checkbox
        document.querySelectorAll('.form-check-input').forEach(cb => {
            cb.addEventListener('change', toggleClearButton);
        });

        // Xử lý khi thay đổi kiểu sắp xếp
        document.getElementById('sortBySelector').addEventListener('change', function() {
            document.getElementById('hiddenSortBy').value = this.value;
            // Submit form filter
            document.getElementById('jobFilterForm').submit();
        });

        // Xử lý khi thay đổi CV để so khớp
        const cvSelector = document.getElementById('cvMatchSelector');
        if (cvSelector) {
            cvSelector.addEventListener('change', function() {
                const url = new URL(window.location.href);
                url.searchParams.set('selectedResumeId', this.value);
                window.location.href = url.toString();
            });
        }
    });
</script>