@using X.PagedList.Mvc.Core;
@using X.PagedList;
@model DoAnCS.Models.HomeViewModel  

@{
    ViewData["Title"] = "Việc làm";
}
<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
<style>
    .job-filter-sidebar {
        background: #fff;
        border-radius: 15px;
        padding: 25px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.05);
        position: sticky;
        top: 20px;
    }
    .job-item-row {
        background: #fff;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 20px;
        transition: all 0.3s ease;
        border: 1px solid #eee;
    }
    .job-item-row:hover {
        border-color: #0d6efd;
        box-shadow: 0 10px 25px rgba(13, 110, 253, 0.1);
        transform: translateX(5px);
    }
    .company-logo-img {
        width: 60px;
        height: 60px;
        object-fit: contain;
        border-radius: 12px;
        border: 1px solid #f0f0f0;
    }

    .company-logo-letter {
        width: 60px;
        height: 60px;
        background-color: #f8f9fa; /* Màu nền nhẹ (bg-light) */
        color: #0d6efd; /* Màu chữ xanh dương (text-primary) */
        border-radius: 12px;
        border: 1px solid #eee;
        display: flex; /* Dùng flex để căn giữa chữ */
        align-items: center;
        justify-content: center;
        font-weight: bold; /* Chữ đậm (fw-bold) */
        font-size: 24px; /* Kích thước chữ (fs-4) */
    }
    
    /* Style cho phân trang */
    .pagination { margin-bottom: 0; }
    .page-item.active .page-link { background-color: #0d6efd; border-color: #0d6efd; }
    
    #btnClearFilters:hover {
        background-color: #fff5f5; /* Màu nền đỏ cực nhẹ */
        box-shadow: 0 2px 4px rgba(220, 53, 69, 0.1); /* Đổ bóng nhẹ */
    }
</style>

<div class="container py-5">
    <div class="row">
        <div class="col-lg-3 mb-4">
            <form asp-action="Jobs" method="get" class="job-filter-sidebar">
                <h5 class="fw-bold mb-4">Bộ lọc tìm kiếm</h5>

                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label small fw-bold text-uppercase text-secondary mb-0">Từ khóa</label>
                        
                        <a href="@Url.Action("Jobs", "Home")" id="btnClearFilters" 
                        class="text-danger small text-decoration-none d-none border border-danger rounded px-2 py-1" 
                        style="font-weight: 600; transition: all 0.2s ease;">
                            <i class='bx bx-refresh'></i> Xóa bộ lọc
                        </a>
                    </div>
                    <input type="text" name="searchQuery" class="form-control" 
                        placeholder="C#, AI, Flutter..." value="@Model.SearchQuery">
                    <input type="hidden" name="sortBy" id="hiddenSortBy" value="@Model.SortBy">
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-bold text-uppercase text-secondary">Vị trí công việc</label>
                    <input type="text" id="filterSearch" class="form-control form-control-sm mb-2" placeholder="Tìm vị trí nhanh...">
                    
                    <div class="filter-scroll-container border rounded-3 p-2 bg-white" style="max-height: 200px; overflow-y: auto;">
                        @foreach (var spec in Model.AllSpecialties)
                        {
                            <div class="form-check mb-1 specialty-item">
                                @* Sửa ID để tránh trùng lặp hoặc ký tự đặc biệt *@
                                <input class="form-check-input" type="checkbox" name="specialties" value="@spec" 
                                    id="spec-@spec.GetHashCode()" 
                                    @(Model.SelectedSpecialties.Contains(spec) ? "checked" : "")>
                                <label class="form-check-label small" for="spec-@spec.GetHashCode()">@spec</label>
                            </div>
                        }
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-bold text-uppercase text-secondary">Doanh nghiệp</label>
                    <input type="text" id="companySearch" class="form-control form-control-sm mb-2" placeholder="Tìm tên công ty...">
                    
                    <div class="filter-scroll-container border rounded-3 p-2 bg-white" style="max-height: 150px; overflow-y: auto;">
                        @if (Model.AllCompanies != null)
                        {
                            @foreach (var comName in Model.AllCompanies)
                            {
                                <div class="form-check mb-1 company-item">
                                    <input class="form-check-input" type="checkbox" name="selectedCompanies" value="@comName" 
                                        id="com-@comName.GetHashCode()" 
                                        @(Model.SelectedCompanies.Contains(comName) ? "checked" : "")>
                                    <label class="form-check-label small" for="com-@comName.GetHashCode()">@comName</label>
                                </div>
                            }
                        }
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 rounded-pill shadow-sm mt-2">
                    <i class='bx bx-filter-alt me-1'></i> Áp dụng bộ lọc
                </button>
            </form>
        </div>

        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold mb-0">Tìm thấy @(Model.RealJobs?.TotalItemCount ?? 0) cơ hội việc làm</h4>
                <select id="sortBySelector" class="form-select form-select-sm w-auto border-0 bg-light">
                    <option value="latest" selected="@(Model.SortBy == "latest")">Mới nhất</option>
                    <option value="salary" selected="@(Model.SortBy == "salary")">Lương cao nhất</option>
                </select>
            </div>

            <div id="job-list">
                @if (Model.RealJobs != null && Model.RealJobs.Any())
                {
                    @foreach (var job in Model.RealJobs)
                    {
                        <div class="job-item-row d-md-flex align-items-center">
                            <div class="me-4 mb-3 mb-md-0 company-logo-container"> @* Đặt một class cho container *@
                                @if (!string.IsNullOrEmpty(job.employer_logo))
                                {
                                    @* Phương pháp 3: Dùng onerror để THAY THẾ nội dung của thẻ parent *@
                                    <img src="@job.employer_logo" 
                                        class="company-logo-img" 
                                        alt="logo" 
                                        onerror="this.parentElement.innerHTML = '<div class=\'company-logo-letter\'>@(string.IsNullOrEmpty(job.employer_name) ? "IT" : job.employer_name[0].ToString().ToUpper())</div>';">
                                }
                                else
                                {
                                    @* Nếu không có link ảnh ngay từ đầu, hiện luôn ô chữ cái đầu *@
                                    <div class="company-logo-letter">
                                        @(string.IsNullOrEmpty(job.employer_name) ? "IT" : job.employer_name[0].ToString().ToUpper())
                                    </div>
                                }
                            </div>
                            <div class="flex-grow-1">
                                <h5 class="fw-bold mb-1"><a asp-controller="Home" asp-action="Details" asp-route-id="@job.job_id" 
                                    class="text-decoration-none text-dark">
                                        @job.job_title
                                    </a>
                                </h5>
                                <p class="text-muted small mb-2">
                                    <span class="text-primary fw-bold">@job.employer_name</span> • @job.job_city
                                </p>
                                <p class="mb-0 text-secondary small">
                                    @{
                                        var desc = job.job_description ?? "Thông tin chi tiết công việc đang được cập nhật...";
                                        @(desc.Length > 150 ? desc.Substring(0, 150) + "..." : desc)
                                    }
                                </p>
                            </div>
                            <div class="text-md-end mt-3 mt-md-0 ms-md-4" style="min-width: 150px;">
                                <div class="text-primary fw-bold mb-2">@job.job_salary</div>
                                @if (!string.IsNullOrEmpty(job.job_apply_link) && job.job_apply_link != "#")
                                {
                                    <a href="@job.job_apply_link" target="_blank" class="btn btn-sm btn-outline-primary px-3 rounded-pill mb-1 d-block w-100">Đến Website Công ty</a>
                                }
                                else
                                {
                                    <a href="/Home/Details/@job.job_id" class="btn btn-sm btn-primary px-3 rounded-pill fw-bold d-block w-100">Ứng tuyển 1-Click <i class="fas fa-bolt ms-1"></i></a>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5">
                        <img src="https://cdn-icons-png.flaticon.com/512/7486/7486744.png" width="100" class="mb-3 opacity-50">
                        <p class="text-muted">Không tìm thấy việc làm nào phù hợp.</p>
                    </div>
                }
            </div>

            <div class="d-flex justify-content-center mt-5">
                @Html.PagedListPager(Model.RealJobs, page => Url.Action("Jobs", new { 
                    page, 
                    searchQuery = Model.SearchQuery, 
                    specialties = Model.SelectedSpecialties, 
                    selectedCompanies = Model.SelectedCompanies,
                    sortBy = Model.SortBy 
                }), 
                    new PagedListRenderOptions {
                        UlElementClasses = new string[] { "pagination", "justify-content-center" },
                        LiElementClasses = new string[] { "page-item" },
                        PageClasses = new string[] { "page-link" },
                        
                        // Cấu hình để hiện số trang
                        DisplayLinkToFirstPage = PagedListDisplayMode.Always,
                        DisplayLinkToLastPage = PagedListDisplayMode.Always,
                        DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                        DisplayLinkToNextPage = PagedListDisplayMode.Always,
                        DisplayLinkToIndividualPages = true, // Quan trọng: Phải bật để hiện số 1, 2, 3...
                        
                        // Logic: Nếu > 5 trang thì chỉ hiện 5 số đầu và dấu ... đến trang cuối
                        MaximumPageNumbersToDisplay = 5, 
                        DisplayEllipsesWhenNotShowingAllPageNumbers = true,
                        
                        // Thay đổi chữ cho các nút đặc biệt (nếu muốn)
                        LinkToFirstPageFormat = "<<",
                        LinkToPreviousPageFormat = "<",
                        LinkToNextPageFormat = ">",
                        LinkToLastPageFormat = ">>"
                    })
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('filterSearch').addEventListener('keyup', function() {
        let value = this.value.toLowerCase();
        document.querySelectorAll('.specialty-item').forEach(function(item) {
            let text = item.innerText.toLowerCase();
            item.style.display = text.includes(value) ? 'block' : 'none';
        });
    });

    document.getElementById('companySearch').addEventListener('keyup', function() {
        let value = this.value.toLowerCase();
        document.querySelectorAll('.company-item').forEach(function(item) {
            let text = item.innerText.toLowerCase();
            item.style.display = text.includes(value) ? 'block' : 'none';
        });
    });

    function toggleClearButton() {
        const btnClear = document.getElementById('btnClearFilters');
        const searchInput = document.querySelector('input[name="searchQuery"]');
        // Lấy tất cả các checkbox có trong 2 bộ lọc
        const checkboxes = document.querySelectorAll('.form-check-input');
        
        let isAnyChecked = Array.from(checkboxes).some(cb => cb.checked);
        let isSearchFilled = searchInput.value.trim() !== "";

        if (isAnyChecked || isSearchFilled) {
            btnClear.classList.remove('d-none');
        } else {
            btnClear.classList.add('d-none');
        }
    }

    // Gán sự kiện lắng nghe
    document.addEventListener('DOMContentLoaded', () => {
        toggleClearButton();
        
        // Theo dõi ô search chính
        document.querySelector('input[name="searchQuery"]').addEventListener('input', toggleClearButton);
        
        // Theo dõi tất cả checkbox
        document.querySelectorAll('.form-check-input').forEach(cb => {
            cb.addEventListener('change', toggleClearButton);
        });

        // Xử lý khi thay đổi kiểu sắp xếp
        document.getElementById('sortBySelector').addEventListener('change', function() {
            document.getElementById('hiddenSortBy').value = this.value;
            // Submit form filter ở bên trái
            document.querySelector('form.job-filter-sidebar').submit();
        });
    });
</script>