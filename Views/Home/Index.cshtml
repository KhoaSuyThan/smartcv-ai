@{
    ViewData["Title"] = "Trang chủ - Hệ thống quản lý CV";
}

<style>
    .hero-section {
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 100px 0;
    }
    .btn-create {
        padding: 12px 30px;
        font-weight: bold;
        border-radius: 50px;
        transition: 0.3s;
    }
    .job-card {
        border: none;
        transition: transform 0.3s;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
    .job-card:hover {
        transform: translateY(-5px);
    }
</style>

<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold text-primary mb-3">Tạo CV giúp bạn trúng tuyển chỉ trong vài phút</h1>
                <p class="lead text-muted mb-4">
                    Bước đầu tiên để có một công việc tốt hơn? Một bản CV chuyên nghiệp. 
                    Hãy bắt đầu ngay với các mẫu CV được thiết kế chuẩn ATS.
                </p>
                <div class="d-flex gap-3">
                    <a asp-controller="Resume" asp-action="Create" class="btn btn-primary btn-create shadow">
                        <i class="fas fa-magic me-2"></i> Tạo CV mới ngay
                    </a>
                    <a href="#jobs-section" class="btn btn-outline-dark btn-create">
                        Tìm hiểu việc làm
                    </a>
                </div>
            </div>
            <div class="col-lg-6 mt-5 mt-lg-0 text-center">
                <img src="https://images.unsplash.com/photo-1586281380349-632531db7ed4?auto=format&fit=crop&q=80&w=800" 
                     class="img-fluid rounded-3 shadow-lg" alt="CV Illustration">
            </div>
        </div>
    </div>
</section>


<section id="jobs-section" class="py-5 bg-white">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-5">
            <div>
                <h2 class="fw-bold mb-2">Cơ hội việc làm mới nhất</h2>
                <p class="text-muted mb-0">Dựa trên kỹ năng và sở thích lập trình của bạn, chúng tôi đề xuất:</p>
            </div>
            <a asp-controller="Home" asp-action="Jobs" class="btn btn-outline-primary rounded-pill px-4 fw-bold">
                Xem tất cả <i class="fas fa-arrow-right ms-2"></i>
            </a>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card job-card h-100 p-3 border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-primary text-white p-2 rounded me-3 shadow-sm"><i class="fas fa-code"></i></div>
                            <h5 class="card-title mb-0">Thực tập sinh .NET</h5>
                        </div>
                        <p class="small text-muted mb-2"><i class="fas fa-map-marker-alt me-2"></i>Hà Nội (Full-time)</p>
                        <p class="card-text text-secondary small">Yêu cầu kiến thức cơ bản về C#, SQL Server và ASP.NET MVC...</p>
                        <div class="mt-3">
                            <span class="badge bg-light text-primary border me-1">C#</span>
                            <span class="badge bg-light text-primary border">SQL</span>
                        </div>
                        <a href="#" class="btn btn-sm btn-primary w-100 mt-3">Xem chi tiết</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card job-card h-100 p-3 border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-success text-white p-2 rounded me-3 shadow-sm"><i class="fas fa-mobile-alt"></i></div>
                            <h5 class="card-title mb-0">Lập trình viên Flutter</h5>
                        </div>
                        <p class="small text-muted mb-2"><i class="fas fa-map-marker-alt me-2"></i>TP. Hồ Chí Minh</p>
                        <p class="card-text text-secondary small">Xây dựng ứng dụng di động đa nền tảng bằng Dart. Ưu tiên có sản phẩm mẫu...</p>
                        <div class="mt-3">
                            <span class="badge bg-light text-success border me-1">Dart</span>
                            <span class="badge bg-light text-success border">Mobile</span>
                        </div>
                        <a href="#" class="btn btn-sm btn-primary w-100 mt-3">Xem chi tiết</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card job-card h-100 p-3 border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-info text-white p-2 rounded me-3 shadow-sm"><i class="fas fa-brain"></i></div>
                            <h5 class="card-title mb-0">AI/Image Specialist</h5>
                        </div>
                        <p class="small text-muted mb-2"><i class="fas fa-map-marker-alt me-2"></i>Đà Nẵng (Remote)</p>
                        <p class="card-text text-secondary small">Nghiên cứu và phát triển các mô hình tạo hình ảnh bằng AI (Stable Diffusion, GANs)...</p>
                        <div class="mt-3">
                            <span class="badge bg-light text-info border me-1">Python</span>
                            <span class="badge bg-light text-info border">AI Image</span>
                        </div>
                        <a href="#" class="btn btn-sm btn-primary w-100 mt-3">Xem chi tiết</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card job-card h-100 p-3 border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-warning text-dark p-2 rounded me-3 shadow-sm"><i class="fas fa-database"></i></div>
                            <h5 class="card-title mb-0">Quản trị viên Database</h5>
                        </div>
                        <p class="small text-muted mb-2"><i class="fas fa-map-marker-alt me-2"></i>Đà Nẵng (Remote)</p>
                        <p class="card-text text-secondary small">Tối ưu hóa các câu lệnh SQL phức tạp và thiết kế sơ đồ ERD chuyên nghiệp...</p>
                        <div class="mt-3">
                            <span class="badge bg-light text-warning border text-dark me-1">SQL Server</span>
                            <span class="badge bg-light text-warning border text-dark">ERD</span>
                        </div>
                        <a href="#" class="btn btn-sm btn-primary w-100 mt-3">Xem chi tiết</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card job-card h-100 p-3 border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-danger text-white p-2 rounded me-3 shadow-sm"><i class="fas fa-shield-alt"></i></div>
                            <h5 class="card-title mb-0">Bảo mật hệ thống</h5>
                        </div>
                        <p class="small text-muted mb-2"><i class="fas fa-map-marker-alt me-2"></i>Hà Nội (Hybrid)</p>
                        <p class="card-text text-secondary small">Giám sát an ninh mạng, phát hiện lỗ hổng và triển khai các giải pháp bảo mật...</p>
                        <div class="mt-3">
                            <span class="badge bg-light text-danger border me-1">Security</span>
                            <span class="badge bg-light text-danger border">Network</span>
                        </div>
                        <a href="#" class="btn btn-sm btn-primary w-100 mt-3">Xem chi tiết</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card job-card h-100 p-3 border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-secondary text-white p-2 rounded me-3 shadow-sm"><i class="fas fa-laptop-code"></i></div>
                            <h5 class="card-title mb-0">Frontend Developer</h5>
                        </div>
                        <p class="small text-muted mb-2"><i class="fas fa-map-marker-alt me-2"></i>TP. Hồ Chí Minh</p>
                        <p class="card-text text-secondary small">Phát triển giao diện web mượt mà bằng HTML, CSS và JavaScript...</p>
                        <div class="mt-3">
                            <span class="badge bg-light text-secondary border me-1">HTML/CSS</span>
                            <span class="badge bg-light text-secondary border">JS</span>
                        </div>
                        <a href="#" class="btn btn-sm btn-primary w-100 mt-3">Xem chi tiết</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* Hiệu ứng di chuột cho card việc làm */
    .job-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .job-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }
</style>

<section id="templates-section" class="py-5" style="background-color: #f8f9fa;">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-5">
            <div>
                <h2 class="fw-bold mb-2">Khám phá các mẫu CV chuyên nghiệp</h2>
                <p class="text-muted mb-0">Thiết kế chuẩn chỉnh, được tối ưu cho các hệ thống lọc hồ sơ (ATS).</p>
            </div>
            <a asp-controller="Resume" asp-action="Templates" class="btn btn-link text-decoration-none fw-bold">
                Xem tất cả mẫu <i class="fas fa-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row g-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100 template-card">
                    <div class="position-relative overflow-hidden bg-light rounded-top">
                        <img src="https://images.unsplash.com/photo-1586281380117-5a60ae2050cc?q=80&w=400" 
                             class="card-img-top p-3" alt="Modern Template">
                        <div class="template-overlay d-flex align-items-center justify-content-center">
                            <a asp-controller="Resume" asp-action="Create" asp-route-template="1" 
                               class="btn btn-primary rounded-pill px-4 shadow">Sử dụng mẫu này</a>
                        </div>
                    </div>
                    <div class="card-body text-center">
                        <span class="badge bg-info-soft text-info mb-2">Phổ biến</span>
                        <h6 class="fw-bold mb-1">Minimalist Modern</h6>
                        <p class="small text-muted mb-0">Tối giản & Tinh tế</p>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100 template-card">
                    <div class="position-relative overflow-hidden bg-light rounded-top">
                        <img src="https://cdn1.vieclam24h.vn/images/assets/img/071-blue-simple-company.jpg" 
                             class="card-img-top p-3" alt="Corporate Template">
                        <div class="template-overlay d-flex align-items-center justify-content-center">
                            <a asp-controller="Resume" asp-action="Create" asp-route-template="2" 
                               class="btn btn-primary rounded-pill px-4 shadow">Sử dụng mẫu này</a>
                        </div>
                    </div>
                    <div class="card-body text-center">
                        <span class="badge bg-success-soft text-success mb-2">Mới</span>
                        <h6 class="fw-bold mb-1">Executive Blue</h6>
                        <p class="small text-muted mb-0">Dành cho cấp quản lý</p>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100 template-card">
                    <div class="position-relative overflow-hidden bg-light rounded-top">
                        <img src="https://images.unsplash.com/photo-1512486130939-2c4f79935e4f?q=80&w=400" 
                             class="card-img-top p-3" alt="Creative Template">
                        <div class="template-overlay d-flex align-items-center justify-content-center">
                            <a asp-controller="Resume" asp-action="Create" asp-route-template="3" 
                               class="btn btn-primary rounded-pill px-4 shadow">Sử dụng mẫu này</a>
                        </div>
                    </div>
                    <div class="card-body text-center">
                        <h6 class="fw-bold mb-1">Creative Designer</h6>
                        <p class="small text-muted mb-0">Sáng tạo & Đột phá</p>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100 template-card border-primary-top">
                    <div class="position-relative overflow-hidden bg-light rounded-top">
                        <img src="https://images.unsplash.com/photo-1486312338219-ce68d2c6f44d?q=80&w=400" 
                             class="card-img-top p-3" alt="Developer Template">
                        <div class="template-overlay d-flex align-items-center justify-content-center">
                            <a asp-controller="Resume" asp-action="Create" asp-route-template="4" 
                               class="btn btn-primary rounded-pill px-4 shadow">Sử dụng mẫu này</a>
                        </div>
                    </div>
                    <div class="card-body text-center">
                        <span class="badge bg-warning-soft text-dark mb-2">Khuyên dùng</span>
                        <h6 class="fw-bold mb-1">Fullstack Developer</h6>
                        <p class="small text-muted mb-0">Tối ưu cho dân IT</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>