    @model DoAnCS.Models.HomeViewModel
    @{
        ViewData["Title"] = "Trang chủ - Hệ thống quản lý CV";
    }

    <style>
        .hero-section {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            padding: 100px 0;
        }
        .btn-create {
            padding: 12px 30px;
            font-weight: bold;
            border-radius: 50px;
            transition: 0.3s;
        }
        .job-card {
            border: none;
            transition: transform 0.3s;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
        .job-card:hover {
            transform: translateY(-5px);
        }
    </style>

    <section class="hero-section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <h1 class="display-4 fw-bold text-primary mb-3">Tạo CV giúp bạn trúng tuyển chỉ trong vài phút</h1>
                    <p class="lead text-muted mb-4">
                        Bước đầu tiên để có một công việc tốt hơn? Một bản CV chuyên nghiệp. 
                        Hãy bắt đầu ngay với các mẫu CV được thiết kế chuẩn ATS.
                    </p>
                    <div class="d-flex gap-3">
                        <a asp-controller="Resume" asp-action="Templates" class="btn btn-primary btn-create shadow">
                            <i class="fas fa-magic me-2"></i> Tạo CV mới ngay
                        </a>
                        <a href="#jobs-section" class="btn btn-outline-dark btn-create">
                            Tìm hiểu việc làm
                        </a>
                    </div>
                </div>
                <div class="col-lg-6 mt-5 mt-lg-0 text-center">
                    <img src="https://images.unsplash.com/photo-1586281380349-632531db7ed4?auto=format&fit=crop&q=80&w=800" 
                        class="img-fluid rounded-3 shadow-lg" alt="CV Illustration">
                </div>
            </div>
        </div>
    </section>


    <section id="jobs-section" class="py-5 bg-white">
        <div class="container">
            <div class="d-flex justify-content-between align-items-end mb-5">
                <div>
                    <h2 class="fw-bold mb-2">Cơ hội việc làm mới nhất</h2>
                    <p class="text-muted mb-0">Dựa trên kỹ năng và sở thích lập trình của bạn, chúng tôi đề xuất:</p>
                </div>
                <a asp-controller="Home" asp-action="Jobs" class="btn btn-outline-primary rounded-pill px-4 fw-bold">
                    Xem tất cả <i class="fas fa-arrow-right ms-2"></i>
                </a>
            </div>

            <div class="row g-4">
            @if (Model.RealJobs != null && Model.RealJobs.Any())
            {
                @foreach (var job in Model.RealJobs.Take(6))
                {
                    <div class="col-md-4">
                        <div class="card job-card h-100 p-3 border-0 shadow-sm">
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-3">
                                    <img src="@(string.IsNullOrEmpty(job.employer_logo) ? "https://via.placeholder.com/50" : job.employer_logo)" 
                                         class="employer-logo rounded me-3" alt="Logo">
                                    <div>
                                        <h6 class="card-title mb-0 fw-bold">@job.job_title</h6>
                                        <small class="text-primary">@job.employer_name</small>
                                    </div>
                                </div>
                                <p class="small text-muted mb-2">
                                    <i class="fas fa-map-marker-alt me-2"></i>@job.job_city 
                                    <span class="badge bg-light text-dark border ms-2">@job.job_employment_type</span>
                                </p>
                                <p class="card-text text-secondary small">
                                    @(job.job_description?.Length > 120 ? job.job_description.Substring(0, 120) + "..." : job.job_description)
                                </p>
                                <a asp-controller="Home" asp-action="Details" asp-route-id="@job.job_id" 
                                class="btn btn-primary w-100 rounded-pill mt-3">
                                Xem chi tiết & Ứng tuyển
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <div class="spinner-border text-primary mb-3"></div>
                    <p class="text-muted">Đang kết nối dữ liệu việc làm thực tế...</p>
                </div>
            }
        </div>
        </div>
    </section>

    <style>
        /* Hiệu ứng di chuột cho card việc làm */
        .job-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .job-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }
    </style>

    <section id="templates-section" class="py-5" style="background-color: #f8f9fa;">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-5">
            <div>
                <h2 class="fw-bold mb-2">Khám phá các mẫu CV chuyên nghiệp</h2>
                <p class="text-muted mb-0">Thiết kế chuẩn chỉnh @DateTime.Now.Year, được tối ưu cho các hệ thống lọc hồ sơ (ATS).</p>
            </div>
            <a asp-controller="Resume" asp-action="Templates" class="btn btn-link text-decoration-none fw-bold">
                Xem tất cả mẫu <i class="fas fa-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row g-4">
            @if (Model.PopularTemplates != null && Model.PopularTemplates.Any())
            {
                @foreach (var template in Model.PopularTemplates)
                {
                    <div class="col-md-3">
                        <div class="card border-0 shadow-sm h-100 template-card">
                            <div class="position-relative overflow-hidden bg-light rounded-top">
                                <img src="@template.PreviewImageUrl" class="card-img-top p-2" alt="@template.Name" 
                                     style="height: 400px; object-fit: contain; background-color: #f8f9fa;"
                                     onerror="this.src='https://images.unsplash.com/photo-1586281380117-5a60ae2050cc?q=80&w=400'">
                                
                                <div class="template-overlay">
                                    <a asp-controller="Resume" asp-action="Create" asp-route-id="@template.TemplateID" 
                                       class="btn btn-primary rounded-pill px-4 shadow fw-bold">
                                        Sử dụng mẫu này
                                    </a>
                                </div>
                            </div>
                            <div class="card-body text-center">
                                <h6 class="fw-bold mb-1">@template.Name</h6>
                                <p class="small text-muted mb-0">Mẫu thiết kế hiện đại</p>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <p class="text-muted">Hiện chưa có mẫu CV nào được kích hoạt.</p>
                </div>
            }
        </div>
    </div>
</section>


    <style>
        /* Hiệu ứng di chuột cho card việc làm */
        .job-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .job-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }
        
        /* Hiệu ứng card mẫu CV */
        .template-card { 
            position: relative; 
            transition: transform 0.3s ease; 
            border: 1px solid #eee !important;
        }
        .template-overlay {
            position: absolute; 
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.05);
            display: flex; 
            align-items: flex-end; 
            justify-content: center;
            opacity: 0;
            transition: opacity 0.3s ease;
            z-index: 2;
        }
        .template-card img {
            /* Ép toàn bộ tờ giấy A4 hiện ra, không bị cắt */
            object-fit: contain !important; 
            padding: 10px;
        }
        .template-card:hover .template-overlay { 
            opacity: 1; 
        }
        .template-card:hover { transform: translateY(-10px); box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important; }
    </style>