<!-- JOBS SECTION -->
<section id="jobs-section" class="section-padding bg-white" data-aos="fade-up">
    <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4 gap-3">
            <div>
                <h2 class="display-6 fw-bold mb-1">Cơ hội việc làm mới nhất</h2>
                <p class="text-muted mb-0">Những vị trí mơ ước đang chờ đợi bạn ứng tuyển ngay hôm nay.</p>
            </div>
            <a asp-controller="Home" asp-action="Jobs" class="btn btn-outline-primary rounded-pill px-4 fw-bold btn-lg">
                Xem tất cả cơ hội <i class="fas fa-arrow-right ms-2"></i>
            </a>
        </div>

        <div class="row g-4">
            @if (Model.LatestJobs != null && Model.LatestJobs.Any())
            {
                @foreach (var job in Model.LatestJobs)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="card h-100 p-4 hover-lift" style="border-radius: 20px;">
                            <div class="d-flex align-items-center mb-4">
                                <div class="bg-light p-2 rounded-3 me-3" style="width: 50px; height: 50px; border: 1px solid #eee;">
                                    @if (!string.IsNullOrEmpty(job.employer_logo))
                                    {
                                        <img src="@job.employer_logo" alt="Employer logo" class="w-100 h-100" style="object-fit: contain;"
                                             onerror="this.onerror=null; this.src='https://icons.getbootstrap.com/assets/icons/building.svg';">
                                    }
                                    else
                                    {
                                        <i class="fas fa-building text-muted"></i>
                                    }
                                </div>
                                <div class="overflow-hidden">
                                    <h6 class="fw-bold mb-1 text-truncate">@job.job_title</h6>
                                    <p class="text-primary small mb-0 fw-semibold text-truncate">@job.employer_name</p>
                                </div>
                            </div>
                            <div class="d-flex gap-2 mb-3">
                                <span class="badge bg-danger-soft text-danger rounded-pill px-3 py-2" style="background-color: rgba(220, 53, 69, 0.1);">
                                    <i class="fas fa-map-marker-alt me-1"></i> @(job.job_city ?? "Toàn quốc")
                                </span>
                                <span class="badge bg-success-soft text-success rounded-pill px-3 py-2" style="background-color: rgba(25, 135, 84, 0.1);">
                                    <i class="fas fa-money-bill-wave me-1"></i> Thương lượng
                                </span>
                            </div>
                            <p class="text-muted small mb-4 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @job.job_description
                            </p>
                            <a asp-controller="Home" asp-action="Details" asp-route-id="@job.job_id" class="btn btn-primary w-100 rounded-pill py-2 fw-bold">
                                Chi tiết & Ứng tuyển
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <p class="text-muted">Đang cập nhật các tin tuyển dụng mới...</p>
                </div>
            }
        </div>
    </div>
</section>

<!-- TEMPLATES SECTION -->
<section id="templates-section" class="section-padding bg-mesh" data-aos="fade-up" style="overflow: hidden;">
    <div class="container">
        <!-- Section Header Premium -->
        <div class="text-center mb-2">
            <span class="badge rounded-pill fw-bold px-3 py-2 mb-3 d-inline-flex align-items-center gap-2" style="background: linear-gradient(135deg, rgba(13,110,253,0.12), rgba(102,16,242,0.12)); color: #0d6efd; font-size: 0.8rem; letter-spacing: 0.5px;">
                <i class="fas fa-layer-group"></i> KHO MẪU CV CHÍNH HÃNG
            </span>
            <h2 class="display-6 fw-bold mb-2">Kho mẫu CV chuẩn chỉnh <span class="text-gradient">ATS</span></h2>
            <p class="text-muted mx-auto" style="max-width: 520px;">Mẫu CV được thiết kế bởi các chuyên gia nhân sự hàng đầu &mdash; được tối ưu để lọt qua mọi hệ thống ATS hiện đại.</p>
            @if (Model.VueTemplates != null && Model.VueTemplates.Any())
            {
                var totalCount = Model.VueTemplates.Count();
                var roundedCount = (totalCount / 10) * 10; // Làm tròn xuống hàng chục: 32 → 30
                <div class="mt-3 d-inline-flex align-items-center gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-black" style="font-size: 2.8rem; line-height: 1; background: linear-gradient(135deg, #0d6efd, #6610f2); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">@roundedCount+</span>
                        <span class="fw-bold text-muted" style="font-size: 1rem; line-height: 1.2;">mẫu CV<br>độc quyền</span>
                    </div>
                    <div class="vr" style="height: 30px; opacity: 0.2;"></div>
                    <div class="d-flex align-items-center gap-2 text-muted small fw-semibold">
                        <span class="d-inline-block rounded-circle" style="width:8px;height:8px;background:#22c55e;box-shadow:0 0 0 3px rgba(34,197,94,0.2);flex-shrink:0;"></span>
                        Cập nhật liên tục
                    </div>
                </div>
            }
        </div>
        
        <!-- Marquee Track -->
        <div class="cv-marquee-container">
            <div class="cv-marquee-wrapper">
                @if (Model.VueTemplates != null && Model.VueTemplates.Any())
                {
                    var popularIndices = new HashSet<int> { 0, 1, 2 };
                    int idx = 0;
                    @* Render lần 1 *@
                    foreach (var template in Model.VueTemplates)
                    {
                        bool isPopular = popularIndices.Contains(idx);
                        <div class="cv-marquee-item">
                            <div class="card border-0 h-100 template-card">
                                <div class="card-img-wrapper">
                                    <img src="@template.ThumbnailUrl" alt="@template.TemplateName"
                                         loading="lazy"
                                         onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1586281380117-5a60ae2050cc?q=80&w=400'">
                                    @if (isPopular)
                                    {
                                        <span class="template-badge"><i class="fas fa-fire me-1"></i>Phổ biến</span>
                                    }
                                    <div class="template-overlay">
                                        <a asp-controller="Resume" asp-action="CreateVue" asp-route-id="@template.Id" class="btn-use">
                                            <i class="fas fa-magic me-1"></i> Dùng mẫu này
                                        </a>
                                    </div>
                                </div>
                                <div class="card-footer-custom">
                                    <h6>@template.TemplateName</h6>
                                    <a asp-controller="Resume" asp-action="CreateVue" asp-route-id="@template.Id" class="preview-icon" title="Xem trước">
                                        <i class="fas fa-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        idx++;
                    }

                    idx = 0;
                    @* Render lần 2 (để tạo vòng lặp vô hạn) *@
                    foreach (var template in Model.VueTemplates)
                    {
                        bool isPopular = popularIndices.Contains(idx);
                        <div class="cv-marquee-item">
                            <div class="card border-0 h-100 template-card">
                                <div class="card-img-wrapper">
                                    <img src="@template.ThumbnailUrl" alt="@template.TemplateName"
                                         loading="lazy"
                                         onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1586281380117-5a60ae2050cc?q=80&w=400'">
                                    @if (isPopular)
                                    {
                                        <span class="template-badge"><i class="fas fa-fire me-1"></i>Phổ biến</span>
                                    }
                                    <div class="template-overlay">
                                        <a asp-controller="Resume" asp-action="CreateVue" asp-route-id="@template.Id" class="btn-use">
                                            <i class="fas fa-magic me-1"></i> Dùng mẫu này
                                        </a>
                                    </div>
                                </div>
                                <div class="card-footer-custom">
                                    <h6>@template.TemplateName</h6>
                                    <a asp-controller="Resume" asp-action="CreateVue" asp-route-id="@template.Id" class="preview-icon" title="Xem trước">
                                        <i class="fas fa-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        idx++;
                    }
                }
                else
                {
                    <div class="w-100 text-center py-5">
                        <p class="text-muted">Đang cập nhật các mẫu VueCV mới nhất...</p>
                    </div>
                }
            </div>
        </div>

        <!-- CTA Button -->
        <div class="text-center mt-4">
            <a asp-controller="Resume" asp-action="VueTemplates" class="btn-cv-explore">
                Khám phá toàn bộ kho mẫu CV
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    </div>
</section>

@if (Model.PartnerCompanies != null && Model.PartnerCompanies.Any())
{
    <!-- PARTNERS SECTION -->
    <section class="partners-section" data-aos="fade-up">
