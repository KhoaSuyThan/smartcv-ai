    @model DoAnCS.Models.HomeViewModel
    @{
        ViewData["Title"] = "Trang chủ - Hệ thống quản lý CV";
    }
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <style>
        .hero-section {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            padding: 100px 0;
        }
        .btn-create {
            padding: 12px 30px;
            font-weight: bold;
            border-radius: 50px;
            transition: 0.3s;
        }
        .job-card {
            border: none;
            transition: transform 0.3s;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
        .job-card:hover {
            transform: translateY(-5px);
        }
        /* Style cho khung chứa logo việc làm */
        .job-logo-box {
            width: 55px;
            height: 55px;
            background-color: #f0f7ff; /* Màu xanh nhạt cực nhẹ */
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #e2e8f0;
            transition: all 0.3s ease;
        }

        /* Hiệu ứng nhịp tim nhẹ cho các tin mới */
        .animate-pulse {
            animation: pulse-blue 2s infinite;
        }

        @@keyframes pulse-blue {
            0% { box-shadow: 0 0 0 0 rgba(13, 110, 253, 0.4); }
            70% { box-shadow: 0 0 0 10px rgba(13, 110, 253, 0); }
            100% { box-shadow: 0 0 0 0 rgba(13, 110, 253, 0); }
        }
    </style>

    <section class="hero-section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <h1 class="display-4 fw-bold text-primary mb-3">Tạo CV giúp bạn trúng tuyển chỉ trong vài phút</h1>
                    <p class="lead text-muted mb-4">
                        Bước đầu tiên để có một công việc tốt hơn? Một bản CV chuyên nghiệp. 
                        Hãy bắt đầu ngay với các mẫu CV được thiết kế chuẩn ATS.
                    </p>
                    <div class="d-flex gap-3">
                        <a asp-controller="Resume" asp-action="Templates" class="btn btn-primary btn-create shadow">
                            <i class="fas fa-magic me-2"></i> Tạo CV mới ngay
                        </a>
                        <a href="#jobs-section" class="btn btn-outline-dark btn-create">
                            Tìm hiểu việc làm
                        </a>
                    </div>
                </div>
                <div class="col-lg-6 mt-5 mt-lg-0 text-center">
                    <img src="https://images.unsplash.com/photo-1586281380349-632531db7ed4?auto=format&fit=crop&q=80&w=800" 
                        class="img-fluid rounded-3 shadow-lg" alt="CV Illustration">
                </div>
            </div>
        </div>
    </section>


    <section id="jobs-section" class="py-5 bg-white">
        <div class="container">
            <div class="d-flex justify-content-between align-items-end mb-5">
                <div>
                    <h2 class="fw-bold mb-2">Cơ hội việc làm mới nhất</h2>
                    <p class="text-muted mb-0">Dựa trên kỹ năng và sở thích lập trình của bạn, chúng tôi đề xuất:</p>
                </div>
                <a asp-controller="Home" asp-action="Jobs" class="btn btn-outline-primary rounded-pill px-4 fw-bold">
                    Xem tất cả <i class="fas fa-arrow-right ms-2"></i>
                </a>
            </div>

            <div class="row g-4">
                @if (Model.LatestJobs != null && Model.LatestJobs.Any())
                {
                    @foreach (var job in Model.LatestJobs)
                    {
                        <div class="col-md-4">
                            <div class="card h-100 border-0 shadow-sm p-3 job-card" style="border-radius: 15px;">
                                <div class="d-flex align-items-start mb-3">
                                    @* 1. KHUNG LOGO: Nền xanh nhạt, bo góc, xử lý lỗi ảnh *@
                                    <div class="me-3 d-flex align-items-center justify-content-center shadow-sm" 
                                        style="width: 55px; height: 55px; background-color: #f0f7ff; border-radius: 12px; flex-shrink: 0; border: 1px solid #e2e8f0;">
                                        
                                        @if (!string.IsNullOrEmpty(job.employer_logo))
                                        {
                                            <img src="@job.employer_logo" 
                                                alt="Logo @job.employer_name"
                                                style="width: 100%; height: 100%; object-fit: contain; border-radius: 12px; padding: 5px;"
                                                @* FIX: Nếu ảnh lỗi, gọi hàm xử lý riêng cho sạch code *@
                                                onerror="this.onerror=null; this.parentElement.innerHTML='<i class=\'bx bx-building text-muted fs-3\'></i>';">
                                        }
                                        else
                                        {
                                            <i class='bx bx-building text-muted fs-3'></i>
                                        }
                                    </div>

                                    @* 2. TIÊU ĐỀ & CÔNG TY: Có giới hạn độ dài để không vỡ khung *@
                                    <div class="overflow-hidden">
                                        <h6 class="fw-bold mb-1 text-truncate" title="@job.job_title" style="color: #2d3748;">
                                            @job.job_title
                                        </h6>
                                        <p class="text-primary small mb-0 text-truncate fw-semibold">
                                            @job.employer_name
                                        </p>
                                    </div>
                                </div>

                                @* 3. ĐỊA ĐIỂM *@
                                <p class="text-muted small mb-2 text-truncate">
                                    <i class='bx bxs-map me-1 text-danger'></i> 
                                    @(string.IsNullOrEmpty(job.job_city) ? "Toàn quốc" : job.job_city)
                                </p>

                                @* 4. MÔ TẢ: Cắt ngắn 3 dòng (Line-clamp) *@
                                <p class="text-secondary small mb-4" 
                                style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; min-height: 4.5em; line-height: 1.5; color: #718096;">
                                    @job.job_description
                                </p>

                                @* 5. NÚT BẤM DƯỚI CÙNG *@
                                <div class="mt-auto">
                                    <a asp-controller="Home" asp-action="Details" asp-route-id="@job.job_id" 
                                    class="btn btn-primary w-100 rounded-pill py-2 fw-bold shadow-sm transition-all">
                                        Xem chi tiết & Ứng tuyển
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5">
                        <div class="mb-3">
                            <i class='bx bx-search-alt text-muted' style="font-size: 4rem;"></i>
                        </div>
                        <h5 class="text-muted">Hiện chưa có cơ hội việc làm nào mới.</h5>
                        <p class="small text-secondary">Vui lòng quay lại sau hoặc đăng nhập trang Admin để nạp dữ liệu.</p>
                    </div>
                }
            </div>
        </div>
    </section>

    <style>
        /* Hiệu ứng di chuột cho card việc làm */
        .job-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .job-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }
    </style>

    <section id="templates-section" class="py-5" style="background-color: #f8f9fa;">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-5">
            <div>
                <h2 class="fw-bold mb-2">Khám phá các mẫu CV chuyên nghiệp</h2>
                <p class="text-muted mb-0">Thiết kế chuẩn chỉnh @DateTime.Now.Year, được tối ưu cho các hệ thống lọc hồ sơ (ATS).</p>
            </div>
            <a asp-controller="Resume" asp-action="Templates" class="btn btn-link text-decoration-none fw-bold">
                Xem tất cả mẫu <i class="fas fa-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row g-4">
            @if (Model.PopularTemplates != null && Model.PopularTemplates.Any())
            {
                @foreach (var template in Model.PopularTemplates)
                {
                    <div class="col-md-3">
                        <div class="card border-0 shadow-sm h-100 template-card @(template.IsProOnly ? "border-pro" : "")">
                            <div class="position-relative overflow-hidden bg-light rounded-top">
                                @if (template.IsProOnly)
                                {
                                    <div class="position-absolute top-0 end-0 m-2" style="z-index: 10;">
                                        <span class="badge bg-warning text-dark shadow-sm px-2 py-1 rounded-pill fw-bold" style="font-size: 0.6rem;">
                                            <i class="fas fa-crown me-1"></i> PRO
                                        </span>
                                    </div>
                                }
                                <img src="@template.PreviewImageUrl" class="card-img-top p-2" alt="@template.Name" 
                                     style="height: 400px; object-fit: contain; background-color: #f8f9fa;"
                                     onerror="this.src='https://images.unsplash.com/photo-1586281380117-5a60ae2050cc?q=80&w=400'">
                                
                                <div class="template-overlay">
                                    <a asp-controller="Resume" asp-action="Create" asp-route-id="@template.TemplateID" 
                                       class="btn btn-primary rounded-pill px-4 shadow fw-bold">
                                        Sử dụng mẫu này
                                    </a>
                                </div>
                            </div>
                            <div class="card-body text-center">
                                <h6 class="fw-bold mb-1">@template.Name</h6>
                                <p class="small text-muted mb-0">Mẫu thiết kế hiện đại</p>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <p class="text-muted">Hiện chưa có mẫu CV nào được kích hoạt.</p>
                </div>
            }
        </div>
    </div>
</section>


    <style>
        /* Hiệu ứng di chuột cho card việc làm */
        .job-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .job-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }
        
        /* Hiệu ứng card mẫu CV */
        .template-card { 
            position: relative; 
            transition: transform 0.3s ease; 
            border: 1px solid #eee !important;
        }
        .border-pro { border: 2px solid #ffc107 !important; }
        .template-overlay {
            position: absolute; 
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.05);
            display: flex; 
            align-items: flex-end; 
            justify-content: center;
            opacity: 0;
            transition: opacity 0.3s ease;
            z-index: 2;
        }
        .template-card img {
            /* Ép toàn bộ tờ giấy A4 hiện ra, không bị cắt */
            object-fit: contain !important; 
            padding: 10px;
        }
        .template-card:hover .template-overlay { 
            opacity: 1; 
        }
        .template-card:hover { transform: translateY(-10px); box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important; }
    </style>