@model DoAnCS.Models.HomeViewModel
@{
    ViewData["Title"] = "Kiến tạo sự nghiệp tương lai";
}

<style>
    /* TYPING CURSOR */
    .typing-text::after {
        content: "|";
        animation: blink 0.7s infinite;
    }
    @@keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
    }

    /* MOCKUP CV */
    .cv-mockup {
        position: relative;
        width: 100%;
        max-width: 450px;
        margin: 0 auto;
        transform-style: preserve-3d;
        perspective: 1000px;
    }
    .cv-mockup-inner {
        background: white;
        border-radius: 10px;
        box-shadow: 20px 20px 60px rgba(0,0,0,0.1), -10px -10px 40px rgba(255,255,255,0.8);
        padding: 20px;
        border: 1px solid #eee;
    }
    .cv-skeleton-line {
        height: 10px;
        background: #f0f0f0;
        margin-bottom: 15px;
        border-radius: 5px;
    }
    .cv-skeleton-circle {
        width: 80px;
        height: 80px;
        background: #e0e0e0;
        border-radius: 50%;
        margin-bottom: 20px;
    }

    /* STATS CARD */
    .stat-card {
        border-radius: 20px;
        padding: 30px;
        text-align: center;
        background: white;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        border: 1px solid #f0f4f8;
    }
    .stat-number {
        font-size: 2.5rem;
        font-weight: 800;
        margin-bottom: 5px;
        display: block;
    }

    /* PROCESS STEP */
    .step-number {
        width: 50px;
        height: 50px;
        background: var(--primary-gradient);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 1.2rem;
        margin: 0 auto 20px;
        box-shadow: 0 4px 15px rgba(13, 110, 253, 0.3);
    }

    /* PREMIUM BLOG CARD */
    .blog-card-premium {
        border: none;
        border-radius: 24px;
        background: #ffffff;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        cursor: pointer;
        height: 100%;
        overflow: hidden;
    }
    .blog-card-premium:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.12);
    }
    .blog-card-premium .card-img-wrapper {
        position: relative;
        overflow: hidden;
        height: 220px;
    }
    .blog-card-premium .card-img-top {
        transition: transform 0.6s ease;
        object-fit: cover;
        height: 100%;
        width: 100%;
    }
    .blog-card-premium:hover .card-img-top {
        transform: scale(1.1);
    }
    .blog-card-premium .badge-category {
        position: absolute;
        top: 20px;
        left: 20px;
        padding: 8px 16px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        z-index: 2;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }
    .blog-card-premium .card-body {
        padding: 30px;
    }
    .blog-card-premium .card-title {
        font-weight: 800;
        font-size: 1.25rem;
        margin-bottom: 15px;
        line-height: 1.4;
        color: #1a202c;
        transition: color 0.3s ease;
    }
    .blog-card-premium:hover .card-title {
        color: #0d6efd;
    }
    .blog-card-premium .card-text {
        color: #718096;
        font-size: 0.95rem;
        line-height: 1.6;
    }
    .blog-card-premium .read-more-link {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 700;
        color: #0d6efd;
        font-size: 0.9rem;
        margin-top: 20px;
    }

    /* BLOG MODAL TYPOGRAPHY */
    .blog-modal-content h4 { font-weight: 800; color: #1a202c; margin-top: 25px; margin-bottom: 15px; }
    .blog-modal-content p { color: #4a5568; line-height: 1.8; margin-bottom: 15px; text-align: justify; }
    .blog-modal-content ul { padding-left: 20px; margin-bottom: 20px; }
    .blog-modal-content li { color: #4a5568; margin-bottom: 10px; line-height: 1.6; }
    .blog-modal-header-img { width: 100%; height: 350px; object-fit: cover; border-radius: 15px; margin-bottom: 30px; }
    .reading-time { font-size: 0.85rem; color: #a0aec0; display: flex; align-items: center; gap: 5px; }

    /* INFINITE MARQUEE CV CAROUSEL - PREMIUM */
    .templates-section-wrapper {
        position: relative;
    }
    .cv-marquee-container {
        overflow: hidden;
        width: 100%;
        position: relative;
        padding: 30px 0 10px;
        mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
        -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
    }
    .cv-marquee-wrapper {
        display: flex;
        width: max-content;
        animation: marquee-scroll 150s linear infinite;
    }
    .cv-marquee-container:hover .cv-marquee-wrapper {
        animation-play-state: paused;
    }
    .cv-marquee-item {
        width: 280px;
        margin-right: 24px;
        flex-shrink: 0;
    }
    @@media (min-width: 1200px) {
        .cv-marquee-item {
            width: 240px;
            margin-right: 24px;
        }
    }
    
    @@keyframes marquee-scroll {
        0%   { transform: translate3d(0, 0, 0); }
        100% { transform: translate3d(-50%, 0, 0); }
    }

    /* TEMPLATE CARD */
    .template-card {
        border-radius: 18px !important;
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1) !important;
        cursor: pointer;
        background: #fff;
        border: 1.5px solid rgba(0,0,0,0.07) !important;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05) !important;
        overflow: hidden;
    }
    .template-card:hover {
        transform: translateY(-10px) scale(1.02);
        box-shadow: 0 24px 48px rgba(13,110,253,0.15) !important;
        border-color: rgba(13,110,253,0.35) !important;
    }
    .template-card .card-img-wrapper {
        position: relative;
        aspect-ratio: 1 / 1.4142;
        background: #f0f4ff;
        overflow: hidden;
        border-radius: 0;
    }
    .template-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top center;
        transition: transform 0.7s cubic-bezier(0.165, 0.84, 0.44, 1);
    }
    .template-card:hover img {
        transform: scale(1.06);
    }
    /* Dual-button overlay */
    .template-card .template-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(10,10,30,0.75) 0%, rgba(10,10,30,0.2) 60%, transparent 100%);
        backdrop-filter: blur(2px);
        opacity: 0;
        transition: opacity 0.35s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-end;
        padding-bottom: 22px;
        gap: 10px;
        z-index: 2;
    }
    .template-card:hover .template-overlay {
        opacity: 1;
    }
    .template-overlay .btn-use {
        background: linear-gradient(135deg, #0d6efd, #6610f2);
        color: white;
        border: none;
        border-radius: 50px;
        padding: 9px 22px;
        font-weight: 700;
        font-size: 0.82rem;
        letter-spacing: 0.3px;
        box-shadow: 0 4px 15px rgba(13,110,253,0.45);
        text-decoration: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        display: inline-block;
    }
    .template-overlay .btn-use:hover {
        transform: scale(1.05);
        box-shadow: 0 6px 20px rgba(13,110,253,0.6);
        color: white;
    }
    /* Badge phổ biến */
    .template-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        z-index: 3;
        padding: 4px 12px;
        border-radius: 50px;
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        color: white;
        background: linear-gradient(135deg, #ff6b35, #f7931e);
        box-shadow: 0 3px 10px rgba(255,107,53,0.4);
        animation: badge-pulse 2.5s ease infinite;
    }
    @@keyframes badge-pulse {
        0%, 100% { box-shadow: 0 3px 10px rgba(255,107,53,0.4); }
        50% { box-shadow: 0 3px 18px rgba(255,107,53,0.7); }
    }
    /* Card footer */
    .template-card .card-footer-custom {
        padding: 12px 15px 14px;
        background: #fff;
        border-top: 1px solid rgba(0,0,0,0.05);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .template-card .card-footer-custom h6 {
        margin: 0;
        font-weight: 700;
        font-size: 0.85rem;
        color: #1a202c;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 150px;
    }
    .template-card .card-footer-custom .preview-icon {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: rgba(13,110,253,0.1);
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        flex-shrink: 0;
        transition: all 0.2s ease;
        text-decoration: none;
    }
    .template-card:hover .card-footer-custom .preview-icon {
        background: #0d6efd;
        color: white;
    }
    /* CTA Button premium */
    .btn-cv-explore {
        background: linear-gradient(135deg, #0d6efd 0%, #6610f2 100%);
        color: white;
        border: none;
        border-radius: 50px;
        padding: 13px 40px;
        font-weight: 700;
        font-size: 1rem;
        letter-spacing: 0.3px;
        box-shadow: 0 6px 25px rgba(13,110,253,0.35);
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }
    .btn-cv-explore:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 35px rgba(13,110,253,0.5);
        color: white;
    }
    .btn-cv-explore i { transition: transform 0.3s ease; }
    .btn-cv-explore:hover i { transform: translateX(4px); }

    /* PARTNERS SECTION */
    .partners-section {
        background-color: #f8f9fa;
        padding-top: 4rem;
        padding-bottom: 4rem;
    }
    .partner-logo-item {
        background: #ffffff;
        border: 1px solid #e9ecef;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.02);
        display: flex;
        align-items: center;
        justify-content: center;
        height: 110px;
        padding: 15px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .partner-logo-item:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08);
    }
    .partner-logo-img {
        max-height: 60px;
        max-width: 160px;
        object-fit: contain;
    }

    /* AI FEATURES CSS */
    .glow-on-hover {
        transition: all 0.3s ease;
    }
    .glow-on-hover:hover {
        box-shadow: 0 0 20px rgba(13, 110, 253, 0.4) !important;
        transform: translateY(-2px);
    }
    .glow-on-hover-success {
        transition: all 0.3s ease;
    }
    .glow-on-hover-success:hover {
        box-shadow: 0 0 20px rgba(25, 135, 84, 0.4) !important;
        transform: translateY(-2px);
    }
    .ai-type-animation {
        overflow: hidden;
        animation: fadeSlideRight 1s ease forwards;
    }
    .ai-float-1 {
        animation: floatUpDown 3s ease-in-out infinite;
    }
    .ai-pulse-glow {
        animation: pulseGlow 2s infinite;
    }
    .scanner-beam {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 3px;
        background: linear-gradient(90deg, transparent, #20c997, transparent);
        box-shadow: 0 0 10px #20c997;
        z-index: 5;
        animation: scanBeam 3s linear infinite;
        opacity: 0.7;
    }
    @@keyframes fadeSlideRight {
        from { opacity: 0; transform: translateX(-15px); }
        to { opacity: 1; transform: translateX(0); }
    }
    @@keyframes floatUpDown {
        0% { transform: translateY(0); }
        50% { transform: translateY(-8px); }
        100% { transform: translateY(0); }
    }
    @@keyframes pulseGlow {
        0% { box-shadow: 0 0 0 0 rgba(25, 135, 84, 0.4); }
        70% { box-shadow: 0 0 0 15px rgba(25, 135, 84, 0); }
        100% { box-shadow: 0 0 0 0 rgba(25, 135, 84, 0); }
    }
    @@keyframes scanBeam {
        0% { top: 5%; opacity: 0; }
        15% { opacity: 1; }
        85% { opacity: 1; }
        100% { top: 95%; opacity: 0; }
    }
</style>

<!-- HERO SECTION -->
<section class="section-padding bg-mesh" style="overflow: hidden;">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6" data-aos="fade-right">
                <span class="badge bg-primary-soft text-primary px-3 py-2 rounded-pill fw-bold mb-3 shadow-sm" style="background-color: rgba(13, 110, 253, 0.1);">
                    <i class="fas fa-sparkles me-2"></i>Ứng dụng AI vào sự nghiệp của bạn
                </span>
                <h1 class="display-3 fw-bold mb-4" style="line-height: 1.1; color: #1a202c;">
                    Tạo CV chuyên nghiệp <br>
                    <span class="text-gradient typing-text" id="typing-target"></span>
                </h1>
                <p class="lead text-muted mb-5 pe-lg-5" style="font-size: 1.15rem;">
                    Nâng tầm hồ sơ của bạn với sự hỗ trợ từ trí tuệ nhân tạo. 
                    Chúng tôi giúp bạn vượt qua các hệ thống lọc hồ sơ (ATS) và gây ấn tượng mạnh với nhà tuyển dụng ngay từ cái nhìn đầu tiên.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Resume" asp-action="VueTemplates" class="btn btn-premium btn-lg">
                        <i class="fas fa-magic me-2"></i> Bắt đầu ngay miễn phí
                    </a>
                    <a href="#jobs-section" class="btn btn-outline-dark btn-lg rounded-pill px-4 fw-bold shadow-sm" style="border-width: 2px;">
                         Khám phá việc làm
                    </a>
                </div>
                <div class="mt-5 d-flex align-items-center gap-4 text-muted small">
                    <div><i class="fas fa-check-circle text-success me-2"></i>Không cần thiết kế</div>
                    <div><i class="fas fa-check-circle text-success me-2"></i>Tải xuống PDF tùy ý</div>
                    <div><i class="fas fa-check-circle text-success me-2"></i>Gợi ý nội dung AI</div>
                </div>
            </div>
            <div class="col-lg-6 mt-5 mt-lg-0" data-aos="zoom-in" data-aos-delay="200">
                <div class="cv-mockup floating">
                    <div class="cv-mockup-inner p-4">
                        <div class="d-flex gap-4 align-items-start mb-4">
                            <div class="cv-skeleton-circle"></div>
                            <div class="flex-grow-1">
                                <div class="cv-skeleton-line" style="width: 80%; height: 20px; background: #0d6efd; opacity: 0.2;"></div>
                                <div class="cv-skeleton-line" style="width: 50%;"></div>
                            </div>
                        </div>
                        <div class="cv-skeleton-line"></div>
                        <div class="cv-skeleton-line"></div>
                        <div class="cv-skeleton-line" style="width: 90%;"></div>
                        <div class="cv-skeleton-line" style="width: 40%; margin-top: 30px;"></div>
                        <div class="cv-skeleton-line"></div>
                        <div class="cv-skeleton-line"></div>
                        <div class="cv-skeleton-line" style="width: 70%;"></div>
                    </div>
                    <!-- Decorative elements -->
                    <div class="position-absolute glass-card p-3 rounded-3 shadow-lg" style="top: -20px; right: -30px; width: 140px;" data-aos="fade-left" data-aos-delay="500">
                        <div class="text-primary fw-bold small"><i class="fas fa-chart-line me-2"></i>ATS Score</div>
                        <div class="h4 fw-bold m-0 text-success">98%</div>
                    </div>
                    <div class="position-absolute glass-card p-3 rounded-3 shadow-lg" style="bottom: 40px; left: -40px; width: 180px;" data-aos="fade-right" data-aos-delay="700">
                        <div class="text-primary fw-bold small"><i class="fas fa-robot me-2"></i>AI Suggested</div>
                        <div class="small m-0 text-muted">"Kỹ năng lãnh đạo"</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- STATS SECTION -->
<section class="py-4 bg-white border-bottom">
    <div class="container">
        <div class="row g-4 justify-content-center">
            <div class="col-md-3" data-aos="fade-up">
                <div class="stat-card">
                    <span class="stat-number text-primary">1000+</span>
                    <span class="text-muted fw-bold">CV đã được tạo</span>
                </div>
            </div>
            <div class="col-md-3" data-aos="fade-up" data-aos-delay="100">
                <div class="stat-card">
                    <span class="stat-number text-success">500+</span>
                    <span class="text-muted fw-bold">Người đã tìm thấy việc</span>
                </div>
            </div>
            <div class="col-md-3" data-aos="fade-up" data-aos-delay="200">
                <div class="stat-card">
                    <span class="stat-number text-info">100+</span>
                    <span class="text-muted fw-bold">Mẫu CV độc quyền</span>
                </div>
            </div>
            <div class="col-md-3" data-aos="fade-up" data-aos-delay="300">
                <div class="stat-card">
                    <span class="stat-number text-warning">4.9/5</span>
                    <span class="text-muted fw-bold">Đánh giá hài lòng</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- AI PROMOTION SECTION -->
<section id="ai-features" class="section-padding bg-white position-relative overflow-hidden">
    <!-- Background element -->
    <div class="position-absolute" style="top: -100px; left: -100px; width: 500px; height: 500px; background: radial-gradient(circle, rgba(102,16,242,0.05) 0%, rgba(255,255,255,0) 70%); z-index: 0;"></div>
    
    <div class="container position-relative" style="z-index: 1;">
        <!-- Feature 1: AI CV Builder -->
        <div class="row align-items-center" style="margin-bottom: 7rem;">
            <div class="col-lg-6 mb-5 mb-lg-0 pe-lg-5" data-aos="fade-right">
                <span class="badge rounded-pill fw-bold px-3 py-2 mb-3 d-inline-flex align-items-center gap-2" style="background: linear-gradient(135deg, rgba(13,110,253,0.1), rgba(102,16,242,0.1)); color: #6610f2;">
                    <i class="fas fa-wand-magic-sparkles"></i> TÍNH NĂNG ĐỘC QUYỀN
                </span>
                <h2 class="display-5 fw-bold mb-4">Tối ưu hóa CV tự động với <span style="background: linear-gradient(135deg, #0d6efd, #6610f2); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">Trí Tuệ Nhân Tạo</span></h2>
                <p class="text-muted fs-5 mb-4">Trợ lý AI thông minh của CVBuilder Pro sẽ phân tích, gợi ý và viết lại kinh nghiệm làm việc của bạn chuẩn xác đến từng từ ngữ, tối ưu hóa điểm chạm với nhà tuyển dụng.</p>
                <ul class="list-unstyled mb-4">
                    <li class="mb-3"><i class="fas fa-check-circle text-primary me-2"></i> Gợi ý câu từ chuyên nghiệp theo ngành nghề mục tiêu</li>
                    <li class="mb-3"><i class="fas fa-check-circle text-primary me-2"></i> Tự động phân tích và sửa lỗi chính tả, ngữ pháp</li>
                    <li class="mb-3"><i class="fas fa-check-circle text-primary me-2"></i> Khám phá bộ từ khóa chuẩn mực giúp lọt qua các bộ lọc ATS</li>
                </ul>
                <a asp-controller="Resume" asp-action="VueTemplates" class="btn btn-primary btn-lg rounded-pill px-4 fw-bold shadow-sm glow-on-hover">Trải nghiệm tạo CV AI <i class="fas fa-arrow-right ms-2"></i></a>
            </div>
            <div class="col-lg-6" data-aos="fade-left">
                <!-- CSS Mockup for AI Builder -->
                <div class="ai-mockup-box rounded-4 p-4 shadow-lg position-relative bg-white border" style="border-width: 2px !important;">
                    <div class="d-flex align-items-center mb-4 border-bottom pb-3">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px;">
                            <i class="fas fa-robot fs-5"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-0">Gemini AI Assistant</h6>
                            <small class="text-muted">Đang viết lại kinh nghiệm làm việc...</small>
                        </div>
                    </div>
                    <div class="typing-container p-2">
                        <div class="text-muted small mb-3 position-relative"><del class="opacity-50">Làm việc nhóm tốt và hoàn thành dự án đúng hạn.</del>
                           <span class="badge bg-danger position-absolute" style="top: -10px; right: 0; font-size: 0.6rem;">Cần cải thiện</span>
                        </div>
                        <div class="text-dark fw-semibold small bg-light p-3 rounded-3 border-start border-primary border-4 ai-type-animation shadow-sm lh-lg">
                            "Đóng vai trò chủ chốt trong việc phối hợp liên phòng ban, dẫn dắt đội ngũ 5 thành viên hoàn thành dự án trước thời hạn 2 tuần, vượt 15% KPI đề ra."
                        </div>
                    </div>
                    <!-- Floating element -->
                    <div class="position-absolute bg-white rounded-pill px-3 py-2 shadow-lg border ai-float-1" style="bottom: -20px; right: -10px;">
