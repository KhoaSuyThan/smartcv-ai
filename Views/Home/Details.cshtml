@model DoAnCS.Models.JobDto

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm p-4" style="border-radius: 20px;">
                <div class="d-flex align-items-center mb-4">
                    <img src="@Model.employer_logo" class="me-3" style="width: 80px; border-radius: 12px; border: 1px solid #eee;">
                    <div>
                        <h2 class="fw-bold mb-1">@Model.job_title</h2>
                        <p class="text-primary mb-0">@Model.employer_name • @Model.job_city</p>
                    </div>
                </div>

                <hr class="text-muted opacity-25">

                <h5 class="fw-bold mb-3">Mô tả công việc</h5>
                <div class="job-description text-secondary" style="line-height: 1.8;">
                    @Model.job_description
                </div>

                <div class="mt-5 d-flex gap-3 flex-wrap">
                    @if (!string.IsNullOrEmpty(Model.job_apply_link) && Model.job_apply_link != "#")
                    {
                        <a href="@Model.job_apply_link" target="_blank" class="btn btn-outline-primary btn-lg rounded-pill fw-bold flex-grow-1" style="flex-basis: 30%;">
                            <i class="fas fa-external-link-alt me-2"></i>Website Công ty
                        </a>
                    }

                    @if (User.Identity.IsAuthenticated && User.IsInRole("User"))
                    {
                        <button type="button" class="btn btn-primary btn-lg rounded-pill fw-bold flex-grow-1 shadow-sm" style="flex-basis: 60%;" data-bs-toggle="modal" data-bs-target="#applyModal">
                            Ứng tuyển nhanh 1-Click <i class="fas fa-paper-plane ms-2"></i>
                        </button>
                    }
                    else if (!User.Identity.IsAuthenticated)
                    {
                        <a href="/Account/Login?returnUrl=/Home/Details/@Model.job_id" class="btn btn-primary btn-lg rounded-pill fw-bold flex-grow-1 shadow-sm" style="flex-basis: 60%;">
                            Đăng nhập để Ứng tuyển <i class="fas fa-sign-in-alt ms-2"></i>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Ứng tuyển Nhanh -->
<div class="modal fade" id="applyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg overflow-hidden" style="border-radius: 16px;">
            <!-- Modal Header: Blue background with Icon -->
            <div class="modal-header bg-primary text-white border-bottom-0 py-3">
                <h5 class="modal-title fw-bold d-flex align-items-center">
                    <i class="fas fa-paper-plane me-2"></i> Xác nhận ứng tuyển
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4 bg-light bg-opacity-10">
                <!-- Job Selection Card (Read only) -->
                <div class="mb-4">
                    <label class="form-label small fw-bold text-secondary text-uppercase mb-2">Vị trí ứng tuyển</label>
                    <div class="card border-0 shadow-sm p-3 bg-white" style="border-radius: 12px;">
                        <div class="d-flex align-items-center">
                            <div class="bg-primary bg-opacity-10 text-primary p-3 me-3" style="border-radius: 10px;">
                                <i class="fas fa-briefcase fa-lg"></i>
                            </div>
                            <div class="overflow-hidden">
                                <h6 class="fw-bold mb-0 text-truncate text-dark">@Model.job_title</h6>
                                <p class="small text-muted mb-0 text-truncate">@Model.employer_name</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- CV Selection -->
                <div class="mb-3">
                    <div class="d-flex align-items-center mb-2">
                        <i class="fas fa-file-pdf text-danger me-2"></i>
                        <label class="form-label small fw-bold text-secondary text-uppercase mb-0">Chọn CV gửi nhà tuyển dụng</label>
                    </div>
                    
                    <form id="applyForm">
                        <input type="hidden" id="jobIdInput" value="@Model.job_id" />
                        
                        @if (ViewBag.UserResumes != null)
                        {
                            var cvs = (List<DoAnCS.Models.Resume>)ViewBag.UserResumes;
                            if (cvs.Any())
                            {
                                <div class="cv-list-container" style="max-height: 300px; overflow-y: auto;">
                                    @foreach (var cv in cvs)
                                    {
                                        var isPdf = !string.IsNullOrEmpty(cv.FileUploadUrl);
                                        <div class="cv-item-wrapper mb-2">
                                            <label class="cv-card cursor-pointer w-100 mb-0">
                                                <input class="form-check-input d-none" type="radio" name="selectedResumeId" value="@cv.ResumeID" required>
                                                <div class="card border p-3 cv-card-inner transition-all" style="border-radius: 12px;">
                                                    <div class="d-flex align-items-center">
                                                        <div class="custom-radio me-3">
                                                            <div class="radio-dot"></div>
                                                        </div>
                                                        <div class="flex-grow-1 overflow-hidden">
                                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                                <h6 class="fw-bold mb-0 text-dark text-truncate">@(cv.Title ?? "CV Chưa đặt tên")</h6>
                                                                @if (isPdf)
                                                                {
                                                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 py-1" style="font-size: 10px;">PDF</span>
                                                                }
                                                            </div>
                                                            <p class="small text-muted mb-0">Cập nhật: @cv.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </label>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning rounded-3 border-0 py-3 shadow-sm">
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-exclamation-triangle fa-lg me-3"></i>
                                        <div>
                                            <p class="mb-0 fw-bold">Bạn chưa có CV nào.</p>
                                            <a href="/Resume/Templates" class="alert-link small">Tạo CV mới ngay để ứng tuyển!</a>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </form>
                </div>
            </div>
            
            <!-- Modal Footer -->
            <div class="modal-footer border-top-0 bg-white p-3 d-flex gap-2">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4 flex-grow-1 fw-bold border-2" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary rounded-pill px-4 flex-grow-1 fw-bold shadow-sm d-flex align-items-center justify-content-center" id="btnSubmitApply">
                    <i class="fas fa-paper-plane me-2"></i> Ứng tuyển
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const applyForm = document.getElementById('applyForm');
        
        // Xử lý hiệu ứng chọn CV Card
        const cvWrappers = document.querySelectorAll('.cv-item-wrapper');
        cvWrappers.forEach(wrapper => {
            const radio = wrapper.querySelector('input[name="selectedResumeId"]');
            const innerCard = wrapper.querySelector('.cv-card-inner');
            
            wrapper.addEventListener('click', () => {
                // Reset all
                cvWrappers.forEach(w => w.querySelector('.cv-card-inner').classList.remove('border-primary', 'bg-primary', 'bg-opacity-10', 'selected'));
                
                // Set selected
                radio.checked = true;
                innerCard.classList.add('border-primary', 'selected');
            });

            // Chọn cái đầu tiên mặc định nếu có
            if (radio && radio.checked) {
                innerCard.classList.add('border-primary', 'selected');
            }
        });

        // Submit form
        const btnSubmit = document.getElementById('btnSubmitApply');
        if (btnSubmit) {
            btnSubmit.addEventListener('click', async function () {
                const selectedCv = applyForm.querySelector('input[name="selectedResumeId"]:checked');
                
                if (!selectedCv) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Thông báo',
                        text: 'Vui lòng chọn 1 CV để ứng tuyển!'
                    });
                    return;
                }

                btnSubmit.disabled = true;
                const originalHtml = btnSubmit.innerHTML;
                btnSubmit.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang xử lý...';

                try {
                    const response = await fetch('/Jobs/ApplyOneClick', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            JobId: parseInt(document.getElementById('jobIdInput').value),
                            ResumeId: parseInt(selectedCv.value)
                        })
                    });

                    const result = await response.json();
                    
                    if (result.success) {
                        // Nếu trang chủ có dùng SweetAlert2 thì dùng, không thì alert
                        if (typeof Swal !== 'undefined') {
                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công!',
                                text: result.message || 'Ứng tuyển thành công!',
                                timer: 2000,
                                showConfirmButton: false
                            }).then(() => {
                                location.href = '/Account/Applications';
                            });
                        } else {
                            alert(result.message || 'Ứng tuyển thành công!');
                            location.href = '/Account/Applications';
                        }
                    } else {
                        if (typeof Swal !== 'undefined') {
                            Swal.fire('Lỗi', result.message || 'Có lỗi xảy ra', 'error');
                        } else {
                            alert(result.message || 'Có lỗi xảy ra');
                        }
                    }
                } catch (error) {
                    alert('Lỗi kết nối máy chủ.');
                } finally {
                    btnSubmit.disabled = false;
                    btnSubmit.innerHTML = originalHtml;
                }
            });
        }
    });
</script>

<style>
    .cursor-pointer { cursor: pointer; }
    .transition-all { transition: all 0.2s ease-in-out; }
    
    .cv-card-inner:hover {
        border-color: #0d6efd !important;
        background-color: rgba(13, 110, 253, 0.05);
    }
    
    .cv-card-inner.selected {
        border-color: #0d6efd !important;
        border-width: 2px !important;
        background-color: rgba(13, 110, 253, 0.05);
    }
    
    /* Custom Radio Styling */
    .custom-radio {
        width: 20px;
        height: 20px;
        border: 2px solid #ccc;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
    }
    
    .cv-card-inner.selected .custom-radio {
        border-color: #0d6efd;
    }
    
    .radio-dot {
        width: 10px;
        height: 10px;
        background-color: #0d6efd;
        border-radius: 50%;
        opacity: 0;
        transform: scale(0.5);
        transition: all 0.2s;
    }
    
    .cv-card-inner.selected .radio-dot {
        opacity: 1;
        transform: scale(1);
    }

    .cv-list-container::-webkit-scrollbar {
        width: 6px;
    }
    .cv-list-container::-webkit-scrollbar-thumb {
        background: #ddd;
        border-radius: 10px;
    }
    .cv-list-container::-webkit-scrollbar-track {
        background: transparent;
    }
</style>
</div>