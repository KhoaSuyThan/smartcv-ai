@model DoAnCS.Models.ViewModels.AdminDashboardVM
@{
    ViewData["Title"] = "Quản lý Vue CV";
}
@Html.AntiForgeryToken()

<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

<div class="admin-template-page py-4" style="background-color: #f8fbff; min-height: 100vh;">
    <div class="container-fluid px-5">
        
        @* Header Section *@
        <div class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <h3 class="fw-bold text-dark m-0">
                    <i class='bx bxs-layout text-primary me-2'></i>Quản lý mẫu Vue CV
                </h3>
                <p class="text-muted small mb-0">Các mẫu CV được xây dựng trên nền tảng Vue.js</p>
            </div>
            <div class="d-flex gap-2">
                <a href="/Admin" class="btn btn-white border shadow-sm rounded-pill px-4 fw-bold text-secondary">
                    <i class='bx bx-left-arrow-alt'></i> Quay về Dashboard
                </a>
                <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold" data-bs-toggle="modal" data-bs-target="#createVueModal">
                    <i class='bx bx-plus-circle'></i> Thêm mẫu mới
                </button>
            </div>
        </div>

        @* Thông báo *@
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
                <i class='bx bxs-check-circle me-2'></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
                <i class='bx bxs-error-circle me-2'></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @* Grid hiển thị *@
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
            @foreach (var item in Model.VueTemplates)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm template-card rounded-4 overflow-hidden mx-auto" style="max-width: 80%; background-color: #ffffff !important;">
                        <div class="cv-preview-box position-relative" id="preview-box-@item.Id">
                            <img src="@(string.IsNullOrEmpty(item.ThumbnailUrl) ? "https://via.placeholder.com/210x297?text=Vue+CV" : item.ThumbnailUrl)" 
                                 class="card-img-top" alt="@item.TemplateName" 
                                 onerror="this.src='https://via.placeholder.com/210x297?text=Vue+CV';">
                            
                            <div class="status-overlay" id="overlay-@item.Id" style="display: @(item.IsActive ? "none" : "flex");">
                                <span class="badge bg-danger rounded-pill px-4 py-2 border border-2 border-white shadow-lg fs-6" style="letter-spacing: 1px;">TẠM ẨN</span>
                            </div>

                            @if (item.IsPremium)
                            {
                                <div class="position-absolute top-0 end-0 m-2" style="z-index: 11;">
                                    <span class="badge bg-warning text-dark border border-white shadow px-2 py-1 rounded-pill fw-bold" style="font-size: 0.65rem;">
                                         <i class='bx bxs-crown me-1'></i> PRO
                                    </span>
                                </div>
                            }
                        </div>
                        
                        <div class="card-body p-3">
                            <h6 class="fw-bold text-dark text-truncate mb-2" style="font-size: 0.9rem;">@item.TemplateName</h6>
                            <p class="text-muted small mb-2">@(item.Category ?? "N/A")</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge bg-light text-muted border px-2 py-1" style="font-size: 0.65rem;">ID: #@item.Id</span>
                                
                                <div class="d-flex gap-1 align-items-center">
                                    @* Nút Sửa *@
                                    <button type="button" class="btn btn-sm text-warning p-1 btn-edit-vue" title="Chỉnh sửa" data-id="@item.Id" data-name="@item.TemplateName" data-component="@item.ComponentName" data-categories="@item.Category" data-thumbnail="@item.ThumbnailUrl" data-active="@item.IsActive.ToString().ToLower()" data-premium="@item.IsPremium.ToString().ToLower()">
                                        <i class='bx bxs-edit-alt fs-4'></i>
                                    </button>

                                    @* Nút Xóa *@
                                    <form asp-action="DeleteVueTemplate" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa mẫu này?')" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm text-danger p-1" title="Xóa mẫu">
                                            <i class='bx bxs-trash fs-4'></i>
                                        </button>
                                    </form>

                                    @* Switch bật/tắt *@
                                    <div class="form-check form-switch ms-1">
                                        <input class="form-check-input cursor-pointer" type="checkbox" 
                                            @(item.IsActive ? "checked" : "") 
                                            onchange="toggleVueStatus(@item.Id, this)">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Phân trang *@
        @if (Model.TotalPages > 1)
        {
            <nav class="mt-5">
                <ul class="pagination justify-content-center custom-pagination">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link shadow-sm" href="?page=@(Model.CurrentPage - 1)"><i class='bx bx-chevron-left'></i></a>
                    </li>
                    @{
                        int startPage = Math.Max(1, Model.CurrentPage - 2);
                        int endPage = Math.Min(Model.TotalPages, startPage + 4);
                        if (endPage - startPage < 4)
                        {
                            startPage = Math.Max(1, endPage - 4);
                        }
                    }

                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link shadow-sm" href="?page=@i">@i</a>
                        </li>
                    }

                    @if (endPage < Model.TotalPages)
                    {
                        if (endPage < Model.TotalPages - 1)
                        {
                            <li class="page-item disabled">
                                <span class="page-link shadow-sm border-0 bg-transparent text-muted fw-bold">...</span>
                            </li>
                        }
                        <li class="page-item">
                            <a class="page-link shadow-sm" href="?page=@Model.TotalPages">@Model.TotalPages</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link shadow-sm" href="?page=@(Model.CurrentPage + 1)"><i class='bx bx-chevron-right'></i></a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>

@* Modal Thêm mẫu mới *@
<div class="modal fade" id="createVueModal" tabindex="-1" aria-labelledby="createVueModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title fw-bold" id="createVueModalLabel">
                    <i class='bx bx-plus-circle me-2'></i>Thêm mẫu Vue CV mới
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="CreateVueCV" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row g-4">
                        <div class="col-md-7">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Tên mẫu CV</label>
                                <input name="TemplateName" class="form-control border-2" placeholder="Ví dụ: Modern Blue" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Tên Component (Vue)</label>
                                <input name="ComponentName" class="form-control border-2" placeholder="Ví dụ: ModernBlue" required />
                                <small class="text-muted">Phải khớp với tên file .vue trong thư mục templates</small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Ngành nghề / Danh mục</label>
                                <div class="d-flex flex-wrap gap-2 mt-1">
                                    @foreach (var cat in new[] { "IT", "Kinh doanh", "Marketing", "Tài chính", "Sáng tạo", "Y tế", "Thực tập", "Chuyên nghiệp", "Khác" })
                                    {
                                        <div class="form-check me-2">
                                            <input class="form-check-input" type="checkbox" name="selectedCategories" value="@cat" id="cat_@cat">
                                            <label class="form-check-label small" for="cat_@cat">@cat</label>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">URL Ảnh xem trước</label>
                                <input name="ThumbnailUrl" id="createPreviewUrl" class="form-control border-2" placeholder="Nhập URL hoặc chọn file bên dưới..." />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-primary">Hoặc tải lên ảnh</label>
                                <input type="file" name="uploadImage" id="createFileInput" class="form-control border-2" accept="image/*" />
                            </div>

                            <div class="d-flex gap-4 mt-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="IsActive" value="true" checked id="createActiveSwitch">
                                    <label class="form-check-label fw-bold small ms-1" for="createActiveSwitch">Kích hoạt</label>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="IsPremium" value="true" id="createProSwitch">
                                    <label class="form-check-label fw-bold small ms-1 text-warning" for="createProSwitch">Mẫu PRO</label>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-5 text-center border-start">
                            <p class="text-muted small fw-bold text-uppercase mb-2">Xem trước Thumbnail</p>
                            <img src="https://via.placeholder.com/210x297?text=Preview" id="createImgPreview" class="img-fluid rounded shadow-sm border" 
                                 style="max-height: 350px; aspect-ratio: 1/1.41; object-fit: cover;" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 py-3">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 shadow fw-bold">Tạo mẫu mới</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Modal Sửa mẫu Vue CV *@
<div class="modal fade" id="editVueModal" tabindex="-1" aria-labelledby="editVueModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-warning text-dark py-3">
                <h5 class="modal-title fw-bold" id="editVueModalLabel">
                    <i class='bx bx-edit me-2'></i>Cập nhật mẫu Vue CV
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editVueForm" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                
                <div class="modal-body p-4">
                    <div class="row g-4">
                        <div class="col-md-7">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Tên mẫu CV</label>
                                <input name="TemplateName" id="editVueTemplateName" class="form-control border-2" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Tên Component (Vue)</label>
                                <input name="ComponentName" id="editVueComponentName" class="form-control border-2" required />
                                <small class="text-muted">Phải khớp với tên file .vue trong thư mục templates</small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Ngành nghề / Danh mục</label>
                                <div class="d-flex flex-wrap gap-2 mt-1">
                                    @foreach (var cat in new[] { "IT", "Kinh doanh", "Marketing", "Tài chính", "Sáng tạo", "Y tế", "Thực tập", "Chuyên nghiệp", "Khác" })
                                    {
                                        <div class="form-check me-2">
                                            <input class="form-check-input edit-vue-cat-check" type="checkbox" name="selectedCategories" value="@cat" id="edit_cat_@cat">
                                            <label class="form-check-label small" for="edit_cat_@cat">@cat</label>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">URL Ảnh xem trước</label>
                                <input name="ThumbnailUrl" id="editVueThumbnailUrl" class="form-control border-2" placeholder="Nhập URL hoặc chọn file bên dưới..." />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-primary">Hoặc tải lên ảnh mới</label>
                                <input type="file" name="uploadImage" id="editVueFileInput" class="form-control border-2" accept="image/*" />
                            </div>

                            <div class="d-flex gap-4 mt-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="editVueActiveSwitch">
                                    <label class="form-check-label fw-bold small ms-1" for="editVueActiveSwitch">Kích hoạt</label>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="IsPremium" value="true" id="editVueProSwitch">
                                    <label class="form-check-label fw-bold small ms-1 text-warning" for="editVueProSwitch">Mẫu PRO</label>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-5 text-center border-start">
                            <p class="text-muted small fw-bold text-uppercase mb-2">Xem trước Thumbnail</p>
                            <img src="https://via.placeholder.com/210x297?text=Preview" id="editVueImgPreview" class="img-fluid rounded shadow-sm border" 
                                 style="max-height: 350px; aspect-ratio: 1/1.41; object-fit: cover;" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 py-3">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 shadow fw-bold">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .cv-preview-box { width: 100%; aspect-ratio: 1 / 1.414; overflow: hidden; background: #f0f0f0; }
    .cv-preview-box img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
    .template-card { transition: all 0.3s ease; border: 1px solid rgba(0,0,0,0.05) !important; }
    .template-card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important; }
    .template-card:hover img { transform: scale(1.08); }
    .status-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.45); backdrop-filter: blur(2px); display: flex; justify-content: center; align-items: center; z-index: 10; }
    .custom-pagination .page-link { border: none; margin: 0 3px; border-radius: 8px !important; color: #666; padding: 8px 16px; font-weight: 600; }
    .custom-pagination .page-item.active .page-link { background: #0d6efd; color: white; }
    .btn-white { background: white; }
    .cursor-pointer { cursor: pointer; }
</style>

<script>
    // Preview for Modal
    document.getElementById('createPreviewUrl').addEventListener('input', function() {
        document.getElementById('createImgPreview').src = this.value || 'https://via.placeholder.com/210x297?text=Preview';
    });

    document.getElementById('createFileInput').addEventListener('change', function(event) {
        const file = event.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('createImgPreview').src = e.target.result;
            }
            reader.readAsDataURL(file);
        }
    });

    // Preview for Edit Modal
    document.getElementById('editVueThumbnailUrl')?.addEventListener('input', function() {
        document.getElementById('editVueImgPreview').src = this.value || 'https://via.placeholder.com/210x297?text=Preview';
    });

    document.getElementById('editVueFileInput')?.addEventListener('change', function(event) {
        const file = event.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('editVueImgPreview').src = e.target.result;
            }
            reader.readAsDataURL(file);
        }
    });

    // Binding data to Edit Modal
    const editVueButtons = document.querySelectorAll('.btn-edit-vue');
    const editVueModalEl = document.getElementById('editVueModal');
    const editVueForm = document.getElementById('editVueForm');

    const editVueTemplateName = document.getElementById('editVueTemplateName');
    const editVueComponentName = document.getElementById('editVueComponentName');
    const editVueThumbnailUrl = document.getElementById('editVueThumbnailUrl');
    const editVueActiveSwitch = document.getElementById('editVueActiveSwitch');
    const editVueProSwitch = document.getElementById('editVueProSwitch');
    const editVueImgPreview = document.getElementById('editVueImgPreview');
    const editVueCatChecks = document.querySelectorAll('.edit-vue-cat-check');

    editVueButtons.forEach(button => {
        button.addEventListener('click', function() {
            const id = this.getAttribute('data-id');
            const name = this.getAttribute('data-name');
            const component = this.getAttribute('data-component');
            const categories = this.getAttribute('data-categories') || "";
            const thumbnail = this.getAttribute('data-thumbnail') || "";
            const active = this.getAttribute('data-active') === "true";
            const premium = this.getAttribute('data-premium') === "true";

            // Set Form action
            editVueForm.action = '/Admin/EditVueCV/' + id;

            // Fill basic info
            editVueTemplateName.value = name;
            editVueComponentName.value = component;
            editVueThumbnailUrl.value = thumbnail;
            editVueImgPreview.src = thumbnail || 'https://via.placeholder.com/210x297?text=Preview';

            // Active & Premium status
            editVueActiveSwitch.checked = active;
            editVueProSwitch.checked = premium;

            // Clear and select Category checkboxes
            const selectedCats = categories.split(',').map(c => c.trim());
            editVueCatChecks.forEach(cb => {
                cb.checked = selectedCats.includes(cb.value);
            });

            // Show modal
            const modal = new bootstrap.Modal(editVueModalEl);
            modal.show();
        });
    });

    function toggleVueStatus(id, checkbox) {
        checkbox.style.opacity = "0.5";
        checkbox.disabled = true;

        fetch(`/Admin/ToggleVueTemplateStatus/${id}`, {
            method: 'POST',
            headers: {
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            }
        })
        .then(response => {
            if (response.ok) {
                let overlay = document.getElementById("overlay-" + id);
                if (overlay) {
                    overlay.style.display = checkbox.checked ? "none" : "flex";
                }
            } else {
                checkbox.checked = !checkbox.checked;
                alert("Lỗi: Không thể cập nhật trạng thái!");
            }
        })
        .catch(error => {
            checkbox.checked = !checkbox.checked;
            console.error('Error:', error);
        })
        .finally(() => {
            checkbox.style.opacity = "1";
            checkbox.disabled = false;
        });
    }
</script>
