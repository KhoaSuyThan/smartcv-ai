@model DoAnCS.Models.Template

<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

<div class="admin-dashboard-wrapper py-5" style="background-color: #f4f7f6; min-height: 100vh;">
    <div class="container">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="card-header bg-success text-white p-4">
                <h4 class="m-0 fw-bold"><i class='bx bx-plus-circle'></i> Khởi tạo Mẫu thiết kế CV mới</h4>
            </div>
            
            <div class="card-body p-5">
                <form asp-action="CreateTemplate" method="post" enctype="multipart/form-data">
                    <div class="row g-4">
                        <div class="col-md-7">
                            <div class="mb-4">
                                <label class="form-label fw-bold">Tên mẫu thiết kế</label>
                                <input asp-for="Name" class="form-control form-control-lg border-2" placeholder="Ví dụ: Creative Minimalist 2026" required />
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-bold">Dành cho đối tượng / Ngành nghề (Chọn nhiều)</label>
                                <div class="d-flex flex-wrap gap-3 mt-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="selectedCategories" value="IT" id="catIT">
                                        <label class="form-check-label" for="catIT">Lập trình viên</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="selectedCategories" value="Kinh tế" id="catKT">
                                        <label class="form-check-label" for="catKT">Kinh tế</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="selectedCategories" value="Marketing" id="catMK">
                                        <label class="form-check-label" for="catMK">Marketing</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="selectedCategories" value="Sáng tạo" id="catST">
                                        <label class="form-check-label" for="catST">Sáng tạo</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="selectedCategories" value="Khác" id="catKhac">
                                        <label class="form-check-label" for="catKhac">Khác</label>
                                    </div>
                                </div>
                            </div>
                            <div class="mb-4">
                                <label class="form-label fw-bold">URL Ảnh xem trước</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class='bx bx-link'></i></span>
                                    <input asp-for="PreviewImageUrl" id="previewUrlInput" class="form-control border-2" placeholder="Nhập URL hoặc tải file bên dưới..." />
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-bold text-primary"><i class='bx bx-image-add'></i> Hoặc tải lên ảnh từ máy tính</label>
                                <input type="file" name="uploadImage" id="fileInput" class="form-control border-2" accept="image/*" />
                                <div class="form-text mt-2 text-muted">Hệ thống sẽ tự động tối ưu tên file khi lưu trữ.</div>
                            </div>

                            <div class="form-check form-switch mt-4">
                                <input class="form-check-input scale-150" type="checkbox" asp-for="IsActive" id="activeSwitch" checked>
                                <label class="form-check-label fw-bold ms-3" for="activeSwitch">Kích hoạt ngay sau khi tạo</label>
                            </div>

                            <div class="form-check form-switch mt-3">
                                <input class="form-check-input scale-150" type="checkbox" asp-for="IsProOnly" id="proSwitch">
                                <label class="form-check-label fw-bold ms-3 text-warning" for="proSwitch">
                                    <i class='bx bxs-crown'></i> Đây là mẫu thiết kế PRO
                                </label>
                            </div>
                        </div>

                        <div class="col-md-5 text-center border-start">
                            <p class="text-muted small fw-bold text-uppercase">Xem trước hình ảnh</p>
                            <div class="preview-box rounded shadow-sm border d-flex align-items-center justify-content-center bg-white overflow-hidden" style="height: 300px; aspect-ratio: 1/1.41; margin: 0 auto;">
                                <img src="/images/no-image.jpg" id="imgPreview" class="img-fluid" style="width: 100%; height: 100%; object-fit: cover;" />
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="col-12">
                            <label class="form-label fw-bold text-primary"><i class='bx bxs-file-html'></i> Thiết lập khung HTML (Dùng {{Tag}} để AI đổ dữ liệu)</label>
                            <textarea asp-for="HtmlContent" class="form-control code-area html-theme" placeholder="<div>{{FullName}}</div>"></textarea>
                        </div>

                        <div class="col-12 mt-4">
                            <label class="form-label fw-bold text-info"><i class='bx bxs-file-css'></i> Thiết lập định dạng CSS</label>
                            <textarea asp-for="CssContent" class="form-control code-area css-theme" placeholder=".cv-container { ... }"></textarea>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-5 pt-4 border-top">
                        <a asp-action="Templates" class="btn btn-light rounded-pill px-4 fw-bold">Hủy bỏ</a>
                        <button type="submit" class="btn btn-success rounded-pill px-5 shadow fw-bold">
                            <i class='bx bx-cloud-upload'></i> Lưu & Công bố mẫu
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>



<style>
    .code-area { 
        height: 380px; 
        font-family: 'Consolas', 'Monaco', monospace; 
        font-size: 13px; 
        padding: 20px; 
        border-radius: 12px; 
    }
    .html-theme { background: #1e1e1e; color: #9cdcfe; border: 1px solid #333; }
    .css-theme { background: #1e1e1e; color: #ce9178; border: 1px solid #333; }
    .form-check-input:checked { background-color: #198754; border-color: #198754; }
    .scale-150 { transform: scale(1.3); cursor: pointer; }
</style>

<script>
    // Live preview khi dán URL ảnh
    document.getElementById('previewUrlInput').addEventListener('input', function() {
        if(this.value) {
            document.getElementById('imgPreview').src = this.value;
        } else {
            document.getElementById('imgPreview').src = '/images/no-image.jpg';
        }
    });

    // Xử lý xem trước ảnh ngay khi Admin chọn file từ máy tính
    document.getElementById('fileInput').addEventListener('change', function(event) {
        const file = event.target.files[0];
        const preview = document.getElementById('imgPreview');
        
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                preview.src = e.target.result;
            }
            reader.readAsDataURL(file);
        } else {
            preview.src = '/images/no-image.jpg';
        }
    });
</script>