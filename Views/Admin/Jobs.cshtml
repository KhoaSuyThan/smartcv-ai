@model DoAnCS.Models.ViewModels.AdminDashboardVM
@{
    ViewData["Title"] = "Quản lý tin tuyển dụng";
}

@* Nhúng thư viện Icon *@
<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

<div class="admin-job-page py-4" style="background-color: #f8fbff; min-height: 100vh;">
    <div class="container-fluid px-5">
        
        @* Header *@
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold text-dark m-0">
                    <i class='bx bxs-briefcase-alt-2 text-warning me-2'></i>Quản lý Tin Tuyển dụng
                </h3>
                <p class="text-muted small mb-0">Hệ thống có tổng cộng <span class="fw-bold text-primary">@Model.TotalJobs</span> bản ghi.</p>
            </div>
            <div class="d-flex gap-2">
                <a href="/Admin" class="btn btn-white border shadow-sm rounded-pill px-4 fw-bold text-secondary">
                    <i class='bx bx-left-arrow-alt'></i> Quay lại Dashboard
                </a>
                <button class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#addJobModal">
                    <i class='bx bx-plus-circle'></i> Đăng tin mới
                </button>
            </div>
        </div>

        @* Bảng danh sách *@
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 py-3" style="width: 80px">Logo</th>
                            <th>Vị trí tuyển dụng</th>
                            <th>Mức lương</th>
                            <th>Hạn nộp</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in Model.Jobs)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="bg-white rounded p-1 border shadow-sm d-flex align-items-center justify-content-center" 
                                         style="height: 50px; width: 50px;">
                                        @if (job.Company != null && !string.IsNullOrEmpty(job.Company.LogoUrl))
                                        {
                                            <img src="@job.Company.LogoUrl" 
                                                 class="rounded"
                                                 style="height: 100%; width: 100%; object-fit: contain;" 
                                                 onerror="this.onerror=null; this.outerHTML='<i class=\'bx bx-building text-muted fs-4\'></i>';" />
                                        }
                                        else
                                        {
                                            <i class='bx bx-building text-muted fs-4'></i>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark fs-6">@job.Title</div>
                                    <div class="text-primary small fw-semibold">@job.Company?.Name</div>
                                    <div class="extra-small text-muted" style="font-size: 0.7rem;">
                                        ID: #@job.JobID | Đăng: @job.CreatedAt.ToString("dd/MM/yyyy")
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-success-soft text-success px-3 py-2">
                                        <i class='bx bx-dollar-circle me-1'></i>@job.Salary
                                    </span>
                                </td>
                                <td>
                                    <span class="@(job.Deadline < DateTime.Now ? "text-danger" : "text-dark") fw-bold small">
                                        <i class='bx bx-calendar-event me-1'></i>@job.Deadline?.ToString("dd/MM/yyyy")
                                    </span>
                                </td>
                                <td>
                                    @if (job.Status == 0)
                                    {
                                        <span class="badge bg-warning-soft text-warning rounded-pill px-3 py-2 animate-pulse">
                                            <i class='bx bx-time-five me-1'></i>Chờ duyệt
                                        </span>
                                    }
                                    else if (job.Status == 1)
                                    {
                                        @if (job.Deadline >= DateTime.Now)
                                        {
                                            <span class="badge bg-info-soft text-info rounded-pill px-3 py-2">
                                                <i class='bx bx-check-double me-1'></i>Đang tuyển
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-soft text-secondary rounded-pill px-3 py-2">
                                                <i class='bx bx-block me-1'></i>Hết hạn
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-soft text-danger rounded-pill px-3 py-2">
                                            <i class='bx bx-x-circle me-1'></i>Từ chối
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        @* Nếu đang chờ duyệt: Hiện nút Duyệt/Từ chối *@
                                        @if (job.Status == 0)
                                        {
                                            <a asp-controller="Jobs" asp-action="Approve" asp-route-id="@job.JobID" 
                                               asp-route-returnUrl="@Context.Request.Path"
                                               class="btn btn-sm btn-success rounded-pill px-3 fw-bold shadow-sm">
                                                Duyệt
                                            </a>
                                            <a asp-controller="Jobs" asp-action="Reject" asp-route-id="@job.JobID" 
                                               asp-route-returnUrl="@Context.Request.Path"
                                               class="btn btn-sm btn-outline-danger rounded-pill px-2">
                                                <i class='bx bx-x'></i>
                                            </a>
                                        }
                                        
                                        @* Nút Sửa *@
                                        <a asp-controller="Jobs" asp-action="Edit" asp-route-id="@job.JobID" 
                                           asp-route-returnUrl="@($"{Context.Request.Path}{Context.Request.QueryString}")"
                                           class="btn btn-sm btn-light border rounded-circle" style="width: 32px; height: 32px;" title="Sửa">
                                            <i class='bx bxs-edit-alt text-primary'></i>
                                        </a>

                                        @* Nút Xóa (Dùng form để bảo mật) *@
                                        <form asp-controller="Jobs" asp-action="Delete" asp-route-id="@job.JobID" method="post" 
                                              onsubmit="return confirm('Bạn có chắc muốn xóa tin này vĩnh viễn?');" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-light border rounded-circle" style="width: 32px; height: 32px;" title="Xóa">
                                                <i class='bx bxs-trash text-danger'></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @* Phân trang *@
        @if (Model.TotalPages > 1)
        {
            <nav class="mt-5">
                <ul class="pagination justify-content-center custom-pagination">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link shadow-sm" href="?page=@(Model.CurrentPage - 1)"><i class='bx bx-chevron-left'></i></a>
                    </li>
                    @{
                        int startPage = Math.Max(1, Model.CurrentPage - 2);
                        int endPage = Math.Min(Model.TotalPages, startPage + 4);
                        if (endPage - startPage < 4)
                        {
                            startPage = Math.Max(1, endPage - 4);
                        }
                    }

                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link shadow-sm" href="?page=@i">@i</a>
                        </li>
                    }

                    @if (endPage < Model.TotalPages)
                    {
                        if (endPage < Model.TotalPages - 1)
                        {
                            <li class="page-item disabled">
                                <span class="page-link shadow-sm border-0 bg-transparent text-muted fw-bold">...</span>
                            </li>
                        }
                        <li class="page-item">
                            <a class="page-link shadow-sm" href="?page=@Model.TotalPages">@Model.TotalPages</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link shadow-sm" href="?page=@(Model.CurrentPage + 1)"><i class='bx bx-chevron-right'></i></a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>

<style>
    /* CSS MÀU BADGE SOFT - Đã tối ưu cho Khoa */
    .bg-success-soft { background-color: #e8f5e9; color: #2e7d32; border: 1px solid #c8e6c9; }
    .bg-warning-soft { background-color: #fff8e1; color: #f57f17; border: 1px solid #ffecb3; }
    .bg-info-soft    { background-color: #e3f2fd; color: #1976d2; border: 1px solid #bbdefb; }
    .bg-danger-soft  { background-color: #ffebee; color: #c62828; border: 1px solid #ffcdd2; }
    .bg-secondary-soft { background-color: #f5f5f5; color: #616161; border: 1px solid #e0e0e0; }

    /* Hiệu ứng nhấp nháy cho tin chờ duyệt */
    .animate-pulse { animation: pulse-animation 2s infinite; }
    @@keyframes pulse-animation {
        0% { opacity: 1; }
        50% { opacity: 0.6; }
        100% { opacity: 1; }
    }

    .table thead th {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #718096;
        border-bottom: 1px solid #edf2f7;
    }

    .table tbody tr:hover { background-color: #fcfdfe; }
    .custom-pagination .page-link {
        border: none; margin: 0 3px; border-radius: 8px !important;
        color: #666; padding: 8px 16px; font-weight: 600;
    }
    .custom-pagination .page-item.active .page-link { background: #0d6efd; color: white; }

    .btn-white { background: white; }
    .hover-primary:hover { color: #0d6efd !important; }
</style>

@* ================================================================= *@
@* MODAL ĐĂNG TIN MỚI *@
@* ================================================================= *@
<div class="modal fade" id="addJobModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <form asp-controller="Jobs" asp-action="Create" method="post" id="addJobForm">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white border-0 py-3">
                    <h5 class="modal-title fw-bold"><i class='bx bx-plus-circle me-2'></i>Đăng tin tuyển dụng mới</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        @* Đơn vị tuyển dụng *@
                        <div class="col-12">
                            <label class="form-label fw-bold small text-uppercase">Đơn vị tuyển dụng</label>
                            <select name="CompanyID" class="form-select border-2 py-2 px-3 rounded-3" required>
                                <option value="">-- Chọn công ty --</option>
                                @if (ViewBag.Companies != null)
                                {
                                    foreach (var c in ViewBag.Companies as List<DoAnCS.Models.Company>)
                                    {
                                        <option value="@c.CompanyID">@c.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        @* Vị trí tuyển dụng *@
                        <div class="col-12">
                            <label class="form-label fw-bold small text-uppercase">Vị trí tuyển dụng</label>
                            <input type="text" name="Title" class="form-control border-2 py-2 px-3 rounded-3" required placeholder="Ví dụ: Backend Developer (.NET Core)">
                        </div>

                        @* Mức lương *@
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-uppercase">Mức lương</label>
                            <select id="modalSalaryType" class="form-select border-2 py-2 px-3 rounded-3 mb-2">
                                <option value="Thỏa thuận">Thỏa thuận</option>
                                <option value="Cạnh tranh">Cạnh tranh</option>
                                <option value="Nhập liệu">Nhập liệu cụ thể</option>
                            </select>

                            <div class="input-group" id="modalSalaryInputGroup" style="display: none;">
                                <span class="input-group-text border-2 bg-light"><i class='bx bx-money'></i></span>
                                <input type="text" id="modalCustomSalary" class="form-control border-2 py-2 px-3" placeholder="Ví dụ: 20-30" oninput="this.value = this.value.replace(/[^0-9\-\s]/g, '')">
                                <span class="input-group-text border-2 bg-light">triệu VNĐ/Tháng</span>
                            </div>
                            <input type="hidden" name="Salary" id="modalSalaryHidden" />
                        </div>

                        @* Hạn chót *@
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-uppercase">Hạn chót nộp hồ sơ</label>
                            <input type="date" name="Deadline" class="form-control border-2 py-2 px-3 rounded-3" required>
                        </div>

                        @* Địa điểm làm việc *@
                        <div class="col-12">
                            <label class="form-label fw-bold small text-uppercase">Địa điểm làm việc</label>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <select id="ModalProvinceSelect" class="form-select border-2 py-2 px-3 rounded-3" required>
                                        <option value="">Chọn tỉnh/thành phố</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <select id="ModalDistrictSelect" class="form-select border-2 py-2 px-3 rounded-3" required>
                                        <option value="">Chọn quận/huyện</option>
                                    </select>
                                </div>
                            </div>
                            <input type="text" name="Location" id="ModalLocationHidden" style="position: absolute; left: -9999px; top: 0;" required />
                        </div>

                        @* Mô tả *@
                        <div class="col-12">
                            <label class="form-label fw-bold small text-uppercase">Mô tả chi tiết công việc</label>
                            <textarea name="Description" class="form-control border-2 rounded-3" rows="4" required placeholder="Nêu rõ các đầu việc hàng ngày..."></textarea>
                        </div>

                        @* Yêu cầu *@
                        <div class="col-12">
                            <label class="form-label fw-bold small text-uppercase">Yêu cầu đối với ứng viên</label>
                            <textarea name="Requirements" class="form-control border-2 rounded-3" rows="4" required placeholder="Kỹ năng chuyên môn, kinh nghiệm, ngoại ngữ..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">Đăng tin ngay</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // --- XỬ LÝ LƯƠNG TRONG MODAL ---
            var salaryHidden = document.getElementById("modalSalaryHidden");
            var salaryType = document.getElementById("modalSalaryType");
            var salaryInputGroup = document.getElementById("modalSalaryInputGroup");
            var customSalary = document.getElementById("modalCustomSalary");

            function updateHiddenValue() {
                if (salaryType.value === "Nhập liệu") {
                    if (customSalary.value.trim() !== "") {
                        salaryHidden.value = customSalary.value.trim() + " triệu VNĐ/Tháng";
                    } else {
                        salaryHidden.value = "";
                    }
                } else {
                    salaryHidden.value = salaryType.value;
                }
            }

            salaryType.addEventListener("change", function () {
                if (this.value === "Nhập liệu") {
                    salaryInputGroup.style.display = "flex";
                } else {
                    salaryInputGroup.style.display = "none";
                }
                updateHiddenValue();
            });

            customSalary.addEventListener("input", function () {
                updateHiddenValue();
            });

            updateHiddenValue();

            // --- ĐỒNG BỘ ĐỊA ĐIỂM TỈNH/THÀNH VÀ QUẬN/HUYỆN TRONG MODAL ---
            var provincesData = [];
            var provinceSelect = document.getElementById("ModalProvinceSelect");
            var districtSelect = document.getElementById("ModalDistrictSelect");
            var locationHidden = document.getElementById("ModalLocationHidden");

            async function loadProvinces() {
                try {
                    const response = await fetch('/data/provinces.json');
                    provincesData = await response.json();
                    
                    provinceSelect.innerHTML = '<option value="">Chọn tỉnh/thành phố</option>';
                    provincesData.forEach(p => {
                        const option = document.createElement('option');
                        option.value = p.name;
                        option.text = p.name;
                        provinceSelect.add(option);
                    });
                } catch (e) {
                    console.error("Error loading provinces in Modal:", e);
                }
            }

            function populateDistricts(provinceName) {
                districtSelect.innerHTML = '<option value="">Chọn quận/huyện</option>';
                if (!provinceName) return;

                const province = provincesData.find(p => p.name === provinceName);
                if (province && province.districts) {
                    province.districts.forEach(d => {
                        const option = document.createElement('option');
                        option.value = d.name;
                        option.text = d.name;
                        districtSelect.add(option);
                    });
                }
            }

            function updateLocationHidden() {
                const p = provinceSelect.value;
                const d = districtSelect.value;
                if (p && d) {
                    locationHidden.value = d + ', ' + p;
                } else if (p) {
                    locationHidden.value = p;
                } else {
                    locationHidden.value = '';
                }
                if (typeof $ !== 'undefined' && $('#addJobForm').data('validator')) {
                    $(locationHidden).valid();
                }
            }

            provinceSelect.addEventListener('change', function() {
                populateDistricts(this.value);
                updateLocationHidden();
            });

            districtSelect.addEventListener('change', function() {
                updateLocationHidden();
            });

            loadProvinces();
        });
    </script>
}