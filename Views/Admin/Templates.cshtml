@model DoAnCS.Models.ViewModels.AdminDashboardVM
@{
    ViewData["Title"] = "Quản lý Mẫu CV";
}
@Html.AntiForgeryToken()

<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

<div class="admin-template-page py-4" style="background-color: #f8fbff; min-height: 100vh;">
    <div class="container-fluid px-5">
        
        @* Header Section *@
        <div class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <h3 class="fw-bold text-dark m-0">
                    <i class='bx bxs-layout text-primary me-2'></i>Quản lý Mẫu thiết kế CV
                </h3>
                <p class="text-muted small mb-0">Hiển thị tối ưu 80% kích thước chuẩn A4.</p>
            </div>
            <div class="d-flex gap-2">
                <a href="/Admin" class="btn btn-white border shadow-sm rounded-pill px-4 fw-bold text-secondary">
                    <i class='bx bx-left-arrow-alt'></i> Quay về Dashboard
                </a>
                <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold" data-bs-toggle="modal" data-bs-target="#createTemplateModal">
                    <i class='bx bx-plus-circle'></i> Thêm mẫu mới
                </button>
            </div>
        </div>

        @* Grid hiển thị 4 mẫu *@
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
            @foreach (var item in Model.Templates)
            {
                <div class="col">
                    @* Thêm class template-card-wrapper để giới hạn 80% *@
                    <div class="card h-100 border-0 shadow-sm template-card rounded-4 overflow-hidden mx-auto" style="max-width: 80%; background-color: #ffffff !important;">
                        @* Tỉ lệ ảnh A4 *@
                        <div class="cv-preview-box position-relative" id="preview-box-@item.TemplateID">
                            <img src="@item.PreviewImageUrl" class="card-img-top" alt="@item.Name" 
                                 onerror="this.src='https://via.placeholder.com/210x297?text=CV+Template';">
                            
                            <div class="status-overlay" id="overlay-@item.TemplateID" style="display: @(item.IsActive ? "none" : "flex");">
                                <span class="badge bg-danger rounded-pill px-4 py-2 border border-2 border-white shadow-lg fs-6" style="letter-spacing: 1px;">TẠM ẨN</span>
                            </div>

                            @if (item.IsProOnly)
                            {
                                <div class="position-absolute top-0 end-0 m-2" style="z-index: 11;">
                                    <span class="badge bg-warning text-dark border border-white shadow px-2 py-1 rounded-pill fw-bold" style="font-size: 0.65rem;">
                                         <i class='bx bxs-crown me-1'></i> PRO
                                    </span>
                                </div>
                            }
                        </div>
                        
                        <div class="card-body p-3">
                            <h6 class="fw-bold text-dark text-truncate mb-2" style="font-size: 0.9rem;">@item.Name</h6>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge bg-light text-muted border px-2 py-1" style="font-size: 0.65rem;">ID: #@item.TemplateID</span>
                                
                                <div class="d-flex gap-1 align-items-center">
                                    @* Nút Sửa *@
                                    <a asp-action="EditCV" asp-route-id="@item.TemplateID" 
                                       asp-route-returnUrl="@($"{Context.Request.Path}{Context.Request.QueryString}")"
                                       class="btn btn-sm text-warning p-1" title="Chỉnh sửa">
                                        <i class='bx bxs-edit-alt fs-5'></i>
                                    </a>

                                    @* Nút Xóa *@
                                    <button onclick="confirmDelete(@item.TemplateID, '@item.Name')" 
                                            class="btn btn-sm text-danger p-1" title="Xóa mẫu">
                                        <i class='bx bxs-trash fs-5'></i>
                                    </button>

                                    @* Switch bật/tắt *@
                                    <div class="form-check form-switch ms-1">
                                        <input class="form-check-input cursor-pointer" type="checkbox" 
                                            @(item.IsActive ? "checked" : "") 
                                            onchange="toggleTemplateStatus(@item.TemplateID, this)">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Phân trang *@
        @if (Model.TotalPages > 1)
        {
            <nav class="mt-5">
                <ul class="pagination justify-content-center custom-pagination">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link shadow-sm" href="?page=@(Model.CurrentPage - 1)"><i class='bx bx-chevron-left'></i></a>
                    </li>
                    @{
                        int startPage = Math.Max(1, Model.CurrentPage - 2);
                        int endPage = Math.Min(Model.TotalPages, startPage + 4);
                        if (endPage - startPage < 4)
                        {
                            startPage = Math.Max(1, endPage - 4);
                        }
                    }

                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link shadow-sm" href="?page=@i">@i</a>
                        </li>
                    }

                    @if (endPage < Model.TotalPages)
                    {
                        if (endPage < Model.TotalPages - 1)
                        {
                            <li class="page-item disabled">
                                <span class="page-link shadow-sm border-0 bg-transparent text-muted fw-bold">...</span>
                            </li>
                        }
                        <li class="page-item">
                            <a class="page-link shadow-sm" href="?page=@Model.TotalPages">@Model.TotalPages</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link shadow-sm" href="?page=@(Model.CurrentPage + 1)"><i class='bx bx-chevron-right'></i></a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>

<style>
    /* ÉP TỈ LỆ A4 CHUẨN */
    .cv-preview-box {
        width: 100%;
        aspect-ratio: 1 / 1.414;
        overflow: hidden;
        background: #f0f0f0;
    }
    .cv-preview-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    /* Hiệu ứng Card */
    .template-card { 
        transition: all 0.3s ease; 
        border: 1px solid rgba(0,0,0,0.05) !important;
    }
    .template-card:hover { 
        transform: translateY(-5px); 
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important; 
    }
    .template-card:hover img { transform: scale(1.08); }

    /* Overlay Trạng thái */
    .status-overlay {
        position: absolute; top: 0; left: 0;
        width: 100%; height: 100%;
        background-color: rgba(0, 0, 0, 0.45);
        backdrop-filter: blur(2px) grayscale(50%);
        -webkit-backdrop-filter: blur(2px) grayscale(50%);
        display: flex; justify-content: center; align-items: center;
        z-index: 10;
    }

    /* Custom Phân trang */
    .custom-pagination .page-link {
        border: none; margin: 0 3px; border-radius: 8px !important;
        color: #666; padding: 8px 16px; font-weight: 600;
    }
    .custom-pagination .page-item.active .page-link { background: #0d6efd; color: white; }

    .btn-white { background: white; }
    .cursor-pointer { cursor: pointer; }
</style>

<script>
    function confirmDelete(id, name) {
        if (confirm(`Bạn có chắc muốn XÓA vĩnh viễn mẫu CV [${name}]?`)) {
            window.location.href = `/Admin/DeleteTemplate/${id}`;
        }
    }
    function toggleTemplateStatus(id, checkbox) {
        // Hiệu ứng mờ đi một chút để người dùng biết đang xử lý
        checkbox.style.opacity = "0.5";
        checkbox.disabled = true;

        // Gửi yêu cầu AJAX bằng Fetch API
        fetch(`/Admin/ToggleTemplateStatus/${id}`, {
            method: 'POST',
            headers: {
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            }
        })
        .then(response => {
            if (response.ok) {
                // Nếu thành công, đổi trạng thái giao diện ngay lập tức
                console.log("Đã cập nhật trạng thái mẫu #" + id);
                let overlay = document.getElementById("overlay-" + id);
                if (overlay) {
                    overlay.style.display = checkbox.checked ? "none" : "flex";
                }
            } else {
                // Nếu lỗi thì gạt nút quay lại trạng thái cũ
                checkbox.checked = !checkbox.checked;
                alert("Lỗi: Không thể cập nhật trạng thái!");
            }
        })
        .catch(error => {
            checkbox.checked = !checkbox.checked;
            console.error('Error:', error);
        })
        .finally(() => {
            checkbox.style.opacity = "1";
            checkbox.disabled = false;
        });
    }
</script>

@* ================================================================= *@
@* MODAL THÊM MẪU CV REACT *@
@* ================================================================= *@
<div class="modal fade" id="createTemplateModal" tabindex="-1" aria-labelledby="createTemplateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title fw-bold" id="createTemplateModalLabel">
                    <i class='bx bx-plus-circle me-2'></i>Thêm mẫu React CV mới
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="CreateTemplate" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                
                @* Gán rỗng cho HTML/CSS vì dùng JSX của React *@
                <input type="hidden" name="HtmlContent" value="" />
                <input type="hidden" name="CssContent" value="" />

                <div class="modal-body p-4">
                    <div class="row g-4">
                        <div class="col-md-7">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Tên mẫu CV (React)</label>
                                <input name="Name" class="form-control border-2" placeholder="Ví dụ: Đặng Ngọc Linh" required />
                                <small class="text-muted">Phải trùng khớp chính xác với Key đã khai báo trong TemplateRegistry.jsx</small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Ngành nghề / Danh mục</label>
                                <div class="d-flex flex-wrap gap-2 mt-1">
                                    @foreach (var cat in new[] { "Lập trình viên", "Kinh tế", "Marketing", "Sáng tạo", "Khác" })
                                    {
                                        <div class="form-check me-2">
                                            <input class="form-check-input" type="checkbox" name="selectedCategories" value="@cat" id="cat_@cat">
                                            <label class="form-check-label small" for="cat_@cat">@cat</label>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">URL Ảnh xem trước</label>
                                <input name="PreviewImageUrl" id="createTemplatePreviewUrl" class="form-control border-2" placeholder="Nhập URL hoặc chọn file bên dưới..." />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-primary">Hoặc tải lên ảnh từ máy tính</label>
                                <input type="file" name="uploadImage" id="createTemplateFileInput" class="form-control border-2" accept="image/*" />
                            </div>

                            <div class="d-flex gap-4 mt-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="IsActive" value="true" checked id="createTemplateActiveSwitch">
                                    <label class="form-check-label fw-bold small ms-1" for="createTemplateActiveSwitch">Kích hoạt ngay</label>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="IsProOnly" value="true" id="createTemplateProSwitch">
                                    <label class="form-check-label fw-bold small ms-1 text-warning" for="createTemplateProSwitch">Mẫu PRO (Chỉ Pro)</label>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-5 text-center border-start">
                            <p class="text-muted small fw-bold text-uppercase mb-2">Xem trước Thumbnail</p>
                            <img src="https://via.placeholder.com/210x297?text=Preview" id="createTemplateImgPreview" class="img-fluid rounded shadow-sm border" 
                                 style="max-height: 350px; aspect-ratio: 1/1.41; object-fit: cover;" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 py-3">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 shadow fw-bold">Tạo mẫu mới</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Script preview for Template Modal
        const urlInput = document.getElementById('createTemplatePreviewUrl');
        const fileInput = document.getElementById('createTemplateFileInput');
        const imgPreview = document.getElementById('createTemplateImgPreview');

        if (urlInput && imgPreview) {
            urlInput.addEventListener('input', function() {
                imgPreview.src = this.value || 'https://via.placeholder.com/210x297?text=Preview';
            });
        }

        if (fileInput && imgPreview) {
            fileInput.addEventListener('change', function(event) {
                const file = event.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        imgPreview.src = e.target.result;
                    }
                    reader.readAsDataURL(file);
                }
            });
        }
    });
</script>