@model DoAnCS.Models.Job

<div class="container py-5">
    <div class="card border-0 shadow-lg rounded-4">
        <div class="card-header bg-primary text-white p-4">
            <h4 class="m-0 fw-bold">
                <i class='bx @(Model?.JobID > 0 ? "bx-edit" : "bx-plus-circle")'></i> 
                @(Model?.JobID > 0 ? "Cập nhật & Duyệt tin" : "Thêm mới Tin tuyển dụng")
            </h4>
        </div>
        <div class="card-body p-5">
            @* Giữ nguyên form, chỉ điều hướng Action dựa trên ID *@
            <form asp-action="@(Model?.JobID > 0 ? "Edit" : "Create")" method="post">
                @Html.AntiForgeryToken()
                @if (Model?.JobID > 0)
                {
                    <input type="hidden" asp-for="JobID" />
                }

                <div class="row g-4">
                    <div class="col-md-8">
                        <label class="form-label fw-bold">Vị trí tuyển dụng</label>
                        <input asp-for="Title" class="form-control border-2" placeholder="Ví dụ: Backend Developer" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Mức lương</label>
                        <select id="salaryType" class="form-select border-2 mb-2">
                            <option value="Thỏa thuận">Thỏa thuận</option>
                            <option value="Cạnh tranh">Cạnh tranh</option>
                            <option value="Nhập liệu">Nhập liệu cụ thể</option>
                        </select>
                        
                        <div class="input-group" id="salaryInputGroup" style="display: none;">
                            <input type="text" id="customSalary" class="form-control border-2" placeholder="Ví dụ: 15-20" />
                            <span class="input-group-text border-2 bg-light">triệu VNĐ/Tháng</span>
                        </div>
                        <input type="hidden" asp-for="Salary" id="Salary" />
                    </div>
                    
                    <div class="col-12">
                        <label class="form-label fw-bold">Công ty tuyển dụng</label>
                        @if (User.IsInRole("Admin"))
                        {
                            <select asp-for="CompanyID" class="form-select border-2" 
                                    asp-items="@(new SelectList(ViewBag.Companies, "CompanyID", "Name"))" required>
                                <option value="">-- Chọn công ty --</option>
                            </select>
                        }
                        else
                        {
                            <input type="text" class="form-control border-2 bg-light" value="@(Model?.Company?.Name)" readonly />
                            <input type="hidden" asp-for="CompanyID" />
                        }
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Hạn nộp</label>
                        <input asp-for="Deadline" type="date" class="form-control border-2" 
                               value="@(Model?.Deadline?.ToString("yyyy-MM-dd"))" required />
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold">Mô tả công việc</label>
                        <textarea asp-for="Description" class="form-control border-2" rows="4"></textarea>
                    </div>
                </div>

                @* Phần nút bấm: Giữ nguyên cấu trúc text-end, chỉ thêm các nút Duyệt/Từ chối *@
                <div class="mt-5 border-top pt-4 text-end">
                    <a asp-controller="Admin" asp-action="Index" class="btn btn-light rounded-pill px-4 me-2">Hủy bỏ</a>

                    @* Nút Duyệt/Từ chối dành riêng cho Admin khi tin đang chờ duyệt (Status = 0) *@
                    @if (User.IsInRole("Admin") && Model?.Status == 0 && Model?.JobID > 0)
                    {
                        <a asp-action="Approve" asp-route-id="@Model.JobID" 
                           class="btn btn-success rounded-pill px-4 me-2 shadow-sm fw-bold">
                            <i class='bx bx-check'></i> Duyệt bài
                        </a>
                        
                        <a asp-action="Reject" asp-route-id="@Model.JobID" 
                           class="btn btn-danger rounded-pill px-4 me-2 shadow-sm fw-bold">
                            <i class='bx bx-x'></i> Từ chối
                        </a>
                    }

                    <button type="submit" class="btn btn-primary rounded-pill px-5 shadow fw-bold">
                        @(Model?.JobID > 0 ? "Lưu thay đổi" : "Lưu tin đăng")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var salaryHidden = document.getElementById("Salary");
            if (!salaryHidden) return;
            
            var salaryType = document.getElementById("salaryType");
            var salaryInputGroup = document.getElementById("salaryInputGroup");
            var customSalary = document.getElementById("customSalary");

            // Khởi tạo từ dữ liệu cũ
            var initialValue = salaryHidden.value;
            if (!initialValue || initialValue === "Thỏa thuận") {
                salaryType.value = "Thỏa thuận";
                salaryHidden.value = "Thỏa thuận";
            } else if (initialValue === "Cạnh tranh") {
                salaryType.value = "Cạnh tranh";
            } else {
                salaryType.value = "Nhập liệu";
                var num = initialValue.replace(" triệu VNĐ/Tháng", "").replace(" Triệu", "").replace(" triệu", "").trim();
                customSalary.value = num;
                salaryInputGroup.style.display = "flex";
            }

            function updateHiddenValue() {
                if (salaryType.value === "Nhập liệu") {
                    if (customSalary.value.trim() !== "") {
                        salaryHidden.value = customSalary.value.trim() + " triệu VNĐ/Tháng";
                    } else {
                        salaryHidden.value = "";
                    }
                } else {
                    salaryHidden.value = salaryType.value;
                }
            }

            salaryType.addEventListener("change", function () {
                if (this.value === "Nhập liệu") {
                    salaryInputGroup.style.display = "flex";
                } else {
                    salaryInputGroup.style.display = "none";
                }
                updateHiddenValue();
            });

            customSalary.addEventListener("input", function () {
                updateHiddenValue();
            });
        });
    </script>
}