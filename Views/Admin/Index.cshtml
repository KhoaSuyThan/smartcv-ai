@model DoAnCS.Models.ViewModels.AdminDashboardVM
@{
    ViewData["Title"] = "Bảng điều khiển Admin";
}

<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

<div class="admin-dashboard-wrapper py-4" style="background-color: #f8fbff; min-height: 100vh;">
    <div class="container-fluid px-5">
        
        @* Header với Nút Hamburger *@
        <div class="d-flex justify-content-between align-items-center mb-5">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-white shadow-sm rounded-3 border-0 px-3 py-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar">
                    <i class='bx bx-menu-alt-left fs-3 text-primary'></i>
                </button>
                <h2 class="fw-bold m-0 text-dark">Quản trị Hệ thống</h2>
            </div>
            <div class="text-muted small">Phiên bản 2026.1</div>
        </div>
        
        @* 4 Ô KPI Thống kê *@
        <div class="row g-4 mb-5">
            <div class="col-md-3">
                <div class="stat-card bg-grad-primary shadow-sm">
                    <div class="stat-content"><h6>Người dùng</h6><h2>@Model.TotalUsers</h2></div>
                    <i class='bx bxs-user-account'></i>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card bg-grad-success shadow-sm">
                    <div class="stat-content"><h6>Công ty</h6><h2>@Model.TotalCompanies</h2></div>
                    <i class='bx bxs-business'></i>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card bg-grad-warning shadow-sm">
                    <div class="stat-content"><h6>Việc làm</h6><h2>@Model.TotalJobs</h2></div>
                    <i class='bx bxs-briefcase-alt-2'></i>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card bg-grad-danger shadow-sm">
                    <div class="stat-content"><h6>CV đã lưu</h6><h2>@Model.TotalResumes</h2></div>
                    <i class='bx bxs-magic-wand'></i>
                </div>
            </div>
        </div>
    </div>
</div>

@* Sidebar Offcanvas *@
<div class="offcanvas offcanvas-start border-0 shadow" tabindex="-1" id="adminSidebar" style="width: 280px; background: #111827;">
    <div class="offcanvas-header border-bottom border-secondary p-4">
        <h5 class="offcanvas-title text-white fw-bold"><i class='bx bxs-zap text-warning me-2'></i>Admin Panel</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body p-0">
        <div class="list-group list-group-flush mt-3 px-3">
            <a href="/Admin" class="menu-item active"><i class='bx bxs-dashboard'></i> Tổng quan</a>
            <div class="menu-label mt-4">QUẢN LÝ DỮ LIỆU</div>
            <a href="/Admin/Templates" class="menu-item"><i class='bx bxs-layout'></i> Mẫu thiết kế CV</a>
            <a href="/Admin/Jobs" class="menu-item"><i class='bx bxs-briefcase-alt-2'></i> Tin tuyển dụng</a>
            <a href="/Admin/Companies" class="menu-item"><i class='bx bxs-business'></i> Công ty</a>
            <div class="menu-label mt-4">HỆ THỐNG</div>
            <a href="/Admin/Users" class="menu-item"><i class='bx bxs-group'></i> Người dùng</a>
            <a href="#" class="menu-item"><i class='bx bxs-bot'></i> Cấu hình Gemini</a>
        </div>
    </div>
</div>

<style>
    /* CSS cho Menu */
    .menu-label { color: #4b5563; font-size: 0.7rem; font-weight: 800; letter-spacing: 1px; padding: 10px 15px; }
    .menu-item { display: flex; align-items: center; gap: 12px; padding: 12px 15px; color: #9ca3af; text-decoration: none; border-radius: 12px; transition: all 0.2s; margin-bottom: 5px; }
    .menu-item:hover { background: rgba(255,255,255,0.05); color: #fff; }
    .menu-item.active { background: #2563eb; color: #fff; box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3); }
    
    /* Copy lại các Class Stat-Card từ code cũ của Khoa vào đây */
    .stat-card { padding: 25px; border-radius: 20px; color: white; position: relative; overflow: hidden; min-height: 140px; display: flex; flex-direction: column; justify-content: center; transition: all 0.3s ease; }
    .stat-card i { position: absolute; right: -10px; bottom: -10px; font-size: 5.5rem; opacity: 0.15; transform: rotate(-15deg); }
    .stat-card h2 { font-weight: 800; font-size: 2.4rem; margin: 0; }
    .bg-grad-primary { background: linear-gradient(135deg, #4e73df 0%, #224abe 100%); }
    .bg-grad-success { background: linear-gradient(135deg, #1cc88a 0%, #13855c 100%); }
    .bg-grad-warning { background: linear-gradient(135deg, #f6c23e 0%, #dda20a 100%); color: #212529 !important; }
    .bg-grad-danger  { background: linear-gradient(135deg, #e74a3b 0%, #be2617 100%); }
</style>