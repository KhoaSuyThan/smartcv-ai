@model IEnumerable<DoAnCS.Models.User>
@{
    ViewData["Title"] = "Quản lý người dùng";
}

<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

<div class="container-fluid px-5 py-4" style="background-color: #f8fbff; min-height: 100vh;">
    @* --- HEADER: Thêm nút Dashboard ở đây --- *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold m-0">
                <i class='bx bxs-group text-primary me-2'></i>Quản lý người dùng
            </h2>
            <p class="text-muted small mb-0">Hệ thống đang có <span class="badge bg-info rounded-pill" style="color: #000 !important;">@Model.Count() thành viên</span></p>
        </div>
        <div class="d-flex gap-2">
            @* NÚT QUAY LẠI DASHBOARD QUAN TRỌNG *@
            <a href="/Admin" class="btn btn-white border shadow-sm rounded-pill px-4 fw-bold text-secondary">
                <i class='bx bx-left-arrow-alt'></i> Dashboard
            </a>
        </div>
    </div>

    @* --- BẢNG NGƯỜI DÙNG --- *@
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small text-uppercase">
                        <tr>
                            <th class="ps-4 py-3">Họ tên</th>
                            <th>Email</th>
                            <th>Vai trò</th>
                            <th>Công ty</th>
                            <th>Ngày tham gia</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm me-3 bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px;">
                                            @user.FullName.Substring(0, 1).ToUpper()
                                        </div>
                                        <strong class="text-dark">@user.FullName</strong>
                                        @if (user.IsPro)
                                        {
                                            <span class="ms-2 badge bg-warning rounded-pill" style="font-size: 0.6rem; vertical-align: middle; color: #000 !important;">
                                                <i class='bx bxs-crown'></i> PRO
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td class="text-muted">@user.Email</td>
                                <td>
                                    @if (user.Role == "Admin")
                                    {
                                        <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle px-3">Quản trị viên</span>
                                    }
                                    else if (user.Role == "Recruiter")
                                    {
                                        <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle px-3">Nhà tuyển dụng</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary-subtle text-secondary border border-secondary-subtle px-3">Ứng viên</span>
                                    }
                                </td>
                                <td>
                                    @if (user.Company != null)
                                    {
                                        <span class="text-dark fw-semibold"><i class='bx bx-buildings me-1'></i>@user.Company.Name</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">---</span>
                                    }
                                </td>
                                <td class="text-muted small">@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <button type="button" class="btn btn-sm btn-white border rounded-pill px-3 shadow-sm btn-edit-user" data-id="@user.UserID" data-fullname="@user.FullName" data-email="@user.Email" data-role="@user.Role" data-ispro="@user.IsPro.ToString().ToLower()" data-companyid="@user.CompanyID">
                                            <i class='bx bxs-edit text-warning'></i> Sửa
                                        </button>
                                        <button class="btn btn-sm btn-white border rounded-pill px-3 shadow-sm" onclick="confirmDelete(@user.UserID, '@user.FullName')">
                                            <i class='bx bxs-lock-alt text-danger'></i> Khóa
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-light { background-color: #f8f9fa !important; }
    .btn-white { background: white; transition: all 0.2s; }
    .btn-white:hover { background: #f1f5f9; transform: translateY(-2px); }
    
    /* Màu sắc Badge theo chuẩn hiện đại */
    .bg-danger-subtle { background-color: #fee2e2 !important; }
    .bg-primary-subtle { background-color: #e0f2fe !important; }
    .bg-secondary-subtle { background-color: #f3f4f6 !important; }
</style>

@* ================================================================= *@
@* MODAL CHỈNH SỬA THÀNH VIÊN *@
@* ================================================================= *@
<div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-warning text-dark py-3">
                <h5 class="modal-title fw-bold" id="editUserModalLabel">
                    <i class='bx bx-user-pin me-2'></i>Chỉnh sửa thành viên
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editUserForm" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Họ và tên</label>
                        <input type="text" name="FullName" id="editUserFullName" class="form-control border-2 py-2 rounded-3" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Email (Không được sửa)</label>
                        <input type="text" id="editUserEmail" class="form-control bg-light border-2 py-2 rounded-3" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Vai trò hệ thống</label>
                        <select name="Role" id="editUserRole" class="form-select border-2 py-2 rounded-3">
                            <option value="User">Ứng viên</option>
                            <option value="Recruiter">Nhà tuyển dụng</option>
                            <option value="Admin">Quản trị viên</option>
                        </select>
                    </div>

                    <div class="mb-3 form-check form-switch bg-light p-3 rounded-3 border">
                        <input class="form-check-input ms-0" type="checkbox" name="IsPro" id="editUserIsPro" value="true">
                        <label class="form-check-label fw-bold ms-2" for="editUserIsPro">
                            <i class='bx bxs-crown text-warning'></i> Kích hoạt gói PRO
                        </label>
                        <div class="small text-muted mt-1 ms-2">Người dùng Pro được dùng mô hình AI cao cấp và không giới hạn mẫu CV.</div>
                    </div>

                    <div class="mb-3" id="editUserCompanySection" style="display: none;">
                        <label class="form-label fw-bold">Thuộc Công ty</label>
                        <select name="CompanyID" id="editUserCompanyID" class="form-select border-2 py-2 rounded-3">
                            <option value="">-- Chọn công ty --</option>
                            @if (ViewBag.Companies != null)
                            {
                                foreach (var comp in ViewBag.Companies)
                                {
                                    <option value="@comp.CompanyID">@comp.Name</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 py-3">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 shadow fw-bold">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function confirmDelete(id, name) {
        if (confirm(`Bạn có chắc chắn muốn KHÓA tài khoản của [${name}] không?\nNgười dùng này sẽ không thể đăng nhập vào hệ thống.`)) {
            // Khoa dùng URL này để gọi action khóa nhé
            window.location.href = `/Admin/LockUser/${id}`;
        }
    }

    // --- XỬ LÝ SỬA USER QUA MODAL ---
    document.addEventListener("DOMContentLoaded", function () {
        const editUserButtons = document.querySelectorAll('.btn-edit-user');
        const editUserModalEl = document.getElementById('editUserModal');
        const editUserForm = document.getElementById('editUserForm');

        const editUserFullName = document.getElementById('editUserFullName');
        const editUserEmail = document.getElementById('editUserEmail');
        const editUserRole = document.getElementById('editUserRole');
        const editUserIsPro = document.getElementById('editUserIsPro');
        const editUserCompanySection = document.getElementById('editUserCompanySection');
        const editUserCompanyID = document.getElementById('editUserCompanyID');

        // Hàm kiểm tra và hiện ô chọn công ty
        function toggleCompanySection(role) {
            if (role === 'Recruiter') {
                editUserCompanySection.style.display = 'block';
            } else {
                editUserCompanySection.style.display = 'none';
                editUserCompanyID.value = ''; // Reset công ty nếu không là Recruiter
            }
        }

        // Lắng nghe thay đổi của select Role
        editUserRole.addEventListener('change', function() {
            toggleCompanySection(this.value);
        });

        // Click sửa
        editUserButtons.forEach(button => {
            button.addEventListener('click', function() {
                const id = this.getAttribute('data-id');
                const fullName = this.getAttribute('data-fullname');
                const email = this.getAttribute('data-email');
                const role = this.getAttribute('data-role');
                const isPro = this.getAttribute('data-ispro') === 'true';
                const companyId = this.getAttribute('data-companyid') || '';

                // Set form action động
                editUserForm.action = '/Admin/EditUser/' + id;

                // Gán dữ liệu
                editUserFullName.value = fullName;
                editUserEmail.value = email;
                editUserRole.value = role;
                editUserIsPro.checked = isPro;
                editUserCompanyID.value = companyId;

                // Cập nhật ẩn/hiển phần chọn công ty
                toggleCompanySection(role);

                // Show modal
                const modal = new bootstrap.Modal(editUserModalEl);
                modal.show();
            });
        });
    });
</script>