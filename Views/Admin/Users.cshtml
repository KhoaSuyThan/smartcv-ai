@model IEnumerable<DoAnCS.Models.User>
@{
    ViewData["Title"] = "Quản lý người dùng";
}

<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

<div class="container-fluid px-5 py-4" style="background-color: #f8fbff; min-height: 100vh;">
    @* --- HEADER: Thêm nút Dashboard ở đây --- *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold m-0">
                <i class='bx bxs-group text-primary me-2'></i>Quản lý người dùng
            </h2>
            <p class="text-muted small mb-0">Hệ thống đang có <span class="badge bg-info rounded-pill" style="color: #000 !important;">@Model.Count() thành viên</span></p>
        </div>
        <div class="d-flex gap-2">
            @* NÚT QUAY LẠI DASHBOARD QUAN TRỌNG *@
            <a href="/Admin" class="btn btn-white border shadow-sm rounded-pill px-4 fw-bold text-secondary">
                <i class='bx bx-left-arrow-alt'></i> Dashboard
            </a>
        </div>
    </div>

    @* --- BẢNG NGƯỜI DÙNG --- *@
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small text-uppercase">
                        <tr>
                            <th class="ps-4 py-3">Họ tên</th>
                            <th>Email</th>
                            <th>Vai trò</th>
                            <th>Công ty</th>
                            <th>Ngày tham gia</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm me-3 bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px;">
                                            @user.FullName.Substring(0, 1).ToUpper()
                                        </div>
                                        <strong class="text-dark">@user.FullName</strong>
                                        @if (user.IsPro)
                                        {
                                            <span class="ms-2 badge bg-warning rounded-pill" style="font-size: 0.6rem; vertical-align: middle; color: #000 !important;">
                                                <i class='bx bxs-crown'></i> PRO
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td class="text-muted">@user.Email</td>
                                <td>
                                    @if (user.Role == "Admin")
                                    {
                                        <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle px-3">Quản trị viên</span>
                                    }
                                    else if (user.Role == "Recruiter")
                                    {
                                        <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle px-3">Nhà tuyển dụng</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary-subtle text-secondary border border-secondary-subtle px-3">Ứng viên</span>
                                    }
                                </td>
                                <td>
                                    @if (user.Company != null)
                                    {
                                        <span class="text-dark fw-semibold"><i class='bx bx-buildings me-1'></i>@user.Company.Name</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">---</span>
                                    }
                                </td>
                                <td class="text-muted small">@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-action="EditUser" asp-route-id="@user.UserID" class="btn btn-sm btn-white border rounded-pill px-3 shadow-sm">
                                            <i class='bx bxs-edit text-warning'></i> Sửa
                                        </a>
                                        <button class="btn btn-sm btn-white border rounded-pill px-3 shadow-sm" onclick="confirmDelete(@user.UserID, '@user.FullName')">
                                            <i class='bx bxs-lock-alt text-danger'></i> Khóa
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-light { background-color: #f8f9fa !important; }
    .btn-white { background: white; transition: all 0.2s; }
    .btn-white:hover { background: #f1f5f9; transform: translateY(-2px); }
    
    /* Màu sắc Badge theo chuẩn hiện đại */
    .bg-danger-subtle { background-color: #fee2e2 !important; }
    .bg-primary-subtle { background-color: #e0f2fe !important; }
    .bg-secondary-subtle { background-color: #f3f4f6 !important; }
</style>

<script>
    function confirmDelete(id, name) {
        if (confirm(`Bạn có chắc chắn muốn KHÓA tài khoản của [${name}] không?\nNgười dùng này sẽ không thể đăng nhập vào hệ thống.`)) {
            // Khoa dùng URL này để gọi action khóa nhé
            window.location.href = `/Admin/LockUser/${id}`;
        }
    }
</script>