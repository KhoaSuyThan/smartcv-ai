@{
    ViewData["Title"] = "Automation Testing Dashboard";
}

<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
<link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<div class="testing-dashboard-page py-4">
    <div class="container-fluid px-4">
        
        <!-- Header Section -->
        <div class="dashboard-header d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold m-0 page-title">
                    <i class='bx bx-shield-quarter text-primary-gradient me-2 animate-float'></i>Automation Testing
                </h3>
                <p class="text-muted small mb-0 font-outfit">Hệ thống tự động giám sát sức khỏe, kiểm thử tích hợp API và chạy kịch bản E2E Playwright thời gian thực.</p>
            </div>
        </div>

        <!-- Custom Tabs Bar -->
        <ul class="nav nav-tabs border-0 mb-4 font-outfit" id="dashboardTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="system-tab" data-bs-toggle="tab" data-bs-target="#system-pane" type="button" role="tab" aria-controls="system-pane" aria-selected="true">
                    <i class='bx bx-desktop me-2'></i>Giám sát Hệ thống
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="e2e-tab" data-bs-toggle="tab" data-bs-target="#e2e-pane" type="button" role="tab" aria-controls="e2e-pane" aria-selected="false">
                    <i class='bx bx-play-circle me-2'></i>Kiểm thử Luồng E2E
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="history-tab" data-bs-toggle="tab" data-bs-target="#history-pane" type="button" role="tab" aria-controls="history-pane" aria-selected="false">
                    <i class='bx bx-history me-2'></i>Lịch sử Kiểm thử
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="config-tab" data-bs-toggle="tab" data-bs-target="#config-pane" type="button" role="tab" aria-controls="config-pane" aria-selected="false">
                    <i class='bx bx-cog me-2'></i>Cấu hình Kịch bản
                </button>
            </li>
        </ul>

        <!-- Tab Panes Content -->
        <div class="tab-content" id="dashboardTabsContent">
            
            <!-- TAB 1: SYSTEM HEALTH & API MONITOR -->
            <div class="tab-pane fade show active" id="system-pane" role="tabpanel" aria-labelledby="system-tab">
                <div class="d-flex justify-content-end mb-3">
                    <button id="btnRunSystemTests" class="btn btn-run-tests font-outfit shadow-sm" onclick="startSystemTests()">
                        <i class='bx bx-play-circle me-2 fs-5'></i>Kích hoạt Giám Sát
                    </button>
                </div>

                <div class="row g-4 mb-4">
                    <!-- Circular Progress -->
                    <div class="col-md-3">
                        <div class="glass-card stat-card d-flex align-items-center p-4">
                            <div class="circular-progress-wrapper me-3">
                                <svg class="circular-progress-svg" viewBox="0 0 100 100">
                                    <circle class="bg-circle" cx="50" cy="50" r="40"></circle>
                                    <circle id="successProgressCircle" class="fg-circle" cx="50" cy="50" r="40" style="stroke-dashoffset: 251.2;"></circle>
                                </svg>
                                <div class="progress-percentage font-outfit" id="percentageText">0%</div>
                            </div>
                            <div>
                                <h6 class="text-muted small mb-1 uppercase-label font-outfit">Tỷ lệ vượt qua</h6>
                                <h4 class="fw-bold mb-0 font-outfit text-gradient" id="statPassRate">0%</h4>
                                <small class="text-muted font-outfit" id="statPassDetails">0 / 0 test case</small>
                            </div>
                        </div>
                    </div>

                    <!-- Avg Response Time -->
                    <div class="col-md-3">
                        <div class="glass-card stat-card p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="icon-box-glass bg-blue">
                                    <i class='bx bx-timer fs-4 text-blue-glow'></i>
                                </div>
                                <span class="badge badge-trend bg-blue-soft text-blue font-outfit" id="timeTrend">N/A</span>
                            </div>
                            <h6 class="text-muted small mb-1 uppercase-label font-outfit">Thời gian chạy tb</h6>
                            <h3 class="fw-bold mb-1 font-outfit text-value" id="statAvgTime">0 ms</h3>
                            <p class="text-muted small mb-0 font-outfit" id="statMaxTime">Cao nhất: 0 ms</p>
                        </div>
                    </div>

                    <!-- Infrastructure Status -->
                    <div class="col-md-6">
                        <div class="glass-card stat-card p-4">
                            <h6 class="text-muted small mb-3 uppercase-label font-outfit"><i class='bx bx-server me-1'></i>Trạng thái các hạ tầng dịch vụ</h6>
                            <div class="row g-3">
                                <div class="col-4">
                                    <div class="service-status-box text-center p-2 rounded-3 border-glass">
                                        <i class='bx bx-data text-muted fs-4 mb-1' id="statusDbIcon"></i>
                                        <div class="small fw-semibold text-value font-outfit">SQL Server</div>
                                        <div class="status-indicator mt-1" id="statusDbBadge">
                                            <span class="dot-status bg-secondary"></span><span class="status-text font-outfit">Chưa kiểm tra</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="service-status-box text-center p-2 rounded-3 border-glass">
                                        <i class='bx bxl-python text-muted fs-4 mb-1' id="statusPythonIcon"></i>
                                        <div class="small fw-semibold text-value font-outfit">Python AI</div>
                                        <div class="status-indicator mt-1" id="statusPythonBadge">
                                            <span class="dot-status bg-secondary"></span><span class="status-text font-outfit">Chưa kiểm tra</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="service-status-box text-center p-2 rounded-3 border-glass">
                                        <i class='bx bx-brain text-muted fs-4 mb-1' id="statusGeminiIcon"></i>
                                        <div class="small fw-semibold text-value font-outfit">Gemini AI</div>
                                        <div class="status-indicator mt-1" id="statusGeminiBadge">
                                            <span class="dot-status bg-secondary"></span><span class="status-text font-outfit">Chưa kiểm tra</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-4">
                    <!-- Console Log -->
                    <div class="col-lg-6">
                        <div class="glass-card console-card p-0 d-flex flex-column">
                            <div class="console-header px-4 py-3 d-flex justify-content-between align-items-center border-bottom-glass">
                                <div class="d-flex align-items-center">
                                    <span class="console-dot bg-danger-dot me-2"></span>
                                    <span class="console-dot bg-warning-dot me-2"></span>
                                    <span class="console-dot bg-success-dot me-3"></span>
                                    <span class="fw-semibold text-muted font-outfit small"><i class='bx bx-terminal me-1'></i>MONITORING LOGS</span>
                                </div>
                                <button class="btn-clear-console" onclick="clearConsoleLog('consoleLogsSystem')"><i class='bx bx-trash me-1'></i>Xóa log</button>
                            </div>
                            <div class="console-body p-4 font-fira" id="consoleLogsSystem">
                                <div class="console-line text-muted">&gt; Ready to start system health check...</div>
                                <span class="console-cursor">_</span>
                            </div>
                        </div>
                    </div>

                    <!-- Detailed Results -->
                    <div class="col-lg-6">
                        <div class="glass-card results-card p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="fw-bold mb-0 font-outfit text-value"><i class='bx bx-list-check me-2 text-primary'></i>Chi Tiết Các Ca Kiểm Thử</h5>
                                <div class="btn-group filter-btn-group p-1 font-outfit" role="group">
                                    <button type="button" class="btn btn-filter active" id="btnFilterAll" onclick="filterResults('all', 'system')">Tất cả</button>
                                    <button type="button" class="btn btn-filter text-success" id="btnFilterPass" onclick="filterResults('success', 'system')">Thành công</button>
                                    <button type="button" class="btn btn-filter text-danger" id="btnFilterFail" onclick="filterResults('failed', 'system')">Thất bại</button>
                                </div>
                            </div>

                            <div class="accordion-results overflow-auto flex-grow-1 pe-1" id="systemTestCasesContainer" style="max-height: 480px;">
                                <div class="text-center text-muted my-5 py-5 font-outfit empty-results-state">
                                    <i class='bx bx-list-check fs-1 opacity-50 mb-3 text-primary-gradient'></i>
                                    <p class="mb-0">Chưa có kết quả kiểm thử nào được ghi nhận.</p>
                                    <p class="small text-muted">Kích hoạt kiểm thử để bắt đầu phân tích hệ thống.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 2: PLAYWRIGHT E2E AUTOMATION TESTING -->
            <div class="tab-pane fade" id="e2e-pane" role="tabpanel" aria-labelledby="e2e-tab">
                <div class="d-flex justify-content-end mb-3">
                    <button id="btnRunE2ETests" class="btn btn-run-tests font-outfit shadow-sm" onclick="startE2ETests()">
                        <i class='bx bx-play-circle me-2 fs-5'></i>Kích hoạt Kiểm Thử E2E
                    </button>
                </div>

                <div class="row g-4 mb-4">
                    <!-- Circular Progress -->
                    <div class="col-md-3">
                        <div class="glass-card stat-card d-flex align-items-center p-4">
                            <div class="circular-progress-wrapper me-3">
                                <svg class="circular-progress-svg" viewBox="0 0 100 100">
                                    <circle class="bg-circle" cx="50" cy="50" r="40"></circle>
                                    <circle id="successProgressCircleE2E" class="fg-circle" cx="50" cy="50" r="40" style="stroke-dashoffset: 251.2;"></circle>
                                </svg>
                                <div class="progress-percentage font-outfit" id="percentageTextE2E">0%</div>
                            </div>
                            <div>
                                <h6 class="text-muted small mb-1 uppercase-label font-outfit">Tỷ lệ vượt qua</h6>
                                <h4 class="fw-bold mb-0 font-outfit text-gradient" id="statPassRateE2E">0%</h4>
                                <small class="text-muted font-outfit" id="statPassDetailsE2E">0 / 0 test case</small>
                            </div>
                        </div>
                    </div>

                    <!-- Avg Response Time -->
                    <div class="col-md-3">
                        <div class="glass-card stat-card p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="icon-box-glass bg-purple">
                                    <i class='bx bx-timer fs-4 text-purple-glow'></i>
                                </div>
                                <span class="badge badge-trend bg-purple-soft text-purple font-outfit" id="timeTrendE2E">N/A</span>
                            </div>
                            <h6 class="text-muted small mb-1 uppercase-label font-outfit">Thời gian chạy tb</h6>
                            <h3 class="fw-bold mb-1 font-outfit text-value" id="statAvgTimeE2E">0 ms</h3>
                            <p class="text-muted small mb-0 font-outfit" id="statMaxTimeE2E">Cao nhất: 0 ms</p>
                        </div>
                    </div>

                    <!-- E2E Engine Status -->
                    <div class="col-md-6">
                        <div class="glass-card stat-card p-4">
                            <h6 class="text-muted small mb-3 uppercase-label font-outfit"><i class='bx bx-bot me-1'></i>Trạng thái Môi trường E2E</h6>
                            <div class="row g-3">
                                <div class="col-4">
                                    <div class="service-status-box text-center p-2 rounded-3 border-glass">
                                        <i class='bx bx-globe text-muted fs-4 mb-1' id="statusE2EBrowserIcon"></i>
                                        <div class="small fw-semibold text-value font-outfit">Playwright Chrome</div>
                                        <div class="status-indicator mt-1" id="statusE2EBrowserBadge">
                                            <span class="dot-status bg-success dot-pulse"></span><span class="status-text text-success font-outfit">Sẵn sàng</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="service-status-box text-center p-2 rounded-3 border-glass">
                                        <i class='bx bx-lock-open text-muted fs-4 mb-1' id="statusE2EBypassIcon"></i>
                                        <div class="small fw-semibold text-value font-outfit">OTP Bypass</div>
                                        <div class="status-indicator mt-1" id="statusE2EBypassBadge">
                                            <span class="dot-status bg-success dot-pulse"></span><span class="status-text text-success font-outfit">Hoạt động (123456)</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="service-status-box text-center p-2 rounded-3 border-glass">
                                        <i class='bx bx-user-check text-muted fs-4 mb-1' id="statusE2EAuthIcon"></i>
                                        <div class="small fw-semibold text-value font-outfit">Candidate/Recruiter</div>
                                        <div class="status-indicator mt-1" id="statusE2EAuthBadge">
                                            <span class="dot-status bg-success dot-pulse"></span><span class="status-text text-success font-outfit">Tự sinh & Dọn dẹp</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-4">
                    <!-- Console Log -->
                    <div class="col-lg-6">
                        <div class="glass-card console-card p-0 d-flex flex-column">
                            <div class="console-header px-4 py-3 d-flex justify-content-between align-items-center border-bottom-glass">
                                <div class="d-flex align-items-center">
                                    <span class="console-dot bg-danger-dot me-2"></span>
                                    <span class="console-dot bg-warning-dot me-2"></span>
                                    <span class="console-dot bg-success-dot me-3"></span>
                                    <span class="fw-semibold text-muted font-outfit small"><i class='bx bx-terminal me-1'></i>E2E PLAYWRIGHT CONSOLE LOGS</span>
                                </div>
                                <button class="btn-clear-console" onclick="clearConsoleLog('consoleLogsE2E')"><i class='bx bx-trash me-1'></i>Xóa log</button>
                            </div>
                            <div class="console-body p-4 font-fira" id="consoleLogsE2E">
                                <div class="console-line text-muted">&gt; Ready to start Playwright E2E testing...</div>
                                <span class="console-cursor">_</span>
                            </div>
                        </div>
                    </div>

                    <!-- Detailed Results -->
                    <div class="col-lg-6">
                        <div class="glass-card results-card p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="fw-bold mb-0 font-outfit text-value"><i class='bx bx-list-check me-2 text-primary'></i>Chi Tiết Các Ca Kiểm Thử E2E</h5>
                                <div class="btn-group filter-btn-group p-1 font-outfit" role="group">
                                    <button type="button" class="btn btn-filter active" id="btnFilterAllE2E" onclick="filterResults('all', 'e2e')">Tất cả</button>
                                    <button type="button" class="btn btn-filter text-success" id="btnFilterPassE2E" onclick="filterResults('success', 'e2e')">Thành công</button>
                                    <button type="button" class="btn btn-filter text-danger" id="btnFilterFailE2E" onclick="filterResults('failed', 'e2e')">Thất bại</button>
                                </div>
                            </div>

                            <div class="accordion-results overflow-auto flex-grow-1 pe-1" id="e2eTestCasesContainer" style="max-height: 480px;">
                                <div class="text-center text-muted my-5 py-5 font-outfit empty-results-state">
                                    <i class='bx bx-list-check fs-1 opacity-50 mb-3 text-primary-gradient'></i>
                                    <p class="mb-0">Chưa có kết quả kiểm thử nào được ghi nhận.</p>
                                    <p class="small text-muted">Kích hoạt kiểm thử để khởi chạy Playwright.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 3: RUN HISTORY -->
            <div class="tab-pane fade" id="history-pane" role="tabpanel" aria-labelledby="history-tab">
                <div class="glass-card p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold mb-0 font-outfit text-value"><i class='bx bx-history me-2 text-primary'></i>Lịch sử thực thi kiểm thử tự động</h5>
                        <button class="btn btn-outline-secondary btn-sm font-outfit rounded-pill px-3" onclick="loadTestHistory()">
                            <i class='bx bx-refresh me-1'></i>Làm mới danh sách
                        </button>
                    </div>

                    <div class="table-responsive">
                        <table class="table align-middle table-hover text-value font-outfit mb-0" id="historyTable">
                            <thead>
                                <tr class="text-muted border-bottom-glass" style="font-size: 0.85rem;">
                                    <th class="py-3">Mã lượt chạy</th>
                                    <th class="py-3">Bộ kiểm thử (Suite)</th>
                                    <th class="py-3">Thời gian thực thi</th>
                                    <th class="py-3 text-center">Tổng số ca</th>
                                    <th class="py-3 text-center">Thành công</th>
                                    <th class="py-3 text-center">Thất bại</th>
                                    <th class="py-3 text-center">Tỷ lệ đạt</th>
                                    <th class="py-3 text-end">Thời gian chạy TB</th>
                                    <th class="py-3 text-center" style="width: 150px;">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody id="historyTableBody">
                                <tr>
                                    <td colspan="9" class="text-center py-5 text-muted">
                                        <i class='bx bx-loader-alt bx-spin fs-3 mb-2'></i>
                                        <p class="mb-0">Đang tải lịch sử từ máy chủ...</p>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- TAB 4: SCENARIO CONFIGURATION -->
            <div class="tab-pane fade" id="config-pane" role="tabpanel" aria-labelledby="config-tab">
                <div class="row g-4">
                    <!-- Scenario Sidebar Selector -->
                    <div class="col-md-3">
                        <div class="glass-card p-4">
                            <h6 class="text-muted small mb-3 uppercase-label font-outfit">Chọn kịch bản E2E</h6>
                            <div class="d-flex flex-column gap-3 font-outfit">
                                <button class="btn btn-scenario-select active w-100 text-start p-3 rounded-3" id="btnSelectAuthScenario" onclick="selectScenario('Auth E2E')">
                                    <div class="fw-bold"><i class='bx bx-user me-2'></i>Auth E2E Scenario</div>
                                    <small class="text-muted opacity-75 d-block mt-1">Đăng ký -> OTP -> Đăng nhập -> Đăng xuất</small>
                                </button>
                                <button class="btn btn-scenario-select w-100 text-start p-3 rounded-3" id="btnSelectJobsScenario" onclick="selectScenario('Jobs E2E')">
                                    <div class="fw-bold"><i class='bx bx-briefcase me-2'></i>Jobs E2E Scenario</div>
                                    <small class="text-muted opacity-75 d-block mt-1">Đăng Recruiter -> Tạo tin -> Sửa tin -> Xóa tin</small>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Steps Editor Panel -->
                    <div class="col-md-9">
                        <div class="glass-card p-4 d-flex flex-column" style="min-height: 500px;">
                            <div class="d-flex justify-content-between align-items-center mb-4 border-bottom-glass pb-3 flex-wrap gap-2">
                                <div>
                                    <h5 class="fw-bold mb-1 font-outfit text-value" id="editorTitle">Cấu hình kịch bản: Auth E2E</h5>
                                    <p class="text-muted small mb-0 font-outfit">Thêm, xóa, chỉnh sửa các bước thực thi Playwright trực tiếp trên trình duyệt.</p>
                                </div>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-outline-secondary btn-sm font-outfit rounded-pill px-3" id="btnToggleMode" onclick="toggleEditMode()">
                                        <i class='bx bx-code-alt me-1'></i>Chỉnh sửa JSON
                                    </button>
                                    <button class="btn btn-outline-primary btn-sm font-outfit rounded-pill px-3" id="btnAddStep" onclick="addTestStep()">
                                        <i class='bx bx-plus-circle me-1'></i>Thêm bước
                                    </button>
                                    <button class="btn btn-save-steps font-outfit rounded-pill px-4" onclick="saveTestSteps()">
                                        <i class='bx bx-save me-1'></i>Lưu kịch bản
                                    </button>
                                </div>
                            </div>

                            <!-- Steps List Wrapper -->
                            <div class="steps-editor-container flex-grow-1 pe-1" id="stepsEditorContainer" style="max-height: 520px; overflow-y: auto;">
                                <!-- Dynamic steps will be rendered here -->
                            </div>

                            <!-- JSON Raw Editor Wrapper (Hidden by default) -->
                            <div class="json-editor-container flex-grow-1 pe-1 d-none" id="jsonEditorContainer">
                                <textarea class="form-control font-fira bg-dark text-success border-glass p-3 h-100" id="jsonTextarea" style="min-height: 480px; resize: vertical; line-height: 1.5; font-size: 0.85rem;" placeholder="Nhập kịch bản dưới dạng JSON..."></textarea>
                                <div class="mt-2 text-muted small"><i class='bx bx-info-circle me-1'></i>Định dạng JSON hợp lệ phải là một mảng danh sách các đối tượng bước kiểm thử. Bạn có thể copy/paste hoặc sửa nhanh hàng loạt.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>

<!-- Glassmorphic Modal for viewing test run details -->
<div class="modal fade glass-modal" id="testDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content glass-card">
            <div class="modal-header border-bottom-glass py-3 px-4 d-flex justify-content-between align-items-center">
                <h5 class="modal-title font-outfit text-value fw-bold" id="modalSuiteName">Chi tiết Lượt Kiểm thử</h5>
                <button type="button" class="btn-close-glass" data-bs-dismiss="modal" aria-label="Close">
                    <i class='bx bx-x fs-3'></i>
                </button>
            </div>
            <div class="modal-body p-4 overflow-auto" style="max-height: 500px;" id="modalTestCasesContainer">
                <!-- Test cases rendered here -->
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --glass-bg-light: rgba(255, 255, 255, 0.45);
        --glass-bg-dark: rgba(30, 41, 59, 0.45);
        --glass-border-light: rgba(255, 255, 255, 0.25);
