<script>
    let systemTestResult = null; // Lưu trữ kết quả suite hệ thống
    let e2eTestResult = null;    // Lưu trữ kết quả suite E2E

    // Đồng bộ Tab với URL Hash để hỗ trợ Refresh & Back/Forward
    function syncTabWithHash() {
        const hash = window.location.hash || '#system';
        const targetTabButton = document.querySelector(`#dashboardTabs button[data-bs-target="${hash}-pane"]`);
        if (targetTabButton) {
            const activeTabButton = document.querySelector('#dashboardTabs button.active');
            if (activeTabButton !== targetTabButton) {
                const tab = bootstrap.Tab.getOrCreateInstance(targetTabButton);
                tab.show();
            }
            
            // Kích hoạt nạp dữ liệu tương ứng dựa trên tab
            if (hash === '#history') {
                loadTestHistory();
            } else if (hash === '#config') {
                loadScenarioSteps();
            }
        }
    }

    // Khi khởi tạo trang, đăng ký sự kiện đồng bộ URL
    document.addEventListener('DOMContentLoaded', function () {
        const tabButtons = document.querySelectorAll('#dashboardTabs button[data-bs-toggle="tab"]');
        tabButtons.forEach(btn => {
            btn.addEventListener('shown.bs.tab', function (e) {
                const targetHash = e.target.getAttribute('data-bs-target').replace('-pane', '');
                if (window.location.hash !== targetHash) {
                    history.pushState(null, null, targetHash);
                }
                
                // Nạp dữ liệu khi người dùng chuyển sang tab Lịch sử hoặc Cấu hình
                if (targetHash === '#history') {
                    loadTestHistory();
                } else if (targetHash === '#config') {
                    loadScenarioSteps();
                }
            });
        });

        // Kích hoạt đồng bộ tab dựa trên hash hiện tại
        syncTabWithHash();
    });

    // Lắng nghe sự kiện di chuyển Back/Forward trong lịch sử trình duyệt
    window.addEventListener('hashchange', syncTabWithHash);
    window.addEventListener('popstate', syncTabWithHash);

    // Xóa log console hiển thị
    function clearConsoleLog(containerId) {
        const consoleLogs = document.getElementById(containerId);
        consoleLogs.innerHTML = `<div class="console-line text-muted">&gt; Terminal cleared. Ready to start new test run...</div><span class="console-cursor">_</span>`;
    }

    // In log ra màn hình console giả lập kèm màu sắc tương ứng
    function writeConsoleLog(containerId, text, type = "info") {
        const container = document.getElementById(containerId);
        const cursor = container.querySelector(".console-cursor");
        
        const line = document.createElement("div");
        line.className = "console-line";
        
        let colorClass = "text-light";
        if (type === "success") colorClass = "text-success"; 
        else if (type === "error") colorClass = "text-danger"; 
        else if (type === "warning") colorClass = "text-warning"; 
        else if (type === "muted") colorClass = "text-muted"; 
        else if (type === "info") colorClass = "text-info"; 

        const now = new Date();
        const timeStr = `[${now.getHours().toString().padStart(2,'0')}:${now.getMinutes().toString().padStart(2,'0')}:${now.getSeconds().toString().padStart(2,'0')}]`;
        
        line.innerHTML = `<span class="text-muted font-fira">${timeStr}</span> <span class="${colorClass}">&gt; ${text}</span>`;
        
        container.insertBefore(line, cursor);
        container.scrollTop = container.scrollHeight;
    }

    // Hiệu ứng chữ chạy từng dòng log cho mượt mà
    function printStaggeredLogs(containerId, lines, callback) {
        let index = 0;
        const container = document.getElementById(containerId);
        const cursor = container.querySelector(".console-cursor");
        
        function printNext() {
            if (index < lines.length) {
                const lineData = lines[index];
                const line = document.createElement("div");
                line.className = "console-line";
                
                let colorClass = "text-light";
                if (lineData.type === "success") colorClass = "text-success";
                else if (lineData.type === "error") colorClass = "text-danger";
                else if (lineData.type === "warning") colorClass = "text-warning";
                else if (lineData.type === "muted") colorClass = "text-muted";
                else if (lineData.type === "info") colorClass = "text-info";
                
                const now = new Date();
                const timeStr = `[${now.getHours().toString().padStart(2,'0')}:${now.getMinutes().toString().padStart(2,'0')}:${now.getSeconds().toString().padStart(2,'0')}]`;
                
                line.innerHTML = `<span class="text-muted font-fira">${timeStr}</span> <span class="${colorClass}">&gt; ${lineData.text}</span>`;
                
                container.insertBefore(line, cursor);
                container.scrollTop = container.scrollHeight;
                index++;
                setTimeout(printNext, 120);
            } else {
                if (callback) callback();
            }
        }
        printNext();
    }

    // Toggle đóng mở hiển thị chi tiết test case
    function toggleTestCaseDetail(element) {
        const body = element.nextElementSibling;
        const arrow = element.querySelector(".tc-arrow");
        
        if (body.style.display === "block") {
            body.style.display = "none";
            if (arrow) arrow.style.transform = "rotate(0deg)";
        } else {
            body.style.display = "block";
            if (arrow) arrow.style.transform = "rotate(90deg)";
        }
    }

    // Lọc danh sách test case dựa trên bộ lọc hoạt động (tất cả, pass, fail)
    function filterResults(filterType, type) {
        if (type === 'system') {
            document.querySelectorAll("#system-pane .btn-filter").forEach(b => b.classList.remove("active"));
            if (filterType === 'all') document.getElementById("btnFilterAll").classList.add("active");
            else if (filterType === 'success') document.getElementById("btnFilterPass").classList.add("active");
            else if (filterType === 'failed') document.getElementById("btnFilterFail").classList.add("active");
            renderTestCasesList('systemTestCasesContainer', systemTestResult, filterType);
        } else {
            document.querySelectorAll("#e2e-pane .btn-filter").forEach(b => b.classList.remove("active"));
            if (filterType === 'all') document.getElementById("btnFilterAllE2E").classList.add("active");
            else if (filterType === 'success') document.getElementById("btnFilterPassE2E").classList.add("active");
            else if (filterType === 'failed') document.getElementById("btnFilterFailE2E").classList.add("active");
            renderTestCasesList('e2eTestCasesContainer', e2eTestResult, filterType);
        }
    }

    // Cập nhật các service status badges cho System Check
    function updateServiceBadges(testCases) {
        testCases.forEach(tc => {
            let iconId = "";
            let badgeId = "";
            
            if (tc.name.includes("SQL Server")) {
                iconId = "statusDbIcon";
                badgeId = "statusDbBadge";
            } else if (tc.name.includes("Python FastAPI")) {
                iconId = "statusPythonIcon";
                badgeId = "statusPythonBadge";
            } else if (tc.name.includes("Gemini")) {
                iconId = "statusGeminiIcon";
                badgeId = "statusGeminiBadge";
            }

            if (iconId && badgeId) {
                const iconEl = document.getElementById(iconId);
                const badgeEl = document.getElementById(badgeId);

                if (tc.status === "Success") {
                    iconEl.className = "bx bx-check-shield text-success fs-4 mb-1 animate-float";
                    badgeEl.innerHTML = `<span class="dot-status bg-success dot-pulse"></span><span class="status-text text-success font-outfit">Hoạt động</span>`;
                } else {
                    iconEl.className = "bx bx-error text-danger fs-4 mb-1";
                    badgeEl.innerHTML = `<span class="dot-status bg-danger dot-pulse"></span><span class="status-text text-danger font-outfit">Lỗi kết nối</span>`;
                }
            }
        });
    }

    // Hiển thị biểu đồ tròn Success rate
    function updateProgressCircle(circleId, textId, rateId, detailsId, passed, total) {
        const percentage = total > 0 ? (passed / total) * 100 : 0;
        const circle = document.getElementById(circleId);
        const radius = circle.r.baseVal.value;
        const circumference = 2 * Math.PI * radius; 
        
        const offset = circumference - (percentage / 100) * circumference;
        circle.style.strokeDashoffset = offset;
        
        document.getElementById(textId).innerText = `${Math.round(percentage)}%`;
        document.getElementById(rateId).innerText = `${Math.round(percentage)}%`;
        document.getElementById(detailsId).innerText = `${passed} / ${total} test case`;
    }

    // Render danh sách test case
    function renderTestCasesList(containerId, suite, filter = "all") {
        const container = document.getElementById(containerId);
        container.innerHTML = "";

        if (!suite || !suite.testCases || suite.testCases.length === 0) {
            container.innerHTML = `
                <div class="text-center text-muted my-5 py-5 font-outfit">
                    <i class='bx bx-list-check fs-1 opacity-50 mb-3 text-primary-gradient'></i>
                    <p class="mb-0">Chưa có kết quả kiểm thử nào.</p>
                </div>`;
            return;
        }

        const cases = suite.testCases.filter(tc => {
            if (filter === "all") return true;
            if (filter === "success") return tc.status === "Success";
            if (filter === "failed") return tc.status === "Failed";
            return true;
        });

        if (cases.length === 0) {
            container.innerHTML = `
                <div class="text-center text-muted my-5 py-5 font-outfit">
                    <p class="mb-0">Không có ca kiểm thử nào khớp với bộ lọc.</p>
                </div>`;
            return;
        }

        cases.forEach(tc => {
            const item = document.createElement("div");
            item.className = "test-case-item shadow-sm border-glass";
            
            const isPass = tc.status === "Success";
            const badgeClass = isPass ? "badge-status-pass" : "badge-status-fail";
            const statusLabel = isPass ? "Thành công" : "Thất bại";
            const statusIcon = isPass ? "bx-check-circle" : "bx-x-circle";
            
            let methodClass = "bg-get";
            if (tc.method.includes("POST")) methodClass = "bg-post";
            else if (tc.method.includes("EF") || tc.method.includes("Playwright")) methodClass = "bg-ef";

            item.innerHTML = `
                <div class="tc-header" onclick="toggleTestCaseDetail(this)">
                    <div class="d-flex align-items-center gap-3">
                        <span class="bg-method ${methodClass} font-fira">${tc.method}</span>
                        <div style="text-align: left;">
                            <div class="tc-title font-outfit">${tc.name}</div>
                            <div class="tc-meta font-fira">${tc.url}</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <span class="tc-duration font-outfit"><i class='bx bx-time-five me-1'></i>${tc.responseTimeMs} ms</span>
                        <span class="badge-status ${badgeClass} font-outfit">
                            <i class='bx ${statusIcon}'></i>${statusLabel}
                        </span>
                        <i class='bx bx-chevron-right tc-arrow text-muted fs-5' style="transition: transform 0.2s;"></i>
                    </div>
                </div>
                <div class="tc-body" style="text-align: left;">
                    <div class="tc-detail-row">
                        <div class="tc-detail-label font-outfit">Kết quả mong đợi:</div>
                        <div class="tc-detail-value font-outfit">${tc.expected || tc.expectedResult || "N/A"}</div>
                    </div>
                    <div class="tc-detail-row">
                        <div class="tc-detail-label font-outfit">Kết quả thực tế:</div>
                        <div class="tc-detail-value font-outfit">${tc.actual || tc.actualResult || "N/A"}</div>
                    </div>
                    ${(tc.errorMessage) ? `
                    <div class="tc-detail-row mt-2">
                        <div class="tc-detail-label text-danger font-outfit">Lỗi hệ thống:</div>
                        <div class="tc-detail-value text-danger font-fira bg-dark p-2 rounded-3 text-sm overflow-auto" style="max-height:120px; width:100%">${tc.errorMessage}</div>
                    </div>` : ""}
                </div>
            `;
            container.appendChild(item);
        });
    }

    // CHẠY GIÁM SÁT HỆ THỐNG (Tab 1)
    function startSystemTests() {
        const btn = document.getElementById("btnRunSystemTests");
        btn.disabled = true;
        btn.innerHTML = `<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Đang kiểm tra...`;
        
        clearConsoleLog("consoleLogsSystem");
        writeConsoleLog("consoleLogsSystem", "Đang khởi tạo các luồng giám sát hệ thống...", "info");
        
        fetch("/Admin/RunSystemTestSuite", { method: "POST" })
        .then(res => res.json())
        .then(data => {
            btn.disabled = false;
            btn.innerHTML = `<i class='bx bx-play-circle me-2 fs-5'></i>Kích hoạt Giám Sát`;

            if (data.success) {
                systemTestResult = data.suite;
                
                const logsToPrint = [
                    { text: "Máy chủ phản hồi yêu cầu. Đang giải nén các kịch bản sức khỏe...", type: "info" }
                ];

                let totalTime = 0;
                let maxTime = 0;
                let passed = 0;

                systemTestResult.testCases.forEach(tc => {
                    totalTime += tc.responseTimeMs;
                    if (tc.responseTimeMs > maxTime) maxTime = tc.responseTimeMs;
                    if (tc.status === "Success") {
                        passed++;
                        logsToPrint.push({ text: `[PASS] ${tc.name} (${tc.responseTimeMs}ms) - ${tc.actual}`, type: "success" });
                    } else {
                        logsToPrint.push({ text: `[FAIL] ${tc.name} (${tc.responseTimeMs}ms) - ${tc.actual}`, type: "error" });
                    }
                });

                const total = systemTestResult.testCases.length;
                const avgTime = total > 0 ? Math.round(totalTime / total) : 0;
                
                logsToPrint.push({ text: `Hoàn tất chạy giám sát! Tỷ lệ vượt qua: ${passed}/${total}.`, type: "warning" });

                // In console logs dạng staggered hiệu ứng
                printStaggeredLogs("consoleLogsSystem", logsToPrint, () => {
                    updateProgressCircle("successProgressCircle", "percentageText", "statPassRate", "statPassDetails", passed, total);
                    document.getElementById("statAvgTime").innerText = `${avgTime} ms`;
                    document.getElementById("statMaxTime").innerText = `Cao nhất: ${maxTime} ms`;
                    document.getElementById("timeTrend").innerText = `Avg: ${avgTime}ms`;
                    
                    updateServiceBadges(systemTestResult.testCases);
                    renderTestCasesList("systemTestCasesContainer", systemTestResult, "all");
                });
            } else {
                writeConsoleLog("consoleLogsSystem", "Kiểm thử thất bại: " + data.message, "error");
                alert("Kiểm thử thất bại: " + data.message);
            }
        })
        .catch(err => {
            btn.disabled = false;
            btn.innerHTML = `<i class='bx bx-play-circle me-2 fs-5'></i>Kích hoạt Giám Sát`;
            writeConsoleLog("consoleLogsSystem", "Lỗi gửi request kiểm thử.", "error");
        });
    }

    // CHẠY KIỂM THỬ E2E PLAYWRIGHT (Tab 2)
    function startE2ETests() {
        const btn = document.getElementById("btnRunE2ETests");
        btn.disabled = true;
        btn.innerHTML = `<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Đang chạy E2E Playwright...`;
        
        clearConsoleLog("consoleLogsE2E");
        
        const initLogs = [
            { text: "Đang khởi tạo Playwright E2E Runner trên máy chủ...", type: "info" },
            { text: "Mở phiên trình duyệt ẩn danh Chromium...", type: "info" },
            { text: "Bắt đầu chạy luồng kiểm thử. Quá trình E2E có thể mất 15-30 giây để hoàn thành...", type: "warning" }
        ];

        printStaggeredLogs("consoleLogsE2E", initLogs, () => {
            fetch("/Admin/RunE2ETestSuite", { method: "POST" })
            .then(res => res.json())
            .then(data => {
                btn.disabled = false;
                btn.innerHTML = `<i class='bx bx-play-circle me-2 fs-5'></i>Kích hoạt Kiểm Thử E2E`;

                if (data.success) {
                    e2eTestResult = data.suite;
                    
                    const logsToPrint = [];
                    let totalTime = 0;
                    let maxTime = 0;
                    let passed = 0;

                    e2eTestResult.testCases.forEach(tc => {
                        totalTime += tc.responseTimeMs;
                        if (tc.responseTimeMs > maxTime) maxTime = tc.responseTimeMs;
                        if (tc.status === "Success") {
                            passed++;
                            logsToPrint.push({ text: `[PASS] ${tc.name} (${tc.responseTimeMs}ms)`, type: "success" });
                            logsToPrint.push({ text: `   -> Kết quả: ${tc.actual}`, type: "muted" });
                        } else {
                            logsToPrint.push({ text: `[FAIL] ${tc.name} (${tc.responseTimeMs}ms)`, type: "error" });
                            logsToPrint.push({ text: `   -> Chi tiết: ${tc.actual}`, type: "error" });
                            if (tc.errorMessage) {
                                logsToPrint.push({ text: `   -> Lỗi: ${tc.errorMessage.substring(0, 150)}...`, type: "error" });
                            }
                        }
                    });

                    const total = e2eTestResult.testCases.length;
                    const avgTime = total > 0 ? Math.round(totalTime / total) : 0;
                    
                    logsToPrint.push({ text: `Hoàn thành kiểm thử Playwright E2E! Tỷ lệ đạt: ${passed}/${total}.`, type: "warning" });

                    printStaggeredLogs("consoleLogsE2E", logsToPrint, () => {
                        updateProgressCircle("successProgressCircleE2E", "percentageTextE2E", "statPassRateE2E", "statPassDetailsE2E", passed, total);
                        document.getElementById("statAvgTimeE2E").innerText = `${avgTime} ms`;
                        document.getElementById("statMaxTimeE2E").innerText = `Cao nhất: ${maxTime} ms`;
                        document.getElementById("timeTrendE2E").innerText = `Avg: ${avgTime}ms`;
                        
                        renderTestCasesList("e2eTestCasesContainer", e2eTestResult, "all");
                    });
                } else {
                    writeConsoleLog("consoleLogsE2E", "Lỗi thực thi kiểm thử E2E: " + data.message, "error");
                    alert("Lỗi thực thi E2E: " + data.message);
                }
            })
            .catch(err => {
                btn.disabled = false;
                btn.innerHTML = `<i class='bx bx-play-circle me-2 fs-5'></i>Kích hoạt Kiểm Thử E2E`;
                writeConsoleLog("consoleLogsE2E", "Thất bại khi kết nối server E2E.", "error");
            });
        });
    }

    // TẢI LỊCH SỬ KIỂM THỬ (Tab 3)
    function loadTestHistory() {
        const tbody = document.getElementById("historyTableBody");
        tbody.innerHTML = `
            <tr>
                <td colspan="9" class="text-center py-5 text-muted">
                    <i class='bx bx-loader-alt bx-spin fs-3 mb-2'></i>
                    <p class="mb-0">Đang tải lịch sử từ database...</p>
                </td>
            </tr>`;

        fetch("/Admin/GetTestHistory")
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                tbody.innerHTML = "";
                if (data.history.length === 0) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class='bx bx-data fs-2 mb-2'></i>
                                <p class="mb-0">Chưa có lịch sử chạy kiểm thử nào được lưu trong database.</p>
                            </td>
                        </tr>`;
                    return;
                }

                data.history.forEach(run => {
                    const date = new Date(run.executionTime);
                    const dateStr = `${date.getDate().toString().padStart(2,'0')}/${(date.getMonth()+1).toString().padStart(2,'0')}/${date.getFullYear()} ${date.getHours().toString().padStart(2,'0')}:${date.getMinutes().toString().padStart(2,'0')}`;
                    
                    const rate = run.totalCases > 0 ? Math.round((run.passedCases / run.totalCases) * 100) : 0;
                    let rateClass = "text-danger";
                    if (rate >= 80) rateClass = "text-success";
                    else if (rate >= 50) rateClass = "text-warning";

                    const tr = document.createElement("tr");
                    tr.className = "border-bottom-glass";
                    tr.innerHTML = `
                        <td class="fw-bold">#${run.testRunID}</td>
                        <td class="fw-semibold text-value">${run.suiteName}</td>
                        <td>${dateStr}</td>
                        <td class="text-center">${run.totalCases}</td>
                        <td class="text-center text-success fw-semibold">${run.passedCases}</td>
                        <td class="text-center text-danger fw-semibold">${run.failedCases}</td>
                        <td class="text-center fw-bold ${rateClass}">${rate}%</td>
                        <td class="text-end fw-semibold">${run.avgResponseTimeMs} ms</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-outline-primary rounded-pill px-2.5 me-1" onclick="viewHistoryDetails(${run.testRunID})" title="Xem chi tiết">
                                <i class='bx bx-show-alt'></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger rounded-pill px-2.5" onclick="deleteHistoryRun(${run.testRunID})" title="Xóa lịch sử">
                                <i class='bx bx-trash'></i>
                            </button>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
            } else {
                tbody.innerHTML = `<tr><td colspan="9" class="text-center text-danger py-4">Lỗi: ${data.message}</td></tr>`;
            }
        })
        .catch(err => {
            tbody.innerHTML = `<tr><td colspan="9" class="text-center text-danger py-4">Không thể kết nối đến máy chủ lấy lịch sử.</td></tr>`;
        });
    }

