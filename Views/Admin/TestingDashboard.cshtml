    // XÓA LỊCH SỬ KIỂM THỬ KHỎI DATABASE
    function deleteHistoryRun(runId) {
        if (!confirm(`Bạn có chắc chắn muốn xóa lượt kiểm thử #${runId} khỏi cơ sở dữ liệu?`)) {
            return;
        }

        fetch(`/Admin/DeleteTestRun?id=${runId}`, { method: "POST" })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                loadTestHistory();
            } else {
                alert("Xóa lịch sử thất bại: " + data.message);
            }
        })
        .catch(err => {
            alert("Lỗi khi kết nối đến máy chủ.");
        });
    }

    // DỮ LIỆU CẤU HÌNH KỊCH BẢN ĐỘNG
    let currentScenario = "Auth E2E";
    let scenarioSteps = [];
    let isJsonMode = false; // Theo dõi chế độ chỉnh sửa (Visual vs JSON)

    // Chuyển đổi qua lại giữa chế độ trực quan và chỉnh sửa JSON thô
    function toggleEditMode() {
        const visualContainer = document.getElementById("stepsEditorContainer");
        const jsonContainer = document.getElementById("jsonEditorContainer");
        const jsonTextarea = document.getElementById("jsonTextarea");
        const toggleBtn = document.getElementById("btnToggleMode");
        const addBtn = document.getElementById("btnAddStep");

        if (!isJsonMode) {
            // Chuyển từ Trực quan sang JSON
            const cleanSteps = scenarioSteps.map(s => ({
                actionType: s.actionType,
                targetSelector: s.targetSelector || "",
                value: s.value || "",
                description: s.description || ""
            }));

            jsonTextarea.value = JSON.stringify(cleanSteps, null, 4);

            visualContainer.classList.add("d-none");
            jsonContainer.classList.remove("d-none");
            if (addBtn) addBtn.classList.add("d-none");

            toggleBtn.innerHTML = `<i class='bx bx-list-ol me-1'></i>Chỉnh sửa trực quan`;
            isJsonMode = true;
        } else {
            // Chuyển từ JSON sang Trực quan
            try {
                const parsed = JSON.parse(jsonTextarea.value);
                if (!Array.isArray(parsed)) {
                    alert("Dữ liệu JSON phải là một mảng (Array) chứa danh sách các bước!");
                    return;
                }

                scenarioSteps = parsed.map((s, idx) => ({
                    stepID: 0,
                    scenarioName: currentScenario,
                    stepOrder: idx + 1,
                    actionType: s.actionType || "Navigate",
                    targetSelector: s.targetSelector || "",
                    value: s.value || "",
                    description: s.description || `Mô tả bước #${idx + 1}`
                }));

                renderScenarioSteps();

                visualContainer.classList.remove("d-none");
                jsonContainer.classList.add("d-none");
                if (addBtn) addBtn.classList.remove("d-none");

                toggleBtn.innerHTML = `<i class='bx bx-code-alt me-1'></i>Chỉnh sửa JSON`;
                isJsonMode = false;
            } catch (ex) {
                alert("Lỗi cú pháp JSON không hợp lệ! Vui lòng kiểm tra lại cấu trúc dấu ngoặc, dấu phẩy.\nChi tiết: " + ex.message);
            }
        }
    }

    // Chọn kịch bản và tải danh sách các bước
    function selectScenario(scenarioName) {
        currentScenario = scenarioName;
        
        // Reset về chế độ trực quan khi chuyển kịch bản
        isJsonMode = false;
        document.getElementById("stepsEditorContainer").classList.remove("d-none");
        document.getElementById("jsonEditorContainer").classList.add("d-none");
        document.getElementById("btnToggleMode").innerHTML = `<i class='bx bx-code-alt me-1'></i>Chỉnh sửa JSON`;
        const addBtn = document.getElementById("btnAddStep");
        if (addBtn) addBtn.classList.remove("d-none");
        
        // Cập nhật class active cho nút chọn kịch bản
        document.getElementById("btnSelectAuthScenario").classList.toggle("active", scenarioName === "Auth E2E");
        document.getElementById("btnSelectJobsScenario").classList.toggle("active", scenarioName === "Jobs E2E");
        
        // Cập nhật tiêu đề editor
        document.getElementById("editorTitle").innerText = `Cấu hình kịch bản: ${scenarioName}`;
        
        loadScenarioSteps();
    }

    // Tải danh sách các bước từ Server
    function loadScenarioSteps() {
        const container = document.getElementById("stepsEditorContainer");
        container.innerHTML = `
            <div class="text-center text-muted my-5 py-5">
                <i class='bx bx-loader-alt bx-spin fs-2 mb-2 text-primary'></i>
                <p>Đang tải danh sách các bước từ cơ sở dữ liệu...</p>
            </div>
        `;

        fetch(`/Admin/GetTestSteps?scenarioName=${currentScenario}`)
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                scenarioSteps = data.steps;
                renderScenarioSteps();
            } else {
                container.innerHTML = `<div class="alert alert-danger font-outfit m-3">Không thể tải kịch bản: ${data.message}</div>`;
            }
        })
        .catch(err => {
            container.innerHTML = `<div class="alert alert-danger font-outfit m-3">Lỗi kết nối máy chủ khi tải kịch bản.</div>`;
        });
    }

    // Hiển thị danh sách các bước lên giao diện editor
    function renderScenarioSteps() {
        const container = document.getElementById("stepsEditorContainer");
        container.innerHTML = "";

        if (scenarioSteps.length === 0) {
            container.innerHTML = `
                <div class="text-center text-muted my-5 py-5 border-dashed rounded-3">
                    <i class='bx bx-list-ol fs-1 opacity-50 mb-3 text-primary-gradient'></i>
                    <p class="mb-0">Kịch bản này hiện chưa có bước nào.</p>
                    <p class="small">Bấm "Thêm bước" ở phía trên để bắt đầu.</p>
                </div>
            `;
            return;
        }

        scenarioSteps.forEach((step, index) => {
            const card = document.createElement("div");
            card.className = "glass-card step-editor-card p-3 mb-3 border-glass";
            card.setAttribute("data-step-index", index);

            card.innerHTML = `
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary rounded-circle px-2 py-1" style="font-size: 0.8rem; line-height: 1;">${index + 1}</span>
                        <span class="fw-semibold text-value font-outfit">Bước #${step.stepOrder || (index + 1)}</span>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-icon-glass btn-sm" onclick="moveStep(${index}, -1)" ${index === 0 ? 'disabled' : ''} title="Di chuyển lên">
                            <i class='bx bx-chevron-up fs-5'></i>
                        </button>
                        <button class="btn btn-icon-glass btn-sm" onclick="moveStep(${index}, 1)" ${index === scenarioSteps.length - 1 ? 'disabled' : ''} title="Di chuyển xuống">
                            <i class='bx bx-chevron-down fs-5'></i>
                        </button>
                        <button class="btn btn-icon-glass btn-sm text-danger" onclick="deleteStep(${index})" title="Xóa bước này">
                            <i class='bx bx-trash fs-5'></i>
                        </button>
                    </div>
                </div>
                <div class="row g-3 font-outfit">
                    <div class="col-md-3">
                        <label class="form-label text-muted small fw-semibold">Loại hành động</label>
                        <select class="form-select bg-dark-soft text-value border-glass" onchange="updateStepField(${index}, 'actionType', this.value)">
                            <option value="Navigate" ${step.actionType === 'Navigate' ? 'selected' : ''}>Navigate (Điều hướng)</option>
                            <option value="Fill" ${step.actionType === 'Fill' ? 'selected' : ''}>Fill (Nhập liệu)</option>
                            <option value="Click" ${step.actionType === 'Click' ? 'selected' : ''}>Click (Bấm nút)</option>
                            <option value="Select" ${step.actionType === 'Select' ? 'selected' : ''}>Select (Chọn option)</option>
                            <option value="AssertUrl" ${step.actionType === 'AssertUrl' ? 'selected' : ''}>AssertUrl (Xác thực URL)</option>
                            <option value="AssertText" ${step.actionType === 'AssertText' ? 'selected' : ''}>AssertText (Xác thực chữ có)</option>
                            <option value="AssertTextNot" ${step.actionType === 'AssertTextNot' ? 'selected' : ''}>AssertTextNot (Xác thực chữ không)</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small fw-semibold">Target CSS Selector</label>
                        <input type="text" class="form-control bg-dark-soft text-value border-glass font-fira" placeholder="Ví dụ: input[name='Email']" value="${step.targetSelector || ''}" onchange="updateStepField(${index}, 'targetSelector', this.value)">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small fw-semibold">Giá trị / Tham số</label>
                        <input type="text" class="form-control bg-dark-soft text-value border-glass font-fira" placeholder="Ví dụ: 123456 hoặc /Account/Login" value="${step.value || ''}" onchange="updateStepField(${index}, 'value', this.value)">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small fw-semibold">Mô tả hiển thị</label>
                        <input type="text" class="form-control bg-dark-soft text-value border-glass" placeholder="Mô tả hành động của bước này" value="${step.description || ''}" onchange="updateStepField(${index}, 'description', this.value)">
                    </div>
                </div>
            `;
            container.appendChild(card);
        });
    }

    // Cập nhật trường dữ liệu của từng bước khi người dùng sửa đổi trên UI
    function updateStepField(index, field, value) {
        scenarioSteps[index][field] = value;
    }

    // Di chuyển bước lên hoặc xuống
    function moveStep(index, direction) {
        const targetIndex = index + direction;
        if (targetIndex < 0 || targetIndex >= scenarioSteps.length) return;

        // Hoán đổi vị trí trong mảng
        const temp = scenarioSteps[index];
        scenarioSteps[index] = scenarioSteps[targetIndex];
        scenarioSteps[targetIndex] = temp;

        // Cập nhật lại thuộc tính stepOrder
        scenarioSteps.forEach((step, idx) => {
            step.stepOrder = idx + 1;
        });

        renderScenarioSteps();
    }

    // Thêm bước mới
    function addTestStep() {
        const nextOrder = scenarioSteps.length + 1;
        scenarioSteps.push({
            stepID: 0,
            scenarioName: currentScenario,
            stepOrder: nextOrder,
            actionType: "Navigate",
            targetSelector: "",
            value: "",
            description: `Mô tả bước #${nextOrder}`
        });
        renderScenarioSteps();
        
        // Tự động cuộn xuống cuối danh sách
        const container = document.getElementById("stepsEditorContainer");
        setTimeout(() => { container.scrollTop = container.scrollHeight; }, 100);
    }

    // Xóa bước khỏi danh sách tạm thời
    function deleteStep(index) {
        if (!confirm("Bạn có chắc chắn muốn xóa bước kiểm thử này?")) return;

        scenarioSteps.splice(index, 1);
        
        // Cập nhật lại số thứ tự
        scenarioSteps.forEach((step, idx) => {
            step.stepOrder = idx + 1;
        });

        renderScenarioSteps();
    }

    // Lưu danh sách các bước vào database
    function saveTestSteps() {
        if (isJsonMode) {
            const jsonTextarea = document.getElementById("jsonTextarea");
            try {
                const parsed = JSON.parse(jsonTextarea.value);
                if (!Array.isArray(parsed)) {
                    alert("Dữ liệu JSON phải là một mảng (Array) chứa danh sách các bước!");
                    return;
                }
                scenarioSteps = parsed.map((s, idx) => ({
                    stepID: 0,
                    scenarioName: currentScenario,
                    stepOrder: idx + 1,
                    actionType: s.actionType || "Navigate",
                    targetSelector: s.targetSelector || "",
                    value: s.value || "",
                    description: s.description || `Mô tả bước #${idx + 1}`
                }));
            } catch (ex) {
                alert("Lỗi cú pháp JSON không hợp lệ! Vui lòng kiểm tra lại trước khi lưu.\nChi tiết: " + ex.message);
                return;
            }
        }

        if (scenarioSteps.length === 0) {
            alert("Kịch bản kiểm thử phải có ít nhất 1 bước!");
            return;
        }

        const btn = document.querySelector(".btn-save-steps");
        const originalHtml = btn.innerHTML;
        btn.innerHTML = `<i class='bx bx-loader-alt bx-spin me-1'></i> Đang lưu...`;
        btn.disabled = true;

        fetch("/Admin/SaveTestSteps", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify(scenarioSteps)
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                alert("Đã lưu cấu hình kịch bản thành công vào cơ sở dữ liệu!");
                if (isJsonMode) {
                    // Nếu đang ở chế độ JSON, tải lại và cập nhật khung soạn thảo
                    fetch(`/Admin/GetTestSteps?scenarioName=${currentScenario}`)
                    .then(res => res.json())
                    .then(d => {
                        if (d.success) {
                            scenarioSteps = d.steps;
                            const cleanSteps = scenarioSteps.map(s => ({
                                actionType: s.actionType,
                                targetSelector: s.targetSelector || "",
                                value: s.value || "",
                                description: s.description || ""
                            }));
                            document.getElementById("jsonTextarea").value = JSON.stringify(cleanSteps, null, 4);
                        }
                    });
                } else {
                    loadScenarioSteps();
                }
            } else {
                alert("Lưu thất bại: " + data.message);
            }
        })
        .catch(err => {
            alert("Lỗi kết nối máy chủ khi lưu cấu hình kịch bản.");
        })
        .finally(() => {
            btn.innerHTML = originalHtml;
            btn.disabled = false;
        });
    }
</script>
