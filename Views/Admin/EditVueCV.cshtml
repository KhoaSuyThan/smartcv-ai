@model DoAnCS.Models.VueTemplate
@{
    ViewData["Title"] = "Chỉnh sửa Vue CV";
}

<div class="container py-4">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-white border-bottom py-3">
            <h4 class="fw-bold text-primary mb-0">
                <i class='bx bxs-edit-alt me-2'></i>Chỉnh sửa mẫu Vue CV: @Model.TemplateName
            </h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="EditVueCV" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedAt" />
                @if (!string.IsNullOrEmpty(ViewBag.ReturnUrl))
                {
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                }

                <div class="row g-4">
                    <div class="col-md-7">
                        <div class="mb-3">
                            <label asp-for="TemplateName" class="form-label fw-bold">Tên mẫu CV</label>
                            <input asp-for="TemplateName" class="form-control form-control-lg border-2" placeholder="Nhập tên mẫu..." />
                            <span asp-validation-for="TemplateName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ComponentName" class="form-label fw-bold">Tên Component (Vue)</label>
                            <input asp-for="ComponentName" class="form-control form-control-lg border-2" placeholder="Ví dụ: ModernTemplate.vue" />
                            <span asp-validation-for="ComponentName" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Dành cho đối tượng / Ngành nghề (Chọn nhiều)</label>
                            @using System.Linq
                            @{
                                var currentCats = (Model.Category ?? "").Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim()).ToList();
                            }
                            <div class="d-flex flex-wrap gap-3 mt-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="selectedCategories" value="IT" id="catIT" @(currentCats.Contains("IT") ? "checked" : "")>
                                    <label class="form-check-label" for="catIT">IT</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="selectedCategories" value="Kinh doanh" id="catKD" @(currentCats.Contains("Kinh doanh") ? "checked" : "")>
                                    <label class="form-check-label" for="catKD">Kinh doanh</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="selectedCategories" value="Marketing" id="catMK" @(currentCats.Contains("Marketing") ? "checked" : "")>
                                    <label class="form-check-label" for="catMK">Marketing</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="selectedCategories" value="Tài chính" id="catTC" @(currentCats.Contains("Tài chính") ? "checked" : "")>
                                    <label class="form-check-label" for="catTC">Tài chính</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="selectedCategories" value="Sáng tạo" id="catST" @(currentCats.Contains("Sáng tạo") ? "checked" : "")>
                                    <label class="form-check-label" for="catST">Sáng tạo</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="selectedCategories" value="Y tế" id="catYT" @(currentCats.Contains("Y tế") ? "checked" : "")>
                                    <label class="form-check-label" for="catYT">Y tế</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="selectedCategories" value="Thực tập" id="catTT" @(currentCats.Contains("Thực tập") ? "checked" : "")>
                                    <label class="form-check-label" for="catTT">Thực tập</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="selectedCategories" value="Chuyên nghiệp" id="catCN" @(currentCats.Contains("Chuyên nghiệp") ? "checked" : "")>
                                    <label class="form-check-label" for="catCN">Chuyên nghiệp</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="selectedCategories" value="Khác" id="catKhac" @(currentCats.Contains("Khác") ? "checked" : "")>
                                    <label class="form-check-label" for="catKhac">Khác</label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">URL Ảnh xem trước</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class='bx bx-link'></i></span>
                                <input asp-for="ThumbnailUrl" id="previewUrlInput" class="form-control border-2" placeholder="Nhập URL hoặc chọn file bên dưới..." />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-primary">Hoặc tải lên ảnh mới</label>
                            <input type="file" name="uploadImage" id="fileInput" class="form-control border-2" accept="image/*" />
                        </div>

                        <div class="form-check form-switch mt-4">
                            <input class="form-check-input" type="checkbox" asp-for="IsActive" id="activeSwitch">
                            <label class="form-check-label fw-bold ms-2" for="activeSwitch">Kích hoạt mẫu này</label>
                        </div>

                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" asp-for="IsPremium" id="proSwitch">
                            <label class="form-check-label fw-bold ms-2 text-warning" for="proSwitch"><i class='bx bxs-crown'></i> Đây là mẫu thiết kế PRO</label>
                        </div>
                    </div>

                    <div class="col-md-5 text-center border-start">
                        <p class="text-muted small fw-bold text-uppercase">Ảnh xem trước hiện tại</p>
                        <img src="@(Model.ThumbnailUrl ?? "https://via.placeholder.com/210x297?text=No+Preview")" id="imgPreview" class="img-fluid rounded shadow-sm border" 
                             style="max-height: 560px; aspect-ratio: 1/1.41; object-fit: cover;" />
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-5 pt-4 border-top">
                    <a href="@(string.IsNullOrEmpty(ViewBag.ReturnUrl) ? "/Admin/VueTemplates" : ViewBag.ReturnUrl)" class="btn btn-light rounded-pill px-4">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 shadow fw-bold">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Live preview khi đổi URL ảnh
    document.getElementById('previewUrlInput').addEventListener('input', function() {
        document.getElementById('imgPreview').src = this.value;
    });

    document.getElementById('fileInput').addEventListener('change', function(event) {
        const file = event.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('imgPreview').src = e.target.result;
            }
            reader.readAsDataURL(file);
        }
    });
</script>

<style>
    .form-check-input:checked { background-color: #0d6efd; border-color: #0d6efd; }
</style>
