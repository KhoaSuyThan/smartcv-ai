<script>
    // Mở modal quyết định duyệt (Đặt lịch hoặc Gửi Offer)
    function openApproveActionModal(applicationId, candidateName) {
        $('#approveCandidateName').text(candidateName);
        $('#interviewAppId').val(applicationId);
        $('#offerAppId').val(applicationId);
        
        // Reset form
        document.getElementById('scheduleInterviewForm').reset();
        document.getElementById('sendOfferForm').reset();
        
        // Hiển thị lại tab 1 (Lịch hẹn) và kích hoạt cả 2 tab
        $('#interview-tab').show();
        var triggerEl = document.querySelector('#approveActionTabs button[data-bs-target="#interview-pane"]');
        if (triggerEl) {
            bootstrap.Tab.getOrCreateInstance(triggerEl).show();
        }
        $('#offer-tab').show();
        
        // Cập nhật lại placeholder hình thức
        toggleLocationPlaceholder('Online');

        var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('approveActionModal'));
        modal.show();
    }

    // Mở trực tiếp tab Gửi Offer cho ứng viên đang phỏng vấn
    function openSendOfferDirectModal(applicationId, candidateName) {
        $('#approveCandidateName').text(candidateName);
        $('#interviewAppId').val(applicationId);
        $('#offerAppId').val(applicationId);
        
        // Reset form
        document.getElementById('scheduleInterviewForm').reset();
        document.getElementById('sendOfferForm').reset();
        
        // Ẩn tab Đặt lịch hẹn, chỉ hiện tab Offer
        $('#interview-tab').hide();
        var triggerEl = document.querySelector('#approveActionTabs button[data-bs-target="#offer-pane"]');
        if (triggerEl) {
            bootstrap.Tab.getOrCreateInstance(triggerEl).show();
        }

        var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('approveActionModal'));
        modal.show();
    }

    // Thay đổi placeholder theo hình thức phỏng vấn
    function toggleLocationPlaceholder(value) {
        const lbl = document.getElementById('lblLocation');
        const input = document.getElementById('interviewLocation');
        if (value === 'Online') {
            lbl.innerText = 'Link phòng họp trực tuyến (Google Meet/Zoom):';
            input.placeholder = 'https://meet.google.com/... hoặc link Zoom';
        } else {
            lbl.innerText = 'Địa điểm phỏng vấn trực tiếp:';
            input.placeholder = 'Ví dụ: Tầng 5, Tòa nhà Keangnam, Mễ Trì, Nam Từ Liêm, Hà Nội';
        }
    }

    // Hiển thị chi tiết lịch phỏng vấn
    function showInterviewDetail(applicationId, time, type, location, notes) {
        let formattedTime = time;
        if (time) {
            const dateObj = new Date(time);
            if (!isNaN(dateObj.getTime())) {
                formattedTime = dateObj.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) + ' - ' + dateObj.toLocaleDateString('vi-VN');
            }
        }
        $('#viewInterviewTime').text(formattedTime || 'N/A');
        $('#viewInterviewType').text(type === 'Online' ? 'Phỏng vấn trực tuyến (Online)' : 'Phỏng vấn trực tiếp (Offline)');
        $('#viewInterviewLocation').html(type === 'Online' ? `<a href="${location}" target="_blank" class="text-primary text-decoration-underline">${location} <i class="fas fa-external-link-alt ms-1 small"></i></a>` : location);
        $('#viewInterviewNotes').text(notes || 'Không có ghi chú nào.');

        var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('interviewDetailModal'));
        modal.show();
    }

    // Hiển thị chi tiết Offer
    function showOfferDetail(applicationId, salary, startDate, notes, status, workLocation) {
        let formattedDate = startDate;
        if (startDate) {
            const dateObj = new Date(startDate);
            if (!isNaN(dateObj.getTime())) {
                formattedDate = dateObj.toLocaleDateString('vi-VN');
            }
        }
        $('#viewOfferSalary').text(salary || 'N/A');
        $('#viewOfferStartDate').text(formattedDate || 'N/A');
        $('#viewOfferWorkLocation').text(workLocation || 'Không chỉ định (Thỏa thuận)');
        $('#viewOfferNotes').text(notes || 'Không có ghi chú/điều khoản bổ sung nào.');

        // Định dạng trạng thái badge
        const badge = $('#viewOfferStatus');
        badge.removeClass('bg-warning bg-success bg-danger text-dark text-white');
        if (status === 'Pending') {
            badge.addClass('bg-warning text-dark').text('Đang chờ phản hồi');
        } else if (status === 'Accepted') {
            badge.addClass('bg-success text-white').text('Đã đồng ý nhận việc');
        } else {
            badge.addClass('bg-danger text-white').text('Đã từ chối nhận việc');
        }

        var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('offerDetailModal'));
        modal.show();
    }

    // Xử lý gửi form Đặt lịch phỏng vấn qua AJAX
    $('#scheduleInterviewForm').on('submit', async function (e) {
        e.preventDefault();
        const btn = $(this).find('button[type="submit"]');
        const oldText = btn.text();
        btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span> Đang gửi...');

        try {
            const formData = new URLSearchParams(new FormData(this));
            const response = await fetch('/Jobs/ScheduleInterview', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: formData.toString()
            });

            const result = await response.json();
            if (result.success) {
                alert(result.message);
                window.location.reload();
            } else {
                alert(result.message || 'Có lỗi xảy ra.');
                btn.prop('disabled', false).text(oldText);
            }
        } catch (error) {
            alert('Lỗi kết nối máy chủ.');
            btn.prop('disabled', false).text(oldText);
        }
    });

    // Xử lý gửi form Offer nhận việc qua AJAX
    $('#sendOfferForm').on('submit', async function (e) {
        e.preventDefault();
        const btn = $(this).find('button[type="submit"]');
        const oldText = btn.text();
        btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span> Đang gửi...');

        try {
            const formData = new URLSearchParams(new FormData(this));
            const response = await fetch('/Jobs/SendJobOffer', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: formData.toString()
            });

            const result = await response.json();
            if (result.success) {
                alert(result.message);
                window.location.reload();
            } else {
                alert(result.message || 'Có lỗi xảy ra.');
                btn.prop('disabled', false).text(oldText);
            }
        } catch (error) {
            alert('Lỗi kết nối máy chủ.');
            btn.prop('disabled', false).text(oldText);
        }
    });

    async function quickUpdateStatus(applicationId, newStatus) {
        if (!confirm(`Bạn có chắc muốn ${newStatus === 'Accepted' ? 'DUYỆT' : 'TỪ CHỐI'} ứng viên này?`)) {
            return;
        }

        try {
            const response = await fetch('/Jobs/UpdateApplicationStatus', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `applicationId=${applicationId}&status=${newStatus}`
            });

            const result = await response.json();
            
            if (result.success) {
                window.location.reload();
            } else {
                alert(result.message || 'Có lỗi xảy ra.');
            }
        } catch (error) {
            alert('Lỗ kết nối máy chủ.');
        }
    }
</script>
}

