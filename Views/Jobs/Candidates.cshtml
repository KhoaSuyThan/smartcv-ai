                                <button type="submit" class="btn btn-success text-white rounded-pill px-4 fw-bold">Xác nhận đặt lịch</button>
                            </div>
                        </form>
                    </div>

                    <!-- Tab 2: Thư mời nhận việc (Offer) -->
                    <div class="tab-pane fade" id="offer-pane" role="tabpanel" aria-labelledby="offer-tab" tabindex="0">
                        <form id="sendOfferForm">
                            <input type="hidden" name="applicationId" id="offerAppId" />
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-secondary small">Mức lương đề xuất (Gross/Net):</label>
                                    <input type="text" name="salary" id="offerSalary" class="form-control rounded-3 border-secondary-subtle" placeholder="Ví dụ: 15,000,000 VND / tháng" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-secondary small">Ngày bắt đầu làm việc:</label>
                                    <input type="date" name="startDate" id="offerStartDate" class="form-control rounded-3 border-secondary-subtle" required />
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-bold text-secondary small">Địa điểm làm việc:</label>
                                    <input type="text" name="workLocation" id="offerWorkLocation" class="form-control rounded-3 border-secondary-subtle" placeholder="Ví dụ: Tầng 5, Tòa nhà Keangnam, Mễ Trì, Hà Nội hoặc Làm việc từ xa (Remote)" required />
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-bold text-secondary small">Lời nhắn / Điều khoản bổ sung:</label>
                                    <textarea name="notes" id="offerNotes" class="form-control rounded-3 border-secondary-subtle" rows="4" placeholder="Ví dụ: Thời gian thử việc 2 tháng (hưởng 85% lương cơ bản). Đóng bảo hiểm đầy đủ sau thử việc..."></textarea>
                                </div>
                            </div>
                            <div class="text-end mt-4 pt-3 border-top">
                                <button type="button" class="btn btn-outline-secondary rounded-pill px-4 me-2" data-bs-dismiss="modal">Hủy</button>
                                <button type="submit" class="btn btn-success text-white rounded-pill px-4 fw-bold">Gửi Offer nhận việc</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

