                                    <label class="form-label fw-bold text-secondary small">Hình thức:</label>
                                    <select name="locationType" id="interviewLocationType" class="form-select rounded-3 border-secondary-subtle" onchange="toggleLocationPlaceholder(this.value)">
                                        <option value="Online">Phỏng vấn trực tuyến (Online)</option>
