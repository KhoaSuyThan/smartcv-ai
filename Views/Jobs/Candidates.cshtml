@model IEnumerable<DoAnCS.Models.Application>
@{
    ViewData["Title"] = "Quản lý Ứng viên";
}

<div class="container py-5 mt-3">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4 border-0 d-flex align-items-center" role="alert">
            <i class="fas fa-check-circle me-3 fs-4 text-success"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4 border-0 d-flex align-items-center" role="alert">
            <i class="fas fa-exclamation-circle me-3 fs-4 text-danger"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1"><i class="fas fa-users-cog me-2"></i>Danh sách Ứng viên</h2>
            <p class="text-muted mb-0">Việc làm: <strong class="text-dark">@ViewBag.JobTitle</strong> (#@ViewBag.JobId)</p>
        </div>
        <a href="/Jobs/Manage" class="btn btn-outline-secondary rounded-pill fw-bold"><i class="fas fa-arrow-left me-2"></i>Quay lại</a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="px-4 py-3 text-muted fw-bold">Ứng viên</th>
                                <th class="py-3 text-muted fw-bold">Liên hệ</th>
                                <th class="py-3 text-muted fw-bold">Ngày nộp</th>
                                <th class="py-3 text-muted fw-bold">Trạng thái</th>
                                <th class="px-4 py-3 text-muted fw-bold text-end" style="min-width: 200px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var app in Model)
                            {
                                <tr>
                                    <td class="px-4 py-4">
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle bg-primary text-white d-flex justify-content-center align-items-center me-3" style="width: 48px; height: 48px; font-weight: bold; font-size: 1.2rem;">
                                                @(string.IsNullOrEmpty(app.Resume?.User?.FullName) ? "U" : app.Resume.User.FullName.Substring(0, 1).ToUpper())
                                            </div>
                                            <div>
                                                <h6 class="mb-1 fw-bold text-dark">@(app.Resume?.User?.FullName ?? "Ứng viên Tự do")</h6>
                                                <span class="text-muted small"><i class="fas fa-file-alt me-1"></i>CV: @(app.Resume?.Title ?? "Chưa đặt tên")</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-4">
                                        <div class="text-secondary small">
                                            <div><i class="fas fa-envelope me-1"></i> @(app.Resume?.User?.Email ?? app.Resume?.Email ?? "N/A")</div>
                                            @if (!string.IsNullOrEmpty(app.Resume?.Phone))
                                            {
                                                <div class="mt-1"><i class="fas fa-phone me-1"></i> @app.Resume.Phone</div>
                                            }
                                        </div>
                                    </td>
                                    <td class="py-4 text-muted small">
                                        @app.AppliedAt.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td class="py-4">
                                        @if (app.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill"><i class="fas fa-clock me-1"></i>Chờ xử lý</span>
                                        }
                                        else if (app.Status == "Reviewing")
                                        {
                                            <span class="badge bg-info text-dark px-3 py-2 rounded-pill"><i class="fas fa-eye me-1"></i>Đang xem xét</span>
                                        }
                                        else if (app.Status == "Interviewing")
                                        {
                                            <span class="badge bg-purple text-white px-3 py-2 rounded-pill cursor-pointer" onclick="showInterviewDetail(@app.ApplicationID, '@(app.InterviewSchedule?.InterviewTime.ToString("yyyy-MM-ddTHH:mm") ?? "")', '@(app.InterviewSchedule?.LocationType ?? "")', '@(app.InterviewSchedule?.Location ?? "")', '@(app.InterviewSchedule?.Notes ?? "")')" title="Click để xem chi tiết lịch phỏng vấn"><i class="fas fa-calendar-alt me-1"></i>Lịch phỏng vấn</span>
                                        }
                                        else if (app.Status == "Offered")
                                        {
                                            <span class="badge bg-orange text-white px-3 py-2 rounded-pill cursor-pointer" style="background-color: #fd7e14 !important;" onclick="showOfferDetail(@app.ApplicationID, '@(app.JobOffer?.Salary ?? "")', '@(app.JobOffer?.StartDate.ToString("yyyy-MM-dd") ?? "")', '@(app.JobOffer?.Notes ?? "")', '@(app.JobOffer?.Status ?? "")', '@(app.JobOffer?.WorkLocation ?? "")')" title="Click để xem chi tiết Offer đã gửi"><i class="fas fa-envelope-open-text me-1"></i>Đã gửi Offer</span>
                                        }
                                        else if (app.Status == "Accepted")
                                        {
                                            <span class="badge bg-success px-3 py-2 rounded-pill"><i class="fas fa-check-circle me-1"></i>Đã nhận việc</span>
                                        }
                                        else if (app.Status == "Rejected" || app.Status == "Từ chối")
                                        {
                                            <span class="badge bg-danger px-3 py-2 rounded-pill"><i class="fas fa-times-circle me-1"></i>Từ chối</span>
                                        }
                                        else if (app.Status == "DeclinedOffer")
                                        {
                                            <span class="badge bg-dark text-white px-3 py-2 rounded-pill" title="Ứng viên từ chối thư mời nhận việc"><i class="fas fa-user-slash me-1"></i>Từ chối Offer</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-3 py-2 rounded-pill">@app.Status</span>
                                        }
                                    </td>
                                    <td class="px-4 py-4 text-end">
                                        <div class="d-flex justify-content-end align-items-center gap-2">
                                            @{
                                                var sessions = ViewBag.InterviewSessions as IEnumerable<DoAnCS.Models.InterviewSession>;
                                                var isession = sessions?.FirstOrDefault(s => s.ResumeID == app.ResumeID);
                                            }

                                            @if (isession == null)
                                            {
                                                <button onclick="openAssignInterviewModal(@app.JobID, @app.ResumeID, '@(app.Resume?.User?.FullName ?? "Ứng viên")')" class="btn btn-sm btn-outline-purple rounded-pill fw-bold" title="Giao bài phỏng vấn tự luận do AI gợi ý">
                                                    <i class="fas fa-robot me-1"></i> Giao phỏng vấn
                                                </button>
                                            }
                                            else if (isession.Status == 0)
                                            {
                                                <span class="badge bg-purple-light text-purple py-2 px-3 rounded-pill fw-bold small me-1" title="Đang chờ ứng viên hoàn thành trả lời phỏng vấn tự luận">
                                                    <i class="fas fa-spinner fa-spin me-1"></i> Đang làm bài
                                                </span>
                                            }
                                            else if (!isession.OverallScore.HasValue)
                                            {
                                                <button onclick="openEvaluateInterviewModal(@isession.SessionID)" class="btn btn-sm btn-purple text-white rounded-pill fw-bold" title="Bài làm tự luận đã được nộp. Bấm để chấm điểm">
                                                    <i class="fas fa-star me-1"></i> Chấm điểm phỏng vấn
                                                </button>
                                            }
                                            else
                                            {
                                                <button onclick="openEvaluateInterviewModal(@isession.SessionID)" class="btn btn-sm btn-outline-success rounded-pill fw-bold" title="Xem kết quả đánh giá phỏng vấn">
                                                    <i class="fas fa-poll-h me-1"></i> Kết quả: @isession.OverallScore/100
                                                </button>
                                            }

                                            @if (app.Status == "Pending" || app.Status == "Reviewing")
                                            {
                                                <button onclick="openApproveActionModal(@app.ApplicationID, '@(app.Resume?.User?.FullName ?? "Ứng viên")')" class="btn btn-sm btn-success rounded-pill fw-bold" title="Duyệt hồ sơ (Đặt lịch phỏng vấn hoặc Gửi Offer)">
                                                    <i class="fas fa-check me-1"></i> Duyệt
                                                </button>
                                                <button onclick="quickUpdateStatus(@app.ApplicationID, 'Rejected')" class="btn btn-sm btn-danger rounded-pill fw-bold" title="Từ chối">
                                                    <i class="fas fa-times me-1"></i> Từ chối
                                                </button>
                                            }
                                            else if (app.Status == "Interviewing")
                                            {
                                                <button onclick="openSendOfferDirectModal(@app.ApplicationID, '@(app.Resume?.User?.FullName ?? "Ứng viên")')" class="btn btn-sm text-white rounded-pill fw-bold" style="background-color: #fd7e14; border-color: #fd7e14;" title="Mời nhận việc (Gửi Offer)">
                                                    <i class="fas fa-paper-plane me-1"></i> Mời nhận việc
                                                </button>
                                            }
                                            <a href="/Jobs/PreviewCV?applicationId=@app.ApplicationID" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill fw-bold hover-primary">
                                                <i class="fas fa-eye me-1"></i> Xem CV
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="mb-3">
                        <i class="fas fa-users-slash text-muted" style="font-size: 4rem; opacity: 0.3;"></i>
                    </div>
                    <h5 class="text-dark fw-bold mb-2">Chưa có ứng viên nào</h5>
                    <p class="text-secondary mb-4">Các đơn ứng tuyển cho công việc này sẽ xuất hiện tại đây.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- ================= MODAL GIAO PHỎNG VẤN AI ================= -->
<div class="modal fade" id="assignInterviewModal" data-bs-backdrop="static" tabindex="-1" aria-labelledby="assignInterviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header bg-purple text-white py-3 rounded-top-4">
                <h5 class="modal-title fw-bold" id="assignInterviewModalLabel"><i class="fas fa-robot me-2"></i>Thiết lập & Giao phỏng vấn</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div id="aiConfigSection">
                    <p class="text-muted small mb-3">
                        Thiết lập các câu hỏi phỏng vấn tự luận cho ứng viên <strong class="text-dark" id="assignCandidateName"></strong>. Bạn có thể tự viết câu hỏi hoặc sử dụng công cụ AI gợi ý dựa trên CV & JD.
                    </p>

                    <!-- Lưu thông tin trạng thái Pro -->
                    <input type="hidden" id="isRecruiterPro" value="@(ViewBag.IsPro == true ? "true" : "false")" />

                    <!-- Khu vực tuỳ chọn sinh câu hỏi -->
                    <div class="card bg-light border-0 rounded-3 mb-4">
                        <div class="card-body p-3">
                            <!-- Nhập yêu cầu tùy chỉnh cho AI -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="form-label fw-bold text-secondary small mb-0 d-flex align-items-center">
                                        <i class="fas fa-comment-dots text-purple me-1"></i> Yêu cầu đặc biệt cho AI (không bắt buộc):
                                    </label>
                                    <span class="text-muted" style="font-size: 0.7rem;"><span id="aiPromptCharCount">0</span>/300 ký tự</span>
                                </div>
                                <textarea id="aiCustomPrompt" class="form-control border-secondary-subtle small rounded-3" rows="2" maxlength="300" placeholder="Ví dụ: Tập trung hỏi sâu về kỹ năng mềm, tư duy logic, khả năng làm việc nhóm hoặc thái độ làm việc..."></textarea>
                            </div>

                            <div class="row align-items-center g-3 pt-2 border-top border-secondary-subtle">
                                <div class="col-md-7">
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <label class="form-label mb-0 fw-bold text-secondary small text-nowrap">Số câu hỏi AI gợi ý:</label>
                                        <select id="aiQuestionCount" class="form-select form-select-sm border-secondary-subtle rounded-3" style="width: 80px; height: 35px;">
                                            @if (ViewBag.IsPro == true)
                                            {
                                                for (int i = 3; i <= 10; i++)
                                                {
                                                    if (i == 3)
                                                    {
                                                        <option value="@i" selected>@i</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@i">@i</option>
                                                    }
                                                }
                                            }
                                            else
                                            {
                                                for (int i = 3; i <= 5; i++)
                                                {
                                                    if (i == 3)
                                                    {
                                                        <option value="@i" selected>@i</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@i">@i</option>
                                                    }
                                                }
                                            }
                                        </select>
                                        <button type="button" onclick="generateSuggestedQuestions()" class="btn btn-sm btn-purple text-white rounded-pill px-3 fw-bold text-nowrap d-flex align-items-center" style="height: 35px;">
                                            <i class="fas fa-magic me-1"></i> Tạo bằng AI
                                        </button>
                                    </div>
                                </div>
                                <div class="col-md-5 text-md-end">
                                    <button type="button" onclick="addNewManualQuestion()" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-bold d-inline-flex align-items-center" style="height: 35px;">
                                        <i class="fas fa-plus me-1"></i> Thêm câu hỏi thủ công
                                    </button>
                                </div>
                            </div>
                            
                            @if (ViewBag.IsPro != true)
                            {
                                <div class="mt-2 text-muted d-flex align-items-center" style="font-size: 0.75rem;">
                                    <i class="fas fa-info-circle me-1 text-info"></i>
                                    <span>Tài khoản thường được chọn từ 3-5 câu hỏi. Nâng cấp <strong class="text-purple">Pro</strong> để chọn từ 3-10 câu hỏi.</span>
                                </div>
                            }
                            else
                            {
                                <div class="mt-2 text-purple fw-bold d-flex align-items-center" style="font-size: 0.75rem;">
                                    <i class="fas fa-star me-1 text-warning"></i>
                                    <span>Bạn đang sử dụng quyền lợi tài khoản <strong>Pro</strong>: Hỗ trợ tạo tối đa 10 câu hỏi.</span>
                                </div>
                            }
                        </div>
                    </div>

                    <form asp-controller="Interview" asp-action="AssignInterviewToCandidate" method="post" id="assignForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="jobId" id="assignJobId" />
                        <input type="hidden" name="resumeId" id="assignResumeId" />
                        <input type="hidden" name="questionsJson" id="assignQuestionsJson" />

                        <!-- Container câu hỏi -->
                        <div id="questionsContainer" class="d-flex flex-column gap-3 position-relative">
                            <!-- Các khối câu hỏi sẽ được sinh động bằng JS -->
                        </div>

                        <!-- Overlay loading cục bộ -->
                        <div id="questionsLoadingOverlay" class="text-center py-5 border rounded-3 bg-white mt-3" style="display: none;">
                            <div class="spinner-border text-purple mb-3" style="width: 2rem; height: 2rem;" role="status"></div>
                            <h6 class="fw-bold text-secondary">AI đang so sánh CV & JD để đề xuất câu hỏi...</h6>
                            <p class="text-muted small mb-0">Quá trình này có thể mất từ 5-10 giây. Vui lòng chờ.</p>
                        </div>

                        <!-- Vùng hiển thị lỗi validation -->
                        <div id="validationErrorMsg" class="alert alert-danger p-3 rounded-3 mt-3 shadow-sm border-0 d-none align-items-center" style="font-size: 0.85rem;">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <span class="error-text"></span>
                        </div>

                        <div class="text-end mt-4 pt-3 border-top">
                            <button type="button" class="btn btn-outline-secondary rounded-pill px-4 me-2" data-bs-dismiss="modal">Hủy</button>
                            <button type="submit" class="btn btn-purple text-white rounded-pill px-4 fw-bold">
                                <i class="fas fa-paper-plane me-1"></i> Giao bài phỏng vấn
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MODAL XEM CHI TIẾT & CHẤM ĐIỂM ================= -->
<div class="modal fade" id="evaluateInterviewModal" data-bs-backdrop="static" tabindex="-1" aria-labelledby="evaluateInterviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered custom-eval-modal">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header text-white py-3 rounded-top-4 border-0" style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);">
                <h5 class="modal-title fw-bold" id="evaluateInterviewModalLabel"><i class="fas fa-poll-h me-2"></i>Đánh giá bài làm phỏng vấn tự luận</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" style="max-height: 80vh; overflow-y: auto;">
                <div id="evalLoadingSection" class="text-center py-5">
                    <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status"></div>
                    <h6 class="fw-bold text-secondary">Đang tải bài làm của ứng viên...</h6>
                </div>

                <div id="evalMainSection" style="display: none;">
                    <div class="row g-4">
                        <!-- Cột Trái: Danh sách Câu hỏi & Trả lời -->
                        <div class="col-lg-8">
                            <h6 class="fw-bold text-dark mb-3"><i class="fas fa-pen-nib text-primary"></i> Nội dung bài làm</h6>
                            <div id="evalQuestionsContainer" class="d-flex flex-column gap-4">
                                <!-- Điền bằng JS -->
                            </div>
                        </div>

                        <!-- Cột Phải: Điểm và Nhận xét chung cuộc -->
                        <div class="col-lg-4 border-start">
                            <div class="sticky-eval-panel">
                                <h6 class="fw-bold text-dark mb-3"><i class="fas fa-clipboard-check text-success"></i> Đánh giá chung cuộc</h6>
                                <form asp-controller="Interview" asp-action="SubmitRecruiterEvaluation" method="post" id="evaluationForm">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="sessionId" id="evalSessionId" />

                                    <!-- Container lưu điểm và nhận xét của từng câu hỏi để submit dạng POST -->
                                    <div id="hiddenQuestionsInputs"></div>

                                    <div class="mb-3">
                                        <label class="form-label fw-bold text-secondary small">Điểm chung cuộc (0 - 100):</label>
                                        <div class="input-group">
                                            <input type="number" name="overallScore" id="evalOverallScore" class="form-control text-center fw-bold fs-5 border-secondary" min="0" max="100" required />
                                            <span class="input-group-text bg-light fw-bold text-secondary">/100</span>
                                        </div>
                                    </div>

                                    <div class="mb-4">
                                        <label class="form-label fw-bold text-secondary small">Nhận xét & Đánh giá chính thức:</label>
                                        <textarea name="overallEvaluation" id="evalOverallComment" class="form-control small border-secondary" rows="8" placeholder="Nhập nhận xét tổng quan về buổi phỏng vấn tự luận của ứng viên..." required></textarea>
                                    </div>

                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-outline-secondary w-50 rounded-pill py-2" data-bs-dismiss="modal">Hủy</button>
                                        <button type="submit" class="btn btn-primary w-50 rounded-pill py-2 fw-bold" id="btnSaveEvaluation">Lưu kết quả</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MODAL LỰA CHỌN HÀNH ĐỘNG DUYỆT HỒ SƠ ================= -->
<div class="modal fade" id="approveActionModal" data-bs-backdrop="static" tabindex="-1" aria-labelledby="approveActionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header bg-success text-white py-3 rounded-top-4">
                <h5 class="modal-title fw-bold" id="approveActionModalLabel"><i class="fas fa-check-circle me-2"></i>Quyết định duyệt hồ sơ</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted small mb-3">
                    Chọn hành động tiếp theo cho hồ sơ ứng viên <strong class="text-dark" id="approveCandidateName"></strong>. Bạn có thể đặt lịch phỏng vấn (Offline/Online) hoặc mời nhận việc trực tiếp.
                </p>

                <!-- Tabs navigation -->
                <ul class="nav nav-pills nav-justified mb-4 p-1 bg-light rounded-3" id="approveActionTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active rounded-3 fw-bold" id="interview-tab" data-bs-toggle="tab" data-bs-target="#interview-pane" type="button" role="tab" aria-controls="interview-pane" aria-selected="true">
                            <i class="fas fa-calendar-alt me-2"></i>Đặt lịch phỏng vấn
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link rounded-3 fw-bold" id="offer-tab" data-bs-toggle="tab" data-bs-target="#offer-pane" type="button" role="tab" aria-controls="offer-pane" aria-selected="false">
                            <i class="fas fa-paper-plane me-2"></i>Mời nhận việc (Gửi Offer)
                        </button>
                    </li>
                </ul>

                <!-- Tabs content -->
                <div class="tab-content" id="approveActionTabsContent">
                    <!-- Tab 1: Đặt lịch phỏng vấn -->
                    <div class="tab-pane fade show active" id="interview-pane" role="tabpanel" aria-labelledby="interview-tab" tabindex="0">
                        <form id="scheduleInterviewForm">
                            <input type="hidden" name="applicationId" id="interviewAppId" />
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-secondary small">Thời gian phỏng vấn:</label>
                                    <input type="datetime-local" name="interviewTime" id="interviewTime" class="form-control rounded-3 border-secondary-subtle" required />
