@section Scripts {
<script>
    // Hàm tự động giãn chiều cao cho textarea theo số dòng và có giới hạn
    function autoResizeTextarea(el) {
        el.style.height = 'auto'; // Trả về auto để đo chính xác scrollHeight tự nhiên
        var newHeight = el.scrollHeight;
        var maxHeight = 400; // Tăng giới hạn chiều cao tối đa lên 400px để hiển thị đầy đủ
        if (newHeight > maxHeight) {
            el.style.height = maxHeight + 'px';
            el.style.overflowY = 'auto';
        } else {
            el.style.height = (newHeight < 31 ? 31 : newHeight) + 'px';
            el.style.overflowY = 'hidden';
        }
    }

    // Helper function render câu hỏi block
    function renderQuestionBlock(index, questionText, criteriaText) {
        return `
            <div class="question-item-block p-3 border rounded-3 bg-white shadow-sm position-relative mb-3">
                <button type="button" class="btn-close position-absolute" style="top: 15px; right: 15px; font-size: 0.8rem;" onclick="removeQuestionBlock(this)" title="Xóa câu hỏi này"></button>
                <div class="mb-2 pe-4">
                    <label class="form-label fw-bold text-primary small mb-1">Câu hỏi số <span class="q-index-number">${index}</span>:</label>
                    <input type="text" class="form-control font-medium q-text-input border-secondary-subtle small" value="${questionText}" placeholder="Nhập câu hỏi tự luận..." required />
                </div>
                <div>
                    <label class="form-label fw-bold text-secondary small mb-1">Đáp án gợi ý / Tiêu chí đánh giá:</label>
                    <textarea class="form-control q-criteria-input small" rows="2" placeholder="Gợi ý đáp án hoặc tiêu chí chấm điểm của câu này...">${criteriaText}</textarea>
                </div>
            </div>
        `;
    }

    // Hàm cập nhật lại số thứ tự câu hỏi
    function updateQuestionIndexes() {
        $('#questionsContainer .question-item-block').each(function(index) {
            $(this).find('.q-index-number').text(index + 1);
        });
    }

    // Hàm xóa câu hỏi
    function removeQuestionBlock(btn) {
        $(btn).closest('.question-item-block').remove();
        updateQuestionIndexes();
        $('#validationErrorMsg').removeClass('d-flex').addClass('d-none');

        // Đồng bộ lại dropdown số câu hỏi nếu khớp
        var count = $('#questionsContainer .question-item-block').length;
        if ($('#aiQuestionCount option[value="' + count + '"]').length > 0) {
            $('#aiQuestionCount').val(count);
        }
    }

    // Hàm thêm câu hỏi trống thủ công
    function addNewManualQuestion() {
        var container = $('#questionsContainer');
        var count = container.find('.question-item-block').length;
        
        var isPro = $('#isRecruiterPro').val() === 'true';
        var maxQuestions = isPro ? 10 : 5;
        
        if (count >= maxQuestions) {
            alert("Tài khoản của bạn chỉ được phép tạo tối đa " + maxQuestions + " câu hỏi.");
            return;
        }

        var html = renderQuestionBlock(count + 1, "", "");
        container.append(html);
        $('#validationErrorMsg').removeClass('d-flex').addClass('d-none');

        // Đồng bộ lại dropdown số câu hỏi nếu khớp
        var newCount = count + 1;
        if ($('#aiQuestionCount option[value="' + newCount + '"]').length > 0) {
            $('#aiQuestionCount').val(newCount);
        }
    }

    // Sự kiện thay đổi số lượng trên dropdown Số câu hỏi AI gợi ý
    $(document).on('change', '#aiQuestionCount', function () {
        var targetCount = parseInt($(this).val());
        var container = $('#questionsContainer');
        var currentCount = container.find('.question-item-block').length;

        if (currentCount < targetCount) {
            // Tự động thêm câu hỏi trống cho đủ
            for (var i = currentCount + 1; i <= targetCount; i++) {
                container.append(renderQuestionBlock(i, "", ""));
            }
        } else if (currentCount > targetCount) {
            // Cắt bớt câu hỏi từ cuối lên
            for (var i = currentCount; i > targetCount; i--) {
                container.find('.question-item-block').last().remove();
            }
        }
        updateQuestionIndexes();
        $('#validationErrorMsg').removeClass('d-flex').addClass('d-none');
    });

    // Lắng nghe sự kiện gõ phím trên ô nhập yêu cầu đặc biệt của AI để cập nhật đếm số ký tự
    $(document).on('input', '#aiCustomPrompt', function () {
        var len = $(this).val().length;
        if (len > 300) {
            $(this).val($(this).val().substring(0, 300));
            len = 300;
        }
        $('#aiPromptCharCount').text(len);
    });

    // Hàm gọi AI tự sinh câu hỏi gợi ý
    function generateSuggestedQuestions() {
        var jobId = $('#assignJobId').val();
        var resumeId = $('#assignResumeId').val();
        var count = $('#aiQuestionCount').val();
        var customPrompt = $('#aiCustomPrompt').val().trim();

        $('#questionsLoadingOverlay').show();
        $('#questionsContainer').hide();
        $('#validationErrorMsg').removeClass('d-flex').addClass('d-none');
        $('button').prop('disabled', true); // Khóa các nút để tránh spam

        $.ajax({
            url: '/Interview/GetAiSuggestedQuestions',
            type: 'POST',
            data: { jobId: jobId, resumeId: resumeId, count: count, customPrompt: customPrompt },
            success: function (res) {
                $('#questionsLoadingOverlay').hide();
                $('#questionsContainer').show();
                $('button').prop('disabled', false);

                if (res.success) {
                    try {
                        var parsed = typeof res.questions === 'string' ? JSON.parse(res.questions) : res.questions;
                        var questionsList = [];

                        if (Array.isArray(parsed)) {
                            questionsList = parsed;
                        } else if (parsed && Array.isArray(parsed.questions)) {
                            questionsList = parsed.questions;
                        } else {
                            throw new Error("Dữ liệu phản hồi không đúng cấu trúc mảng câu hỏi.");
                        }

                        var container = $('#questionsContainer');
                        container.empty();

                        questionsList.forEach(function (q, index) {
                            var html = renderQuestionBlock(index + 1, q.question, q.expectedAnswer || q.expectedCriteria || '');
                            container.append(html);
                        });
                    } catch (e) {
                        console.error("Lỗi parse JSON câu hỏi AI:", e, res.questions);
                        alert("Không thể phân tích định dạng câu hỏi do AI phản hồi không đúng cấu trúc JSON.");
                    }
                } else {
                    alert(res.message || "Lỗi khi sinh câu hỏi gợi ý.");
                }
            },
            error: function () {
                $('#questionsLoadingOverlay').hide();
                $('#questionsContainer').show();
                $('button').prop('disabled', false);
                alert("Lỗi kết nối đến máy chủ.");
            }
        });
    }

    // ============ LOGIC MỞ MODAL GIAO PHỎNG VẤN AI ============
    function openAssignInterviewModal(jobId, resumeId, candidateName) {
        $('#assignJobId').val(jobId);
        $('#assignResumeId').val(resumeId);
        $('#assignCandidateName').text(candidateName);
        $('#validationErrorMsg').removeClass('d-flex').addClass('d-none');
        $('#aiCustomPrompt').val('');
        $('#aiPromptCharCount').text('0');
        
        // Reset container và tự động thêm sẵn 3 câu hỏi trống ban đầu
        var container = $('#questionsContainer');
        container.empty();
        for (var i = 1; i <= 3; i++) {
            container.append(renderQuestionBlock(i, "", ""));
        }

        // Hiện modal
        $('#questionsLoadingOverlay').hide();
        $('#questionsContainer').show();
        
        var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('assignInterviewModal'));
        modal.show();
    }

    // Khi submit form Giao phỏng vấn, đóng gói dữ liệu JSON
    $('#assignForm').on('submit', function (e) {
        var questions = [];
        var isValid = true;
        var emptyCount = 0;

        $('.question-item-block').each(function () {
            var qText = $(this).find('.q-text-input').val().trim();
            var qCrit = $(this).find('.q-criteria-input').val().trim();
            
            if (qText === "") {
                emptyCount++;
            }

            questions.push({
                question: qText,
                expectedAnswer: qCrit
            });
        });

        var qCount = questions.length;
        var isPro = $('#isRecruiterPro').val() === 'true';
        var minQuestions = 3;
        var maxQuestions = isPro ? 10 : 5;

        // Validate số lượng câu hỏi
        if (qCount < minQuestions || qCount > maxQuestions) {
            e.preventDefault();
            var limitMsg = isPro ? "3 - 10 câu hỏi" : "3 - 5 câu hỏi";
            $('#validationErrorMsg').find('.error-text').text("Số lượng câu hỏi không hợp lệ. Bạn cần thiết lập từ " + limitMsg + ". Hiện tại đang có " + qCount + " câu hỏi.").end().removeClass('d-none').addClass('d-flex');
            return false;
        }

        // Validate nội dung trống
        if (emptyCount > 0) {
            e.preventDefault();
            $('#validationErrorMsg').find('.error-text').text("Vui lòng nhập nội dung câu hỏi đầy đủ (không được để trống câu hỏi).").end().removeClass('d-none').addClass('d-flex');
            return false;
        }

        $('#assignQuestionsJson').val(JSON.stringify(questions));
        
        var btn = $(this).find('button[type="submit"]');
        btn.prop('disabled', true);
        btn.html('<span class="spinner-border spinner-border-sm me-2"></span> Đang gửi...');
    });


    // ============ LOGIC MỞ MODAL CHẤM ĐIỂM BÀI LÀM ============
    function openEvaluateInterviewModal(sessionId) {
        $('#evalSessionId').val(sessionId);
        $('#evalLoadingSection').show();
        $('#evalMainSection').hide();
        
        var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('evaluateInterviewModal'));
        modal.show();

        // Gọi API lấy thông tin bài làm
        $.ajax({
            url: '/Interview/GetCandidateInterviewResult',
            type: 'GET',
            data: { sessionId: sessionId },
            success: function (res) {
                if (res.success) {
                    var data = res.data;
                    var container = $('#evalQuestionsContainer');
                    var hiddenInputs = $('#hiddenQuestionsInputs');
                    container.empty();
                    hiddenInputs.empty();

                    $('#evalOverallScore').val(data.overallScore || "");
                    $('#evalOverallComment').val(data.aiEvaluation || "");

                    // Nếu đã hoàn tất chấm điểm, disable nút lưu và form để chỉ xem
                    if (data.status === 1 && data.overallScore !== null) {
                        $('#btnSaveEvaluation').hide();
                    } else {
                        $('#btnSaveEvaluation').show();
                    }

                    // Tách các câu hỏi và câu trả lời
                    var interviewers = data.messages.filter(m => m.role === 'interviewer');
                    var candidates = data.messages.filter(m => m.role === 'candidate');

                    interviewers.forEach(function (q, index) {
                        // Tìm câu trả lời tương ứng
                        var ans = candidates.find(c => c.choicesJson === q.content);
                        var ansText = ans ? ans.content : "(Không có câu trả lời)";
                        var ansScore = ans && ans.score !== null ? ans.score : "";
                        var ansFeedback = ans && ans.feedback !== null ? ans.feedback : "";
                        var ansMsgId = ans ? ans.messageId : 0;

                        var html = `
                            <div class="eval-item border rounded-3 p-3 position-relative mb-3">
                                <h6 class="fw-bold mb-2 eval-question-title" style="font-size: 1.05rem;">
                                    <span class="badge bg-purple-light text-purple me-1">Câu hỏi ${index + 1}</span> ${q.content}
                                </h6>
                                <div class="eval-criteria-box p-2.5 rounded-3 mb-3 small mx-1" style="font-size: 0.8rem; line-height: 1.4;">
                                    <i class="fas fa-info-circle me-1"></i><strong>Tiêu chí đánh giá:</strong> ${q.feedback || 'Chưa thiết lập tiêu chí đánh giá cho câu hỏi này.'}
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold text-secondary small mb-1"><i class="fas fa-reply text-success"></i> Câu trả lời của ứng viên:</label>
                                    <div class="eval-answer-box p-3 rounded-3 small mx-1" style="text-align: justify; line-height: 1.5; white-space: pre-wrap;">${ansText}</div>
                                </div>
                        `;

                        if (ans) {
                            html += `
                                <div class="row g-3 align-items-center mt-2 pt-3 border-top border-secondary-subtle">
                                    <div class="col-md-3">
                                        <label class="form-label fw-bold text-secondary small mb-1">Điểm số:</label>
                                        <div class="input-group input-group-sm">
                                            <input type="number" class="form-control text-center score-input-${ansMsgId} border-secondary-subtle fw-bold text-purple" value="${ansScore}" min="0" max="100" onchange="updateHiddenInput(${ansMsgId}, this.value, null)" ${data.overallScore !== null ? 'disabled' : ''} required />
                                            <span class="input-group-text bg-light text-secondary border-secondary-subtle font-monospace" style="font-size: 0.7rem;">/100</span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold text-secondary small mb-1">Nhận xét chi tiết (STAR):</label>
                                        <textarea class="form-control feedback-input-${ansMsgId} eval-feedback-textarea border-secondary-subtle small py-1" rows="1" oninput="autoResizeTextarea(this)" onchange="updateHiddenInput(${ansMsgId}, null, this.value)" ${data.overallScore !== null ? 'disabled' : ''} placeholder="Nhập nhận xét chi tiết..." required>${ansFeedback}</textarea>
                                    </div>
                                    <div class="col-md-3 text-end">
                                        <label class="form-label d-block mb-1">&nbsp;</label>
                            `;

                            if (data.overallScore === null) {
                                html += `
                                        <button type="button" class="btn btn-outline-purple btn-sm w-100 py-2 fw-bold d-inline-flex align-items-center justify-content-center btn-ai-evaluate" style="height: 31px; border-width: 1.5px;" onclick="getAiFeedback(${ansMsgId})" title="AI tự động chấm điểm và nhận xét">
                                            <i class="fas fa-robot me-1.5"></i> AI Chấm
                                        </button>
                                `;
                            }

                            html += `
                                    </div>
                                </div>
                            `;

                            // Thêm các hidden inputs tương ứng để submit form
                            hiddenInputs.append(`
                                <input type="hidden" name="scores[${ansMsgId}]" id="hidScore-${ansMsgId}" value="${ansScore}" />
                                <input type="hidden" name="feedbacks[${ansMsgId}]" id="hidFeedback-${ansMsgId}" value="${ansFeedback}" />
                            `);
                        }

                        html += `</div>`;
                        container.append(html);
                    });

                    $('#evalLoadingSection').hide();
                    $('#evalMainSection').show();

                    // Tự động căn chỉnh chiều cao cho toàn bộ các textarea nhận xét chi tiết sau khi hiển thị (tránh display: none làm scrollHeight = 0)
                    setTimeout(function() {
                        $('.eval-feedback-textarea').each(function () {
                            autoResizeTextarea(this);
                        });
                    }, 50);
                } else {
                    alert(res.message || "Không thể tải bài làm.");
                    modal.hide();
                }
            },
            error: function () {
                alert("Lỗi kết nối máy chủ.");
                modal.hide();
            }
        });
    }

    // Hàm cập nhật các hidden inputs khi người dùng tự gõ điểm/feedback
    function updateHiddenInput(msgId, score, feedback) {
        if (score !== null) {
            $('#hidScore-' + msgId).val(score);
            calculateAverageScore();
        }
        if (feedback !== null) {
            $('#hidFeedback-' + msgId).val(feedback);
        }
    }

    // Hàm tự động tính điểm trung bình cộng các câu hỏi và điền vào OverallScore
    function calculateAverageScore() {
        var total = 0;
        var countValid = 0;
        var totalInputs = $('input[id^="hidScore-"]').length;

        $('input[id^="hidScore-"]').each(function () {
            var val = parseInt($(this).val());
            if (!isNaN(val) && $(this).val() !== "") {
                total += val;
                countValid++;
            }
        });

        // Chỉ tính điểm chung cuộc và điền vào ô khi đã chấm đủ tất cả các câu hỏi
        if (totalInputs > 0 && countValid === totalInputs) {
            $('#evalOverallScore').val(Math.round(total / totalInputs));
        } else {
            // Nếu chưa chấm đủ thì để trống
            $('#evalOverallScore').val('');
        }
    }

    // Gọi AI tự động chấm điểm và viết nhận xét STAR nháp cho 1 câu trả lời
    function getAiFeedback(messageId) {
        var btn = $('.btn-ai-evaluate').filter('[onclick="getAiFeedback(' + messageId + ')"]');
        var oldHtml = btn.html();
        btn.prop('disabled', true);
        btn.html('<span class="spinner-border spinner-border-sm"></span>');

        $.ajax({
            url: '/Interview/GetAiFeedbackForAnswer',
            type: 'POST',
            data: { messageId: messageId },
            success: function (res) {
                if (res.success) {
                    $('.score-input-' + messageId).val(res.score);
                    var textarea = $('.feedback-input-' + messageId);
                    textarea.val(res.feedback);
                    if (textarea.length > 0) {
                        autoResizeTextarea(textarea[0]);
                    }
                    
                    // Cập nhật vào hidden input
                    $('#hidScore-' + messageId).val(res.score);
                    $('#hidFeedback-' + messageId).val(res.feedback);

                    calculateAverageScore();
                    btn.html('<i class="fas fa-check text-success"></i>');
                } else {
                    alert(res.message || "Lỗi khi gọi AI chấm điểm.");
                    btn.prop('disabled', false).html(oldHtml);
                }
            },
            error: function () {
                alert("Lỗi kết nối AI service.");
                btn.prop('disabled', false).html(oldHtml);
            }
        });
    }

    // Xác nhận khi lưu kết quả chấm điểm
    $('#evaluationForm').on('submit', function (e) {
        // Đồng bộ dữ liệu hiển thị từ các ô input/textarea sang hidden input trước khi validate
        $('input[class*="score-input-"]').each(function () {
            var classAttr = $(this).attr('class');
            var match = classAttr.match(/score-input-(\d+)/);
            if (match) {
                var msgId = match[1];
                $('#hidScore-' + msgId).val($(this).val());
            }
        });
        $('textarea[class*="feedback-input-"]').each(function () {
            var classAttr = $(this).attr('class');
            var match = classAttr.match(/feedback-input-(\d+)/);
            if (match) {
                var msgId = match[1];
                $('#hidFeedback-' + msgId).val($(this).val());
            }
        });

        // Kiểm tra xem đã chấm đủ toàn bộ câu hỏi hay chưa
        var totalInputs = $('input[id^="hidScore-"]').length;
        var countValid = 0;
        var hasEmptyFeedback = false;

        $('input[id^="hidScore-"]').each(function () {
            var val = $(this).val();
            if (val !== "" && !isNaN(parseInt(val))) {
                countValid++;
            }
        });

        $('input[id^="hidFeedback-"]').each(function () {
            var val = $(this).val().trim();
            if (val === "") {
                hasEmptyFeedback = true;
            }
        });

        if (countValid < totalInputs || hasEmptyFeedback) {
            e.preventDefault();
            alert("Bạn bắt buộc phải chấm điểm và nhập nhận xét chi tiết cho tất cả " + totalInputs + " câu hỏi trước khi lưu kết quả!");
            return false;
        }

        // Kiểm tra điểm chung cuộc và nhận xét tổng quan
        var overallScore = $('#evalOverallScore').val();
        var overallComment = $('#evalOverallComment').val().trim();
        if (overallScore === "" || overallComment === "") {
            e.preventDefault();
            alert("Vui lòng nhập Điểm chung cuộc và Nhận xét tổng quan chính thức!");
            return false;
        }

        if (!confirm("Bạn có chắc chắn muốn lưu kết quả chấm điểm? Trạng thái sẽ chuyển thành Đã chấm điểm.")) {
            e.preventDefault();
            return false;
        }
        
        var btn = $('#btnSaveEvaluation');
        btn.prop('disabled', true);
        btn.html('<span class="spinner-border spinner-border-sm me-2"></span> Đang lưu...');
    });
</script>

