                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-bold text-secondary small">Lời nhắn / Chỉ dẫn gửi ứng viên:</label>
                                    <textarea name="notes" id="interviewNotes" class="form-control rounded-3 border-secondary-subtle" rows="3" placeholder="Ví dụ: Vui lòng chuẩn bị CV bản in, trang phục lịch sự và có mặt trước 10 phút..."></textarea>
                                </div>
