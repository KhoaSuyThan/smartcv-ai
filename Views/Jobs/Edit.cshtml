@model DoAnCS.Models.Job
@{
    ViewData["Title"] = "Chỉnh sửa tin tuyển dụng";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0 p-4">
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                    <h4 class="fw-bold text-primary mb-0">
                        <i class="bi bi-pencil-square me-2"></i>Chỉnh sửa tin tuyển dụng
                    </h4>
                    <a href="@(string.IsNullOrEmpty(ViewBag.ReturnUrl) ? (User.IsInRole("Admin") ? "/Admin/Jobs" : "/Jobs/Manage") : ViewBag.ReturnUrl)" class="btn btn-outline-secondary btn-sm rounded-pill">
                        <i class="bi bi-arrow-left me-1"></i>Quay lại
                    </a>
                </div>

                <form asp-action="Edit" method="post">
                    @if (!string.IsNullOrEmpty(ViewBag.ReturnUrl))
                    {
                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    }
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    @* Các trường ẩn để giữ ID và dữ liệu gốc *@
                    <input type="hidden" asp-for="JobID" />
                    <input type="hidden" asp-for="RecruiterID" />
                    <input type="hidden" asp-for="CompanyID" />
                    <input type="hidden" asp-for="CreatedAt" />

                    <div class="row g-4">
                        <div class="col-md-12">
                            <label asp-for="Title" class="form-label fw-bold small text-uppercase text-muted">Tiêu đề tin</label>
                            <input asp-for="Title" class="form-control" placeholder="Ví dụ: Senior .NET Developer" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-uppercase text-muted">Mức lương</label>
                            <select id="salaryType" class="form-select mb-2">
                                <option value="Thỏa thuận">Thỏa thuận</option>
                                <option value="Cạnh tranh">Cạnh tranh</option>
                                <option value="Nhập liệu">Nhập liệu cụ thể</option>
                            </select>

                            <div class="input-group" id="salaryInputGroup" style="display: none;">
                                <span class="input-group-text bg-light"><i class="bi bi-cash"></i></span>
                                <input type="text" id="customSalary" class="form-control" placeholder="Ví dụ: 15-25" />
                                <span class="input-group-text bg-light">triệu VNĐ/Tháng</span>
                            </div>
                            <input type="hidden" asp-for="Salary" id="Salary" />
                            <span asp-validation-for="Salary" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Deadline" class="form-label fw-bold small text-uppercase text-muted">Hạn cuối nộp hồ sơ</label>
                            <input asp-for="Deadline" type="date" class="form-control" />
                            <span asp-validation-for="Deadline" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-bold small text-uppercase text-muted">Trạng thái</label>
                            <select asp-for="Status" class="form-select">
                                <option value="1">Đang tuyển (Công khai)</option>
                                <option value="0">Tạm dừng (Ẩn tin)</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-uppercase text-muted">Địa điểm làm việc</label>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <select id="ProvinceSelect" class="form-select">
                                        <option value="">Chọn tỉnh/thành phố</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <select id="DistrictSelect" class="form-select">
                                        <option value="">Chọn quận/huyện</option>
                                    </select>
                                </div>
                            </div>
                            <input type="text" asp-for="Location" id="Location" style="position: absolute; left: -9999px; top: 0;" />
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-bold small text-uppercase text-muted">Mô tả công việc</label>
                            <textarea asp-for="Description" class="form-control" rows="6" placeholder="Mô tả các công việc chính..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Requirements" class="form-label fw-bold small text-uppercase text-muted">Yêu cầu ứng viên</label>
                            <textarea asp-for="Requirements" class="form-control" rows="6" placeholder="Yêu cầu về kỹ năng, kinh nghiệm..."></textarea>
                            <span asp-validation-for="Requirements" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mt-5 pt-3 border-top d-flex justify-content-end gap-2">
                        <button type="submit" class="btn btn-primary px-5 rounded-pill shadow-sm fw-bold">
                            <i class="bi bi-save me-2"></i>Cập nhật tin ngay
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var salaryHidden = document.getElementById("Salary");
            if (!salaryHidden) return;
            
            var salaryType = document.getElementById("salaryType");
            var salaryInputGroup = document.getElementById("salaryInputGroup");
            var customSalary = document.getElementById("customSalary");

            // Khởi tạo từ dữ liệu cũ
            var initialValue = salaryHidden.value;
            if (!initialValue || initialValue === "Thỏa thuận") {
                salaryType.value = "Thỏa thuận";
                salaryHidden.value = "Thỏa thuận";
            } else if (initialValue === "Cạnh tranh") {
                salaryType.value = "Cạnh tranh";
            } else {
                salaryType.value = "Nhập liệu";
                var num = initialValue.replace(" triệu VNĐ/Tháng", "").replace(" triệu", "").trim();
                customSalary.value = num;
                salaryInputGroup.style.display = "flex";
            }

            function updateHiddenValue() {
                if (salaryType.value === "Nhập liệu") {
                    if (customSalary.value.trim() !== "") {
                        salaryHidden.value = customSalary.value.trim() + " triệu VNĐ/Tháng";
                    } else {
                        salaryHidden.value = "";
                    }
                } else {
                    salaryHidden.value = salaryType.value;
                }
            }

            salaryType.addEventListener("change", function () {
                if (this.value === "Nhập liệu") {
                    salaryInputGroup.style.display = "flex";
                } else {
                    salaryInputGroup.style.display = "none";
                }
                updateHiddenValue();
            });

            customSalary.addEventListener("input", function () {
                updateHiddenValue();
            });

            // --- ĐỒNG BỘ ĐỊA ĐIỂM TỈNH/THÀNH VÀ QUẬN/HUYỆN ---
            var provincesData = [];
            var provinceSelect = document.getElementById("ProvinceSelect");
            var districtSelect = document.getElementById("DistrictSelect");
            var locationHidden = document.getElementById("Location");

            async function loadProvinces() {
                try {
                    const response = await fetch('/data/provinces.json');
                    provincesData = await response.json();
                    
                    provinceSelect.innerHTML = '<option value="">Chọn tỉnh/thành phố</option>';
                    provincesData.forEach(p => {
                        const option = document.createElement('option');
                        option.value = p.name;
                        option.text = p.name;
                        provinceSelect.add(option);
                    });

                    // Khởi tạo nếu đã có giá trị sẵn
                    if (locationHidden && locationHidden.value) {
                        setDropdownsFromLocation(locationHidden.value);
                    }
                } catch (e) {
                    console.error("Error loading provinces:", e);
                }
            }

            function populateDistricts(provinceName) {
                districtSelect.innerHTML = '<option value="">Chọn quận/huyện</option>';
                if (!provinceName) return;

                const province = provincesData.find(p => p.name === provinceName);
                if (province && province.districts) {
                    province.districts.forEach(d => {
                        const option = document.createElement('option');
                        option.value = d.name;
                        option.text = d.name;
                        districtSelect.add(option);
                    });
                }
            }

            function setDropdownsFromLocation(locString) {
                if (!locString) return;
                const parts = locString.split(',').map(s => s.trim());
                if (parts.length >= 2) {
                    const dName = parts[0];
                    const pName = parts[1];
                    provinceSelect.value = pName;
                    populateDistricts(pName);
                    districtSelect.value = dName;
                } else {
                    const pName = parts[0];
                    provinceSelect.value = pName;
                    populateDistricts(pName);
                    districtSelect.value = '';
                }
            }

            function updateLocationHidden() {
                const p = provinceSelect.value;
                const d = districtSelect.value;
                if (p && d) {
                    locationHidden.value = d + ', ' + p;
                } else if (p) {
                    locationHidden.value = p;
                } else {
                    locationHidden.value = '';
                }
            }

            provinceSelect.addEventListener('change', function() {
                populateDistricts(this.value);
                updateLocationHidden();
            });

            districtSelect.addEventListener('change', function() {
                updateLocationHidden();
            });

            locationHidden.addEventListener('input', function() {
                setDropdownsFromLocation(this.value);
            });
            locationHidden.addEventListener('change', function() {
                setDropdownsFromLocation(this.value);
            });

            loadProvinces();
        });
    </script>
}