        $(document).ready(function() {
            // 1. Lấy dữ liệu JSON từ Model gửi từ C# sang
            const experiencesJson = `@Html.Raw(Model.ResumeSections?.FirstOrDefault(s => s.SectionType == "Experience")?.ContentJSON ?? "[]")`;
            const educationJson = `@Html.Raw(Model.ResumeSections?.FirstOrDefault(s => s.SectionType == "Education")?.ContentJSON ?? "[]")`;
            const skillsJson = `@Html.Raw(Model.ResumeSections?.FirstOrDefault(s => s.SectionType == "Skills")?.ContentJSON ?? "[]")`;

            // Làm sạch container trước khi đổ dữ liệu
            $('#experience-container').empty();
            $('#education-container').empty();
            $('#it-skills-container').empty();

            // 2. Khôi phục Kinh nghiệm
            const exps = JSON.parse(experiencesJson);
            if (exps.length > 0) {
                exps.forEach(item => addItemWithData('experience', item));
            } else {
                addItem('experience'); // Tự động tạo 1 ô trống nếu chưa có dữ liệu
            }

            // 3. Khôi phục Học vấn
            const edus = JSON.parse(educationJson);
            if (edus.length > 0) {
                edus.forEach(item => addItemWithData('education', item));
            } else {
                addItem('education'); // Tự động tạo 1 ô trống nếu chưa có dữ liệu
            }

            // 4. Khôi phục Kỹ năng (IT Skills)
            const skills = JSON.parse(skillsJson);
            if (skills.length > 0) {
                skills.forEach(item => addItemWithData('it-skill', item));
            }

            updatePreview(); 
            $(document).on('input', '.form-control', updatePreview);
        });

