                                    <div class="col-7"><input type="text" class="form-control it-skill-name" value="${data.Name || ''}" placeholder="Kỹ năng"></div>
                                    <div class="col-5"><input type="text" class="form-control it-skill-level" value="${data.Level || ''}" placeholder="Mức độ"></div>
                                </div>
                            </div>`;
                $('#it-skills-container').append(html);
            }
        }

        async function manualSave(btn) {
            const $btn = $(btn);
            const originalHtml = $btn.html();
            const resumeId = parseInt($('#ResumeID').val()) || 0;

            if (resumeId === 0) {
                alert("Không tìm thấy ID bản ghi để lưu!");
                return;
            }

            // 1. Hiệu ứng đang lưu
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang lưu...');
            $('#autosave-status').html('<i class="fas fa-sync fa-spin"></i> Đang xử lý lệnh lưu thủ công...');

            try {
                // 2. Gom dữ liệu
                const data = gatherResumeData();

                // 3. Gửi Ajax (Dùng chung Action AutoSave vì logic lưu là như nhau)
                const res = await $.ajax({
                    url: '/Resume/AutoSave',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data)
                });

                if (res.success) {
                    isDirty = false; // Reset cờ thay đổi
                    
                    // 4. Hiệu ứng thành công: Đổi màu nút xanh lá đậm trong 2 giây
                    $btn.removeClass('btn-success').addClass('btn-primary').html('<i class="fas fa-check"></i> Đã lưu thành công!');
                    $('#autosave-status').html('<i class="fas fa-check-circle text-success"></i> Hệ thống đã cập nhật lúc ' + res.lastSaved);

                    setTimeout(() => {
                        $btn.removeClass('btn-primary').addClass('btn-success').html(originalHtml);
                        $btn.prop('disabled', false);
                    }, 2000);
                } else {
                    alert("Lỗi: " + res.message);
                    $btn.prop('disabled', false).html(originalHtml);
                }
            } catch (err) {
                console.error(err);
                alert("Không thể kết nối đến máy chủ!");
                $btn.prop('disabled', false).html(originalHtml);
            }
        }

        // 1. Hàm tối ưu Kinh nghiệm làm việc
        function optimizeExperience(btn) {
            const $btn = $(btn);
            const $textarea = $btn.closest('.mb-3').find('textarea'); // Tìm ô textarea tương ứng
            const content = $textarea.val();
            const jobTitle = $('#JobTitle').val(); // Lấy vị trí ứng tuyển làm ngữ cảnh

            if (!content) { alert("Vui lòng nhập vài ý về công việc của bạn!"); return; }

            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang tối ưu...');

            $.post('/AI/ProcessText', { type: 'optimize_exp', content: content, context: jobTitle }, function(res) {
                if (res.success) {
                    $textarea.val(res.data);
                    updatePreview(); // Cập nhật bản xem trước CV
                }
                $btn.prop('disabled', false).html('✨ Tối ưu bằng AI (STAR)');
            });
        }

        // 2. Hàm gợi ý Kỹ năng
        function suggestSkills() {
            const jobTitle = $('#JobTitle').val(); // Người dùng nhập "Web Developer" chẳng hạn
            if (!jobTitle) { alert("Vui lòng nhập Vị trí ứng tuyển trước!"); return; }

            const $btn = $('.btn-primary:contains("Gợi ý kỹ năng")');
            $btn.prop('disabled', true).text('Đang tìm...');

            $.post('/AI/ProcessText', { type: 'suggest_skills', content: jobTitle }, function(res) {
                if (res.success) {
                    // Cộng dồn vào các kỹ năng đã có
                    let currentSkills = $('#SkillsInput').val();
                    $('#SkillsInput').val(currentSkills ? currentSkills + ", " + res.data : res.data);
                    updatePreview();
                }
                $btn.prop('disabled', false).text('🪄 Gợi ý kỹ năng');
            });
        }

        let isDirty = false; // Biến cờ: Chỉ lưu khi có thay đổi thực sự
        let currentResumeId = $('#ResumeID').val(); // Đảm bảo bạn có input ẩn lưu ResumeID

        // Theo dõi mọi thay đổi trên các ô nhập liệu
        $(document).on('input change', '.form-control', function() {
            isDirty = true;
        });

        // Vòng lặp tự động lưu mỗi 30 giây
        setInterval(function() {
            let resumeId = parseInt($('#ResumeID').val()) || 0;
            if (isDirty && currentResumeId > 0) {
                performAutoSave();
            }
        }, 30000); // 30000ms = 30s

        function performAutoSave() {
            // 1. Gom dữ liệu (Sử dụng hàm gom dữ liệu bạn đã có)
            const data = gatherResumeData(); 
            console.log("Dữ liệu chuẩn bị gửi đi:", data);

            if(data.ResumeID === 0) {
                console.error("LỖI: ResumeID đang bằng 0, Server sẽ từ chối lưu!");
                return;
            }

            // 2. Hiện thông báo "Đang lưu..." nhỏ ở góc
            $('#autosave-status').html('<i class="fas fa-sync fa-spin"></i> Đang lưu nháp...');

            $.ajax({
                url: '/Resume/AutoSave',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function(res) {
                    if (res.success) {
                        isDirty = false;
                        // Hiển thị thời gian lưu cuối cùng
                        $('#autosave-status').html('<i class="fas fa-check-circle text-success"></i> Đã lưu lúc ' + res.lastSaved);
                    }
                },
                error: function() {
                    $('#autosave-status').html('<i class="fas fa-exclamation-triangle text-danger"></i> Lỗi lưu tự động');
                }
            });
        }
    </script>
}