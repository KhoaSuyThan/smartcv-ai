@model DoAnCS.Models.Resume
@{
    var temp = Model.Template;
    ViewData["Title"] = "Thiết kế CV (Beta) - " + (temp?.Name ?? "Mẫu mới");

    string GetSectionJson(string type, string defaultVal = "[]")
    {
        var section = Model.ResumeSections?.FirstOrDefault(s => s.SectionType == type);
        return (section != null && !string.IsNullOrEmpty(section.ContentJSON)) ? section.ContentJSON : defaultVal;
    }
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Merriweather:ital,wght@0,300;0,400;0,700;1,300&family=Montserrat:wght@300;400;500;600;700;800&family=Open+Sans:wght@300;400;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">

<style>
    /* Bắt buộc ẩn footer */
    footer, .footer, #footer { display: none !important; opacity: 0 !important; visibility: hidden !important; height: 0 !important; overflow: hidden !important; }
    
    /* Ghi đè container của ASP.NET Core */
    main[role="main"] { padding: 0 !important; margin: 0 !important; max-width: 100% !important; display: flex !important; flex-direction: column !important; flex: 1 !important; overflow: hidden !important; }
    .content-wrapper { padding: 0 !important; margin: 0 !important; display: flex !important; flex-direction: column !important; flex: 1 !important; overflow: hidden !important; }
    .container { max-width: 100% !important; padding: 0 !important; margin: 0 !important; }
    
    /* Ngăn scroll dọc ngoài body và giới hạn chiều cao tuyệt đối (125vh để bù trừ cho zoom 80%) */
    body { overflow: hidden !important; height: 125vh !important; }
    html { overflow: hidden !important; height: 125vh !important; }

    /* TỐI ƯU HÓA KHI IN / XUẤT PDF */
    @@page { 
        size: A4; 
        margin: 0; 
    }

    @@media print {
        * { 
            -webkit-print-color-adjust: exact !important; 
            print-color-adjust: exact !important; 
        }

        /* Ẩn các phần của layout trang web */
        body > header, 
        body > footer, 
        body > nav, 
        body > aside, 
        .no-print,
        button,
        select,
        .fixed,
        .sticky,
        #react-beta-root [data-toolbar="true"] { 
            display: none !important; 
        }

        /* Thiết lập lại phần chứa React App và tất cả các tầng bọc ngoài của CV */
        html, body, #react-beta-root, 
        #react-beta-root > div,
        #react-beta-root > div > div:last-child,
        #react-beta-root > div > div:last-child > div:not([data-toolbar="true"]) { 
            background: white !important; 
            background-image: none !important;
            display: block !important; 
            margin: 0 !important; 
            padding: 0 !important; 
            width: 100% !important; 
            height: auto !important; 
            min-height: 0 !important;
            overflow: visible !important;
            position: static !important;
            box-shadow: none !important;
            zoom: 100% !important; /* Đảm bảo loại bỏ zoom 80% từ Layout */
        }

        /* Ẩn cột trái chỉnh sửa */
        #react-beta-root > div > div:first-child {
            display: none !important;
        }

        /* Ẩn các spacer bên ngoài CV */
        #react-beta-root > div > div:last-child > div:not([data-toolbar="true"]) > div:last-child {
            display: none !important;
        }

        /* Định cấu hình trang CV xem trước khi in */
        #cv-preview-area { 
            width: 210mm !important; 
            min-height: 297mm !important;
            overflow: visible !important; 
            margin: 0 auto !important; 
            box-shadow: none !important; 
            zoom: 1.0 !important; /* Đưa về tỉ lệ 100% thực tế */
            border: none !important;
            position: relative !important; 
            background: white !important; 
            page-break-after: avoid !important;
        }

        /* Đảm bảo chiều cao các khối nội dung co dãn tự nhiên */
        #cv-preview-area main,
        #cv-preview-area aside,
        #cv-preview-area .left-column,
        #cv-preview-area .right-column,
        #cv-preview-area .left-sidebar,
        #cv-preview-area .right-main,
        #cv-preview-area .cv-sidebar,
        #cv-preview-area .cv-main-content {
            overflow: visible !important;
            height: auto !important;
            min-height: 0 !important;
        }
    }
</style>

<div id="react-beta-root" style="width: 100%; flex: 1; margin: 0; padding: 0; display: flex; background: #525659; overflow: hidden;"></div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script>
        // Xóa cứng footer bằng JS để đảm bảo chắc chắn 100%
        document.addEventListener("DOMContentLoaded", function() {
            var footers = document.querySelectorAll('footer');
            footers.forEach(f => f.remove());
        });

        // Inject data from C# Model to JS Window object
        window.INITIAL_TEMPLATE_NAME = '@Html.Raw(temp?.Name ?? "Đặng Ngọc Linh")';
        window.INITIAL_RESUME_DATA = {
            ResumeID: @Model.ResumeID,
            TemplateID: @Model.TemplateID,
            isPro: @(ViewBag.IsPro == true ? "true" : "false"),
            Title: '@Html.Raw((Model.Title ?? "CV React Beta").Replace("'", "\\'"))',
            fullName: '@Html.Raw((Model.FullName ?? "").Replace("'", "\\'"))',
            jobTitle: '@Html.Raw((Model.JobTitle ?? "").Replace("'", "\\'"))',
            phone: '@Html.Raw((Model.Phone ?? "").Replace("'", "\\'"))',
            email: '@Html.Raw((Model.Email ?? "").Replace("'", "\\'"))',
            address: '@Html.Raw((Model.Address ?? "").Replace("'", "\\'"))',
            summary: '@Html.Raw((Model.Summary ?? "").Replace("'", "\\'").Replace("\n", "\\n"))',
            avatarUrl: '@Html.Raw((Model.AvatarUrl ?? "").Replace("'", "\\'"))',
            themeColor: '@Html.Raw((Model.ThemeColor ?? "").Replace("'", "\\'"))',
            fontFamily: @Html.Raw(GetSectionJson("FontFamily", "\"\"")),
            bgColor: @Html.Raw(GetSectionJson("BgColor", "\"\"")),
            textAlign: @Html.Raw(GetSectionJson("TextAlign", "\"\"")),
            visibleSections: @Html.Raw(GetSectionJson("VisibleSections", "{}")),
            website: @Html.Raw(GetSectionJson("Website", "\"\"")),
            experiences: @Html.Raw(GetSectionJson("Experience", "[]")), 
            educations: @Html.Raw(GetSectionJson("Education", "[]")),
            skills: @Html.Raw(GetSectionJson("Skills", "[]")),
            projects: @Html.Raw(GetSectionJson("Projects", "[]")),
            activities: @Html.Raw(GetSectionJson("Activities", "[]")),
            certifications: @Html.Raw(GetSectionJson("Certifications", "[]")),
            awards: @Html.Raw(GetSectionJson("Awards", "[]")),
            references: @Html.Raw(GetSectionJson("References", "[]")),
            hobbies: @Html.Raw(GetSectionJson("Hobbies", "[]")),
            languages: @Html.Raw(GetSectionJson("Languages", "[]")),
            otherSkills: @Html.Raw(GetSectionJson("OtherSkills", "[]"))
        };
        window.TEMPLATE_METADATA = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.TemplatesMetadata));
    </script>
    <script type="module" src="~/js/react-beta/app.js"></script>
}