                                <div class="col-5"><input type="text" class="form-control other-level" placeholder="Mức độ"></div>
                            </div>
                        </div>`;
            $('#other-skills-container').append(html);
        }
        // 5. Hàm cập nhật Preview (Mỗi Token chỉ được xử lý 1 lần duy nhất)
        function updatePreview() {
            // 1. Luôn bắt đầu từ mã HTML gốc để đảm bảo các Token không bị mất sau lần thay thế đầu tiên
            let currentHtml = originalHtml;
            let avatarSrc = $('#AvatarBase64').val() || 'https://i.imgur.com/8Km9tLL.png';  

            // 2. Bản đồ Token cho các thông tin cố định
            const map = {
                '{{FullName}}': $('#FullNameInput').val() || 'HỌ VÀ TÊN ỨNG VIÊN',
                '{{JobTitle}}': $('#JobTitleInput').val() || 'VỊ TRÍ ỨNG TUYỂN',
                '{{Summary}}': $('#SummaryInput').val() || 'Mục tiêu nghề nghiệp...',
                '{{Email}}': $('#EmailInput').val() || 'email@example.com',
                '{{Phone}}': $('#PhoneInput').val() || '0123.456.789',
                '{{AvatarUrl}}': avatarSrc,
                '{{BirthDate}}': $('#BirthDateInput').val() || '27/01/1998',
                '{{Address}}': $('#AddressInput').val() || 'TP. Hồ Chí Minh',
                '{{GraduationType}}': $('.edu-gradtype').val() || 'Chưa cập nhật' //
            };

            // 3. Xử lý các danh sách động (Học vấn, Kinh nghiệm, Kỹ năng...)

            // --- HỌC VẤN ---
            let eduHtml = '';
                $('.education-item').each(function() {
                    let school = $(this).find('.edu-school').val();
                    let major = $(this).find('.edu-major').val();
                    let year = $(this).find('.edu-year').val();
                    let grad = $(this).find('.edu-gradtype').val();
                    
                    if(school) {
                        eduHtml += `
                            <div class="exp-item">
                                <span class="exp-year">• ${year || '2020 - 2024'}</span>
                                <div class="exp-content">
                                    <strong>${school}</strong><br>
                                    ${major}<br>
                                    ${grad ? `Xếp loại: ${grad}` : ''}
                                </div>
                            </div>`;
                    }
                });
            map['{{Education}}'] = eduHtml;

            // --- KINH NGHIỆM LÀM VIỆC ---
            let expHtml = '';
                $('.experience-item').each(function() {
                    let company = $(this).find('.exp-company').val();
                    let role = $(this).find('.exp-role').val();
                    let time = $(this).find('.exp-time').val();
                    let desc = $(this).find('.exp-desc').val();
                    
                    let formattedDesc = desc ? desc.trim().split('\n').filter(line => line.trim() !== "").join('<br>') : 'Mô tả chi tiết...';

                    if(company || role) {
                        // Thay đoạn cũ bằng đoạn này (viết sát các thẻ div lại với nhau)
                        expHtml += `<div class="exp-item"><span class="exp-year">• ${time || '2022 - 2025'}</span><div class="exp-content"><div class="info-line"><strong>Công ty:</strong> ${company || ''}</div><div class="info-line"><strong>Vị trí:</strong> ${role || ''}</div><div class="desc-text">${formattedDesc}</div></div></div>`;
                    }
                });
            map['{{Experience}}'] = expHtml;

            // --- TIN HỌC ---
            let itHtml = '<ul style="list-style:none; padding:0; margin:0;">';
            $('.it-skill-item').each(function() {
                let name = $(this).find('.it-skill-name').val();
                let level = $(this).find('.it-skill-level').val();
                if(name) itHtml += `<li>• ${name}: ${level}</li>`;
            });
            map['{{Skills}}'] = itHtml + '</ul>';

            // --- NGOẠI NGỮ ---
            let langHtml = '<ul style="list-style:none; padding:0; margin:0;">';
            $('.language-item').each(function() {
                let name = $(this).find('.lang-name').val();
                let level = $(this).find('.lang-level').val();
                if(name) langHtml += `<li style="display:flex; justify-content:space-between;"><span>• ${name}</span><span style="font-style:italic; opacity:0.8;">${level}</span></li>`;
            });
            map['{{Languages}}'] = langHtml + '</ul>';

            // --- KỸ NĂNG KHÁC ---
            let otherHtml = '<ul style="list-style:none; padding:0; margin:0;">';
            $('.other-skill-item').each(function() {
                let name = $(this).find('.other-name').val();
                let level = $(this).find('.other-level').val();
                if(name) otherHtml += `<li>• ${name} ${level ? '('+level+')' : ''}</li>`;
            });
            map['{{OtherSkills}}'] = otherHtml + '</ul>';

            // --- GIẢI THƯỞNG ---
            let awardHtml = '<ul style="padding-left:15px; margin:0;">';
            $('.award-item').each(function() {
                let name = $(this).find('.award-name').val();
                if(name) awardHtml += `<li>${name}</li>`;
            });
            map['{{Awards}}'] = awardHtml + '</ul>';

            // --- NGƯỜI THAM CHIẾU ---
            let refHtml = '';
            $('.reference-item').each(function() {
                let info = $(this).find('.ref-info').val();
                if(info) refHtml += `<p style="margin-bottom:5px; font-size:12px;">• ${info}</p>`;
            });
            map['{{References}}'] = refHtml;

            // Quét CHỨNG CHỈ (Sidebar CV 2)
            let certHtml = '';
            $('.cert-item').each(function() {
                let year = $(this).find('.cert-year').val();
                let name = $(this).find('.cert-name').val();
                if(name) {
                    certHtml += `<div style="margin-bottom:8px;">
                                    <div style="font-weight:bold; font-size:11px; color:#634c46;">${year}</div>
                                    <div style="font-size:12.5px;">${name}</div>
                                </div>`;
                }
            });
            map['{{Certifications}}'] = certHtml;

            // Quét HOẠT ĐỘNG (Main Body CV 2)
            let actHtml = '';
            $('.activity-item').each(function() {
                let name = $(this).find('.act-name').val();
                let time = $(this).find('.act-time').val();
                let desc = $(this).find('.act-desc').val();
                if(name) {
                    actHtml += `<div class="exp-item">
                                    <div class="exp-header">
                                        <span class="company-name">${name}</span>
                                        <span class="date-badge">${time}</span>
                                    </div>
                                    <div class="exp-desc">${desc}</div>
                                </div>`;
                }
            });
            map['{{Activities}}'] = actHtml;

            // 4. Tiến hành thay thế hàng loạt Token bằng Regex
            for (let token in map) {
                let regex = new RegExp(token.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'g');
                currentHtml = currentHtml.replace(regex, map[token]);
            }

            // 5. Cập nhật vùng Preview
            $('#resume-preview').html(currentHtml);
        }

