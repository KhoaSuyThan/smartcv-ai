        async function exportToPDF() {
            const { jsPDF } = window.jspdf;
            
            // 1. Lấy ResumeID từ input ẩn
            const resumeId = parseInt($('#ResumeID').val()) || 0;
            if (resumeId === 0) {
                alert("Lỗi: Không tìm thấy ID bản ghi để lưu dữ liệu!");
                return;
            }

            // 2. Thiết lập trạng thái nút bấm
            const btn = event.currentTarget;
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang lưu & tạo PDF...';
            btn.disabled = true;

            try {
                // --- BƯỚC A: ÉP LƯU DỮ LIỆU MỚI NHẤT VÀO DATABASE ---
                // Sử dụng hàm gatherResumeData() để gom dữ liệu hiện tại trên form
                const currentData = gatherResumeData(); 
                
                const saveRes = await $.ajax({
                    url: '/Resume/AutoSave',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(currentData)
                });

                if (!saveRes.success) {
                    throw new Error("Không thể lưu bản nháp trước khi xuất PDF.");
                }

                // --- BƯỚC B: GHI LOG LỊCH SỬ XUẤT FILE ---
                $.post('/Resume/LogExport', { resumeId: resumeId });

                // --- BƯỚC C: TẠO FILE PDF (GIỮ NGUYÊN LOGIC CỦA BẠN) ---
                const element = document.querySelector('.cv-preview-wrapper') || document.querySelector('.preview-column > div'); 

                // Tạm thời đưa zoom về 100% để tránh lỗi html2canvas làm dính chữ khi trang đang bị zoom
                const htmlElement = document.documentElement;
                const originalZoom = htmlElement.style.zoom;
                htmlElement.style.zoom = "100%";

                const canvas = await html2canvas(element, {
                    scale: 2, 
                    useCORS: true,
                    logging: false,
                    backgroundColor: "#ffffff"
                });

                // Khôi phục lại mức zoom ban đầu
                if (originalZoom) {
                    htmlElement.style.zoom = originalZoom;
                } else {
                    htmlElement.style.removeProperty('zoom');
                }

                const imgData = canvas.toDataURL('image/png');
                const pdf = new jsPDF('p', 'mm', 'a4');
                const pageWidth = 210;
                const pageHeight = 297;
                const imgWidth = pageWidth;
                const imgHeight = (canvas.height * pageWidth) / canvas.width;

                pdf.addImage(imgData, 'PNG', 0, 0, imgWidth, imgHeight);
                pdf.save(`CV_${resumeId}_${new Date().getTime()}.pdf`);

                // Thông báo thành công trên thanh trạng thái (nếu có)
                $('#autosave-status').html('<i class="fas fa-check-circle text-success"></i> Đã lưu và xuất PDF thành công!');

            } catch (error) {
                console.error(error);
                alert("Lỗi: " + error.message);
            } finally {
                // Hoàn tác trạng thái nút
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }

