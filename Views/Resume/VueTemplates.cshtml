@model IEnumerable<DoAnCS.Models.VueTemplate>
@{
    ViewData["Title"] = "Thư viện mẫu CV Vue (Testing)";
}

<style>
    .template-card {
        position: relative; 
        transition: transform 0.3s ease; 
        border: 1px solid #eee !important;
    }
    .border-pro { border: 2px solid #ffc107 !important; }

    .template-card img {
        object-fit: contain !important; 
        padding: 10px;
    }

    .template-card:hover { transform: translateY(-10px); box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important; }

    .hover-overlay {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0, 0, 0, 0.4);
        display: flex;
        align-items: flex-end;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.3s ease;
        z-index: 2;
    }
    .template-card:hover .hover-overlay { opacity: 1; }
    
    .test-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        z-index: 3;
    }
</style>

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold mb-3 text-primary"><i class="fas fa-flask me-2"></i>Thử nghiệm Mẫu CV Vue</h1>
        <p class="text-muted mx-auto" style="max-width: 600px;">
            Đây là tab tạm thời để kiểm tra các mẫu CV được xây dựng bằng Vue.js từ bảng <code>VueTemplates</code>.
        </p>
    </div>

    <div class="d-flex justify-content-center gap-2 mb-5 flex-wrap filter-container">
        <button class="btn btn-outline-primary rounded-pill px-4 filter-btn active" data-filter="all">Tất cả mẫu</button>
        <button class="btn btn-outline-primary rounded-pill px-4 filter-btn" data-filter="IT">IT</button>
        <button class="btn btn-outline-primary rounded-pill px-4 filter-btn" data-filter="Kinh doanh">Kinh doanh</button>
        <button class="btn btn-outline-primary rounded-pill px-4 filter-btn" data-filter="Marketing">Marketing</button>
        <button class="btn btn-outline-primary rounded-pill px-4 filter-btn" data-filter="Tài chính">Tài chính</button>
        <button class="btn btn-outline-primary rounded-pill px-4 filter-btn" data-filter="Sáng tạo">Sáng tạo</button>
        <button class="btn btn-outline-primary rounded-pill px-4 filter-btn" data-filter="Y tế">Y tế</button>
        <button class="btn btn-outline-primary rounded-pill px-4 filter-btn" data-filter="Thực tập">Thực tập</button>
        <button class="btn btn-outline-primary rounded-pill px-4 filter-btn" data-filter="Chuyên nghiệp">Chuyên nghiệp</button>
        <button class="btn btn-outline-primary rounded-pill px-4 filter-btn" data-filter="Khác">Khác</button>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show shadow-sm border-0 mb-4 rounded-3 d-flex align-items-center justify-content-between" role="alert">
            <div class="d-flex align-items-center">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <span class="fw-bold">@TempData["ErrorMessage"]</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4 justify-content-center">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="alert alert-info">
                    Chưa có mẫu CV Vue nào trong bảng VueTemplates.
                </div>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4 col-lg-3 template-item" data-category="@item.Category">
                    <div class="card h-100 border-0 shadow-sm template-card @(item.IsPremium ? "border-pro" : "")">
                        <div class="test-badge">
                            <span class="badge bg-danger shadow-sm px-2 py-1 rounded-pill fw-bold">VUE TEST</span>
                        </div>
                        
                        @if (item.IsPremium)
                        {
                            <div class="position-absolute top-0 end-0 m-2 z-3">
                                <span class="badge bg-warning text-dark shadow-sm px-3 py-2 rounded-pill fw-bold">
                                    <i class="fas fa-crown me-1"></i> PRO
                                </span>
                            </div>
                        }
                        
                        <div class="position-relative">
                            <img src="@item.ThumbnailUrl" class="card-img-top p-2 bg-light" alt="@item.TemplateName" 
                                 style="height: 350px; object-fit: cover;"
                                 onerror="this.src='https://images.unsplash.com/photo-1586281380117-5a60ae2050cc?q=80&w=400'">
                            
                            <div class="hover-overlay">
                                <a asp-controller="Resume" 
                                   asp-action="CreateVue" 
                                   asp-route-id="@item.Id" 
                                   class="btn btn-primary rounded-pill px-4 shadow fw-bold mb-3">
                                    Sử dụng mẫu này
                                </a>
                            </div>
                        </div>
                        <div class="card-body text-center">
                            <h6 class="fw-bold mb-1">@item.TemplateName</h6>
                            <p class="small text-muted mb-1">Component: @item.ComponentName</p>
                            @if (!string.IsNullOrEmpty(item.Category))
                            {
                                <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3">@item.Category</span>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <div class="mt-5 text-center">
        <a asp-action="Templates" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="fas fa-arrow-left me-2"></i> Quay lại Kho mẫu chính
        </a>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const filters = document.querySelectorAll('.filter-btn');
        const items = document.querySelectorAll('.template-item');
        const predefinedCategories = ['IT', 'Kinh doanh', 'Marketing', 'Tài chính', 'Sáng tạo', 'Y tế', 'Thực tập', 'Chuyên nghiệp'];
        let activeFilters = new Set(['all']);

        filters.forEach(btn => {
            btn.addEventListener('click', function() {
                const filterValue = this.getAttribute('data-filter');

                if (filterValue === 'all') {
                    activeFilters.clear();
                    activeFilters.add('all');
                    filters.forEach(f => f.classList.remove('active'));
                    this.classList.add('active');
                } else {
                    if (activeFilters.has('all')) {
                        activeFilters.delete('all');
                        document.querySelector('[data-filter="all"]').classList.remove('active');
                    }

                    if (activeFilters.has(filterValue)) {
                        activeFilters.delete(filterValue);
                        this.classList.remove('active');
                    } else {
                        activeFilters.add(filterValue);
                        this.classList.add('active');
                    }

                    if (activeFilters.size === 0) {
                        activeFilters.add('all');
                        document.querySelector('[data-filter="all"]').classList.add('active');
                    }
                }

                renderItems();
            });
        });

        function renderItems() {
            items.forEach(item => {
                const itemCategoryStr = item.getAttribute('data-category') || "";
                const itemCategories = itemCategoryStr.split(',').map(s => s.trim()).filter(s => s !== "");

                let show = false;
                if (activeFilters.has('all')) {
                    show = true;
                } else {
                    // Logic AND: Phải thỏa mãn TẤT CẢ các filter đang chọn
                    show = Array.from(activeFilters).every(filter => {
                        if (filter === 'Khác') {
                            // Khác: Nếu không có category nào hoặc có category không nằm trong danh sách định sẵn
                            if (itemCategories.length === 0) return true;
                            return itemCategories.some(cat => !predefinedCategories.includes(cat));
                        }
                        return itemCategories.includes(filter);
                    });
                }

                if (show) {
                    item.style.display = 'block';
                    setTimeout(() => { item.style.opacity = '1'; }, 10);
                } else {
                    item.style.opacity = '0';
                    setTimeout(() => { item.style.display = 'none'; }, 300);
                }
            });
        }
    });
</script>
