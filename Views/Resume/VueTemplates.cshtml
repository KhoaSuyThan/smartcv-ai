@model IEnumerable<DoAnCS.Models.VueTemplate>
@{
    ViewData["Title"] = "Mẫu CV Vue";
}

<style>
    /* Premium UI Styles */
    body {
        background-color: #f4f6f9 !important;
    }
    
    .hero-section {
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        border-radius: 1.5rem;
        padding: 2rem 2rem;
        color: white;
        position: relative;
        overflow: hidden;
        box-shadow: 0 20px 40px -10px rgba(124, 58, 237, 0.3);
        transition: background 0.3s ease, box-shadow 0.3s ease;
    }
    
    [data-bs-theme="dark"] .hero-section {
        background: linear-gradient(135deg, #1e1b4b 0%, #2e1065 100%) !important;
        box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.5) !important;
    }
    
    .hero-pattern {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0.1;
        background-image: radial-gradient(white 2px, transparent 2px);
        background-size: 30px 30px;
    }

    .hero-content {
        position: relative;
        z-index: 1;
    }

    /* Filters */
    .filter-container {
        gap: 0.75rem !important;
    }
    
    .filter-btn {
        border: none !important;
        background-color: #ffffff;
        color: #4b5563;
        font-weight: 500;
        padding: 0.6rem 1.2rem;
        border-radius: 50rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .filter-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        color: #4f46e5;
    }

    .filter-btn.active {
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        color: white;
        box-shadow: 0 10px 15px -3px rgba(124, 58, 237, 0.3);
    }

    /* Cards */
    .template-item {
        transition: all 0.4s ease-out;
    }

    .template-card {
        border: 1px solid rgba(0, 0, 0, 0.06) !important;
        border-radius: 1.25rem !important;
        overflow: hidden;
        background: #ffffff;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.02) !important;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
    }

    .template-card.border-pro { 
        border: 2px solid #fbbf24 !important;
        box-shadow: 0 0 20px rgba(251, 191, 36, 0.25) !important;
    }
    .template-card.border-pro::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; height: 4px;
        background: linear-gradient(90deg, #fbbf24, #f59e0b);
        z-index: 10;
    }

    .template-card:hover { 
        transform: translateY(-8px); 
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1) !important; 
    }
    
    .template-card.border-pro:hover {
        box-shadow: 0 0 30px rgba(251, 191, 36, 0.5) !important;
    }

    .card-img-wrapper {
        position: relative;
        padding: 1rem;
        background: #f1f5f9;
        border-radius: 1.25rem 1.25rem 0 0;
        overflow: hidden;
    }

    .template-card img {
        object-fit: contain !important; 
        height: 320px;
        width: 100%;
        border-radius: 0.75rem;
        background: white;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.08), 0 2px 4px rgba(0, 0, 0, 0.04) !important;
        border: 1px solid rgba(0, 0, 0, 0.08) !important;
        transition: transform 0.5s ease;
    }
    
    .template-card:hover img {
        transform: scale(1.02);
    }

    /* Glassmorphism Badges */
    .badge-glass {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        color: #1f2937;
        font-weight: 600;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }

    .badge-pro {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: white;
        font-weight: 700;
        border: none;
        box-shadow: 0 4px 10px rgba(245, 158, 11, 0.4);
    }
    
    .test-badge {
        position: absolute;
        top: 1.5rem;
        left: 1.5rem;
        z-index: 3;
    }

    .pro-badge {
        position: absolute;
        top: 1.5rem;
        right: 1.5rem;
        z-index: 3;
    }

    /* Hover Overlay */
    .hover-overlay {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(17, 24, 39, 0.4);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: all 0.4s ease;
        z-index: 5;
        border-radius: 1.25rem 1.25rem 0 0;
    }
    
    .template-card:hover .hover-overlay { opacity: 1; }
    
    .btn-use-template {
        transform: translateY(20px);
        transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        background: white;
        color: #4f46e5;
        border: none;
        font-weight: 700;
        padding: 0.8rem 1.5rem;
        border-radius: 50rem;
        box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        text-decoration: none;
    }
    
    .btn-use-template:hover {
        background: #4f46e5;
        color: white;
        box-shadow: 0 15px 30px rgba(79, 70, 229, 0.4);
    }

    .template-card:hover .btn-use-template {
        transform: translateY(0);
    }

    /* Card Body */
    .card-body {
        padding: 1.5rem;
        background: white;
    }

    .category-tag {
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.4em 0.8em;
        background-color: #e0e7ff;
        color: #4338ca;
        border-radius: 0.5rem;
        display: inline-block;
        margin-top: 0.5rem;
    }

    /* Premium Modal Styles */
    .modal-pro-content {
        border-radius: 1.5rem !important;
        border: none;
        background: #ffffff;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        overflow: visible; /* To allow the floating icon to show */
    }
    
    .modal-pro-header {
        background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
        padding: 3rem 1rem 1.5rem;
        border-radius: 1.5rem 1.5rem 0 0;
        position: relative;
        border-bottom: 1px solid #fde68a;
    }
    
    .modal-pro-icon {
        width: 90px;
        height: 90px;
        background: linear-gradient(135deg, #fbbf24 0%, #d97706 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        box-shadow: 0 10px 25px -5px rgba(217, 119, 6, 0.5);
        position: absolute;
        top: -45px;
        left: 50%;
        transform: translateX(-50%);
        border: 5px solid white;
    }
    
    .modal-pro-icon i {
        font-size: 2.5rem;
        color: white;
    }
    
    .btn-pro-upgrade {
        background: linear-gradient(135deg, #fbbf24 0%, #d97706 100%);
        color: white !important;
        border: none;
        font-weight: 700;
        box-shadow: 0 10px 15px -3px rgba(217, 119, 6, 0.3);
        transition: all 0.3s ease;
    }
    
    .btn-pro-upgrade:hover {
        transform: translateY(-2px);
        box-shadow: 0 15px 20px -5px rgba(217, 119, 6, 0.4);
        color: white !important;
    }
    
    .btn-pro-upgrade i {
        color: #fef3c7 !important;
    }
</style>

<div class="container-fluid py-5" style="max-width: 1750px;">
    <!-- Hero Section -->
    <div class="hero-section mb-5 text-center">
        <div class="hero-pattern"></div>
        <div class="hero-content">
            <h1 class="fw-bold mb-3 display-5"><i class="fas fa-magic me-3 text-warning"></i>Bộ Sưu Tập Mẫu CV Vue</h1>
            <p class="mx-auto fs-5 opacity-75" style="max-width: 700px;">
                Trải nghiệm những mẫu CV hiện đại, tương tác cao được xây dựng với khả năng tùy chỉnh trực quan, xem trước thời gian thực.
            </p>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="d-flex justify-content-center mb-5 flex-wrap filter-container">
        <button class="filter-btn active" data-filter="all"><i class="fas fa-layer-group"></i> Tất cả</button>
        <button class="filter-btn" data-filter="IT"><i class="fas fa-laptop-code"></i> IT</button>
        <button class="filter-btn" data-filter="Kinh doanh"><i class="fas fa-chart-line"></i> Kinh doanh</button>
        <button class="filter-btn" data-filter="Marketing"><i class="fas fa-bullhorn"></i> Marketing</button>
        <button class="filter-btn" data-filter="Tài chính"><i class="fas fa-coins"></i> Tài chính</button>
        <button class="filter-btn" data-filter="Sáng tạo"><i class="fas fa-palette"></i> Sáng tạo</button>
        <button class="filter-btn" data-filter="Y tế"><i class="fas fa-heartbeat"></i> Y tế</button>
        <button class="filter-btn" data-filter="Thực tập"><i class="fas fa-user-graduate"></i> Thực tập</button>
        <button class="filter-btn" data-filter="Chuyên nghiệp"><i class="fas fa-briefcase"></i> Chuyên nghiệp</button>
        <button class="filter-btn" data-filter="Khác"><i class="fas fa-ellipsis-h"></i> Khác</button>
    </div>

    <!-- Pro Upgrade Modal (Luôn tồn tại trong DOM) -->
    <div class="modal fade" id="proUpgradeModal" tabindex="-1" aria-labelledby="proUpgradeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modal-pro-content mt-4">
                <div class="modal-header border-0 pb-0 position-absolute end-0 top-0 z-3 p-3">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-pro-header text-center">
                    <div class="modal-pro-icon">
                        <i class="fas fa-crown"></i>
                    </div>
                    <h3 class="fw-bold mb-1 mt-2" style="color: #92400e; letter-spacing: -0.5px;">Tính Năng Cao Cấp</h3>
                </div>
                <div class="modal-body text-center px-4 py-4">
                    <p class="text-secondary mb-4 fs-6 lh-lg" id="proModalMessage">@(TempData["ErrorMessage"] ?? "Mẫu CV này được thiết kế độc quyền cho thành viên Pro. Hãy nâng cấp tài khoản để trải nghiệm mẫu CV xịn xò này!")</p>
                    <div class="d-grid gap-3">
                        <a href="/Account/Upgrade" class="btn btn-pro-upgrade rounded-pill py-3 fs-5">
                            <i class="fas fa-bolt me-2"></i> Nâng cấp Pro ngay
                        </a>
                        <button type="button" class="btn btn-light rounded-pill py-2 fw-bold text-muted border" data-bs-dismiss="modal">Để sau</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function() {
                var proModal = new bootstrap.Modal(document.getElementById('proUpgradeModal'));
                proModal.show();
            });
        </script>
    }

    <!-- Cards Section -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-4 justify-content-center">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="p-5 bg-white rounded-4 shadow-sm border border-light">
                    <i class="fas fa-folder-open text-muted mb-3" style="font-size: 4rem; opacity: 0.5;"></i>
                    <h3 class="fw-bold text-dark">Chưa có mẫu CV nào</h3>
                    <p class="text-muted">Danh sách mẫu CV Vue hiện tại đang trống. Vui lòng quay lại sau.</p>
                </div>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col template-item" data-category="@item.Category">
                    <div class="card h-100 template-card @(item.IsPremium ? "border-pro" : "")">
                        @if (item.IsPremium)
                        {
                            <div class="pro-badge">
                                <span class="badge badge-pro px-3 py-2 rounded-pill">
                                    <i class="fas fa-crown me-1"></i> PRO
                                </span>
                            </div>
                        }
                        
                        <div class="card-img-wrapper">
                            <img src="@item.ThumbnailUrl" alt="@item.TemplateName" 
                                 onerror="this.src='https://images.unsplash.com/photo-1586281380117-5a60ae2050cc?q=80&w=400'">
                            
                            <div class="hover-overlay">
                                <a href="@Url.Action("CreateVue", "Resume", new { id = item.Id })" 
                                   onclick="return checkProAccess(event, @item.IsPremium.ToString().ToLower(), @ViewBag.IsPro.ToString().ToLower());"
                                   class="btn btn-use-template">
                                    <i class="fas fa-pen-nib me-2"></i>Sử dụng mẫu này
                                </a>
                            </div>
                        </div>
                        <div class="card-body text-center">
                            <h5 class="fw-bold mb-1 text-dark">@item.TemplateName</h5>
                            @if (!string.IsNullOrEmpty(item.Category))
                            {
                                <div class="category-tag">@item.Category</div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>

</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const filters = document.querySelectorAll('.filter-btn');
        const items = document.querySelectorAll('.template-item');
        const predefinedCategories = ['IT', 'Kinh doanh', 'Marketing', 'Tài chính', 'Sáng tạo', 'Y tế', 'Thực tập', 'Chuyên nghiệp'];
        let activeFilters = new Set(['all']);

        filters.forEach(btn => {
            btn.addEventListener('click', function() {
                const filterValue = this.getAttribute('data-filter');

                if (filterValue === 'all') {
                    activeFilters.clear();
                    activeFilters.add('all');
                    filters.forEach(f => f.classList.remove('active'));
                    this.classList.add('active');
                } else {
                    if (activeFilters.has('all')) {
                        activeFilters.delete('all');
                        document.querySelector('[data-filter="all"]').classList.remove('active');
                    }

                    if (activeFilters.has(filterValue)) {
                        activeFilters.delete(filterValue);
                        this.classList.remove('active');
                    } else {
                        activeFilters.add(filterValue);
                        this.classList.add('active');
                    }

                    if (activeFilters.size === 0) {
                        activeFilters.add('all');
                        document.querySelector('[data-filter="all"]').classList.add('active');
                    }
                }

                renderItems();
            });
        });

        function renderItems() {
            items.forEach(item => {
                const itemCategoryStr = item.getAttribute('data-category') || "";
                const itemCategories = itemCategoryStr.split(',').map(s => s.trim()).filter(s => s !== "");

                let show = false;
                if (activeFilters.has('all')) {
                    show = true;
                } else {
                    // Logic AND: Phải thỏa mãn TẤT CẢ các filter đang chọn
                    show = Array.from(activeFilters).every(filter => {
                        if (filter === 'Khác') {
                            // Khác: Nếu không có category nào hoặc có category không nằm trong danh sách định sẵn
                            if (itemCategories.length === 0) return true;
                            return itemCategories.some(cat => !predefinedCategories.includes(cat));
                        }
                        return itemCategories.includes(filter);
                    });
                }

                if (show) {
                    item.style.display = 'block';
                    setTimeout(() => { item.style.opacity = '1'; }, 10);
                } else {
                    item.style.opacity = '0';
                    setTimeout(() => { item.style.display = 'none'; }, 300);
                }
            });
        }
    });

    window.checkProAccess = function(e, isPremium, isPro) {
        if (isPremium && !isPro) {
            e.preventDefault();
            var proModal = new bootstrap.Modal(document.getElementById('proUpgradeModal'));
            proModal.show();
            return false;
        }
        return true;
    };
</script>
