@model IEnumerable<DoAnCS.Models.Resume>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-0"><i class="bi bi-file-earmark-person-fill me-2"></i>Hồ sơ của tôi</h2>
            <p class="text-muted">Danh sách các bản CV đã tạo và bản nháp đang thực hiện</p>
        </div>
        <a href="@Url.Action("Templates", "Resume")" class="btn btn-primary shadow-sm px-4">
            <i class="bi bi-plus-lg"></i> Tạo CV mới
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 border rounded-3 bg-light">
            <i class="bi bi-file-earmark-person display-1 text-secondary mb-3"></i>
            <h4 class="text-secondary">Bạn chưa có bản CV nào</h4>
            <a href="@Url.Action("Templates", "Resume")" class="btn btn-primary mt-3">Bắt đầu ngay</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var cv in Model)
            {
                <div class="col-md-6 col-lg-4 col-xl-3" id="cv-card-@cv.ResumeID">
                    <div class="card h-100 shadow-sm border-0 transition-hover">
                        
                        <div class="position-relative overflow-hidden bg-white border-bottom" 
                             style="aspect-ratio: 1 / 1.4; width: 100%;">
                            
                             @{
                                bool isVueCV_Img = (cv.Title != null && cv.Title.StartsWith("CV Vue:")) || !string.IsNullOrEmpty(cv.JsonContent);
                                bool isPdf_Img = !string.IsNullOrEmpty(cv.FileUploadUrl);
                                string previewUrl = "";
                                
                                if (isPdf_Img) 
                                {
                                    // Placeholder cho file PDF tải lên
                                    previewUrl = "/images/pdf-placeholder.png"; 
                                }
                                else if (isVueCV_Img) 
                                {
                                    // Tìm thumbnail chuẩn từ bảng VueTemplates thông qua TemplateID
                                    var vtList = ViewBag.VueTemplates as IEnumerable<DoAnCS.Models.VueTemplate>;
                                    var vt = vtList?.FirstOrDefault(t => t.Id == cv.TemplateID);
                                    previewUrl = vt?.ThumbnailUrl ?? "/images/templates/vue-default.png";
                                }
                                else 
                                {
                                    previewUrl = cv.Template?.PreviewImageUrl ?? "/images/templates/default-template.png";
                                }
                            }

                            @if (isPdf_Img)
                            {
                                <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center bg-light border-bottom">
                                    <i class="bi bi-file-earmark-pdf text-danger" style="font-size: 5rem;"></i>
                                    <p class="text-muted small mt-2">Bản PDF tải lên</p>
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(previewUrl))
                            {
                                <img src="@previewUrl" class="card-img-top" 
                                     style="height: 100%; width: 100%; object-fit: cover; object-position: top;" 
                                     alt="Template Preview">
                            }
                            else
                            {
                                <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center bg-light text-secondary opacity-50">
                                     <i class="bi bi-file-earmark-person" style="font-size: 4rem;"></i>
                                     <span class="small mt-2 font-monospace">@cv.Title</span>
                                </div>
                            }
                            
                             <div class="position-absolute top-0 end-0 m-2 d-flex flex-column gap-1 align-items-end">
                                @{
                                    bool isVueCV_Badge = (cv.Title != null && cv.Title.StartsWith("CV Vue:")) || !string.IsNullOrEmpty(cv.JsonContent);
                                    bool isPdfUpload = !string.IsNullOrEmpty(cv.FileUploadUrl);
                                }
                                
                                @if (isPdfUpload)
                                {
                                    <span class="badge bg-danger shadow-sm">
                                        <i class="bi bi-file-earmark-pdf-fill"></i> FILE TẢI LÊN
                                    </span>
                                }
                                else if (isVueCV_Badge)
                                {
                                    <span class="badge bg-info text-dark shadow-sm">
                                        <i class="bi bi-magic"></i> VUE BUILDER
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-dark shadow-sm">
                                        <i class="bi bi-layout-text-window-reverse"></i> TRUYỀN THỐNG
                                    </span>
                                }

                                <span class="badge @(cv.IsDraft ? "bg-warning text-dark" : "bg-success") shadow-sm">
                                    <i class="bi @(cv.IsDraft ? "bi-pencil-fill" : "bi-check-circle-fill")"></i> 
                                    @(cv.IsDraft ? "Bản nháp" : "Hoàn thiện")
                                </span>
                            </div>
                        </div>
                        
                        <div class="card-body">
                            <h6 class="card-title mb-1 fw-bold text-truncate" id="cv-name-@cv.ResumeID">@cv.Title</h6>
                            <small class="text-muted d-block mb-3">Cập nhật: @cv.UpdatedAt.ToString("dd/MM/yyyy")</small>
                            
                            <div class="d-grid gap-2">
                                @{
                                    bool isVueCV = (cv.Title != null && cv.Title.StartsWith("CV Vue:")) || !string.IsNullOrEmpty(cv.JsonContent);
                                }
                                
                                 @if (isPdfUpload)
                                {
                                    <a href="@cv.FileUploadUrl" target="_blank" class="btn btn-danger">
                                        <i class="bi bi-eye me-1"></i> Xem file PDF
                                    </a>
                                }
                                else if (isVueCV)
                                {
                                    <a href="@Url.Action("Builder", "Resume", new { id = cv.ResumeID })" class="btn btn-primary">
                                        <i class="bi bi-magic me-1"></i> Tiếp tục chỉnh sửa (Vue)
                                    </a>
                                }
                                else
                                {
                                    <a href="@Url.Action("Create", "Resume", new { id = cv.TemplateID })" class="btn btn-outline-primary">
                                        <i class="bi bi-pencil-fill me-1"></i> Tiếp tục chỉnh sửa
                                    </a>
                                }
                                
                                <div class="d-flex gap-2">
                                    <button onclick="renameCV(@cv.ResumeID)" class="btn btn-light border flex-grow-1">
                                        <i class="bi bi-pencil-square"></i> Sửa tên
                                    </button>
                                    
                                    <button onclick="deleteCV(@cv.ResumeID)" class="btn btn-outline-danger px-3">
                                        <i class="bi bi-trash"></i> Xóa
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    /* Hiệu ứng hover card giống các trang tuyển dụng lớn */
    .transition-hover { transition: all 0.3s ease; border: 1px solid #eee !important; }
    .transition-hover:hover { transform: translateY(-5px); box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.1)!important; border-color: #0d6efd !important; }
    
    /* Đảm bảo nút Sửa tên có màu nền nhẹ nhàng */
    .btn-light { background-color: #f8f9fa; color: #333; }
    .btn-light:hover { background-color: #e2e6ea; }
</style>

@section Scripts {
    <script>
        // Hàm đổi tên CV qua AJAX
        function renameCV(cvId) {
            let currentTitle = $('#cv-name-' + cvId).text().trim();
            let newName = prompt("Nhập tên mới cho bản CV này:", currentTitle);
            
            if (newName && newName.trim() !== "" && newName.trim() !== currentTitle) {
                $.ajax({
                    url: '@Url.Action("UpdateName", "Resume")',
                    type: 'POST',
                    data: { id: cvId, newName: newName.trim() },
                    success: function(res) {
                        if (res.success) {
                            $('#cv-name-' + cvId).text(newName.trim());
                            $('#cv-name-' + cvId).fadeOut(100).fadeIn(100);
                        } else {
                            alert(res.message || "Lỗi khi đổi tên.");
                        }
                    },
                    error: function() { alert("Lỗi kết nối máy chủ."); }
                });
            }
        }

        // Hàm xóa CV qua AJAX
        function deleteCV(cvId) {
            if (confirm("Bạn có chắc chắn muốn xóa bản hồ sơ này?")) {
                $.ajax({
                    url: '@Url.Action("Delete", "Resume")',
                    type: 'POST',
                    data: { id: cvId },
                    success: function(res) {
                        if (res.success) {
                            $('#cv-card-' + cvId).fadeOut(400, function() { 
                                $(this).remove(); 
                                if ($('.card').length === 0) location.reload();
                            });
                        } else {
                            alert(res.message || "Lỗi khi xóa.");
                        }
                    }
                });
            }
        }
    </script>
}