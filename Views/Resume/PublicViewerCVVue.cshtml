@{
    ViewData["Title"] = "Hồ sơ năng lực (CV)";
    Layout = "_Layout"; 
}

@section Styles {
    <!-- Load CSS của Vue -->
    <link rel="stylesheet" href="~/cvbuilder/assets/index_v13.css" asp-append-version="true" />
    
    <style>
        /* Cấu hình để ẩn các công cụ Editor */
        .cv-builder-editor-panel { display: none !important; }
        .no-print.sticky.top-0 { display: none !important; }
        .absolute.top-7.z-40 { display: none !important; }
        .sticky.top-\[80px\] { display: none !important; } /* Hide AI Tools */
        .sticky.top-\[110px\] > div:not(:first-child) { display: none !important; } /* Hide Cover Letter and Job Matcher */
        
        /* Ẩn tất cả các công cụ tương tác nổi trong CV */
        div.nav-btns, button.nav-btn, button.delete-btn, div.contact-item-btns,
        .cv-preview-card .nav-btns, .cv-preview-card .nav-btn, .cv-preview-card .delete-btn { 
            display: none !important; 
            opacity: 0 !important;
            visibility: hidden !important;
            pointer-events: none !important;
        }
        
        .cv-preview-card .section-block:hover, 
        .cv-preview-card .item-container:hover,
        .cv-preview-card .section-active,
        .cv-preview-card .section-selected,
        .cv-preview-card .section-selected-main,
        .cv-preview-card .section-selected-sidebar { 
            background-color: transparent !important; 
            border-color: transparent !important; 
            box-shadow: none !important; 
            cursor: text !important; 
            outline: none !important;
        }
        
        /* Disable clicks on contenteditable elements inside preview */
        .cv-preview-card [contenteditable], .cv-preview-card input, .cv-preview-card textarea, .cv-preview-card button {
            pointer-events: none !important;
            user-select: text !important;
        }
        
        .cv-builder-container {
            justify-content: center !important;
            background-color: #f3f4f6 !important;
        }

        :root {
            --navbar-h: 72px;
            --footer-h: 0px;
        }

        html, body.cv-builder-page { 
            overflow: hidden !important; /* Khóa cuộn trang chính để cuộn trong iframe/app */
            height: 100% !important;
            background-color: #f3f4f6 !important;
        }

        .content-wrapper { 
            padding: 0 !important; 
            overflow: hidden !important;
            background-color: #f3f4f6 !important;
            height: calc(100vh - 72px) !important; /* Chiều cao khít màn hình dưới navbar */
        }

        .content-wrapper > main { 
            padding: 0 !important; 
            overflow: hidden !important;
            background-color: #f3f4f6 !important;
            height: 100% !important;
        }

        #app {
            background-color: #f3f4f6;
            overflow: auto !important;
            height: 100% !important;
        }
        
        /* Auto scale CV container to center it nicely if possible */
        .cv-preview-card {
            margin: 40px auto !important;
            box-shadow: 0 10px 40px rgba(0,0,0,0.1) !important;
        }

        /* Hỗ trợ Dark Mode đồng bộ */
        [data-bs-theme="dark"] html, 
        [data-bs-theme="dark"] body.cv-builder-page,
        [data-bs-theme="dark"] .content-wrapper,
        [data-bs-theme="dark"] .content-wrapper > main,
        [data-bs-theme="dark"] #app {
            background-color: #0f172a !important;
        }
    </style>
}

<script>
    // Chạy chung cho cả 2 luồng để ẩn footer và thêm class body cv-builder-page
    document.addEventListener('DOMContentLoaded', function () {
        var footer = document.querySelector('footer');
        if (footer) footer.style.display = 'none';
        document.body.classList.add('cv-builder-page');
    });
</script>

@if (Model != null && !string.IsNullOrEmpty(Model.FileUploadUrl))
{
    @* Nếu đây là CV được người dùng upload dưới dạng PDF *@
    <div style="width: 100%; height: 100%; background: #333; margin: 0; padding: 0;">
        <iframe src="@Model.FileUploadUrl" width="100%" height="100%" style="border: none;"></iframe>
    </div>
}
else
{
    @* Giao diện cho CV Vue *@
    <script>
        window.CURRENT_RESUME_ID = @(ViewBag.ResumeId ?? 0);
        window.IS_PUBLIC_VIEW = true; // Flag for safety
        window.IS_PRO_USER = @(ViewBag.IsOwnerPro == true ? "true" : "false");

        document.addEventListener('DOMContentLoaded', function () {
            // Bắt sự kiện click ở giai đoạn Capture (trước khi Vue nhận được)
            // để ngăn chặn hoàn toàn các thao tác chọn section/kích hoạt edit trong Vue
            document.addEventListener('click', function(e) {
                if (window.IS_PUBLIC_VIEW && e.target.closest('.cv-preview-card')) {
                    e.stopPropagation();
                }
            }, true);

            // Inject watermark cho CV công khai của user Free
            if (!window.IS_PRO_USER) {
                var checkReady = setInterval(function() {
                    var cvCard = document.querySelector('.cv-preview-card');
                    if (cvCard) {
                        clearInterval(checkReady);
                        cvCard.style.position = 'relative';
                        var wm = document.createElement('div');
                        wm.textContent = '@@cvbuilder';
                        wm.style.cssText = 'position:absolute;bottom:10px;left:14px;font-size:9px;color:rgba(100,116,139,0.55);z-index:10;pointer-events:none;font-weight:500;letter-spacing:0.3px;font-family:Inter,Segoe UI,sans-serif;user-select:none;';
                        cvCard.appendChild(wm);
                    }
                }, 500);
            }
        });
    </script>

    <div id="app">
        <div style="display:flex; justify-content:center; align-items:center; height:60vh;">
            <div class="text-center">
                <h2 class="text-primary"><i class="fas fa-spinner fa-spin me-2"></i>Đang tải CV...</h2>
            </div>
        </div>
    </div>
    
    @section Scripts {
        <script type="module" src="~/cvbuilder/assets/index_v13.js" asp-append-version="true"></script>
    }
}
