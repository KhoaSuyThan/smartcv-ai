@{
    ViewData["Title"] = "Vue CV Builder";
    Layout = "_Layout"; 
}

@section Styles {
    <!-- Load CSS của Vue -->
    <link rel="stylesheet" href="~/cvbuilder/assets/index_v13.css" asp-append-version="true" />
    <!-- Cropper CSS cho ảnh đại diện -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css">
    
    <style>
        /* Cấu hình để Builder luôn phủ kín phần giữa header và footer */
        :root {
            --navbar-h: 72px;
            --footer-h: 0px;
        }

        /* ĐẢM BẢO trang Builder không bị scroll dọc ngoài ý muốn và đồng bộ màu nền */
        html, body.cv-builder-page { 
            overflow: hidden !important; 
            height: 100% !important;
            background-color: #f3f4f6 !important;
            margin: 0;
            padding: 0;
        }

        /* Bù trừ zoom 80% từ Layout */
        body.cv-builder-page {
            min-height: 125vh !important; /* 100 / 0.8 = 125 */
        }

        /* Content wrapper không có padding */
        .content-wrapper, .content-wrapper > main { 
            padding: 0 !important; 
            overflow: hidden !important;
            background-color: #f3f4f6 !important;
            height: 100% !important;
        }

        /* Container Vue App */
        #app {
            background-color: #f3f4f6;
            overflow: hidden;
            height: 100% !important;
        }

        .cv-builder-container {
            display: flex;
            overflow: hidden;
            height: 100% !important;
        }

        /* HIỂN THỊ TÁCH ĐÔI TRANG GIẤY TRÊN LIVE PREVIEW */
        #cv-printable-area div.z-50.no-print > div,
        #cv-printable-area .page-break-mask {
            height: 24px !important;
            background-color: #1e293b !important; /* Trùng khớp hoàn hảo với bg-slate-800 của vùng preview */
            background-image: none !important;
            border-top: 1.5px solid #0f172a !important; /* Viền sậm tạo độ sâu cho mép cắt */
            border-bottom: 1.5px solid #0f172a !important;
            border-left: none !important;
            border-right: none !important;
            box-shadow: inset 0 8px 8px -6px rgba(0, 0, 0, 0.5), 
                        inset 0 -8px 8px -6px rgba(0, 0, 0, 0.5) !important;
            backdrop-filter: none !important;
            opacity: 1 !important;
        }

        #cv-printable-area div.z-50.no-print {
            height: 24px !important;
            margin-top: -4px !important; /* Cân chỉnh cho khít mốc top: calc(p * 297mm - 8px) */
        }

        #cv-printable-area .page-break-indicator {
            height: 24px !important;
            margin-top: 13px !important; /* Cân chỉnh cho khít mốc top: calc(p * 297mm - 25px) */
        }

        /* Đồng bộ màu nền khi dùng chế độ Dark Mode nếu có */
        [data-bs-theme="dark"] #cv-printable-area div.z-50.no-print > div,
        [data-bs-theme="dark"] #cv-printable-area .page-break-mask {
            background-color: #1e293b !important;
            border-top: 1.5px solid #020617 !important;
            border-bottom: 1.5px solid #020617 !important;
            box-shadow: inset 0 8px 8px -6px rgba(0, 0, 0, 0.7), 
                        inset 0 -8px 8px -6px rgba(0, 0, 0, 0.7) !important;
        }

        /* TỐI ƯU HÓA KHI IN / XUẤT PDF */
        @@page { size: A4; margin: 0; }

        @@media print {
            * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }

            body > header, 
            body > footer, 
            body > nav, 
            body > aside, 
            .no-print, 
            .cv-builder-editor-panel, 
            button, 
            .fixed, 
            .sticky { display: none !important; }
            
            /* Xóa bỏ hoàn toàn màu nền và pattern của UI khi in */
            html, body, body.cv-builder-page, #app, 
            .content-wrapper, 
            .content-wrapper > main, 
            .cv-builder-container, 
            .cv-builder-container > .flex-1 { 
                background: white !important; 
                background-image: none !important;
                display: block !important; 
                margin: 0 !important; 
                padding: 0 !important; 
                width: 100% !important; 
                height: auto !important; 
                min-height: 0 !important;
                overflow: visible !important;
                position: static !important;
            }

            /* Reset lỗi Zoom cho Preview Card */
            .cv-preview-card {
                transform: none !important;
                margin: 0 !important;
                padding: 0 !important;
                border: none !important;
                box-shadow: none !important;
                width: 210mm !important;
                height: auto !important;
                min-height: 0 !important;
                position: static !important;
                display: block !important;
                background: white !important;
            }

            .cv-preview-wrapper {
                padding: 0 !important;
                margin: 0 !important;
                display: block !important;
                min-width: 0 !important;
                width: 100% !important;
                height: auto !important;
            }

            #cv-printable-area { 
                width: 210mm !important; 
                overflow: visible !important; 
                margin: 0 !important; 
                box-shadow: none !important; 
                transform: none !important; 
                position: relative !important; 
                background: white !important; 
                border: none !important;
            }

            /* CRITICAL: Children của template (main, sidebar columns, flex columns) */
            
            /* Make columns stretch to fill the height of their parent wrapper */
            #cv-printable-area main,
            #cv-printable-area aside,
            #cv-printable-area .left-column,
            #cv-printable-area .right-column,
            #cv-printable-area .left-sidebar,
            #cv-printable-area .right-main,
            #cv-printable-area .cv-sidebar,
            #cv-printable-area .cv-main-content {
                overflow: visible !important;
                height: 100% !important;
                max-height: none !important;
            }

            /* Direct children headers or browser bars should NEVER be forced to 100% height, they must be natural height */
            #cv-printable-area header,
            #cv-printable-area footer,
            #cv-printable-area .browser-header,
            #cv-printable-area .header-card,
            #cv-printable-area .header-area,
            #cv-printable-area .header-container,
            #cv-printable-area .profile-card,
            #cv-printable-area .profile-section {
                height: auto !important;
                flex-grow: 0 !important;
                flex-shrink: 0 !important;
            }

            /* For templates with a wrapper div (like .cv-container, .main-layout, etc.) directly under root */
            #cv-printable-area > div:not(.deco-element):not(.no-print):not(.absolute):not(.browser-header):not(.header-card):not(.header-area):not(.header-container):not(.profile-card):not(.profile-section) {
                height: 100% !important;
                overflow: visible !important;
            }

            /* But if a wrapper div is preceded by a header/browser bar, it should grow instead of forcing 100% height */
            #cv-printable-area > header + div:not(.absolute),
            #cv-printable-area > .browser-header + div:not(.absolute),
            #cv-printable-area > .header-card + div:not(.absolute),
            #cv-printable-area > .header-area + div:not(.absolute),
            #cv-printable-area > .profile-card + div:not(.absolute),
            #cv-printable-area > .profile-section + div:not(.absolute),
            .cv-elegant-wrapper > div:not(.header-area):not(.absolute),
            .cv-browser-wrapper > div:not(.browser-header):not(.absolute) {
                height: auto !important;
                flex-grow: 1 !important;
                flex-shrink: 1 !important;
                overflow: visible !important;
            }
        }
    </style>
}

<script>
    window.CURRENT_RESUME_ID = @(ViewBag.ResumeId ?? 0);
    window.IS_PRO_USER = @(User.HasClaim("IsPro", "True") || User.IsInRole("Admin") ? "true" : "false");

    document.addEventListener('DOMContentLoaded', function () {
        var footer = document.querySelector('footer');
        if (footer) footer.style.display = 'none';

        function syncHeight() {
            var navbar = document.querySelector('header');
            var navH = navbar ? navbar.offsetHeight : 72;
            document.documentElement.style.setProperty('--navbar-h', navH + 'px');

            // Cấu hình các wrapper
            var wrappers = ['.content-wrapper', 'main', '#app', '.cv-builder-container', '.cv-builder-editor-panel'];
            wrappers.forEach(function(selector) {
                var el = document.querySelector(selector);
                if (el) {
                    el.style.height = 'calc(100% - 0px)';
                    el.style.overflow = 'hidden';
                }
            });
        }

        syncHeight();
        window.addEventListener('resize', syncHeight);
        setTimeout(syncHeight, 500);
        setTimeout(syncHeight, 2000);

        document.body.classList.add('cv-builder-page');
    });
</script>

<div id="app">
    <div style="display:flex; justify-content:center; align-items:center; height:60vh;">
        <div class="text-center">
            <h2 class="text-primary"><i class="fas fa-spinner fa-spin me-2"></i>Đang tải Trình tạo CV...</h2>
            <p class="text-muted">Vui lòng chờ trong giây lát</p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
    <script type="module" src="~/cvbuilder/assets/index_v13.js" asp-append-version="true"></script>
}
