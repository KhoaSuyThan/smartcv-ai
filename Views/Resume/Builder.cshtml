@{
    ViewData["Title"] = "Vue CV Builder";
    Layout = "_Layout"; 
}

@section Styles {
    <!-- Load CSS của Vue -->
    <link rel="stylesheet" href="~/cvbuilder/assets/index_v12.css" asp-append-version="true" />
    <!-- Cropper CSS cho ảnh đại diện -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css">
    
    <style>
        /* Cấu hình để Builder luôn phủ kín phần giữa header và footer */
        :root {
            --navbar-h: 72px;
            --footer-h: 0px;
        }

        /* ĐẢM BẢO trang Builder không bị scroll dọc ngoài ý muốn và đồng bộ màu nền */
        html, body.cv-builder-page { 
            overflow: hidden !important; 
            height: 100% !important;
            background-color: #f3f4f6 !important;
            margin: 0;
            padding: 0;
        }

        /* Bù trừ zoom 80% từ Layout */
        body.cv-builder-page {
            min-height: 125vh !important; /* 100 / 0.8 = 125 */
        }

        /* Content wrapper không có padding */
        .content-wrapper, main { 
            padding: 0 !important; 
            overflow: hidden !important;
            background-color: #f3f4f6 !important;
            height: 100% !important;
        }

        /* Container Vue App */
        #app {
            background-color: #f3f4f6;
            overflow: hidden;
            height: 100% !important;
        }

        .cv-builder-container {
            display: flex;
            overflow: hidden;
            height: 100% !important;
        }

        /* TỐI ƯU HÓA KHI IN / XUẤT PDF */
        @@page { size: A4; margin: 0 !important; }

        @@media print {
            * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }

            header:not(#cv-printable-area *), 
            footer:not(#cv-printable-area *), 
            nav:not(#cv-printable-area *), 
            aside:not(#cv-printable-area *), 
            .no-print, 
            .cv-builder-editor-panel, 
            button, 
            .fixed, 
            .sticky { display: none !important; }
            
            /* Xóa bỏ hoàn toàn màu nền và pattern của UI khi in */
            html, body, #app, .content-wrapper, main, .cv-builder-container, .flex-1 { 
                background: white !important; 
                background-image: none !important;
                display: block !important; 
                margin: 0 !important; 
                padding: 0 !important; 
                width: 100% !important; 
                height: auto !important; 
                min-height: 0 !important;
                overflow: visible !important;
                position: static !important;
            }

            /* Reset lỗi Zoom cho Preview Card */
            .cv-preview-card {
                transform: none !important;
                margin: 0 !important;
                padding: 0 !important;
                border: none !important;
                box-shadow: none !important;
                width: 210mm !important;
                height: auto !important;
                min-height: 0 !important;
                position: static !important;
                display: block !important;
                background: white !important;
            }

            .cv-preview-wrapper {
                padding: 0 !important;
                margin: 0 !important;
                display: block !important;
                min-width: 0 !important;
                width: 100% !important;
                height: auto !important;
            }

            #cv-printable-area { 
                width: 210mm !important; 
                min-height: 0 !important;
                overflow: visible !important; 
                margin: 0 !important; 
                box-shadow: none !important; 
                transform: none !important; 
                position: static !important; 
                background: white !important; 
                border: none !important;
            }

            /* CRITICAL: Children của template (main, sidebar columns, flex columns) */
            #cv-printable-area > *,
            #cv-printable-area main,
            #cv-printable-area .left-sidebar,
            #cv-printable-area .right-main,
            #cv-printable-area .cv-sidebar,
            #cv-printable-area .cv-main-content {
                overflow: visible !important;
                height: auto !important;
                max-height: none !important;
            }
        }
    </style>
}

<script>
    window.CURRENT_RESUME_ID = @(ViewBag.ResumeId ?? 0);
    window.IS_PRO_USER = @(User.HasClaim("IsPro", "True") || User.IsInRole("Admin") ? "true" : "false");

    document.addEventListener('DOMContentLoaded', function () {
        var footer = document.querySelector('footer');
        if (footer) footer.style.display = 'none';

        function syncHeight() {
            var navbar = document.querySelector('header');
            var navH = navbar ? navbar.offsetHeight : 72;
            document.documentElement.style.setProperty('--navbar-h', navH + 'px');

            // Cấu hình các wrapper
            var wrappers = ['.content-wrapper', 'main', '#app', '.cv-builder-container', '.cv-builder-editor-panel'];
            wrappers.forEach(function(selector) {
                var el = document.querySelector(selector);
                if (el) {
                    el.style.height = 'calc(100% - 0px)';
                    el.style.overflow = 'hidden';
                }
            });
        }

        syncHeight();
        window.addEventListener('resize', syncHeight);
        setTimeout(syncHeight, 500);
        setTimeout(syncHeight, 2000);

        document.body.classList.add('cv-builder-page');
    });
</script>

<div id="app">
    <div style="display:flex; justify-content:center; align-items:center; height:60vh;">
        <div class="text-center">
            <h2 class="text-primary"><i class="fas fa-spinner fa-spin me-2"></i>Đang tải Trình tạo CV...</h2>
            <p class="text-muted">Vui lòng chờ trong giây lát</p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
    <script type="module" src="~/cvbuilder/assets/index_v12.js" asp-append-version="true"></script>
}
