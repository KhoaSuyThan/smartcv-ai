@model IEnumerable<DoAnCS.Models.Company>

@{
    ViewData["Title"] = "Danh sách Công ty";
}

<div class="companies-wrapper min-vh-100" style="background-color: #f8fafc;">
    <div class="container py-4">
        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-2">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
                <li class="breadcrumb-item active text-success fw-medium" aria-current="page">Danh sách Công ty</li>
            </ol>
        </nav>

        <!-- Header Card -->
        <div class="card border-0 shadow-sm rounded-4 px-4 py-3 mb-4 header-card-companies">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="header-title-companies mb-1 fs-3 fw-bold">Khám phá doanh nghiệp hàng đầu</h1>
                    <p class="header-desc-companies mb-0 small">Tìm hiểu môi trường làm việc và cơ hội nghề nghiệp tại các công ty uy tín.</p>
                </div>
                <div class="col-md-4 d-flex justify-content-md-end justify-content-start gap-2 mt-3 mt-md-0 align-items-center">
                    <div class="stat-box px-3 py-1 rounded-3 d-flex flex-column align-items-center justify-content-center text-center">
                        <span class="stat-num">@Model.Count()</span>
                        <span class="stat-label">Công ty</span>
                    </div>
                    <div class="stat-box px-3 py-1 rounded-3 d-flex flex-column align-items-center justify-content-center text-center">
                        <span class="stat-num">@Model.Sum(c => c.Jobs?.Count(j => j.Status == 1) ?? 0)</span>
                        <span class="stat-label">Việc làm</span>
                    </div>
                </div>
            </div>
        </div>


        <div class="row g-4">
            @foreach (var item in Model)
            {
                var activeJobsCount = item.Jobs?.Count(j => j.Status == 1) ?? 0;
                <div class="col-lg-4 col-md-6" data-aos="fade-up">
                    <div class="card h-100 company-card overflow-hidden">
                        <!-- Card Banner -->
                        <div class="card-banner" style="height: 100px; background: linear-gradient(135deg, rgba(25, 135, 84, 0.1) 0%, rgba(32, 201, 151, 0.1) 100%); position: relative;">
                            @if (activeJobsCount > 0)
                            {
                                <span class="badge bg-success position-absolute top-0 end-0 m-3 shadow-sm border border-white border-opacity-25">@activeJobsCount Việc làm</span>
                            }
                        </div>
                        
                        <!-- Logo Area -->
                        <div class="text-center position-relative" style="margin-top: -50px; z-index: 2;">
                            <div class="company-logo-wrapper d-inline-block p-2 rounded-4 shadow-sm border border-success border-opacity-10">
                                <div class="w-100 h-100 d-flex align-items-center justify-content-center overflow-hidden rounded-3">
                                    @if (!string.IsNullOrEmpty(item.LogoUrl))
                                    {
                                        <img src="@item.LogoUrl" alt="@item.Name" class="img-fluid" style="max-height: 80px;">
                                    }
                                    else
                                    {
                                        <span class="fs-1 fw-bold text-success">@item.Name.Substring(0, 1).ToUpper()</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="card-body p-4 text-center">
                            <h5 class="card-title fw-bold mb-2 text-dark">@item.Name</h5>
                            <p class="text-muted small mb-3">
                                <span class="badge bg-light text-success border px-2 py-1">
                                    <i class="fas fa-map-marker-alt text-danger me-1"></i> @(item.Address ?? "Toàn quốc")
                                </span>
                            </p>
                            <p class="card-text text-secondary small mb-0 description-text">
                                @(string.IsNullOrEmpty(item.Description) ? "Chưa có mô tả chi tiết cho công ty này." : item.Description)
                            </p>
                        </div>
                        
                        <div class="card-footer bg-transparent border-0 p-4 pt-0">
                            <div class="d-grid">
                                <a asp-action="Details" asp-route-id="@item.CompanyID" class="btn btn-success rounded-pill fw-bold py-2 transition-all detail-btn">
                                    Xem chi tiết
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5 bg-white rounded-4 shadow-sm" data-aos="fade-up">
                <div class="mb-4">
                    <i class="fas fa-search fa-4x text-light"></i>
                </div>
                <h4 class="text-muted">Chưa tìm thấy dữ liệu công ty.</h4>
                <p class="text-muted small">Vui lòng quay lại sau nhé!</p>
            </div>
        }
    </div>
</div>

<style>
    .company-card {
        border: 2px solid transparent;
        border-bottom: 4px solid #198754;
        border-radius: 24px;
        background-color: #ffffff;
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.03);
    }
    
    .company-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 25px -5px rgba(25, 135, 84, 0.15), 0 10px 10px -5px rgba(25, 135, 84, 0.1);
        border-color: #198754;
    }
    
    .company-logo-wrapper {
        width: 100px;
        height: 100px;
        transition: all 0.3s ease;
        background-color: #ffffff !important;
        border: 1px solid rgba(25, 135, 84, 0.15) !important;
    }
    
    .company-card:hover .company-logo-wrapper {
        transform: scale(1.1);
        box-shadow: 0 8px 15px rgba(25, 135, 84, 0.2) !important;
    }
    
    .company-card:hover .card-banner {
        filter: brightness(0.98);
    }

    .detail-btn {
        box-shadow: 0 4px 10px rgba(25, 135, 84, 0.2);
    }

    .detail-btn:hover {
        background-color: #157347;
        box-shadow: 0 6px 15px rgba(25, 135, 84, 0.4);
        transform: scale(1.02);
    }
    
    .description-text {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 4.5em;
        line-height: 1.5;
        color: #475569;
    }
    
    .opacity-90 { opacity: 0.9; }
    .z-1 { z-index: 1; }

    /* Custom Header Card */
    .header-card-companies {
        background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%) !important;
        border: 1px solid rgba(25, 135, 84, 0.1) !important;
    }
    
    [data-bs-theme="dark"] .header-card-companies {
        background: rgba(25, 135, 84, 0.1) !important;
        border: 1px solid rgba(25, 135, 84, 0.35) !important;
        box-shadow: 0 8px 32px 0 rgba(25, 135, 84, 0.1) !important;
    }
    
    .header-title-companies {
        color: #14532d !important;
        font-weight: 800 !important;
        letter-spacing: -0.5px;
    }
    
    [data-bs-theme="dark"] .header-title-companies {
        color: #f0fdf4 !important;
    }
    
    .header-desc-companies {
        color: #166534 !important;
        opacity: 0.85;
        font-weight: 500;
    }
    
    [data-bs-theme="dark"] .header-desc-companies {
        color: #dcfce7 !important;
    }

    .stat-box {
        background: rgba(25, 135, 84, 0.06); 
        border: 1px solid rgba(25, 135, 84, 0.15);
        min-width: 95px;
        transition: all 0.3s ease;
    }

    [data-bs-theme="dark"] .stat-box {
        background: rgba(25, 135, 84, 0.2); 
        border: 1px solid rgba(25, 135, 84, 0.4);
    }

    .stat-num {
        color: #198754; 
        font-weight: 800; 
        font-size: 1.15rem;
        line-height: 1.2;
    }

    [data-bs-theme="dark"] .stat-num {
        color: #dcfce7;
    }

    .stat-label {
        color: #157347; 
        font-size: 0.72rem; 
        font-weight: bold;
    }

    [data-bs-theme="dark"] .stat-label {
        color: #a7f3d0;
    }

    [data-bs-theme="dark"] .companies-wrapper {
        background-color: transparent !important;
    }

    [data-bs-theme="dark"] .company-card {
        background-color: #1e293b !important;
        border-bottom: 4px solid #198754 !important;
    }

    [data-bs-theme="dark"] .company-card .card-title {
        color: #f8fafc !important;
    }
</style>
